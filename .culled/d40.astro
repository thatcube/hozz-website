---
/** 40 · Selvedge — a double-Z seam visibly joins two soft halves. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <path d="M31 5C15 5 5 15 5 32s10 27 26 27V5Z" fill={a.deep} />
  <path d="M33 5c16 0 26 10 26 27S49 59 33 59V5Z" fill={a.hue} />
  <circle cx="32" cy="32" r="27" fill="none" stroke={a.light} stroke-width="1.25" stroke-opacity="0.32" />

  <g fill="none" stroke={a.light} stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M15 19H31L15 33H31" />
    <path d="M33 31H49L33 45H49" />
  </g>
</svg>
