---
/** 33 · Soft Signal — the ZZ face reduced to three equal-weight gestures. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <g
    fill="none"
    stroke={a.hue}
    stroke-width="3.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 24H28L20 31H28" />
    <path d="M36 24H44L36 31H44" />
    <path d="M28 37.5C30 40.5 34 40.5 36 37.5" />
  </g>
</svg>
