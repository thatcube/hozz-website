---
/**
 * 20 · Tile — a squircle in one flat hue, ZZ knocked out in white. Nothing else.
 *
 * The most iOS-native answer in the set, so the proportions of the knockout
 * are the entire design. The container is a true superellipse (n = 4.6), not a
 * rounded rect, so the corners stay tense. Inside it:
 *
 *   letter height  25   ·  bar weight  4.9  ·  diagonal weight  4.99
 *   pair width     35   ·  counter gap  4   ·  clear space  ≥13 on every side
 *
 * The diagonal band is cut at 5.9 units horizontally so that its perpendicular
 * weight comes out at 4.99 — matching the bars almost exactly, which is what
 * stops the letter looking bottom-heavy. The two Zs are set 4 apart, slightly
 * tighter than a stroke, so they read as one word rather than two glyphs.
 *
 * No gradient, no shading, no outline, no second colour.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <path
    d="M63 32C63 35.7 63 39.4 62.9 43C62.9 46.7 62.7 50.5 61.5 54C60.3 57.3 57.3 60.3 54 61.5C50.5 62.7 46.7 62.9 43.1 62.9C39.4 63 35.7 63 32 63C28.3 63 24.6 63 21 62.9C17.3 62.9 13.5 62.7 10 61.5C6.7 60.3 3.7 57.3 2.5 54C1.3 50.5 1.1 46.7 1.1 43.1C1 39.4 1 35.7 1 32C1 28.3 1 24.6 1.1 21C1.1 17.3 1.3 13.5 2.5 10C3.7 6.7 6.7 3.7 10 2.5C13.5 1.3 17.3 1.1 20.9 1.1C24.6 1 28.3 1 32 1C35.7 1 39.4 1 43 1.1C46.7 1.1 50.5 1.3 54 2.5C57.3 3.7 60.3 6.7 61.5 10C62.7 13.5 62.9 17.3 62.9 20.9C63 24.6 63 28.3 63 32Z"
    fill={a.hue}
  />

  <g fill="#fff">
    <path d="M14.5 19.5L30 19.5L30 24.4L20.4 39.6L30 39.6L30 44.5L14.5 44.5L14.5 39.6L24.1 24.4L14.5 24.4Z" />
    <path d="M34 19.5L49.5 19.5L49.5 24.4L39.9 39.6L49.5 39.6L49.5 44.5L34 44.5L34 39.6L43.6 24.4L34 24.4Z" />
  </g>
</svg>
