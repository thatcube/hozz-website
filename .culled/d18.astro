---
/**
 * 18 · Monoline — the whole ZZ drawn as one unbroken line of even weight.
 *
 * Two Zs standing on a single shared baseline. The stroke enters at the top
 * left, cuts down the first diagonal, runs the full width of the foot, and
 * climbs the second diagonal to finish on the second top bar — one line, one
 * weight, one colour, no container and no fill anywhere in the mark.
 *
 * Everything is carried by three numbers: a 5.2-unit stroke, a 26-unit letter
 * height, and diagonals at 63° that are steep enough to read as Z rather than
 * as a zigzag. Round caps and joins keep the line from growing miter spikes
 * where the diagonals meet the bars.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <path
    d="M15 19L28 19L15 45L49 45L36 45L49 19L36 19"
    fill="none"
    stroke={a.hue}
    stroke-width="5.2"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
