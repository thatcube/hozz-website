---
/** 15 · Interlace — two translucent folded panels overlap into a compact ZZ. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const frontId = `g-d15-front-${app}`;
const backId = `g-d15-back-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={backId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={a.light} />
      <stop offset="1" stop-color={a.hue} />
    </linearGradient>
    <linearGradient id={frontId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={a.hue} />
      <stop offset="0.78" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
  </defs>
  <path
    d="M11 14h29v7L24.5 38H40v8H11v-7l15.5-17H11Z"
    fill={`url(#${backId})`}
    fill-opacity="0.84"
  />
  <path
    d="M24 19h29v7L37.5 43H53v8H24v-7l15.5-17H24Z"
    fill={`url(#${frontId})`}
    fill-opacity="0.84"
  />
</svg>
