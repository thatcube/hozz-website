---
/**
 * 08 · Softclip — crisp Z peaks resolve into rounded waveform valleys.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const id = `g-d08-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={id} x1="14.5" y1="18" x2="49.5" y2="38" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={a.light} />
      <stop offset="0.5" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
  </defs>

  <g fill={`url(#${id})`}>
    <path d="M14.5 18H29.5V22.5H14.5Z" />
    <path d="M25.5 20H30L20.4 31.7C19.2 33.1 20.2 35 22 35H29.5V38.5H20.2C15.9 38.5 13.9 33.3 16.7 29.9Z" />
    <path d="M34.5 18H49.5V22.5H34.5Z" />
    <path d="M45.5 20H50L40.4 31.7C39.2 33.1 40.2 35 42 35H49.5V38.5H40.2C35.9 38.5 33.9 33.3 36.7 29.9Z" />
  </g>
</svg>
