---
/**
 * 05 · Meniscus — the ZZ half-submerged, and refracted where it goes under.
 *
 * A circle, filled to just past the middle with the app's own hue. The ZZ stands
 * in it: dark and dry above the waterline, pale and nudged sideways below it, the
 * way a straw looks broken in a glass. One physical idea, no ornament.
 *
 * The fill level, the wave and the letterforms are identical across the four
 * apps. Only the hue moves.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const grad = `g-d05-${app}`;
const glass = `k-d05-${app}`;
const water = `w-d05-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={grad} x1="0" y1="0.35" x2="0.35" y2="1">
      <stop offset="0" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
    <clipPath id={glass}>
      <circle cx="32" cy="32" r="29.5" />
    </clipPath>
    <clipPath id={water}>
      <path d="M-2 37.6C9 33.9 21 33.9 32 37.2C43 40.5 55 40.5 66 37V66H-2Z" />
    </clipPath>
  </defs>

  <!-- The glass. -->
  <circle cx="32" cy="32" r="29.5" fill={a.light} />

  <!-- What's in it. -->
  <g clip-path={`url(#${glass})`}>
    <path d="M-2 37.6C9 33.9 21 33.9 32 37.2C43 40.5 55 40.5 66 37V66H-2Z" fill={`url(#${grad})`} />
    <path
      d="M-2 37.6C9 33.9 21 33.9 32 37.2C43 40.5 55 40.5 66 37"
      fill="none"
      stroke="#fff"
      stroke-opacity="0.45"
      stroke-width="1.3"
    />
  </g>

  <!-- ZZ above the line: dry. -->
  <g fill={a.deep}>
    <path d="M15.5 22h15v4.4L21.9 38.1h8.6v4.4h-15v-4.4l8.6-11.7h-8.6z" />
    <path d="M33.5 22h15v4.4L39.9 38.1h8.6v4.4h-15v-4.4l8.6-11.7h-8.6z" />
  </g>

  <!-- ZZ below the line: pale, and stepped sideways where it enters the liquid. -->
  <g clip-path={`url(#${water})`}>
    <g transform="translate(0.8 0)" fill="#fff" fill-opacity="0.94">
      <path d="M15.5 22h15v4.4L21.9 38.1h8.6v4.4h-15v-4.4l8.6-11.7h-8.6z" />
      <path d="M33.5 22h15v4.4L39.9 38.1h8.6v4.4h-15v-4.4l8.6-11.7h-8.6z" />
    </g>
  </g>
</svg>
