---
/** 14 · Breakout — a solid lozenge whose silhouette is interrupted by two carved Zs. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const gradientId = `g-d14-${app}`;
const maskId = `m-d14-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={a.light} />
      <stop offset="0.68" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
    <mask id={maskId}>
      <rect width="64" height="64" fill="#000" />
      <path d="M8 14C8 9.6 11.6 6 16 6h32c4.4 0 8 3.6 8 8v36c0 4.4-3.6 8-8 8H16c-4.4 0-8-3.6-8-8Z" fill="#fff" />
      <g fill="none" stroke="#000" stroke-width="5.5" stroke-linecap="square" stroke-linejoin="round">
        <path d="M7 20h25L16 37h19" />
        <path d="M30 27h25L39 44h19" />
      </g>
    </mask>
  </defs>
  <path
    d="M8 14C8 9.6 11.6 6 16 6h32c4.4 0 8 3.6 8 8v36c0 4.4-3.6 8-8 8H16c-4.4 0-8-3.6-8-8Z"
    fill={`url(#${gradientId})`}
    mask={`url(#${maskId})`}
  />
</svg>
