---
/**
 * 07 · Pluck — a ZZ signal whose amplitude settles like a struck string.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const id = `g-d07-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={id} x1="16.5" y1="17.5" x2="47.5" y2="36" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={a.deep} />
      <stop offset="0.48" stop-color={a.hue} />
      <stop offset="1" stop-color={a.light} />
    </linearGradient>
  </defs>

  <path
    d="M16.5 17.5H27.5L16.5 36H28.5L36.5 22H47.5L39.5 32.5H47.5"
    fill="none"
    stroke={`url(#${id})`}
    stroke-width="4.5"
    stroke-linecap="butt"
    stroke-linejoin="round"
  />
</svg>
