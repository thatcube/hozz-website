---
/**
 * 01 · Lens — worked example
 *
 * A modern, flat reading: a soft squircle, one diagonal gradient of the app's
 * own hue, and the ZZ cut clean out of it as negative space. No smiley, no
 * outline, no pixels. The ZZ *is* the mark.
 *
 * The letterforms are drawn as paths rather than set in a typeface, so the mark
 * carries no font dependency and stays identical everywhere.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const id = `g-d01-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={a.light} />
      <stop offset="0.55" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
  </defs>

  <!-- Squircle: a superellipse, not a rounded rect — the corners stay tense. -->
  <path
    d="M32 2C52.5 2 62 11.5 62 32S52.5 62 32 62 2 52.5 2 32 11.5 2 32 2Z"
    fill={`url(#${id})`}
  />

  <!-- ZZ knocked out. Two strokes, the second smaller and offset, so it reads
       as a pair rather than a repeat. -->
  <g fill="#fff" fill-opacity="0.95">
    <path d="M18 20h20v5L26.5 39H38v5H18v-5l11.5-14H18z" />
    <path d="M40 34h12v3.4l-6.7 8.2H52V49H40v-3.4l6.7-8.2H40z" fill-opacity="0.8" />
  </g>
</svg>
