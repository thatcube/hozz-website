---
/**
 * 27 · Crease — the same fold, done in paper.
 *
 * A flat strip with its two free ends cut on the bias, the way a ribbon end is
 * cut. At each crease the paper's own thickness catches as a narrow darker
 * band, which is the only modelling in the mark — no gradient doing the work
 * of a shadow, no outline.
 *
 * The slivers are clipped to the letterform, so nothing spills outside the
 * silhouette. Below about 30px the thickness falls under half a pixel and
 * vanishes, leaving a clean ZZ. That is the intended behaviour, not a loss.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const id = `g-d27-${app}`;

/** Pull the pale tint back toward the hue so the paper never goes washed out. */
const mix = (from: string, to: string, t: number) =>
  '#' +
  [1, 3, 5]
    .map((i) => {
      const x = parseInt(from.slice(i, i + 2), 16);
      const y = parseInt(to.slice(i, i + 2), 16);
      return Math.round(x * (1 - t) + y * t)
        .toString(16)
        .padStart(2, '0');
    })
    .join('');
const paper = mix(a.light, a.hue, 0.62);
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color={paper} />
      <stop offset="1" stop-color={a.hue} />
    </linearGradient>
    <clipPath id={`${id}-c`}>
      <path d="M14 21L30 21L21 37.6L26.8 37.6L30 43L14 43L14 37.6L23 26.4L17.2 26.4Z" />
      <path d="M34 21L50 21L41 37.6L46.8 37.6L50 43L34 43L34 37.6L43 26.4L37.2 26.4Z" />
    </clipPath>
  </defs>

  <!-- Strip inside x/y 14–50; the free ends are cut on the bias. -->
  <g fill={`url(#${id})`}>
    <path d="M14 21L30 21L21 37.6L26.8 37.6L30 43L14 43L14 37.6L23 26.4L17.2 26.4Z" />
    <path d="M34 21L50 21L41 37.6L46.8 37.6L50 43L34 43L34 37.6L43 26.4L37.2 26.4Z" />
  </g>

  <!-- The paper's thickness, showing along each of the four creases. -->
  <g clip-path={`url(#${id}-c)`} fill={a.deep} fill-opacity="0.46">
    <path d="M30 21L23 26.4L24.16 27.9L31.16 22.5Z" />
    <path d="M14 43L21 37.6L19.84 36.1L12.84 41.5Z" />
    <path d="M50 21L43 26.4L44.16 27.9L51.16 22.5Z" />
    <path d="M34 43L41 37.6L39.84 36.1L32.84 41.5Z" />
  </g>
</svg>
