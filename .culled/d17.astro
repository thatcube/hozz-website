---
/** 17 · Strata — two Z-shaped cuts divide a circle into floating colour bands. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const gradientId = `g-d17-${app}`;
const maskId = `m-d17-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <radialGradient id={gradientId} cx="0.3" cy="0.24" r="0.92">
      <stop offset="0" stop-color={a.light} />
      <stop offset="0.82" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </radialGradient>
    <mask id={maskId}>
      <rect width="64" height="64" fill="#000" />
      <circle cx="32" cy="32" r="28" fill="#fff" />
      <g fill="none" stroke="#000" stroke-width="4.5" stroke-linecap="square" stroke-linejoin="round">
        <path d="M2 16h43L17 29h45" />
        <path d="M2 35h43L17 48h45" />
      </g>
    </mask>
  </defs>
  <circle cx="32" cy="32" r="28" fill={`url(#${gradientId})`} mask={`url(#${maskId})`} />
</svg>
