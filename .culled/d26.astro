---
/**
 * 26 · Fold — a Z is what a ribbon does when you fold it back on itself twice.
 *
 * One strip runs through each Z: along the top, back down the diagonal, out
 * along the bottom. The two creases are mitred, so the middle face turns away
 * from the light and reads darker. That single tone step is all the depth the
 * mark needs — no shading, no bevel, no shadow. The turns do the work.
 *
 * Two tones only: a lit face and a folded face, both white over the app's own
 * hue. At 20px the fold disappears and a solid ZZ is left standing, which is
 * the point: the silhouette carries the identity, the folds only enrich it.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const id = `g-d26-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={a.light} />
      <stop offset="0.5" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
  </defs>

  <path d="M32 2C52.5 2 62 11.5 62 32S52.5 62 32 62 2 52.5 2 32 11.5 2 32 2Z" fill={`url(#${id})`} />

  <!-- The ribbon sits inside x/y 14–50 — twelve units of air on every side. -->
  <g fill="#fff">
    <path d="M14 21L30 21L23 26.4L14 26.4Z" fill-opacity="0.97" />
    <path d="M30 21L21 37.6L14 43L14 37.6L23 26.4Z" fill-opacity="0.62" />
    <path d="M21 37.6L30 37.6L30 43L14 43Z" fill-opacity="0.97" />

    <path d="M34 21L50 21L43 26.4L34 26.4Z" fill-opacity="0.97" />
    <path d="M50 21L41 37.6L34 43L34 37.6L43 26.4Z" fill-opacity="0.62" />
    <path d="M41 37.6L50 37.6L50 43L34 43Z" fill-opacity="0.97" />
  </g>
</svg>
