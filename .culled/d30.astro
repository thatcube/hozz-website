---
/** 30 · Open Air — the familiar ZZ face, floating freely with no container. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <g
    fill="none"
    stroke={a.hue}
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M20 22H29L20 29H29" stroke-width="4" />
    <path d="M35 22H44L35 29H44" stroke-width="4" />
    <path d="M21 36C25 44 39 44 43 36" stroke-width="4" />
  </g>
</svg>
