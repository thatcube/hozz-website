---
/** 23 · Near / Far — two Z planes separated by scale, tone and overlap. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const id = `g-d23-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={`${id}-far`} x1="34" y1="20" x2="50" y2="45" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={a.light} />
      <stop offset="1" stop-color={a.hue} stop-opacity="0.72" />
    </linearGradient>
    <linearGradient id={`${id}-near`} x1="14" y1="17" x2="33" y2="48" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
  </defs>

  <path
    d="M34 20h16v5l-8.5 15H50v5H34v-5l8.5-15H34Z"
    fill={`url(#${id}-far)`}
    opacity="0.72"
  />
  <path
    d="M14 17h19v5.5L23 42h10v6H14v-5.5l10-20H14Z"
    fill={`url(#${id}-near)`}
  />
</svg>
