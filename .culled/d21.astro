---
/**
 * 21 · Module — the ZZ built strictly from a grid, every angle 45°.
 *
 * One module, u = 5, generates the whole mark and nothing is nudged by eye:
 *
 *   bar weight        1u    (5)
 *   diagonal run      2u    (10)     — equal to its drop, so exactly 45°
 *   letter height     4u    (20)
 *   letter width      (2+√2)u ≈ 17.07
 *   gap between Zs    1u    (5)
 *
 * The diagonal is cut 7.071 (u·√2) wide horizontally, which is precisely the
 * width that makes its perpendicular weight land on 5.000 — identical to the
 * bars. So the uniform stroke is a consequence of the grid rather than an
 * optical correction applied on top of it. Nothing is thinned at the joins,
 * nothing is overshot at the terminals.
 */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}
const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <g fill={a.hue}>
    <path d="M12.43 22L29.5 22L29.5 27L19.5 37L29.5 37L29.5 42L12.43 42L12.43 37L22.43 27L12.43 27Z" />
    <path d="M34.5 22L51.57 22L51.57 27L41.57 37L51.57 37L51.57 42L34.5 42L34.5 37L44.5 27L34.5 27Z" />
  </g>
</svg>
