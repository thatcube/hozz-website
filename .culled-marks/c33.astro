---
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'wide' } as const;
const box = faceBoxAt(face);
const air = [box.x, 31 - box.right, box.y, 31 - box.bottom];
if (Math.min(...air) < 6) throw new Error('c33 face needs six clear pixels');
---

<MarkFrame size={size} title="Hozz — Unheld">
  <path d="M12 18h1v1h-1z M19 18h1v1h-1z M12 19h2v1h-2z M18 19h2v1h-2z M13 20h6v1h-6z" fill="#16312a" />
  <path d="M12 12h3v1h-3z M13 13h2v1h-2z M12 14h2v1h-2z M12 15h3v1h-3z" fill="#16312a" />
  <path d="M17 12h3v1h-3z M18 13h2v1h-2z M17 14h2v1h-2z M17 15h3v1h-3z" fill="#16312a" />
  <g fill="#55a994" shape-rendering="crispEdges">
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
