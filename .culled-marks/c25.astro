---
/**
 * 25 · Tag
 *
 * The label you tie to the thing you are keeping: a chamfered kraft tag with
 * an ochre head and a real punched hole. The two-tone head replaces the header
 * rule — same ochre, one shape instead of two — which leaves the whole lower
 * field of the tag empty for the face.
 *
 * The face is centred on that field at (16, 19), not on the tag, so the head
 * and the hole stay chrome.
 *
 * Drawn against the shared face geometry in `src/data/mark.ts` rather than a
 * hand-placed copy of it, so the eyes stay the family's eyes.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;

const face = facePathsAt({ cx: 16, cy: 19, size: 'md', smile: 'wide' });
---

