---
/**
 * m08 · Cans — over-ear headphones, hung round the neck so the lead drapes.
 *
 * The port is a real thing on a closed-back cup: a slot cut through the shell
 * so the driver can breathe. Here that port is the Z. Both bars run out to the
 * cup's rim and stop dead against it, because a slot cut in a shell can only go
 * as far as the shell — so the letter is shaped by the circle rather than
 * placed inside it. Take the cups away and the bars have no ends.
 *
 * The lead is slung between the two cups, which is where it sits when the
 * headphones are round your neck rather than on your head. It is the mouth, and
 * it is also the only part of the object that goes anywhere.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;

const uid = `m08-${Math.random().toString(36).slice(2, 9)}`;

const CY = 29.4;
const CX = [14, 34];
const OUTER = 8; // the cup
const FACE = 6.4; // the shell's inner face, where the port is cut

// bar 2 against diag 3.3. The slot widens as it crosses, the way a moulded vent
// does where it has the most material behind it.
const Z = { y: CY - 4.2, w: 9.6, h: 8.4, bar: 2, diag: 3.3, cap: 'open' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    {
      CX.map((cx, i) => (
        <clipPath id={`${uid}-${i}`}>
          <circle cx={cx} cy={CY} r={FACE} />
        </clipPath>
      ))
    }
  </defs>

  {/* Band and lead are drawn first so both tuck under the cups. */}
  <path
    d="M8 25.6A17 17 0 0 1 40 25.6"
    stroke={app.hue}
    stroke-width="3.6"
    fill="none"
  />
  <path
    d="M11.8 34.2Q24 47.6 36.2 34.2"
    stroke={app.hue}
    stroke-width="2.5"
    stroke-linecap="round"
    fill="none"
  />

  {CX.map((cx) => <circle cx={cx} cy={CY} r={OUTER} fill={app.hue} />)}
  <circle
    cx={CX[0]}
    cy={CY}
    r={FACE}
    fill={app.deep}
    opacity={ground === 'dark' ? 1 : 0.96}
  />
  <circle
    cx={CX[1]}
    cy={CY}
    r={FACE}
    fill={app.deep}
    opacity={ground === 'dark' ? 1 : 0.96}
  />

  {
    CX.map((cx, i) => (
      <g clip-path={`url(#${uid}-${i})`}>
        <path d={zPath({ ...Z, x: cx - Z.w / 2 })} fill={app.light} />
      </g>
    ))
  }
</svg>
