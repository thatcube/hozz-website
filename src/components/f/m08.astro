---
/**
 * m08 · Slack — a pair of earbuds after a pocket.
 *
 * One cable, drawn once and never lifted. It leaves the left bud, folds into a
 * Z, turns straight back into a second Z, and the leftover length falls away
 * underneath and ends at the other bud. The two Zs are two folds in the same
 * run, joined by the same piece of cable that made them, so neither can be
 * moved without the other. The bars are the cable lying flat and the diagonals
 * are the cable crossing the fall, which is why the two weights differ.
 *
 * Three shapes: two buds and one cable. The slack is the mouth.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;

// bar 2.6 against diag 4.2.
const Z = { y: 12.9, h: 11.5, w: 13.5, bar: 2.6, diag: 4.2 };
const ZX = [9.6, 28];

const TOP_Y = Z.y + Z.bar / 2;
const FOOT_Y = Z.y + Z.h - Z.bar / 2;
const HEAD = { x: ZX[0], y: TOP_Y };
const TAIL = { x: 13.6, y: 30.6 };
const BUD = 3.5;

// The turn between the two folds, and the slack left over after the second.
const FOLD = `M${ZX[0] + Z.w} ${FOOT_Y}C26.2 22.4 25 15.4 ${ZX[1]} ${TOP_Y}`;
const SLACK =
  `M${ZX[1] + Z.w} ${FOOT_Y}` +
  `C41.5 31 33 37.5 23 36.5` +
  `C18.4 36 15 33.6 ${TAIL.x} ${TAIL.y}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <path
    d={FOLD}
    stroke={app.hue}
    stroke-width={Z.bar * 0.62}
    stroke-linecap="round"
    fill="none"
  />
  <path
    d={SLACK}
    stroke={app.hue}
    stroke-width={Z.bar}
    stroke-linecap="round"
    fill="none"
  />
  {ZX.map((zx) => <path d={zPath({ ...Z, x: zx })} fill={app.hue} />)}
  {[HEAD, TAIL].map((p) => <circle cx={p.x} cy={p.y} r={BUD} fill={app.hue} />)}
  {
    [HEAD, TAIL].map((p) => (
      <circle cx={p.x} cy={p.y} r={BUD * 0.4} fill={app.deep} />
    ))
  }
</svg>
