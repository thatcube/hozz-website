---
/**
 * m08 · Cans — over-ear headphones, worn round the neck.
 *
 * A closed-back cup is a sealed drum, and a sealed drum will not breathe, so
 * every real one has a port cut through the shell. Here that port is the Z: its
 * two bars run out past the driver face and are severed by the cup's rim, which
 * means the letter has no outline of its own — the circle finishes it. Move the
 * cup and the Z is cut differently; remove the cup and there is nothing left to
 * cut.
 *
 * The lead slung between the two cups is the mouth, and it is drawn at the sag
 * it takes when the headphones are round your neck rather than on your head —
 * which is where they are when you are walking, and where the downloads matter.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;

const uid = `m08-${Math.random().toString(36).slice(2, 9)}`;

const CUP = { cy: 26.8, r: 7.7, cx: [13.6, 34.4] };
const FACE = 6.15;

// The band comes over the top and down the outer side of each cup, which is
// where a real one meets the yoke — not a hoop balanced on top of two circles.
const BAND = 'M7.6 24.6A16.7 16.7 0 0 1 40.4 24.6';

// The sag of a lead when the cups are hanging at your collarbone.
const LEAD = 'M12.4 31.4Q24 44.2 35.6 31.4';

const Z = {
  y: CUP.cy - 4.05,
  w: 9.6,
  h: 8.1,
  bar: 1.88,
  diag: 3.15,
  cap: 'open' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    {
      CUP.cx.map((cx, i) => (
        <clipPath id={`${uid}-f${i}`}>
          <circle cx={cx} cy={CUP.cy} r={FACE} />
        </clipPath>
      ))
    }
  </defs>

  {/* Band and lead go down first so the cups cover where they enter. */}
  <path d={BAND} stroke={app.hue} stroke-width="3" stroke-linecap="round" fill="none" />
  <path
    d={LEAD}
    stroke={app.hue}
    stroke-width="2.3"
    stroke-linecap="round"
    fill="none"
    opacity={ground === 'dark' ? 0.95 : 1}
  />

  {
    CUP.cx.map((cx, i) => (
      <>
        <circle cx={cx} cy={CUP.cy} r={CUP.r} fill={app.hue} />
        <circle cx={cx} cy={CUP.cy} r={FACE} fill={app.deep} />
        <g clip-path={`url(#${uid}-f${i})`}>
          <path d={zPath({ ...Z, x: cx - Z.w / 2 })} fill={app.light} />
        </g>
      </>
    ))
  }
</svg>
