---
/**
 * p10 · Sprocket Turn
 *
 * The perforation rails themselves turn into two Zs, then return to the edge.
 * Hole size and pitch stay constant through the turn, so there is no separate
 * letter layer to lift away from the film.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p10-${Math.random().toString(36).slice(2, 9)}`;

const topY = 14;
const bottomY = 27.2;
const zRun = (left: number, right: number) => [
  ...Array.from({ length: 5 }, (_, i) => ({ x: left + (right - left) * (i / 4), y: topY })),
  ...Array.from({ length: 5 }, (_, i) => ({
    x: right - (right - left) * ((i + 1) / 6),
    y: topY + (bottomY - topY) * ((i + 1) / 6),
  })),
  ...Array.from({ length: 5 }, (_, i) => ({ x: left + (right - left) * (i / 4), y: bottomY })),
];
const perforations = [
  ...[7.4, 10.7].map((y) => ({ x: 9.2, y })),
  ...zRun(9.2, 22.4),
  ...[30.5, 33.8, 37.1, 40.4].map((y) => ({ x: 9.2, y })),
  ...[7.4, 10.7].map((y) => ({ x: 38.8, y })),
  ...zRun(25.6, 38.8),
  ...[30.5, 33.8, 37.1, 40.4].map((y) => ({ x: 38.8, y })),
];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} film-frame mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      {
        perforations.map(({ x, y }) => (
          <rect x={x - 1.15} y={y - 1.15} width="2.3" height="2.3" rx="0.55" fill="#000" />
        ))
      }
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <path d="M9 4H39L42 7V41L39 44H9L6 41V7Z" fill={app.deep} />
    <rect x="12.2" y="6.5" width="23.6" height="35" rx="1.4" fill={app.hue} />
  </g>
</svg>
