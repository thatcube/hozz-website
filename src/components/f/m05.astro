---
/**
 * m05 · Fork tines
 *
 * The two Zs are the two vibrating tines of one tuning fork. Both grow from the
 * same curved yoke and stem, so the pair is one object rather than two cells.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const Z = {
  y: 6.5,
  w: 14.5,
  h: 19,
  bar: 3.4,
  diag: 6.2,
  cap: 'angled' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} tuning fork mark`}
>
  <path
    d="M10 23V28C10 34.5 15.5 38 22 38H26C32.5 38 38 34.5 38 28V23M24 38V44"
    stroke={app.hue}
    stroke-width="5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
  <path
    d={zPath({ ...Z, x: 6.5 }) + zPath({ ...Z, x: 27 })}
    fill={app.hue}
  />
</svg>
