---
/**
 * m05 · Fork tines
 *
 * The lower bar of each drawn Z continues directly into a shoulder of one
 * tuning-fork yoke. The letters are therefore the fork's vibrating tines, not a
 * knockout placed in a body.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} tuning fork mark`}
>
  <path
    d="M6.5 6.5H21V9.9H6.5V6.5ZM21 9.9L12.7 22.1H6.5L14.8 9.9H21ZM27 6.5H41.5V9.9H27V6.5ZM41.5 9.9L33.2 22.1H27L35.3 9.9H41.5Z"
    fill={app.hue}
  />
  <path
    d="M6.5 22.1H21V25.5H12V28C12 33 16 36 22 36H26C32 36 36 33 36 28V25.5H27V22.1H41.5V28C41.5 36.5 35 41 27 41H26.5V45H21.5V41H21C13 41 6.5 36.5 6.5 28V22.1Z"
    fill={app.hue}
  />
</svg>
