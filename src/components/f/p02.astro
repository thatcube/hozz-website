---
/**
 * p02 · Sheen — a bowed sheet of glass, and what the room leaves on it.
 *
 * The object is a curved screen: no frame, no foot, just a lens of glass that
 * swells in the middle, held by a hairline of its own bright edge. The glass is
 * dark, the way a screen is dark before you look at it properly.
 *
 * Every bright mark on it is one reflection, arriving across the glass at an
 * angle: the wash, the two Zs at its core, and the crescent below where the
 * sheen runs out along the bow of the surface. That crescent is the mouth — it
 * only bends that way because the screen is curved, which is why the face
 * cannot be carried across to a flat one.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;

const uid = `p02-${Math.random().toString(36).slice(2, 9)}`;
const clipId = `${uid}-glass`;

// The outer lens. Ends 23 tall, middle 25.8 — enough bow to be a curved panel,
// not so much that it swells into the front glass of a cathode tube.
const OUTER = 'M4 10.5Q24 7.7 44 10.5V33.5Q24 36.3 4 33.5Z';
// The glass itself, inset 1.1 all round, leaving the bright edge as a hairline.
const GLASS = 'M5.1 11.6Q24 8.8 42.9 11.6V32.4Q24 35.2 5.1 32.4Z';

// diag 6.2 against bar 2.9 — the diagonal is more than twice the bars, so the
// letter has a wedge in it that no typeface would tolerate.
const Z = { y: 14.4, w: 12.2, h: 13.5, bar: 2.9, diag: 6.2, cap: 'angled' as const };
const zLeft = 10.6;
const zRight = 25.2; // pair spans 10.6–37.4, centred on 24
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={clipId}>
      <path d={GLASS} />
    </clipPath>
  </defs>

  {/* The lit edge of the lens, which is all the frame a screen like this gets. */}
  <path d={OUTER} fill={app.hue} />
  <path d={GLASS} fill={app.deep} />

  <g clip-path={`url(#${clipId})`}>
    {/* The room arriving across the glass at an angle — one reflection, of which
        the letters are the bright core. */}
    <path
      d="M-4 42L16 0H29L9 42Z"
      fill={app.light}
      opacity={ground === 'dark' ? 0.2 : 0.17}
    />
    <path d={zPath({ ...Z, x: zLeft })} fill={app.light} />
    <path d={zPath({ ...Z, x: zRight })} fill={app.light} />
    {/* The same sheen running out along the curve — the mouth. */}
    <path
      d="M15.5 29.4Q24 33.4 32.5 29.4"
      stroke={app.light}
      stroke-width="2.4"
      stroke-linecap="round"
      fill="none"
    />
  </g>
</svg>
