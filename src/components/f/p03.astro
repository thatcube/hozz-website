---
/**
 * p03 · Turn — a screen seen from the side, and a picture that goes round it.
 *
 * The object is an ultra-thin panel standing at an angle to us. Because it has
 * no bezel, its picture runs right off the front and continues over the near
 * edge onto the sliver of side we can see — the edge-lit wrap a panel this thin
 * can do. That corner is a hard fold, so the letter that crosses it bends: its
 * left end climbs away from us on a different plane, in a different tone.
 *
 * Straighten the panel and the bend has nothing to bend over.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;

const uid = `p03-${Math.random().toString(36).slice(2, 9)}`;
const faceId = `${uid}-face`;
const edgeId = `${uid}-edge`;

// The panel, turned 4.5 degrees. Everything below lives in this one plane.
const TURN = 'translate(24 22) skewY(4.5) translate(-24 -22)';

// The picture, foreshortened by the turn, and 3.8 of side face folded back off
// its near corner at x = 14.9.
const FACE = { x: 14.9, y: 14.6, w: 22, h: 15 };
const EDGE = 'M14.9 14.6L11.1 13.1V28.1L14.9 29.6Z';
// The side plane rises 1.5 over 3.8, which is 21.5 degrees off the front.
const FOLD = 'translate(14.9 22) skewY(21.5) translate(-14.9 -22)';

// diag 5.4 against bar 2.3 — the wedge is more than twice the bars.
const Z = { y: 16.8, w: 10.2, h: 10.4, bar: 2.3, diag: 5.4, cap: 'flat' as const };
const zL = zPath({ ...Z, x: 12.6 }); // starts behind the corner, on the side
const zR = zPath({ ...Z, x: 24.7 });
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={faceId} transform={TURN}>
      <rect x={FACE.x} y={FACE.y} width={FACE.w} height={FACE.h} rx="1.2" />
    </clipPath>
    <clipPath id={edgeId} transform={TURN}>
      <path d={EDGE} />
    </clipPath>
  </defs>

  <g transform={TURN}>
    <rect
      x="18"
      y="31.6"
      width="16"
      height="1.2"
      rx="0.6"
      fill={app.deep}
      opacity={ground === 'dark' ? 0.5 : 0.3}
    />
    {/* The near edge, lit, because it is the only part turned toward the room. */}
    <path d={EDGE} fill={app.light} />
    <rect x={FACE.x} y={FACE.y} width={FACE.w} height={FACE.h} rx="1.2" fill={app.hue} />
  </g>

  {/* The picture, on the front. */}
  <g clip-path={`url(#${faceId})`} fill={app.deep}>
    <g transform={TURN}>
      <path d={zL} />
      <path d={zR} />
    </g>
  </g>

  {/* And the same picture carrying on round the corner, tipped onto the side. */}
  <g clip-path={`url(#${edgeId})`} fill={app.deep}>
    <g transform={TURN}>
      <g transform={FOLD}>
        <path d={zL} />
      </g>
    </g>
  </g>
</svg>
