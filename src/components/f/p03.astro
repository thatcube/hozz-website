---
/**
 * p03 · Thin — a wall panel seen from just below, so a sliver of its underside
 * shows and splays toward you.
 *
 * The one structural dependency: **the panel's thickness is the bottom bar.**
 * A screen's defining modern property is how thin it is, so that is the
 * measurement the letters are made from. The picture wraps the bottom edge, and
 * so does the ZZ: each diagonal runs down the lit face and stops dead on the
 * corner, and the foot continues onto the underside, foreshortened to exactly
 * the depth of the panel. That is where the stroke contrast comes from — the
 * top bar is 4.59 because the letter chose it, the bottom bar is 3.6 because
 * the object did. Make the panel thicker and every foot gets heavier.
 *
 * Not a knockout. The letters are the picture, so they are drawn in the set's
 * own dark, and they change colour where they cross the corner because the
 * underside is not facing the light.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p03-${Math.random().toString(36).slice(2, 9)}`;

const CORNER = 29.2; // where the lit face turns under
const DEPTH = 3.6; // and how thin the panel is
const FACE = { x: 5, y: 13, w: 38, r: 2.6 };
const UNDER = `M5 ${CORNER}L43 ${CORNER}L44.8 ${CORNER + DEPTH}L3.2 ${
  CORNER + DEPTH
}Z`;

const H = 16;
const BAR = 0.287 * H;
const Z = {
  y: CORNER - H + BAR, // the foot starts exactly at the corner
  w: 0.936 * H,
  h: H,
  bar: BAR,
  diag: 0.511 * H,
  cap: 'angled' as const,
};
const GAP = 0.213 * H;
const LX = 24 - Z.w - GAP / 2;
const RX = 24 + GAP / 2;

// The underside is foreshortened to the panel's depth, and the feet with it.
const SQUASH = `translate(0 ${CORNER}) scale(1 ${DEPTH / BAR}) translate(0 ${-CORNER})`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={`${uid}-f`}>
      <rect
        x={FACE.x}
        y={FACE.y}
        width={FACE.w}
        height={CORNER - FACE.y}
        rx={FACE.r}
      />
    </clipPath>
    <clipPath id={`${uid}-u`}>
      <path d={UNDER} />
    </clipPath>
  </defs>

  <rect
    x={FACE.x}
    y={FACE.y}
    width={FACE.w}
    height={CORNER - FACE.y + FACE.r}
    rx={FACE.r}
    fill={app.hue}
  />
  <path d={UNDER} fill={app.deep} />

  {/* The picture, on the face. */}
  <g clip-path={`url(#${uid}-f)`} fill={app.deep}>
    <path d={zPath({ ...Z, x: LX })} />
    <path d={zPath({ ...Z, x: RX })} />
  </g>

  {/* And the same picture, carrying on round the corner. */}
  <g clip-path={`url(#${uid}-u)`} fill={app.light}>
    <g transform={SQUASH}>
      <path d={zPath({ ...Z, x: LX })} />
      <path d={zPath({ ...Z, x: RX })} />
    </g>
  </g>
</svg>
