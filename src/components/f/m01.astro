---
/**
 * m01 · Rim — a record, cut wider than itself.
 *
 * The dependency: **the disc's edge is what ends every bar.** The pair is drawn
 * wider than the record, so all four bar ends fall outside it and are taken by
 * the rim — the silhouette is notched four times and no terminal in the mark is
 * drawn by hand. Narrow the record and the letters lose their ends; widen it
 * and the notches close.
 *
 * The spindle is deliberately smaller than the gap here: the spacing is not its
 * job in this one.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const uid = `m01-${Math.random().toString(36).slice(2, 9)}`;

const R = 19; // disc spans 5–43
const GAP = 7;

// 17 + 7 + 17 = 41, running 3.5 to 44.5 across a disc that runs 5 to 43, so
// every bar end is over the edge. `cap` is moot: the ends are never on screen.
const Z = { y: 14, w: 17, h: 20, bar: 3.4, diag: 6.4, cap: 'flat' as const };
const zLeft = 24 - GAP / 2 - Z.w;
const zRight = 24 + GAP / 2;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      <circle cx="24" cy="24" r="2" fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <circle cx="24" cy="24" r={R} fill={app.hue} />
    {/* One groove near the rim is the whole object budget. */}
    <circle
      cx="24"
      cy="24"
      r={R - 2.8}
      fill="none"
      stroke={app.deep}
      stroke-width="1.3"
      opacity="0.5"
    />
  </g>
</svg>
