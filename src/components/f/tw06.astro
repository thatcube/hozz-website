---
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw06-${Math.random().toString(36).slice(2, 9)}`;
const BEAM = 'M7 24Q18 8 38 9Q44 24 38 39Q18 40 7 24Z';
const Z = {
  y: 17,
  w: 10.5,
  h: 14,
  bar: 3,
  diag: 5.6,
  cap: 'angled' as const,
};
const edge = ground === 'dark' ? app.light : app.deep;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} live signal mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#000" />
      <path d={BEAM} fill="#fff" />
      <path d={zPath({ ...Z, x: 12 })} fill="#000" />
      <path d={zPath({ ...Z, x: 24 })} fill="#000" />
    </mask>
  </defs>

  <path d={BEAM} fill={app.hue} mask={`url(#${uid})`} />
  <circle cx="6" cy="24" r="3.5" fill={edge} />
  <path
    d="M38 9Q45 24 38 39"
    stroke={edge}
    stroke-width="3"
    stroke-linecap="round"
  />
</svg>
