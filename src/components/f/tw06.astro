---
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw06-${Math.random().toString(36).slice(2, 9)}`;
const BEAM = 'M7 24Q17 6 39 8Q46 24 39 40Q17 42 7 24Z';
const Z = {
  y: 16.5,
  w: 10.5,
  h: 15,
  bar: 3.2,
  diag: 5.8,
  cap: 'angled' as const,
};
const zLeft = 12;
const zRight = 24;
const edge = ground === 'dark' ? app.light : app.deep;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} live broadcast beam mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#000" />
      <path d={BEAM} fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
  </defs>

  <path d={BEAM} fill={app.hue} mask={`url(#${uid})`} />
  <circle cx="6" cy="24" r="3.5" fill={edge} />
  <path
    d="M39 8Q46 24 39 40"
    stroke={edge}
    stroke-width="3"
    stroke-linecap="round"
  />
</svg>
