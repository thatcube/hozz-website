---
/**
 * tw02 · Through — two bubbles, one in front of the other.
 *
 * Not a knockout: the letters have no ground behind them. **The far bubble is
 * what you see through the near one.** The ZZ is an opening cut in the front
 * bubble and the only thing filling it is the bubble behind — take the second
 * bubble away and the letters go empty, slide it and they change colour. The
 * letters are not the property of either speaker; they are what shows when the
 * two of them are lined up.
 *
 * Two shapes and two fills. The far bubble reads at the top and right, and its
 * tail points the other way, so it is plainly a second bubble rather than a
 * plate behind the first.
 *
 * Tried and rejected: running the second Z out through the front wall so its
 * openings met the far bubble. It made the dependency obvious and truncated the
 * letter, because an opening that touches a field of its own colour has no edge
 * left. Legibility won.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw02-${Math.random().toString(36).slice(2, 9)}`;

/** Behind: 12–44 by 13–35, tail down to the right. */
const BACK = [
  'M19 13',
  'H37',
  'A7 7 0 0 1 44 20',
  'V28',
  'A7 7 0 0 1 37 35',
  'L40.5 41',
  'L32.5 35',
  'H19',
  'A7 7 0 0 1 12 28',
  'V20',
  'A7 7 0 0 1 19 13',
  'Z',
].join(' ');

/** In front: 4–38 by 8–32, tail down to the left. */
const FRONT = [
  'M11 8',
  'H31',
  'A7 7 0 0 1 38 15',
  'V25',
  'A7 7 0 0 1 31 32',
  'H17',
  'L8 39',
  'L12.5 32',
  'H11',
  'A7 7 0 0 1 4 25',
  'V15',
  'A7 7 0 0 1 11 8',
  'Z',
].join(' ');

/** The pair spans 13.6–36.4 by 15.5–29.5, filling the one patch of the front
 *  bubble that has anything behind it, to within half a unit of its corners. The letters are filled by the far bubble and by nothing
 *  else, which is why they are its exact purple and not the ground's. */
const Z = { y: 15.5, w: 10, h: 14, bar: 3.4, diag: 5.9, cap: 'flat' as const };
const zLeft = 13.6;
const zRight = 26.4;

const behind = ground === 'dark' ? app.light : app.deep;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
  </defs>

  <path d={BACK} fill={behind} />
  <path d={FRONT} fill={app.hue} mask={`url(#${uid})`} />
</svg>
