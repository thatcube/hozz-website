---
/**
 * tw02 · Overlap — two bubbles, and the ZZ cut out of where they cross.
 *
 * One dependency: **the overlap is the field the letters live in.** The pair is
 * exactly as wide as the band the two bubbles share and sits centred in it, so
 * pull the bubbles apart and the letters have nowhere to be; push them together
 * and the pair is squeezed. The letters are not in either bubble — they are in
 * the conversation, which is the app.
 *
 * Three shapes: two bubbles in the same purple, and their intersection one step
 * darker. The letters knock through all of it to the ground, so they carry the
 * full tonal separation at 24px.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw02-${Math.random().toString(36).slice(2, 9)}`;
const clipId = `${uid}-b`;

/** Said first: 4–34 by 7–29, tail down to the left. */
const SAID = [
  'M10 7',
  'H28',
  'A6 6 0 0 1 34 13',
  'V23',
  'A6 6 0 0 1 28 29',
  'H15.5',
  'L7 35.8',
  'L11 29',
  'H10',
  'A6 6 0 0 1 4 23',
  'V13',
  'A6 6 0 0 1 10 7',
  'Z',
].join(' ');

/** Answered: 14–44 by 13–35, tail down to the right. */
const BACK = [
  'M20 13',
  'H38',
  'A6 6 0 0 1 44 19',
  'V29',
  'A6 6 0 0 1 38 35',
  'L41 41.8',
  'L33.5 35',
  'H20',
  'A6 6 0 0 1 14 29',
  'V19',
  'A6 6 0 0 1 20 13',
  'Z',
].join(' ');

/** The shared band is 14–34 by 13–29. The pair spans 15–33: one unit inside it
 *  either side, so the overlap is visibly what sizes the letters. */
const Z = { y: 15.5, w: 8, h: 11, bar: 2.7, diag: 4.9, cap: 'flat' as const };
const zLeft = 15;
const zRight = 25;

const crossFill = ground === 'dark' ? app.light : app.deep;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
    <clipPath id={clipId}>
      <path d={BACK} />
    </clipPath>
  </defs>

  <g mask={`url(#${uid})`}>
    <path d={BACK} fill={app.hue} />
    <path d={SAID} fill={app.hue} />
    {/* One shading step, and it is the concept: the two of them at once. */}
    <g clip-path={`url(#${clipId})`}>
      <path d={SAID} fill={crossFill} />
    </g>
  </g>
</svg>
