---
/**
 * tw02 · Crease — the bubble's bottom edge turned up.
 *
 * One sheet, creased once near the bottom, so the last few units of it are the
 * back of the sheet rather than the front. That single bend does three jobs:
 * it is the fold, it is the mouth — the crease is bowed, so it grins — and it
 * is where the tail comes from, which means the tail is the folded part of the
 * bubble arriving somewhere rather than a stub applied to a corner.
 *
 * The letters are cut through the front of the sheet only. The fold is in front
 * of them, so the outer ends of their lower bars tuck behind it. That is where
 * the depth comes from: a bend, not a highlight. Nothing here was added to the
 * shipped bubble — one edge was turned.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;

const uid = `tw02-${Math.random().toString(36).slice(2, 9)}`;
const maskId = `${uid}-m`;
const clipId = `${uid}-c`;

/** Body 40 × 28. */
const BODY =
  'M15 5H33A11 11 0 0 1 44 16V22A11 11 0 0 1 33 33H15A11 11 0 0 1 4 22V16A11 11 0 0 1 15 5Z';

/**
 * The crease: 24.4 at the sides, 28.4 at the centre. A 4-unit bow, which is a
 * mouth; the flat version of this line was a horizon and read as nothing.
 */
const FOLD = 'M0 24.4Q24 28.4 48 24.4V48H0Z';

/** The fold arriving. Straight edges, because folded paper has straight edges. */
const TAIL = 'M11.4 28.6L6 42.8L21 30.4Z';

const Z = { y: 12.2, w: 10.6, h: 14.4, bar: 3.1, diag: 5.3, cap: 'angled' as const };
const zLeft = 12.8;
const zRight = 25.8; // the pair spans 12.8–36.4; the crease crosses it at 25.9
const foldFill = ground === 'dark' ? app.light : app.deep;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={maskId}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
    <clipPath id={clipId}>
      <path d={BODY} />
    </clipPath>
  </defs>

  {/* Front of the sheet, with the letters cut out of it. */}
  <g mask={`url(#${maskId})`}>
    <path d={BODY} fill={app.hue} />
  </g>

  {/* The back of the sheet: in front of the letters, and running on as the tail. */}
  <path d={TAIL} fill={foldFill} />
  <g clip-path={`url(#${clipId})`}>
    <path d={FOLD} fill={foldFill} />
  </g>
</svg>
