---
/**
 * tw04 · Tally lamp
 *
 * The two Zs are live windows cut through the face of a studio tally lamp.
 * Their open terminals run into the lens edges, so the glass completes them.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw04-${Math.random().toString(36).slice(2, 9)}`;

const LENS =
  'M17 8H31L33 10V36L31 38H17L15 36V10Z';
const Z = {
  x: 16.4,
  w: 15.2,
  h: 7.2,
  bar: 2.1,
  diag: 4.7,
  cap: 'open' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} tally lamp mark`}
>
  <defs>
    <clipPath id={`${uid}-clip`}>
      <path d={LENS} />
    </clipPath>
    <mask id={`${uid}-face`}>
      <rect width="48" height="48" fill="#000" />
      <path d={LENS} fill="#fff" />
      <circle cx="24" cy="12.6" r="2.5" fill="#000" />
      <path d={zPath({ ...Z, y: 17 })} fill="#000" />
      <path d={zPath({ ...Z, y: 27 })} fill="#000" />
      <rect x="22.8" y="36" width="2.4" height="3" fill="#000" />
    </mask>
  </defs>

  {/* A clipped-corner housing and camera-shoe foot make this a studio tally. */}
  <path d="M15 5H33L37 9V38L33 42H15L11 38V9Z" fill={app.deep} />
  {/* One backlight, revealed only by apertures in the darker faceplate. */}
  <path d={LENS} fill={app.light} clip-path={`url(#${uid}-clip)`} />
  <path
    d={LENS}
    fill={app.hue}
    opacity={ground === 'dark' ? '0.9' : '1'}
    mask={`url(#${uid}-face)`}
  />

  <path d="M18 42H30L28 45H20Z" fill={app.deep} />
</svg>
