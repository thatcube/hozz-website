---
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw04-${Math.random().toString(36).slice(2, 9)}`;
const CAMERA = 'M7 6H31V13H40L45 18V30L40 35H31V42H7L3 38V10Z';
const Z = {
  y: 14,
  w: 11.5,
  h: 16,
  bar: 3.1,
  diag: 5.6,
  cap: 'angled' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} tally lamp mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#000" />
      <path d={CAMERA} fill="#fff" />
      <path d={zPath({ ...Z, x: 6 })} fill="#000" />
      <path d={zPath({ ...Z, x: 18.5 })} fill="#000" />
    </mask>
  </defs>

  <path d={CAMERA} fill={app.hue} mask={`url(#${uid})`} />
  <circle cx="18" cy="4" r="2.8" fill={ground === 'dark' ? app.light : app.deep} />
</svg>
