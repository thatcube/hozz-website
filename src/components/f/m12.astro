---
/**
 * m12 · Return Sign
 *
 * Segno logic is rebuilt rather than copied: each return marker uses two
 * counter-facing bowls crossed by a much heavier diagonal, producing a Z. The
 * staff passes through the strokes, so the score completes the marks.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const ink = ground === 'dark' ? app.light : app.deep;
const uid = `m12-${Math.random().toString(36).slice(2, 9)}`;
const zStarts = [10.3, 27.1];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} return sign mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d="M8 17H40M8 31H40" stroke="#000" stroke-width="1.25" />
    </mask>
  </defs>

  <g stroke={ink} stroke-linecap="round">
    {[10, 17, 24, 31, 38].map((y) => <path d={`M5 ${y}H43`} stroke-width="1.25" opacity="0.64" />)}
    <path d="M5 9V39M7.4 9V39M40.6 9V39M43 9V39" stroke-width="1.7" />
  </g>

  <g mask={`url(#${uid})`} stroke={app.hue} fill="none" stroke-linecap="round">
    {
      zStarts.map((x) => (
        <g>
          <path
            d={`M${x + 0.8} 16.8C${x + 3.2} 13.4 ${x + 8.4} 13.4 ${x + 10.4} 16.1`}
            stroke-width="2.55"
          />
          <path
            d={`M${x + 0.8} 31.9C${x + 3.2} 34.6 ${x + 8.4} 34.6 ${x + 10.4} 31.2`}
            stroke-width="2.55"
          />
          <path d={`M${x + 10.1} 16L${x + 1.1} 32.2`} stroke-width="4.8" />
        </g>
      ))
    }
  </g>

  <g fill={app.hue}>
    <circle cx="8.8" cy="21" r="1.35" />
    <circle cx="8.8" cy="27" r="1.35" />
    <circle cx="39.2" cy="21" r="1.35" />
    <circle cx="39.2" cy="27" r="1.35" />
  </g>
</svg>
