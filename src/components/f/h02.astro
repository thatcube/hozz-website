---
/**
 * h02 · Seam — a clamped preserving jar whose two working lines are the letters.
 *
 * A jar that keeps something has exactly two lines that matter: the seal seam
 * under the clamp, and the surface of what is inside. Both run wall to wall.
 * Here they are also the bars of the ZZ — each letter's top bar sits in the
 * seam and is the seam, lit; each letter's bottom bar sits on the surface and is
 * the surface, lit; and a diagonal falls from one to the other. Take the jar away and both
 * horizontals go with it; the letters have nothing left to be made of.
 *
 * Reading: letters. The pair is far too wide and too tall to be eyes, and the
 * contents sit under them as a solid mass, so there is no sleeping face here.
 *
 * The diagonal is 6.2 against a 3.6 bar — nearly twice the mass, which no
 * typeface would do, and the reason this cannot have come from one.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}

const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

// The board puts eight of these on one page. Shared ids would silently make
// every instance use the first one's clip.
const uid = `h02-${Math.random().toString(36).slice(2, 9)}`;

// Shouldered jar: a straight neck that flares out to full width by the belly.
// Not a rounded square — the shoulder is what makes it read as glass.
const SHELL =
  'M10.6 10.2H37.4C39.6 12.6 41 15.2 41 18.2V39.4A3.6 3.6 0 0 1 37.4 43H10.6A3.6 3.6 0 0 1 7 39.4V18.2C7 15.2 8.4 12.6 10.6 10.2Z';

const SEAM = 15.8; // top of the seal band
const FILL = 32; // surface of the contents

// Bars land exactly in the seam and exactly on the surface, so the letters are
// dimensioned by the jar rather than the other way round.
const Z = { y: SEAM, w: 12.4, h: FILL - SEAM, bar: 3.6, diag: 6.2, cap: 'flat' as const };
const zL = 9.8;
const zR = 25.8;

const lid = ground === 'dark' ? 1 : 0.92;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Hozz"
>
  <defs>
    <clipPath id={`${uid}-jar`}>
      <path d={SHELL} />
    </clipPath>
  </defs>

  <!-- clamp and lid -->
  <g fill={app.deep} opacity={lid}>
    <rect x="14.2" y="4.2" width="19.6" height="3.2" rx="1.1" />
    <rect x="11.2" y="7.4" width="25.6" height="2.8" rx="1.2" />
  </g>

  <path d={SHELL} fill={app.hue} />

  <g clip-path={`url(#${uid}-jar)`}>
    <!-- the seal seam, continuous wall to wall, and the contents below it -->
    <rect x="6" y={SEAM + 0.7} width="36" height="2.2" fill={app.deep} />
    <rect x="6" y={FILL} width="36" height="12" fill={app.deep} />

    <!-- the same seam and the same surface, lit where they become letters -->
    <path d={zPath({ ...Z, x: zL })} fill={app.light} />
    <path d={zPath({ ...Z, x: zR })} fill={app.light} />
  </g>
</svg>
