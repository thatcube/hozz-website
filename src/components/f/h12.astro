---
/**
 * h12 · Record Stamp
 *
 * A compact hand stamp whose two clean rubber dies are the ZZ. The four-unit
 * handle stem lands exactly in their four-unit gap and fixes the letterspacing.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const rubber = ground === 'dark' ? app.light : app.deep;
const Z = { y: 21, w: 13.5, h: 18, bar: 3.4, diag: 7.2, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} record-stamp mark`}
>
  <path
    d="M17 5H31Q33 5 33 8V11Q33 15 29 15H26V21H22V15H19Q15 15 15 11V8Q15 5 17 5Z"
    fill={app.hue}
  />
  <path d="M10 17H38Q40 17 40 19V23H8V19Q8 17 10 17Z" fill={app.hue} />
  <path d={zPath({ ...Z, x: 8.5 })} fill={rubber} />
  <path d={zPath({ ...Z, x: 26 })} fill={rubber} />
</svg>
