---
/**
 * h12 · Record Stamp
 *
 * A compact hand stamp whose two clean rubber dies are the ZZ. Their top bars
 * pass behind the mounting plate, which visibly clamps them to the tool.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const rubber = ground === 'dark' ? app.light : app.deep;
const Z = { y: 20, w: 13.5, h: 19, bar: 4.6, diag: 7.5, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} record-stamp mark`}
>
  <path d={zPath({ ...Z, x: 8.5 })} fill={rubber} />
  <path d={zPath({ ...Z, x: 26 })} fill={rubber} />
  <path
    d="M18 5H30Q33 5 33 8V11Q33 15 29 17H19Q15 15 15 11V8Q15 5 18 5Z"
    fill={app.hue}
  />
  <path d="M10 17H38Q40 17 40 19V22H8V19Q8 17 10 17Z" fill={app.hue} />
</svg>
