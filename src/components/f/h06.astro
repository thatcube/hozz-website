---
/**
 * h06 · Transfer Gate
 *
 * A single gate leaf between two posts. The ZZ is one clean openwork pair in
 * the shared leaf, not two letters divided into separate panels.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const uid = `h06-${Math.random().toString(36).slice(2, 9)}`;

const Z = { y: 15, w: 12, h: 17, bar: 3.2, diag: 6.2, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
  data-ground={ground}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 10 })} fill="#000" />
      <path d={zPath({ ...Z, x: 25 })} fill="#000" />
    </mask>
  </defs>

  <path d="M4 7H8V41H4ZM40 7H44V41H40Z" fill={app.deep} />
  <g mask={`url(#${uid})`}>
    <rect x="8" y="12" width="31" height="24" fill={app.hue} />
    <rect x="8" y="12" width="31" height="2.2" fill={app.light} />
    <rect x="8" y="33" width="31" height="3" fill={app.deep} opacity="0.42" />
  </g>
</svg>
