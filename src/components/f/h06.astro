---
/**
 * h06 · Handoff Gate
 *
 * One gate leaf, one shared field. Its long rails and two broad braces form
 * the pair; there are no separate panels for the Zs to sit inside.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
  data-ground={ground}
>
  <path d="M4 7H8V41H4Z" fill={app.deep} />
  <path
    d="M8 12H24V16H8ZM8 32H24V36H8ZM18 16H24L16 32H10ZM27 12H44V16H27ZM27 32H44V36H27ZM36 16H42L34 32H28ZM40 12H44V36H40Z"
    fill={app.hue}
  />
  <path d="M4 7H8V10H4ZM8 12H44V14H8Z" fill={app.light} />
</svg>
