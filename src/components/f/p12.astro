---
/**
 * p12 · Case Press
 *
 * A portrait media case with one visible spine. The pressed ZZ takes its heavy
 * diagonal directly from the spine width, so the packaging sets its contrast.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const Z = { y: 17, w: 10.5, h: 16, bar: 2.6, diag: 5, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} pressed-media-case mark`}
>
  <path d="M7 7H13V42H7Z" fill={app.deep} />
  <path d="M13 7H41V42H13Z" fill={app.hue} />
  <path
    d={`${zPath({ ...Z, x: 15 })}${zPath({ ...Z, x: 28.5 })}`}
    fill={app.deep}
    opacity="0.72"
  />
</svg>
