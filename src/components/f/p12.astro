---
/**
 * p12 · Creased Folder
 *
 * A simple tabbed folder with the ZZ pressed into its front flap. The heavy
 * diagonals are the depressed fold planes; the thin bars are their returns.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const Z = { y: 21, w: 13, h: 14, bar: 2.7, diag: 6.4, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} creased-folder mark`}
>
  <path d="M5 10H18L22 14H43V41H5Z" fill={app.deep} />
  <path d="M5 18H43V41H5Z" fill={app.hue} />
  <path
    d={`${zPath({ ...Z, x: 8 })}${zPath({ ...Z, x: 27 })}`}
    fill={app.deep}
    opacity="0.72"
  />
</svg>
