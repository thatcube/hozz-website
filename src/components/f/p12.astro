---
/**
 * p12 · Collection Folder
 *
 * A classic tabbed folder and one front flap. The ZZ is cut through the flap,
 * where the lighter contents behind provide full tonal separation.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p12-${Math.random().toString(36).slice(2, 9)}`;
const Z = { y: 21, w: 14, h: 14, bar: 3, diag: 6.2, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} collection-folder mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 8 })} fill="#000" />
      <path d={zPath({ ...Z, x: 26 })} fill="#000" />
    </mask>
  </defs>

  <path d="M5 10H18L22 14H43V41H5Z" fill={app.deep} />
  <path d="M8 15H40V39H8Z" fill={app.light} />
  <path d="M5 18H43V41H5Z" fill={app.hue} mask={`url(#${uid})`} />
</svg>
