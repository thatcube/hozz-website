---
/**
 * m06 · Fill front
 *
 * A single arched level gauge holds one field of active signal. The ZZ is
 * knocked only out of that fill; lowering the level would crop the letters and
 * emptying it would remove them.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const uid = `m06-${Math.random().toString(36).slice(2, 9)}`;
const INNER = 'M7 38V23C7 14.5 14 9 24 9C34 9 41 14.5 41 23V38H7Z';
const LEVEL = 14;
const Z = {
  y: 18,
  w: 10,
  h: 13,
  bar: 3.1,
  diag: 6,
  cap: 'angled' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} audio level mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 12 })} fill="#000" />
      <path d={zPath({ ...Z, x: 26 })} fill="#000" />
    </mask>
    <clipPath id={`${uid}-field`}>
      <path d={INNER} />
    </clipPath>
  </defs>

  <g clip-path={`url(#${uid}-field)`} mask={`url(#${uid})`}>
    <rect x="7" y={LEVEL} width="34" height={38 - LEVEL} fill={app.hue} />
  </g>
  <path d={INNER} stroke={app.deep} stroke-width="3" stroke-linejoin="round" />
</svg>
