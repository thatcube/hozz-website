---
/**
 * m06 · Fill front
 *
 * One active signal field rises into two clean Z crests. The gauge's peak line
 * is also the bottom bar of both letters, so the silhouette cannot be separated
 * from the measured level.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const groundFill = ground === 'dark' ? '#16181c' : '#fbfbfa';
const uid = `m06-${Math.random().toString(36).slice(2, 9)}`;
const INNER = 'M7 37V23C7 14.5 14 9 24 9C34 9 41 14.5 41 23V37H7Z';
const Z = {
  y: 13,
  w: 13.5,
  h: 14,
  bar: 2.8,
  diag: 5.4,
  cap: 'angled' as const,
};
const active =
  zPath({ ...Z, x: 9 }) +
  zPath({ ...Z, x: 25.5 }) +
  'M7 24H41V37H7V24Z';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} audio level mark`}
>
  <defs>
    <clipPath id={uid}>
      <path d={INNER} />
    </clipPath>
  </defs>

  <path
    d="M4 41V23C4 12 12.5 5 24 5C35.5 5 44 12 44 23V41H4Z"
    fill={app.deep}
  />
  <path d={INNER} fill={groundFill} />
  <path d={active} fill={app.hue} clip-path={`url(#${uid})`} />
</svg>
