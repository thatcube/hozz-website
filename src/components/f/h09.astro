---
/**
 * h09 · Resting — one trace, running at rest.
 *
 * The object is a single continuous trace: it enters at the left edge, settles
 * onto its resting line, and leaves at the right edge on the same level it
 * came in at. Nothing else is drawn — no strip, no frame, no grid. A calm
 * signal, because Hozz measures and never scores.
 *
 * The move: **the resting line is the letters' bottom bar.** The trace does
 * not stop for the pair and the pair is not laid over the trace — the line
 * lifts off its own level, folds twice, and comes back down to it, so the two
 * bottom bars and the two tails are one unbroken run at one height. Raise the
 * resting level and the letters rise with it; take the trace away and there
 * are no letters at all.
 *
 * The run breaks between the Zs, as a real excursion does, or the pair would
 * close up and read as a pair of sevens. The fold is heavier than the run,
 * which is what a stroke of constant width does when it crosses at an angle —
 * never a typeface.
 *
 * Zs as letters, not eyes: no face on a health mark.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

const BAR = 3.4;
const REST = 32; // the resting level: the centre line of both bottom bars

const Z = {
  y: REST - 20 + BAR / 2,
  w: 13.2,
  h: 20,
  bar: BAR,
  diag: 5.6,
  cap: 'flat' as const,
};
const zLeft = 9;
const zRight = 25.2;
const zEnd = zRight + Z.w;

// The run is dead level either side of the pair: it is at rest, and it holds
// the same height it hands to the bottom bars.
const runY = REST - BAR / 2;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <g fill={app.hue}>
    <path d={zPath({ ...Z, x: zLeft })} />
    <path d={zPath({ ...Z, x: zRight })} />
  </g>
  <g fill={app.hue}>
    <rect x="0" y={runY} width={zLeft} height={BAR} />
    <rect x={zEnd} y={runY} width={48 - zEnd} height={BAR} />
  </g>
</svg>
