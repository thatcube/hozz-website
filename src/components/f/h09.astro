---
/**
 * h09 · Field — the trace is the hole, not the ink.
 *
 * The object is a plot field: a landscape card with a graduated value rail
 * down its left side, the way a chart carries its scale. The signal is not
 * drawn on the field. It is punched clean through it, starting at the rail and
 * running out towards the right margin, so what shows inside the trace is
 * whatever is behind the mark — paper, or the dark. That is the literal claim
 * Hozz makes: the readings are not the app's, and nothing here holds them.
 *
 * The resting line is the same cut as the letters, and it is the bottom bar of
 * both of them. Cover the letters and a graduated field remains. Cover the
 * field and the letters stop existing altogether, because they have no fill of
 * their own — they are the absence of it.
 *
 * Zs as letters. No face: an app that reads sleep must not draw sleeping Zs.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

const uid = `h09-${Math.random().toString(36).slice(2, 9)}`;
const clipId = `${uid}-c`;

// 40 : 26 is 1.54 — a plot field, wider than it is tall.
const CARD = { x: 4, y: 11, w: 40, h: 26, r: 5 };
const RAIL = 10.6; // right edge of the value rail

const BAR = 3;
const REST = 28.6;

const Z = {
  y: 17.4,
  w: 11.8,
  h: REST + BAR - 17.4,
  bar: BAR,
  diag: 4.8, // 4.8 across at 50° is 3.7 of real weight against a 3 bar
  cap: 'angled' as const,
};
const zLeft = 13.2;
const zRight = 27.2; // 2.2 of gap; the pair sits clear of the rail

const VALUES = [15.4, 20.2, 25];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={clipId}>
      <rect x={CARD.x} y={CARD.y} width={CARD.w} height={CARD.h} rx={CARD.r} />
    </clipPath>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      {/* The cut starts inside the rail and stops short of the right edge, so
          the field stays one piece rather than two. */}
      <rect x="7.4" y={REST} width="33.8" height={BAR} rx="0.4" fill="#000" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <rect
      x={CARD.x}
      y={CARD.y}
      width={CARD.w}
      height={CARD.h}
      rx={CARD.r}
      fill={app.hue}
    />
    <g clip-path={`url(#${clipId})`}>
      <rect
        x={CARD.x}
        y={CARD.y}
        width={RAIL - CARD.x}
        height={CARD.h}
        fill={app.deep}
      />
      {
        VALUES.map((y) => (
          <rect x="6.2" y={y} width="2.8" height="1.4" rx="0.4" fill={app.hue} />
        ))
      }
    </g>
  </g>
</svg>
