---
/**
 * h09 · Field — a plot field with the trace cut out of it.
 *
 * The object is the field a measurement is drawn in: a landscape card standing
 * on its own axis strip, with the time scale ticked along the base. The signal
 * is not drawn on top of it. It is punched through it, so what shows in the
 * trace is whatever is behind the mark — paper, or the dark.
 *
 * The rule the trace holds runs the full width of the field and is the top bar
 * of both letters; the two dips below it are the diagonals and the floors.
 * Cover the letters and a ticked, empty plot field remains. Cover the field and
 * the letters stop existing, because they have no fill of their own — they are
 * the absence of it.
 *
 * Zs as letters. No face: a health app that reads sleep must not be caught
 * drawing sleeping Zs.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

const uid = `h09-${Math.random().toString(36).slice(2, 9)}`;
const clipId = `${uid}-c`;

// 40 : 26 is 1.54 — a plot field, wider than it is tall.
const CARD = { x: 4, y: 11, w: 40, h: 26, r: 5 };
const AXIS = 33; // top of the axis strip

const RULE = 17.5; // top edge of the line the trace holds
const BAR = 3;

const Z = {
  y: RULE,
  w: 11.6,
  h: 13.5,
  bar: BAR,
  diag: 4.6, // heavier than the bar, and it falls at 47°
  cap: 'angled' as const,
};
const zLeft = 11.1;
const zRight = 25.3; // 2.6 of gap; the pair spans 11.1–36.9, centred on 24

const TICKS = [8.4, 13.6, 18.8, 24, 29.2, 34.4, 39.6];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={clipId}>
      <rect
        x={CARD.x}
        y={CARD.y}
        width={CARD.w}
        height={CARD.h}
        rx={CARD.r}
      />
    </clipPath>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      {/* The rule runs past both edges: a field is a view onto a longer run. */}
      <rect x="1" y={RULE} width="46" height={BAR} fill="#000" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <rect
      x={CARD.x}
      y={CARD.y}
      width={CARD.w}
      height={CARD.h}
      rx={CARD.r}
      fill={app.hue}
    />
    <g clip-path={`url(#${clipId})`}>
      <rect
        x={CARD.x}
        y={AXIS}
        width={CARD.w}
        height={CARD.y + CARD.h - AXIS}
        fill={app.deep}
      />
      {
        TICKS.map((x) => (
          <rect x={x - 0.65} y="34.4" width="1.3" height="2.6" fill={app.hue} />
        ))
      }
    </g>
  </g>
</svg>
