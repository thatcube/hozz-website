---
/**
 * tw09 · Sticker — an emote as the thing you slap on somebody's chat.
 *
 * Emotes are traded and installed like stickers, so the object is a physical
 * die-cut one: printed face on top, pale backing under it, cut to the outline
 * with the loose keyline a die leaves, peeled up at one corner where somebody
 * has started lifting it off the sheet.
 *
 * The letters are the die-cut. The eyes and the grin are punched clean through
 * the printed layer, so what fills them is the backing the sticker is made of —
 * the same pale board that shows all the way round its edge. Take the sticker
 * away and there is nothing for the Zs to be cut from; take the Zs away and the
 * sticker is a blank.
 *
 * The peel is not decoration either: it is what proves there are two layers,
 * which is the only reason the letters can be a hole rather than a fill.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;

const uid = `tw09-${Math.random().toString(36).slice(2, 9)}`;

// Taller than wide, narrow at the crown, full in the jaw — an emote crop, and
// deliberately not the wide head of tw07 or the squashed one of tw08.
const STICKER =
  'M10 25.5C10 16 16.3 8.5 24 8.5C31.7 8.5 38 16 38 25.5C38 33.4 31.7 39 24 39C16.3 39 10 33.4 10 25.5Z';

// The corner somebody has begun to lift, folded back on itself. Its underside
// is in shade, which is the cheapest possible proof that the sticker has a back.
const FLAP =
  'M33.8 32.6C35.9 34.2 36.4 36.4 35.2 38.3C32.6 39.2 29.5 38.9 27.3 37.9Z';

// diag 4.2 on bar 2.3: the turn is nearly twice the line, which no typeface does.
const Z = { y: 15.6, w: 7.6, h: 8.4, bar: 2.3, diag: 4.2, cap: 'angled' as const };
const zLeft = 15.5;
const zRight = 24.9; // 1.8 of gap; the pair spans 15.5–32.5, centred on 24

// Top lip climbing 1.3 units to the right, bowl slung under it: a lopsided open
// grin. A symmetrical arc here would be a smiley, and a smiley is not a reaction.
const GRIN = 'M16.6 28.2L31.6 26.9C31.9 33 28.5 36.3 24.1 36.1C19.6 35.9 16.3 33 16.6 28.2Z';

// A die leaves an even margin all the way round, which a scaled outline does
// not — so the backing is the same path worn as a fat stroke.
const KEYLINE = 3.2;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    {/* Everything past the fold line has been lifted off the surface. */}
    <mask id={`${uid}c`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      <path d="M33.8 32.6L48 48L27.3 37.9Z" fill="#000" />
    </mask>

    {/* The die-cut itself. */}
    <mask id={`${uid}f`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      <path d={GRIN} fill="#000" />
    </mask>
  </defs>

  <g transform="rotate(-7 24 24)">
    <g mask={`url(#${uid}c)`}>
      <path
        d={STICKER}
        fill={app.light}
        stroke={app.light}
        stroke-width={KEYLINE}
        stroke-linejoin="round"
      />
      <g mask={`url(#${uid}f)`}>
        <path d={STICKER} fill={app.hue} />
      </g>
    </g>
    <path d={FLAP} fill={app.deep} />
  </g>
</svg>
