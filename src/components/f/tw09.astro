---
/**
 * tw09 · Sticker — one emote, die-cut, printed a hair off register.
 *
 * Three facts about how a sticker is made and nothing else: the pale margin a
 * cutter leaves, the colour laid slightly out of register, and the cut itself.
 * Cover the letters and a die-cut sticker is plainly there.
 *
 * The dependency: **the cutter leaves the same pale margin inside the letters
 * as it leaves around the sticker.** One blade, one offset, everywhere — so the
 * ribbon of backing showing inside each Z is exactly the ribbon showing at the
 * rim, and neither can change without the other. It is one number, KERF, used
 * in both places: it strokes the backing outward at the rim and it holds the
 * backing back inward at the letters.
 *
 * The cut goes right through, so the core of each letter is bare ground and the
 * tonal separation is total. At small sizes the margin falls below a pixel and
 * the letters simply become a clean knockout, which is the correct way for it
 * to fail.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw09-${Math.random().toString(36).slice(2, 9)}`;

const KERF = 0.9; // the margin the blade leaves, at the rim and in the letters

const DIE =
  'M8 25.5C8 14.5 15 6.5 24 6.5C33 6.5 40 14.5 40 25.5C40 34.8 33 41.5 24 41.5C15 41.5 8 34.8 8 25.5Z';

const Z = { y: 15, w: 10, h: 12, bar: 3, diag: 5.3, cap: 'angled' as const };
const zLeft = 11.5;
const zRight = 26.5;

const GRIN =
  'M13.6 31.8L34.6 30.4C35 36.8 30.4 40.1 24 39.9C18.2 39.7 13.2 36.8 13.6 31.8Z';

const cuts = [zPath({ ...Z, x: zLeft }), zPath({ ...Z, x: zRight }), GRIN];
const backing = ground === 'dark' ? app.light : app.light;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    {/* The print: cut to the letter exactly. */}
    <mask id={`${uid}p`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      {cuts.map((d) => <path d={d} fill="#000" />)}
    </mask>
    {/* The backing: same cut, held back by KERF/2 — the same margin the blade
        leaves outside, restored here by stroking the hole shut. */}
    <mask id={`${uid}b`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      {cuts.map((d) => (
        <path
          d={d}
          fill="#000"
          stroke="#fff"
          stroke-width={KERF}
          stroke-linejoin="round"
        />
      ))}
    </mask>
  </defs>

  <g transform="rotate(-8 24 24)">
    <g mask={`url(#${uid}b)`}>
      <path
        d={DIE}
        fill={backing}
        stroke={backing}
        stroke-width={KERF}
        stroke-linejoin="round"
      />
    </g>
    <g mask={`url(#${uid}p)`}>
      <path d={DIE} fill={app.hue} transform="translate(-0.4 -0.5)" />
    </g>
  </g>
</svg>
