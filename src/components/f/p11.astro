---
/**
 * p11 · Casework
 *
 * Flat cases make the horizontal shelves while thicker leaning collector cases
 * make the diagonals. Every segment has a visible spine or cover edge, so the
 * ZZ is assembled from media objects rather than a solid letter panel.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} case-library mark`}
>
  {/* Upright cases make the collection legible even with the central pair hidden. */}
  <rect x="5" y="15" width="3.1" height="24.7" rx="0.7" fill={app.deep} />
  <rect x="8.8" y="10" width="3.4" height="29.7" rx="0.7" fill={app.hue} />
  <path d="M12.9 13.4H16L14.7 39.7H11.6Z" fill={app.deep} />
  <path d="M34 12.1H37.2L38.4 39.7H35.2Z" fill={app.deep} />
  <rect x="38.8" y="8" width="3.4" height="31.7" rx="0.7" fill={app.hue} />
  <rect x="42.8" y="16.5" width="2.2" height="23.2" rx="0.6" fill={app.deep} />

  {/* Each Z is three visibly separate cases, complete with a darker spine edge. */}
  <g>
    <path d="M13.6 10.5H24V13.3H13.6Z" fill={app.light} />
    <path d="M13.6 10.5H15V13.3H13.6Z" fill={app.hue} />
    <path d="M20.1 14.1L24 15.4L17.4 30.2L13.5 28.9Z" fill={app.light} />
    <path d="M20.1 14.1L21.4 14.5L14.8 29.3L13.5 28.9Z" fill={app.hue} />
    <path d="M13.5 30.9H24V33.7H13.5Z" fill={app.light} />
    <path d="M13.5 30.9H14.9V33.7H13.5Z" fill={app.hue} />

    <path d="M24.8 11.2H35.4V14H24.8Z" fill={app.light} />
    <path d="M24.8 11.2H26.2V14H24.8Z" fill={app.hue} />
    <path d="M31.5 14.8L35.4 16.1L28.7 30.1L24.8 28.8Z" fill={app.light} />
    <path d="M31.5 14.8L32.8 15.2L26.1 29.2L24.8 28.8Z" fill={app.hue} />
    <path d="M24.8 30.9H35.4V33.7H24.8Z" fill={app.light} />
    <path d="M24.8 30.9H26.2V33.7H24.8Z" fill={app.hue} />
  </g>

  <rect x="3.5" y="39.2" width="41" height="3.2" rx="1.4" fill={app.deep} />
</svg>
