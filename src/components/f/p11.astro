---
/**
 * p11 · Box Set
 *
 * Three case tops stay individually visible, but join into one box-set field
 * before the ZZ begins. The knockout therefore remains whole at every stroke.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96 } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p11-${Math.random().toString(36).slice(2, 9)}`;
const Z = { y: 16, w: 14, h: 16, bar: 3.2, diag: 6.2, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} box-set mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 7 })} fill="#000" />
      <path d={zPath({ ...Z, x: 27 })} fill="#000" />
    </mask>
  </defs>

  <path
    d="M5 13H16V38H5ZM17 9H29V38H17ZM30 14H43V38H30ZM5 15H43V38H5Z"
    fill={app.hue}
    mask={`url(#${uid})`}
  />
  <path d="M3.5 37H44.5V42H3.5Z" fill={app.deep} />
</svg>
