---
/**
 * m09 · Grille — a portable stereo: two vents, a handle, a tape door.
 *
 * The vent panel is a stack of ribs at a fixed pitch. Two ribs in the middle of
 * each stack have run into one another — the second rib slides down the
 * diagonal into the fifth — and the stack picks the pitch back up above and
 * below. The Z is not a shape laid over the grille; it is what the grille does
 * for four of its rows, which is why the outermost ribs still line up with the
 * Z's own bars. Cover the grille and the letters go with it.
 *
 * The tape door is the mouth. The handle is why this is a carrier and not a
 * piece of furniture: the whole point of the object is that it goes with you,
 * which is also the point of a downloaded library.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;

const uid = `m09-${Math.random().toString(36).slice(2, 9)}`;

const BODY = { x: 4.5, y: 11.4, w: 39, h: 29.2, r: 3.2 };
const PANEL = { y: 15.4, w: 12, h: 16.2, x: [8, 28] };

// Rib pitch: 1.7 of material, 1.2 of air. Six rows fit the panel exactly.
const RIB = { w: 10, h: 1.7, inset: 1 };
const PLAIN = [15.4, 29.9]; // the rows that keep the pitch

// The Z's bars land on rows two and five, so it is measured in the same pitch.
// diag 3.9 against bar 1.7: the diagonal is where the two lost rows went.
const Z = { y: 18.3, w: 10, h: 10.4, bar: 1.7, diag: 3.9 };

const DOOR = { x: 15, y: 34.2, w: 18, h: 4, r: 1.3 };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={uid}>
      <rect
        x={BODY.x}
        y={BODY.y}
        width={BODY.w}
        height={BODY.h}
        rx={BODY.r}
      />
    </clipPath>
  </defs>

  {/* The handle passes behind the body, so the body's top edge cuts it. */}
  <path
    d="M16.5 12A7.8 7.8 0 0 1 31.5 12"
    stroke={app.deep}
    stroke-width="2.4"
    fill="none"
  />

  <rect
    x={BODY.x}
    y={BODY.y}
    width={BODY.w}
    height={BODY.h}
    rx={BODY.r}
    fill={app.hue}
  />

  <g clip-path={`url(#${uid})`}>
    <rect
      x={BODY.x}
      y={BODY.y + BODY.h - 3.2}
      width={BODY.w}
      height={3.2}
      fill={app.deep}
      opacity={ground === 'dark' ? 0.34 : 0.26}
    />
  </g>

  {
    PANEL.x.map((px) => (
      <>
        <rect
          x={px}
          y={PANEL.y}
          width={PANEL.w}
          height={PANEL.h}
          rx={1.6}
          fill={app.deep}
        />
        {PLAIN.map((ry) => (
          <rect
            x={px + RIB.inset}
            y={ry}
            width={RIB.w}
            height={RIB.h}
            rx={0.5}
            fill={app.light}
          />
        ))}
        <path d={zPath({ ...Z, x: px + RIB.inset })} fill={app.light} />
      </>
    ))
  }

  <rect
    x={DOOR.x}
    y={DOOR.y}
    width={DOOR.w}
    height={DOOR.h}
    rx={DOOR.r}
    fill={app.deep}
  />
</svg>
