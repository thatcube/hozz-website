---
/**
 * m09 · Thread — tape threaded between two spools.
 *
 * The supply spool sits high on the left, the take-up spool low on the right,
 * and the whole run of tape between them is the ZZ: it leaves the first hub,
 * folds, folds back, and winds onto the second. Each Z ends inside a hub, so
 * the letters are the tape path and cannot be lifted away from the spools that
 * hold them. The bars are the ribbon flat and the diagonals are the ribbon
 * crossing the run, which is why the two weights differ.
 *
 * Three shapes: two spools and one tape. Two fills.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;

// bar 3 against diag 4.8.
const Z = { y: 17.5, h: 12.6, w: 13, bar: 3, diag: 4.8 };
const ZX = [9.5, 26.5];

const TOP_Y = Z.y + Z.bar / 2;
const FOOT_Y = Z.y + Z.h - Z.bar / 2;

// Both loose ends of the ribbon land on a hub: the supply and the take-up. They
// stay small deliberately — at full spool size they read as letters themselves.
const HUBS = [
  { x: ZX[0], y: TOP_Y },
  { x: ZX[1] + Z.w, y: FOOT_Y },
];
const HUB = { r: 3.6, core: 1.45 };

const FOLD = `M${ZX[0] + Z.w} ${FOOT_Y}C25.9 27.9 24.5 20.3 ${ZX[1]} ${TOP_Y}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  {HUBS.map((h) => <circle cx={h.x} cy={h.y} r={HUB.r} fill={app.hue} />)}
  <path d={FOLD} stroke={app.hue} stroke-width={Z.bar * 0.62} fill="none" />
  {ZX.map((zx) => <path d={zPath({ ...Z, x: zx })} fill={app.hue} />)}
  {
    HUBS.map((h) => (
      <circle cx={h.x} cy={h.y} r={HUB.core} fill={app.deep} />
    ))
  }
</svg>
