---
/**
 * h05 · Crossing
 *
 * The bridge has no body behind the letters. A continuous deck, two broad
 * diagonals, and their lower rails are the span itself.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
  data-ground={ground}
>
  <path
    d="M4 12H22V16H4ZM7 31H21V35H7ZM16 16H22L14 31H8ZM25 12H44V16H25ZM24 31H41V35H24ZM36 16H42L28 31H22Z"
    fill={app.hue}
  />
  <path
    d="M5 29H43V42H5ZM11 42C12.5 31 19 27.5 24 27.5C29 27.5 35.5 31 37 42Z"
    fill={app.deep}
    fill-rule="evenodd"
  />
  <path d="M4 12H44V14H4Z" fill={app.light} />
</svg>
