---
/**
 * m07 · Window — a compact cassette, seen through its two hub windows.
 *
 * The shell is closed, so the only tape you can see is the span each window
 * frames. That span has been pulled slack and has folded back on itself, which
 * is what a ribbon does, and a ribbon folded twice is a Z. Between the two
 * windows the tape runs behind the shell, which is the reason there are two
 * separate Zs here and not one long zigzag — the object is what separates them.
 *
 * The letters have no edge of their own. Every bar runs straight out into the
 * window's rim and is cut off by it, so the shape of each terminal is the
 * window's shape. Take the cassette away and both Zs lose both ends of both
 * bars.
 *
 * The mouth is the head opening in the bottom edge: the notch the playback head
 * reaches through, and the only place a closed cassette is genuinely open.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;

// Unique per instance: the board renders this component eight times on one page
// and a duplicated clip id would silently clip the wrong shape.
const uid = `m07-${Math.random().toString(36).slice(2, 9)}`;

// 40 : 26 is 1.54. A Compact Cassette shell is 100 : 64, or 1.5625.
const SHELL = { x: 4, y: 11, w: 40, h: 26, r: 3.2 };

// The recessed well the windows are sunk into — the step that stops this being
// a rounded rectangle with two holes in it.
const WELL = { x: 9.4, y: 14.4, w: 29.2, h: 14.4, r: 2.2 };

const R = 6.2;
const CY = 21.6;
const CX = [17, 31];

// bar 2 against diag 3.4. The diagonal carries seventy per cent more mass than
// the bars, which is the thing a typeface would never do.
const Z = { y: 17.4, w: 9.8, h: 8.4, bar: 2, diag: 3.4, cap: 'open' as const };

// The head opening. 11 wide against the shell's 40, under the gap between the
// windows.
const SLOT = { x: 18.5, y: 31.4, w: 11, h: 3.4, r: 1.7 };

const b = SHELL.y + SHELL.h;
const shade =
  `M${SHELL.x} ${b - 3}H${SHELL.x + SHELL.w}V${b - SHELL.r}` +
  `A${SHELL.r} ${SHELL.r} 0 0 1 ${SHELL.x + SHELL.w - SHELL.r} ${b}` +
  `H${SHELL.x + SHELL.r}A${SHELL.r} ${SHELL.r} 0 0 1 ${SHELL.x} ${b - SHELL.r}Z`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    {
      CX.map((cx, i) => (
        <clipPath id={`${uid}-${i}`}>
          <circle cx={cx} cy={CY} r={R} />
        </clipPath>
      ))
    }
  </defs>

  <rect
    x={SHELL.x}
    y={SHELL.y}
    width={SHELL.w}
    height={SHELL.h}
    rx={SHELL.r}
    fill={app.hue}
  />
  <path d={shade} fill={app.deep} opacity={ground === 'dark' ? 0.36 : 0.28} />

  <rect
    x={WELL.x}
    y={WELL.y}
    width={WELL.w}
    height={WELL.h}
    rx={WELL.r}
    fill={app.deep}
  />

  {CX.map((cx) => <circle cx={cx} cy={CY} r={R} fill={app.light} />)}

  {
    CX.map((cx, i) => (
      <g clip-path={`url(#${uid}-${i})`}>
        <path d={zPath({ ...Z, x: cx - Z.w / 2 })} fill={app.deep} />
      </g>
    ))
  }

  <rect
    x={SLOT.x}
    y={SLOT.y}
    width={SLOT.w}
    height={SLOT.h}
    rx={SLOT.r}
    fill={app.deep}
  />
</svg>
