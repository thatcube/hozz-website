---
/**
 * h04 · Transfer Tape
 *
 * The object is the pair: two equal lengths of broad tape folded through the
 * same level change. Each plane changes shade at the physical fold.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
  data-ground={ground}
>
  <path d="M5 10H22L21 14H5ZM27 10H44L43 14H27Z" fill={app.light} />
  <path d="M15 14H21L12 32H6ZM37 14H43L34 32H28Z" fill={app.hue} />
  <path d="M6 32H22L21 36H6ZM28 32H44L43 36H28Z" fill={app.deep} />
</svg>
