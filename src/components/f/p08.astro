---
/**
 * p08 · Iris — a lens wide open in the dark, and the light it lets through.
 *
 * The dependency: **the opening sets the pair's width.** The two letters are
 * inscribed in the iris. They swell to fill it at its widest, and the blades
 * cut the outer corner off every bar on the blade's own slant, so the dark of
 * the barrel floods into the ends. Narrow the hole and the letters are eaten;
 * shrink the pair and it rattles around inside. They are one measurement.
 *
 * Two shapes, two fills. The letters are a full knockout of the light.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p08-${Math.random().toString(36).slice(2, 9)}`;

// Six blades, opened to a hexagon 36 across and 31.2 high, inside the barrel.
const R_BARREL = 21.5;
const iris = 'M42 24L33 8.41H15L6 24L15 39.59H33Z';

// 14.2 + 1.6 + 14.2 = 30, running 9 to 39. At the top and bottom of the bars
// the blades are only 27.9 apart, so each outer corner loses 1.04 on the slant.
const Z = { y: 17, w: 14.2, h: 14, bar: 3.9, diag: 7.4, cap: 'flat' as const };
const zLeft = 9;
const zRight = 24.8;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
  </defs>

  <circle
    cx="24"
    cy="24"
    r={R_BARREL}
    fill={ground === 'dark' ? app.deep : app.deep}
  />
  <path d={iris} fill={app.hue} mask={`url(#${uid})`} />
</svg>
