---
/**
 * p08 · Under — a door shut on a lit room, with the light getting out below it.
 *
 * The dependency is the direction of the light, not a crop. The only light in
 * this mark comes from the strip under the door, so everything it touches is
 * caught along its underside: the raised panel carries the same pale tone on
 * the bottom edge of every stroke, and nowhere else. Put the light anywhere
 * else — above, or behind — and the whole letter shades the other way. The
 * panel is not knocked out of the door; it stands off it, and the light beneath
 * is what makes it visible at all.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p08-${Math.random().toString(36).slice(2, 9)}`;

const DOOR = { x: 7, y: 2, w: 34, h: 38 };
const LIFT = 1.2; // how far the panel stands off the door

// 13.2 + 1.6 + 13.2 = 28, running 10 to 38 inside a door 34 wide.
const Z = { y: 14, w: 13.2, h: 14, bar: 3.9, diag: 7.1, cap: 'flat' as const };
const zLeft = 10;
const zRight = 24.8;
const lit = ground === 'dark' ? app.light : app.light;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <g id={uid}>
    <rect
      x={DOOR.x}
      y={DOOR.y}
      width={DOOR.w}
      height={DOOR.h}
      rx="2"
      fill={app.deep}
    />

    {/* The same light, caught on the underside of every stroke. */}
    <path d={zPath({ ...Z, y: Z.y + LIFT, x: zLeft })} fill={lit} />
    <path d={zPath({ ...Z, y: Z.y + LIFT, x: zRight })} fill={lit} />
    <path d={zPath({ ...Z, x: zLeft })} fill={app.hue} />
    <path d={zPath({ ...Z, x: zRight })} fill={app.hue} />

    {/* Where it gets out. */}
    <rect x="4" y="41" width="40" height="2.8" rx="1.4" fill={lit} />
  </g>
</svg>
