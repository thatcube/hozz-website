---
/**
 * m11 · Folded Flags
 *
 * Each quaver is complete only when its flag leaves the stem, folds through a
 * heavy diagonal, and returns. Its two bars are made from the note material;
 * without them the coloured fold is only a slash, not a detachable letter.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const ink = ground === 'dark' ? app.light : app.deep;

const notes = [
  { x: 8.2, cx: 8.3 },
  { x: 27, cx: 27.1 },
];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} folded note flags mark`}
>
  {
    notes.map((note) => (
      <g>
        <rect x={note.x - 1.15} y="22.8" width="2.8" height="13.6" rx="1.4" fill={ink} />
        <ellipse
          cx={note.cx}
          cy="36.4"
          rx="4.3"
          ry="2.9"
          transform={`rotate(-18 ${note.cx} 36.4)`}
          fill={ink}
        />
        <path
          d={`M${note.x} 10H${note.x + 12.8}M${note.x} 24H${note.x + 12.8}`}
          stroke={ink}
          stroke-width="2.4"
          stroke-linecap="square"
        />
        <path
          d={`M${note.x + 11.7} 10L${note.x + 1.1} 24`}
          stroke={app.hue}
          stroke-width="5.2"
          stroke-linecap="square"
          stroke-linejoin="bevel"
        />
      </g>
    ))
  }
</svg>
