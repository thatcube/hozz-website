---
/**
 * h10 · Open Punch
 *
 * One wide, tabbed record card. Two punches open through its top edge and end
 * inside the card, so the pair is carried by one continuous silhouette.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const uid = `h10-${Math.random().toString(36).slice(2, 9)}`;

const Z = { y: 10, w: 13, h: 20, bar: 3.8, diag: 7.6, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} open-punch record mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 8.5 })} fill="#000" />
      <path d={zPath({ ...Z, x: 26 })} fill="#000" />
    </mask>
  </defs>

  <path
    d="M4 10H11V6H21V10H44V38H4Z"
    fill={ground === 'dark' ? app.light : app.hue}
    mask={`url(#${uid})`}
  />
</svg>
