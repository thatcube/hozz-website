---
/**
 * h08 · Scored — a field of record, scored at two levels.
 *
 * The object is a run of measurement that fills the tile and passes off every
 * edge, because the body was doing this before the app looked. Two levels are
 * scored clean through it — an upper limit and a resting level — and they are
 * the only marks on it.
 *
 * The move that ties the letters to it: **the two scores are the letters'
 * bars**. The upper score is both top bars and the lower score is both bottom
 * bars, and each runs on past the pair to the edge of the tile, so the ZZ is
 * the length of the record where the two levels fold into one another. Only
 * the two falls are added. Shift the levels and the letters change height with
 * them; take them away and there is nothing left but two diagonals.
 *
 * Scores and letters are one continuous knockout, so the ground shows through
 * both and the pair keeps full tonal separation down to 24px.
 *
 * Zs as letters, not eyes: no face on a health mark.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const uid = `h08-${Math.random().toString(36).slice(2, 9)}`;

const BAR = 3.2;
const TOP = 15; // the upper level, and therefore both top bars
const FLOOR = 29.6; // the resting level, and therefore both bottom bars

const Z = {
  y: TOP,
  w: 13.6,
  h: FLOOR + BAR - TOP,
  bar: BAR,
  diag: 5.4,
  cap: 'flat' as const,
};
// 13.6 + 3 + 13.6 = 30.2, running 8.9 to 39.1, centred on 24. The scores stop
// at the letter gap, or the pair would read as a pair of sevens.
const zLeft = 8.9;
const zRight = 25.5;
const zMid = zLeft + Z.w;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <g fill="#000">
        <rect x="0" y={TOP} width={zMid} height={BAR} />
        <rect x={zRight} y={TOP} width={48 - zRight} height={BAR} />
        <rect x="0" y={FLOOR} width={zMid} height={BAR} />
        <rect x={zRight} y={FLOOR} width={48 - zRight} height={BAR} />
        <path d={zPath({ ...Z, x: zLeft })} />
        <path d={zPath({ ...Z, x: zRight })} />
      </g>
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <rect width="48" height="48" fill={app.hue} />
    {/* One shading step: the record below the resting level, held darker. */}
    <rect x="0" y={FLOOR} width="48" height={48 - FLOOR} fill={app.deep} />
  </g>
</svg>
