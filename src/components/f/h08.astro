---
/**
 * h08 · Plot — an axis, and the line it holds.
 *
 * The object is the frame every measurement is drawn in: a value axis standing
 * on the left with its graduations, and the line the readings are plotted
 * against running away to the right. No panel, no plate — a plot is a frame,
 * not a box, and Hozz should look like the quiet instrument rather than the
 * dashboard.
 *
 * The trace *is* that bottom line. It lies along it for most of the run and
 * leaves it exactly twice, and each excursion closes on the line again, so the
 * axis is the bottom bar of both letters. Cover the letters and a graduated
 * axis remains, which is a deliberate thing. Cover the axis and the letters
 * lose the stroke that finished them — two sevens hanging over nothing.
 *
 * Zs as letters. No face, and none is wanted: a health app that reads sleep
 * cannot afford a pair of sleeping eyes.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

const dark = ground === 'dark';
const frame = dark ? app.hue : app.deep; // the instrument
const trace = dark ? app.light : app.hue; // the reading, always the brighter

const BAR = 2.4;
const BASE = 31.6; // top edge of the line everything is measured from

const AXIS = { x: 6.6, y: 11, w: BAR, h: BASE + BAR - 11 };

const Z = {
  y: 20.4,
  w: 10.6,
  h: BASE + BAR - 20.4,
  bar: BAR,
  diag: 4.6, // 4.6 across at 56° is 3.8 of real weight against a 2.4 bar
  cap: 'angled' as const,
};
const zLeft = 13.4;
const zRight = 26.4; // 2.4 of gap; the pair sits to the right of the axis

// Graduations: three on the value axis, four along the run.
const VALUES = [13.6, 19.2, 24.8];
const TIMES = [16.6, 23.2, 29.8, 36.4];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <g fill={frame}>
    <rect x={AXIS.x} y={AXIS.y} width={AXIS.w} height={AXIS.h} rx="0.6" />
    {
      VALUES.map((y) => (
        <rect x={AXIS.x + AXIS.w} y={y} width="2.7" height="1.5" rx="0.4" />
      ))
    }
    {
      TIMES.map((x) => (
        <rect x={x} y={BASE + BAR} width="1.5" height="2.4" rx="0.4" />
      ))
    }
  </g>

  <g fill={trace}>
    {/* The base line runs from the axis out past the right margin. */}
    <rect x={AXIS.x} y={BASE} width={41.4 - AXIS.x} height={BAR} />
    <path d={zPath({ ...Z, x: zLeft })} />
    <path d={zPath({ ...Z, x: zRight })} />
  </g>
</svg>
