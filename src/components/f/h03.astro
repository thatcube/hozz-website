---
/**
 * h03 · Measure — a domed tank, and the ZZ is a swerve in its ruling.
 *
 * The tank is ruled, because the only question anyone asks a tank is how much
 * is in it. Two of the graduations misbehave: the line at 21.5 thickens and
 * drops away on the diagonal, cuts through the line below it, and lands on the
 * surface of the contents — then the ruling picks up again either side as if
 * nothing had happened. Erase the scale and there are no letters. Erase the
 * letters and the scale has two holes in it.
 *
 * Reading: letters — the pair is embedded in a ruled band, not floated on a
 * face. Should anyone read them as eyes anyway, the bright level line directly
 * beneath them is a mouth, so the mark cannot fall into the asleep trap.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

const uid = `h03-${Math.random().toString(36).slice(2, 9)}`;

// Dome on top, barrel below, flat base: a pressure vessel, not a box.
const SHELL =
  'M8 20.5A16 10 0 0 1 40 20.5V39.5A3.2 3.2 0 0 1 36.8 42.7H11.2A3.2 3.2 0 0 1 8 39.5Z';
// Everything inside is clipped to the shell itself, so each graduation is
// exactly as long as the vessel is wide at that height — which is what makes
// the top one shorten into the dome, and what makes the ruling run past the
// letters to both walls.
const RULE = { x: 8, w: 32, t: 1 };
const TOP = 21.5;
const FILL = 34;

// bar 3.4 against diag 5.4, over a 1-unit line: the graduation thickens more
// than three times over, and then the fold is heavier still.
// Flat caps, because every other line on the scale ends flat too.
const Z = { y: TOP, w: 10.6, h: FILL - TOP, bar: 3.4, diag: 5.4, cap: 'flat' as const };
const zL = 12;
const zR = 25.4;

// The plain ruling sits back a step so the two that misbehave carry the mark.
const rule = ground === 'dark' ? 0.9 : 0.76;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={`${uid}-c`}>
      <path d={SHELL} />
    </clipPath>
  </defs>

  {/* Filler port on the crown, then the shell. */}
  <rect x="20.4" y="4.6" width="7.2" height="1.9" rx="0.9" fill={app.hue} />
  <rect x="22.2" y="6.5" width="3.6" height="5" fill={app.hue} />
  <path d={SHELL} fill={app.hue} />

  <g clip-path={`url(#${uid}-c)`}>
    {/* The scale. The letters grow out of the second line and cross the third. */}
    <rect x={RULE.x} y="15.4" width={RULE.w} height={RULE.t} fill={app.deep} opacity={rule} />
    <rect x={RULE.x} y={TOP} width={RULE.w} height={RULE.t} fill={app.deep} opacity={rule} />
    <rect x={RULE.x} y="27.6" width={RULE.w} height={RULE.t} fill={app.deep} opacity={rule} />

    <path d={zPath({ ...Z, x: zL })} fill={app.deep} />
    <path d={zPath({ ...Z, x: zR })} fill={app.deep} />

    {/* The level itself, and the contents below it. */}
    <rect x={RULE.x} y={FILL} width={RULE.w} height="1.6" fill={app.light} />
    <rect x={RULE.x} y={FILL + 1.6} width={RULE.w} height="9" fill={app.deep} />
  </g>
</svg>
