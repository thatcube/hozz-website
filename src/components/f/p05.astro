---
/**
 * p05 · Switchback scrubber
 *
 * Two chapter rails bend into Zs. Their end stops, chapter ticks, and circular
 * playheads are transport hardware; without the rails there is no letterform.
 */
import { zSpine } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;

const LEFT = { x: 5.5, y: 12, w: 16, h: 24 };
const RIGHT = { x: 26.5, y: 12, w: 16, h: 24 };
const rail = ground === 'dark' ? app.light : app.deep;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} scrubber mark`}
>
  <path
    d={zSpine(LEFT)}
    stroke={rail}
    stroke-width="5.4"
    stroke-linecap="round"
    stroke-linejoin="bevel"
  />
  <path
    d={zSpine(RIGHT)}
    stroke={rail}
    stroke-width="5.4"
    stroke-linecap="round"
    stroke-linejoin="bevel"
  />

  <path
    d={zSpine(LEFT)}
    stroke={app.hue}
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="bevel"
  />
  <path
    d={zSpine(RIGHT)}
    stroke={app.hue}
    stroke-width="2.4"
    stroke-linecap="round"
    stroke-linejoin="bevel"
  />

  <circle cx="13.6" cy="21.9" r="3.2" fill={app.hue} stroke={rail} stroke-width="1.8" />
  <circle cx="34.6" cy="21.9" r="3.2" fill={app.hue} stroke={rail} stroke-width="1.8" />
  <path d="M12.6 20.3L15.1 21.9L12.6 23.5Z" fill={rail} />
  <path d="M33.6 20.3L36.1 21.9L33.6 23.5Z" fill={rail} />

  <path d="M8.5 7.5V10M18.5 7.5V10M29.5 7.5V10M39.5 7.5V10" stroke={rail} stroke-width="2" />
  <path d="M8.5 38V40.5M18.5 38V40.5M29.5 38V40.5M39.5 38V40.5" stroke={rail} stroke-width="2" />
</svg>
