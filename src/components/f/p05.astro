---
/**
 * p05 · Switchback scrubber
 *
 * A single progress rail swelling into one circular thumb. The pair is punched
 * through the filled portion of the track as one shared interval.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p05-${Math.random().toString(36).slice(2, 9)}`;
const Z = {
  y: 18,
  w: 9,
  h: 12,
  bar: 3,
  diag: 5.4,
  cap: 'angled' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} scrubber mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 8 })} fill="#000" />
      <path d={zPath({ ...Z, x: 19.5 })} fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <rect x="4" y="15" width="35" height="18" rx="9" fill={app.hue} />
  </g>
  <circle cx="38" cy="24" r="9.5" fill={ground === 'dark' ? app.light : app.deep} />
  <circle cx="38" cy="24" r="5" fill={app.hue} />
</svg>
