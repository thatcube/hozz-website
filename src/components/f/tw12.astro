---
/**
 * tw12 · Watch party
 *
 * Four simple head bumps merge into one audience silhouette facing a single
 * live screen. ZZ is a clean knockout through the shared crowd mass.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw12-${Math.random().toString(36).slice(2, 9)}`;

const Z = { y: 27, w: 13, h: 13, bar: 3.5, diag: 7, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} watch-party audience mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 9.5 })} fill="#000" />
      <path d={zPath({ ...Z, x: 25.5 })} fill="#000" />
    </mask>
  </defs>

  <rect x="17" y="4" width="14" height="7" rx="2" fill={app.deep} />
  <g mask={`url(#${uid})`}>
    <path
      d="M4 43V30Q4 26 7 25C5.5 23.7 5 21.8 5.5 20C6 17.5 8 16 10 16C12 16 14 17.5 14.5 20C15 21.7 14.5 23.4 13.5 24.5C14.5 24 15.5 23.7 16.5 23.5C15 22 14.5 20 15 18C15.5 15 18 13 20.5 13C22 13 23.5 13.8 24.5 15C25.5 13.8 27 13 28.5 13C31 13 33.5 15 34 18C34.5 20 34 22 32.5 23.5C33.5 23.7 34.5 24 35.5 24.5C34.5 23.4 34 21.7 34.5 20C35 17.5 37 16 39 16C41 16 43 17.5 43.5 20C44 21.8 43.5 23.7 42 25Q44 26 44 30V43H4Z"
      fill={app.hue}
    />
    <path d="M4 39Q24 45 44 39V43H4V39Z" fill={app.deep} />
  </g>
</svg>
