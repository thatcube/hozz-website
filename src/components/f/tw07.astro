---
/**
 * tw07 · Spam — one emote, pasted three times.
 *
 * The object is not a face. The object is *the same face sent three times in a
 * row*, which is the actual texture of a Twitch chat: nobody posts one emote.
 * Three identical heads, rigidly registered, stepping back up the line like a
 * message repeating faster than the column can scroll.
 *
 * The eyes and the grin are drilled straight through the whole stack, so the
 * hole passes the front copy, both echoes and out the back. That is why the
 * letters cannot be lifted off: they have no fill of their own, and there is
 * nothing behind them but more of the same emote.
 *
 * The trail runs along the Zs' own diagonal. The diagonal of this Z drops by
 * (diag - w, h - 2·bar) = (-3.4, +3.7); each copy is offset by exactly the
 * reverse, scaled. So the direction the emote repeats in and the direction the
 * letter cuts in are the same line — the step of the spam is the stroke of the Z.
 *
 * The mouth is compulsory here and it is not the shipped smile. It is a wide
 * open lopsided grin, top edge running uphill, because an emote is a reaction
 * and a neutral face is not one.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;

// Rendered eight times on one page; a shared mask id would silently apply the
// wrong holes to a neighbour.
const uid = `tw07-${Math.random().toString(36).slice(2, 9)}`;

// diag 4.0 against bar 2.25 — the diagonal carries nearly twice the bar's mass,
// which is what stops a Z looking like it was set rather than drawn.
const Z = { y: 17.4, w: 7.4, h: 8.2, bar: 2.25, diag: 4.0, cap: 'angled' as const };
const zLeft = 12.75;
const zRight = 21.85; // 1.7 of gap; the pair spans 12.75–29.25, centred on 21

// The repeat vector: the reverse of the diagonal (-3.4, +3.7), scaled to 0.735.
const STEP = { x: 2.5, y: -2.72 };

// A head squashed wider than it is tall, heavier on the right cheek — a shape
// mid-reaction rather than a circle waiting for two letters to be put in it.
const HEAD =
  'M6 25.2C6 17.9 12.4 13.4 21.4 13.4C30.4 13.4 36 18.2 36 26C36 33.8 30 38.6 21.4 38.6C12.6 38.6 6 33.4 6 25.2Z';

// Top edge runs uphill to the right, bottom slung left: a grin, not a smile.
const GRIN =
  'M13.9 28.4L28.3 27.1C28.75 33.4 25 36.7 20.9 36.05C16.6 35.4 13.6 32.6 13.9 28.4Z';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      {/* Oversized, because the group this masks is rotated. */}
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      <path d={GRIN} fill="#000" />
    </mask>
  </defs>

  <g transform="rotate(-5 24 26)">
    <g mask={`url(#${uid})`}>
      {/* Copy three, then copy two — the same head, stepping back up the line. */}
      <g transform={`translate(${STEP.x * 2} ${STEP.y * 2})`}>
        <path d={HEAD} fill={app.light} opacity="0.45" />
      </g>
      <g transform={`translate(${STEP.x} ${STEP.y})`}>
        <path d={HEAD} fill={app.light} />
      </g>
      {/* The copy in front. */}
      <path d={HEAD} fill={app.hue} />
      {/* One step of shade where the front copy overhangs the one behind. */}
      <path
        d="M6 25.2C6 17.9 12.4 13.4 21.4 13.4C24.1 13.4 26.5 13.85 28.5 14.65C22.4 16.7 18.2 22.2 18.2 29C18.2 32.6 19.4 35.9 21.4 38.55C12.6 38.5 6 33.4 6 25.2Z"
        fill={app.deep}
        opacity="0.22"
      />
    </g>
  </g>
</svg>
