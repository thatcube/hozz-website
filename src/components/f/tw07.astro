---
/**
 * tw07 · Spam — one emote, sent three times.
 *
 * The object is not a face, it is *the repeat*. Nobody posts one emote; the
 * same block arriving three times in a row is what a chat actually looks like.
 * So: three identical heads, rigidly registered, each separated from the next
 * by a hairline of ground so they read as three sends rather than as one head
 * with a shadow behind it.
 *
 * The eyes and the grin are drilled straight through the whole stack — front
 * copy, both echoes, out the back. That is why the letters cannot be lifted
 * off: they have no fill of their own, and there is nothing behind them but
 * more of the same emote.
 *
 * The trail runs along the Zs' own diagonal. This Z drops by (diag - w,
 * h - 2·bar) = (-3.4, +3.7); every copy is offset by exactly the reverse. The
 * direction the emote repeats in and the direction the letter cuts in are one
 * line — the step of the spam is the stroke of the Z.
 *
 * The mouth is not the shipped smile. It is wide open and slung to one side,
 * top edge running uphill, because an emote is a reaction and a neutral face
 * is not one.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;

// Rendered eight times on one page; a shared id would apply a neighbour's holes.
const uid = `tw07-${Math.random().toString(36).slice(2, 9)}`;

// diag 4.0 against bar 2.25 — the diagonal carries nearly twice the bar, which
// is the cheapest way to stop a Z looking like it was set rather than drawn.
const Z = { y: 17.4, w: 7.4, h: 8.2, bar: 2.25, diag: 4.0, cap: 'angled' as const };
const zLeft = 12.75;
const zRight = 21.85; // 1.7 of gap; the pair spans 12.75–29.25, centred on 21

// The repeat vector: the reverse of the diagonal (-3.4, +3.7), scaled to 0.94.
const STEP = { x: 3.2, y: -3.5 };

// Wider than tall, tight over the left brow, heavy in the right jaw — a head
// caught mid-reaction, not a circle with two letters put inside it.
const HEAD =
  'M6.4 22.8C6.4 16.8 12.6 13 21 13C30.4 13 36.2 17.6 36.2 26C36.2 33.6 30.4 38.6 21.6 38.6C12.2 38.6 6.4 33.2 6.4 22.8Z';

// Top edge uphill to the right, bottom slung left: a grin, not a smile.
const GRIN =
  'M13.9 28.4L28.3 27.1C28.75 33.4 25 36.7 20.9 36.05C16.6 35.4 13.6 32.6 13.9 28.4Z';

// The head grown by about a unit, used to knock a gap out of the copy behind,
// so three sends stay three sends instead of fusing into one shadowed blob.
const grow = (dx: number, dy: number) =>
  `translate(${dx} ${dy}) translate(21 26) scale(1.068 1.08) translate(-21 -26)`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    {/* The face, drilled through everything. */}
    <mask id={`${uid}f`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      <path d={GRIN} fill="#000" />
    </mask>

    {/* The second send keeps clear of the copy in front of it. */}
    <mask id={`${uid}a`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      <path d={HEAD} transform={grow(0, 0)} fill="#000" />
    </mask>

    {/* The third keeps clear of both. */}
    <mask id={`${uid}b`}>
      <rect x="-20" y="-20" width="88" height="88" fill="#fff" />
      <path d={HEAD} transform={grow(0, 0)} fill="#000" />
      <path d={HEAD} transform={grow(STEP.x, STEP.y)} fill="#000" />
    </mask>
  </defs>

  <g transform="rotate(-5 24 26)">
    <g mask={`url(#${uid}f)`}>
      <g mask={`url(#${uid}b)`}>
        <path
          d={HEAD}
          transform={`translate(${STEP.x * 2} ${STEP.y * 2})`}
          fill={app.light}
          opacity={ground === 'dark' ? 0.58 : 0.72}
        />
      </g>
      <g mask={`url(#${uid}a)`}>
        <path d={HEAD} transform={`translate(${STEP.x} ${STEP.y})`} fill={app.light} />
      </g>
      <path d={HEAD} fill={app.hue} />
    </g>
  </g>
</svg>
