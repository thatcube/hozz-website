---
/**
 * tw07 · Spam — one emote tile and the copy behind it.
 *
 * Nobody sends one emote, so the object is the repeat: two identical cards,
 * the second landing behind and above the first. Cover the face and a stack of
 * two cards is plainly there.
 *
 * The dependency: **the copy is offset along the Z's own diagonal.** The Z
 * turns on a slant of (w - diag) across by (h - 2·bar) down, and that exact
 * vector is where the second card sits — so the direction the spam travels and
 * the stroke the letter turns on are one line. Change the letter's proportions
 * and the stack has to move; move the stack and the echo stops running along
 * the letter. Neither number is typed twice; the offset is computed from Z.
 *
 * The face is bored through the pile — front card, card behind, out the back —
 * so the letters have no fill of their own and hold only the ground.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw07-${Math.random().toString(36).slice(2, 9)}`;

const Z = { y: 15.6, w: 10, h: 12, bar: 2.9, diag: 5, cap: 'angled' as const };

// The letter's diagonal, as a vector: across by RUN, up by RISE.
const RUN = Z.w - Z.diag;
const RISE = Z.h - 2 * Z.bar;

const TILE = 30;
const R = 5.5;
const FRONT = { x: 6.4, y: 12 };
const BACK = { x: FRONT.x + RUN, y: FRONT.y - RISE };

// 10 + 3 + 10 = 23, running 10 to 33, centred in the front card.
const zLeft = 10;
const zRight = 23;

const GRIN =
  'M11.6 31.6C16.4 30 27.4 29.8 31.8 31.4C31.4 36.6 27.2 39.4 21.6 39.4C15.6 39.4 12 36.2 11.6 31.6Z';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      <path d={GRIN} fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <rect x={BACK.x} y={BACK.y} width={TILE} height={TILE} rx={R} fill={app.light} />
    <rect
      x={FRONT.x}
      y={FRONT.y}
      width={TILE}
      height={TILE}
      rx={R}
      fill={ground === 'dark' ? app.hue : app.hue}
    />
  </g>
</svg>
