---
/**
 * p01 · Fold — a screen creased down the middle, and a picture creased with it.
 *
 * The object is a concave panel: two facets meeting at a fold that sits further
 * away than the ends, so the outer edges are the tall ones and the silhouette
 * pinches at the waist. No bezel, no foot, no stand — a sheet with a bend in it.
 *
 * There is one Z on each facet and each lies in that facet's plane, so they
 * lean in opposite directions. The picture continues across the fold, which
 * means the two letters actually overlap in the middle — the lit crease passes
 * in front of them and is the only reason they read as two. Flatten the screen
 * and the opposite leans are nonsense; take the letters away and the fold has
 * nothing to break.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;

// Rendered eight times on one page; a shared clip id clips the wrong mark.
const uid = `p01-${Math.random().toString(36).slice(2, 9)}`;

// Ends 23.6 tall, fold 20 — a sixteen-nine sheet with a bend in it.
const SHELL =
  'M4 11.6Q4 10.2 5.4 10.33L24 12V32L5.4 33.67Q4 33.8 4 32.4Z' +
  'M44 11.6Q44 10.2 42.6 10.33L24 12V32L42.6 33.67Q44 33.8 44 32.4Z';
const RIGHT_FACET = 'M24 12L44 10.2V33.8L24 32Z';

// diag 6.6 against bar 3.2 — the diagonal is more than double the bars, and
// 5.8 of run against 9 of drop keeps it steep enough to read small.
const Z = { y: 13.4, w: 14, h: 16.2, bar: 3.4, diag: 7.2, cap: 'angled' as const };

// The facets slope 1.8 units over 20, which is 5.1 degrees. Each letter takes
// its own facet's slope, about its own centre.
const leanL = 'translate(17.4 21.5) skewY(5.1) translate(-17.4 -21.5)';
const leanR = 'translate(30.6 21.5) skewY(-5.1) translate(-30.6 -21.5)';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={uid}>
      <path d={SHELL} />
    </clipPath>
  </defs>

  {/* Hung, so the only thing under it is its own shadow. */}
  <rect
    x="16"
    y="35.6"
    width="16"
    height="1.2"
    rx="0.6"
    fill={app.deep}
    opacity={ground === 'dark' ? 0.5 : 0.3}
  />

  <g clip-path={`url(#${uid})`}>
    <path d={SHELL} fill={app.hue} />
    {/* The far facet turns away from the light. Depth, from the geometry. */}
    <path d={RIGHT_FACET} fill={app.deep} opacity="0.22" />

    <path d={zPath({ ...Z, x: 10.4 })} fill={app.deep} transform={leanL} />
    <path d={zPath({ ...Z, x: 23.6 })} fill={app.deep} transform={leanR} />

    {/* The crease, in front of both. The letters overlap behind it. */}
    <rect x="23.1" y="12" width="1.8" height="20" fill={app.light} />
  </g>
</svg>
