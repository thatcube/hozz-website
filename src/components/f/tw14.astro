---
/**
 * tw14 · Wheeze — caught mid-laugh, and losing.
 *
 * The family's other marks are level. This one is not: the grin has slipped up
 * at one corner, and the squint above it has gone over with it. The head stays
 * round, so the only thing tilted is the face — which is what leaning looks
 * like on an emote.
 *
 * The dependency: **the squint is canted by exactly the angle the grin is
 * crooked.** LIP holds the two corners of the mouth; TILT is the angle between
 * them, and that same angle sets the whole ZZ pair. Level the grin and the eyes
 * straighten with it; drag one corner higher and they follow. The pair rotates
 * as one unit, so the letters are canted but never distorted — a Z at seven degrees is
 * still a Z, and both are still the same Z.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw14-${Math.random().toString(36).slice(2, 9)}`;

// The two corners of the mouth. The cant of the face follows from these.
const LIP = { x0: 13.2, y0: 32.2, x1: 36.8, y1: 29.2 };
const TILT = (Math.atan2(LIP.y1 - LIP.y0, LIP.x1 - LIP.x0) * 180) / Math.PI;

const Z = { y: 13.4, w: 10, h: 12.8, bar: 3.3, diag: 5.8, cap: 'angled' as const };
const zLeft = 12;
const zRight = 26;

const SKULL =
  'M24 6.8C33.8 6.8 41 14 41 24.4C41 34.8 33.6 42 23.6 42C14 42 7 34.8 7 24.4C7 14 14.2 6.8 24 6.8Z';

const MOUTH =
  `M${LIP.x0} ${LIP.y0}C19 30.2 31.4 27.6 ${LIP.x1} ${LIP.y1}` +
  `C37.2 35.4 31.6 40.2 24.8 40C18.2 39.8 12.7 37.4 ${LIP.x0} ${LIP.y0}Z`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <g transform={`rotate(${TILT} 24 20)`}>
        <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
        <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      </g>
      <path d={MOUTH} fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <path d={SKULL} fill={ground === 'dark' ? app.hue : app.hue} />
  </g>
</svg>
