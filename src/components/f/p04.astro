---
/**
 * p04 · Play cleave
 *
 * A triangular playhead travelling along a short transport rail. The first
 * switchback opens into its square tail and the second opens into its raked
 * nose, so the playhead supplies the pair's outer terminals.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p04-${Math.random().toString(36).slice(2, 9)}`;

const Z_LEFT = {
  x: 11.3,
  y: 17.8,
  w: 9.4,
  h: 12.4,
  bar: 2.6,
  diag: 5.4,
  cap: 'angled' as const,
};
const Z_RIGHT = {
  x: 23.3,
  y: 17.8,
  w: 9.4,
  h: 12.4,
  bar: 2.6,
  diag: 5.4,
  cap: 'angled' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} play cleave mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath(Z_LEFT)} fill="#000" />
      <path d={zPath(Z_RIGHT)} fill="#000" />
      <rect x="8" y="17.8" width="4.5" height="2.6" fill="#000" />
      <rect x="8" y="27.6" width="4.5" height="2.6" fill="#000" />
      <rect x="32.2" y="17.8" width="4.5" height="2.6" fill="#000" />
      <rect x="32.2" y="27.6" width="4.5" height="2.6" fill="#000" />
    </mask>
  </defs>

  <path d="M4 24H12" stroke={app.deep} stroke-width="4" stroke-linecap="round" />
  <circle cx="4.5" cy="24" r="3" fill={app.deep} />

  <g mask={`url(#${uid})`}>
    <path d="M8 4L45 24L8 44Z" fill={app.deep} />
    <path d="M8 6.5L42.5 24L8 41.5Z" fill={app.hue} />
    <path
      d="M8 6.5L42.5 24L38.6 26L8 10Z"
      fill={ground === 'dark' ? app.light : app.light}
      opacity="0.72"
    />
  </g>
</svg>
