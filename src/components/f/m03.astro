---
/**
 * m03 · Rake — a record turned away from you.
 *
 * The dependency: **the turn squashes the letters by exactly what it squashes
 * the disc by.** The cut lies in the record's surface, so it takes the same
 * 0.72 the rim does — the proof is the spindle, which is an oval for the same
 * reason. Stand the letters upright and the record would have to stand up with
 * them.
 *
 * The cut is confined to the top face, so the record's outline stays whole:
 * cover the letters and an unbroken oval with a thickness under it is left.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const uid = `m03-${Math.random().toString(36).slice(2, 9)}`;

const CY = 22.4;
const RX = 19;
const K = 0.72; // what the turn takes out of every vertical
const RY = RX * K;
const EDGE = 1.8; // the record's thickness, the one shading step
// In shadow against paper, catching the light against black; either way it is
// what stops the lens reading as a flat hoop.
const EDGE_FILL = ground === 'dark' ? app.light : app.deep;

// Drawn upright at 20 tall, then squashed with the surface it is cut into.
const GAP = 7; // wider than the hole on purpose: the spacing is not its job
const Z = {
  y: CY - 8 / K,
  w: 11,
  h: 16 / K,
  bar: 3 / K,
  diag: 5.4, // horizontal, so the turn leaves it alone
  cap: 'angled' as const,
};
const zLeft = 24 - GAP / 2 - Z.w;
const zRight = 24 + GAP / 2;
const squash = `translate(0 ${CY}) scale(1 ${K}) translate(0 ${-CY})`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={`${uid}-face`}>
      <ellipse cx="24" cy={CY} rx={RX} ry={RY} />
    </clipPath>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      {/* Cut into the surface only, so the rim survives it. */}
      <g clip-path={`url(#${uid}-face)`} transform={squash}>
        <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
        <path d={zPath({ ...Z, x: zRight })} fill="#000" />
      </g>
      <ellipse cx="24" cy={CY} rx="1.6" ry={1.6 * K} fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <ellipse cx="24" cy={CY + EDGE} rx={RX} ry={RY} fill={EDGE_FILL} />
    <ellipse cx="24" cy={CY} rx={RX} ry={RY} fill={app.hue} />
  </g>
</svg>
