---
/**
 * tw08 · Howl — a head mid-laugh, eyes squeezed shut.
 *
 * An emote is a reaction, and the loudest reaction there is folds the eyes
 * away: laugh hard enough and the eye stops being a shape and becomes a
 * crease. That crease *is* the Z here — not a letter laid over a face but the
 * fold the face makes while doing the one thing it exists to do.
 *
 * The head is squashed wider than it is tall and tipped back, and the creases
 * take their measure from it: their length is the skull's own chord at brow
 * height, so both top bars run past the box on `open` caps and are cut off by
 * the head's edge. The head decides where the letters stop.
 *
 * The mouth is the whole lower half of the face, open, upper teeth showing.
 * Two Zs with no mouth read as asleep; this one could not be asleep if it
 * tried.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;

const uid = `tw08-${Math.random().toString(36).slice(2, 9)}`;

// 33 across by 28 down. Laughter squashes a head, and the creases inherit it:
// bar 2.3 against diag 4.2, so the fold's turn carries nearly twice its own line.
// Each crease is set wider than the skull at brow height, so the head's own
// contour is what decides where the letter stops.
const HEAD =
  'M7.5 25C7.5 17.2 14.4 12 24.4 12C34.4 12 40.5 17.6 40.5 26.4C40.5 34.8 34 40 24 40C14 40 7.5 34.4 7.5 25Z';

const Z = { y: 14.8, w: 9.8, h: 9.4, bar: 2.3, diag: 4.2, cap: 'angled' as const };
const zLeft = 10;
const zRight = 28.2; // 8.4 of clear cheek; both outer ends land past the skull and are trimmed

// The howl. Its floor sits a unit and a half inside the jaw, which is what
// makes the face look like it is barely containing the noise.
const MOUTH =
  'M13.6 28.2C18.5 26.6 30.5 26.4 34.8 28C34.4 34.6 30 38.6 24 38.6C17.6 38.6 14 34.4 13.6 28.2Z';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={`${uid}h`}>
      <path d={HEAD} />
    </clipPath>
    {/* The teeth are trimmed by the mouth, so the lip line is always the mouth's. */}
    <clipPath id={`${uid}m`}>
      <path d={MOUTH} />
    </clipPath>
  </defs>

  <g transform="rotate(-9 24 26)">
    <path d={HEAD} fill={app.hue} />
    <path d={MOUTH} fill={app.deep} />
    <g clip-path={`url(#${uid}m)`}>
      <rect x="13" y="25.6" width="23" height="3.4" fill={app.light} />
    </g>
    <g clip-path={`url(#${uid}h)`}>
      <path d={zPath({ ...Z, x: zLeft })} fill={app.deep} />
      <path d={zPath({ ...Z, x: zRight })} fill={app.deep} />
    </g>
  </g>
</svg>
