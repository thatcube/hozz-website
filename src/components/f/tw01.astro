---
/**
 * tw01 · Spout — a bubble, and the ZZ cut clean through it.
 *
 * One dependency, and it is the only thing holding the concept up: **the tail
 * is the gap between the two Zs.** The bubble's single defining feature — the
 * thing that makes it a bubble rather than a rounded box — starts exactly where
 * the left Z ends and finishes exactly where the right Z begins, so the pair
 * sets the letterspacing and the letterspacing sets the tail. Slide the letters
 * apart and the tail widens with them; close them up and the bubble loses its
 * point.
 *
 * That is the whole object: one outline, one fill, no highlight, no keyline.
 * The corner radius is generous at the top and tight at the bottom, which is
 * how a bubble is drawn by hand and where its character comes from.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.twozz;
const uid = `tw01-${Math.random().toString(36).slice(2, 9)}`;

/** 13.4 + 7 + 13.4 = 33.8, running 7.1 to 40.9, centred on 24. Flat caps, so
 *  the channel between the pair is a true vertical 7 units wide. */
const Z = { y: 12, w: 13.4, h: 17, bar: 3.6, diag: 6.2, cap: 'flat' as const };
const zLeft = 7.1;
const zRight = 27.5;

const gapL = zLeft + Z.w; // 20.5
const gapR = zRight; //      27.5

/** Body 4–44 by 8–34, soft over the top, firm underneath, and the tail hung
 *  off the bottom edge across exactly the width of the gap. */
const BODY = [
  'M13 8',
  'H35',
  'A9 9 0 0 1 44 17',
  'V29',
  'A5 5 0 0 1 39 34',
  `H${gapR}`,
  'L24 40.2',
  `L${gapL} 34`,
  'H9',
  'A5 5 0 0 1 4 29',
  'V17',
  'A9 9 0 0 1 13 8',
  'Z',
].join(' ');
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: zLeft })} fill="#000" />
      <path d={zPath({ ...Z, x: zRight })} fill="#000" />
    </mask>
  </defs>

  <path d={BODY} fill={app.hue} mask={`url(#${uid})`} />
</svg>
