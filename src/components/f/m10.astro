---
/**
 * m10 · Flag Aperture
 *
 * One unmistakable note silhouette carries one broad flag. The two Zs are
 * complete holes through that working flag, with no stroke fragments or texture.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.mozz;
const uid = `m10-${Math.random().toString(36).slice(2, 9)}`;
const Z = { y: 12, w: 10.8, h: 11.5, bar: 3, diag: 5.6, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} note flag aperture mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 17.5 })} fill="#000" />
      <path d={zPath({ ...Z, x: 30.5 })} fill="#000" />
    </mask>
  </defs>

  <rect x="13" y="8" width="3" height="29" rx="1.5" fill={app.deep} />
  <ellipse
    cx="10.8"
    cy="37"
    rx="5"
    ry="3"
    transform="rotate(-18 10.8 37)"
    fill={app.deep}
  />
  <g mask={`url(#${uid})`}>
    <path
      d="M13 8H38C42.6 8 45 10.8 43.3 15L40 26.7C39.3 29.2 36.8 30.2 33.8 28.8L13 25Z"
      fill={app.hue}
    />
    <path d="M28.35 8H30.6L29.6 27L28.2 25Z" fill={app.deep} opacity="0.55" />
  </g>
</svg>
