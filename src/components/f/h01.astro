---
/**
 * h01 · Manifold — one feed in, two tanks, and the ZZ is what settles in them.
 *
 * A single port at the top runs into a header pipe, which drops through two
 * short down-pipes into two standing tanks. Inside each tank the contents are
 * not a plain block: the surface runs across, folds down, and returns along the
 * floor, so the Z *is* what is being kept. Both of its bars are cut off flat by
 * the tank walls — `cap: 'open'`, then clipped to the tank interior — which is
 * why the letter cannot be lifted out. Its terminals belong to the vessel.
 *
 * One feed arriving at two tanks standing at the same level is the whole Hozz
 * argument in a picture: one export, more than one destination, both of them
 * yours, and you can see how much is in each.
 *
 * Reading: letters. The pair sits low under a tall headspace, inside two
 * separate containers, so it reads as contents rather than as a face.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;

// Rendered eight times on one board; a shared clip id would clip the wrong one.
const uid = `h01-${Math.random().toString(36).slice(2, 9)}`;

const TANK = { y: 15.4, w: 14.8, h: 27.6, r: 3.2 };
const tL = 7.6;
const tR = 25.6;

// Walls 1.1, floor at 41.9. The interiors are what the letters are clipped to.
const IN = { y: 16.5, w: 12.6, bottom: 41.9 };
const inL = 8.7;
const inR = 26.7;

// Fill at 27.4, floor at 41.9. diag 5.2 against bar 3.2 — the fold is heavier
// than the surface, which is the cheapest way to stop looking like type.
const FILL = 27.4;
const Z = {
  y: FILL,
  w: IN.w,
  h: IN.bottom - FILL,
  bar: 3.2,
  diag: 5.2,
  cap: 'open' as const,
};

const weld = ground === 'dark' ? 0.8 : 0.6;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} mark`}
>
  <defs>
    <clipPath id={`${uid}-c`}>
      <rect x={inL} y={IN.y} width={IN.w} height={IN.bottom - IN.y} />
      <rect x={inR} y={IN.y} width={IN.w} height={IN.bottom - IN.y} />
    </clipPath>
  </defs>

  {/* One flanged port in, the header that carries it, two drops out. */}
  <rect x="20.6" y="4.2" width="6.8" height="1.8" rx="0.9" fill={app.deep} />
  <rect x="22.6" y="6" width="2.8" height="3" fill={app.deep} />
  <rect x="6" y="8.6" width="36" height="4.2" rx="2.1" fill={app.deep} />
  <rect x="13.2" y="12.6" width="3.6" height="3.4" fill={app.deep} />
  <rect x="31.2" y="12.6" width="3.6" height="3.4" fill={app.deep} />

  <rect
    x={tL}
    y={TANK.y}
    width={TANK.w}
    height={TANK.h}
    rx={TANK.r}
    fill={app.hue}
  />
  <rect
    x={tR}
    y={TANK.y}
    width={TANK.w}
    height={TANK.h}
    rx={TANK.r}
    fill={app.hue}
  />

  <g clip-path={`url(#${uid}-c)`}>
    <path d={zPath({ ...Z, x: inL })} fill={app.light} />
    <path d={zPath({ ...Z, x: inR })} fill={app.light} />
  </g>

  {/* The seam where each tank is closed. */}
  <rect x={tL} y="16" width={TANK.w} height="1" fill={app.deep} opacity={weld} />
  <rect x={tR} y="16" width={TANK.w} height="1" fill={app.deep} opacity={weld} />
</svg>
