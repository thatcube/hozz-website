---
/**
 * h11 · Die-cut Folio
 *
 * The cover is one bound edge around one visible page block. The knockout lives
 * only in that page block: thin the pages and the letters crop; remove them and
 * the letters disappear while the cover remains.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const uid = `h11-${Math.random().toString(36).slice(2, 9)}`;
const page = ground === 'dark' ? app.light : app.hue;
const Z = { y: 16, w: 11.5, h: 15, bar: 3, diag: 5.8, cap: 'angled' as const };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} die-cut folio mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 10 })} fill="#000" />
      <path d={zPath({ ...Z, x: 26.5 })} fill="#000" />
    </mask>
  </defs>

  {/* One continuous cover: top, rounded binding edge and bottom. */}
  <path
    d="M7 9H45V13H8Q6 13 6 15V33Q6 35 8 35H45V39H7Q3 39 3 35V13Q3 9 7 9Z"
    fill={app.deep}
  />
  {/* Only the pages carry the knockout. */}
  <path
    d="M8 13H44V35H8Q6 35 6 33V15Q6 13 8 13Z"
    fill={page}
    mask={`url(#${uid})`}
  />
</svg>
