---
/**
 * h11 · Bound Edges
 *
 * A closed folio seen from its fore-edge: two adjacent signatures share one
 * field, while their bowed covers and heavy page cuts make the paired profile.
 */
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.hozz;
const pages = ground === 'dark' ? app.light : app.deep;
const uid = `h11-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} bound-folio mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <circle cx="6.5" cy="24" r="2.1" fill="#000" />
    </mask>
  </defs>
  <g mask={`url(#${uid})`}>
    <path
      d="M5 10Q14 8.5 23 10V14Q14 12.5 8 14V34Q14 35.5 23 34V38Q14 36.5 5 38Z"
      fill={app.hue}
    />
    <path
      d="M25 10Q34 8.5 43 10V14Q34 12.5 25 14Z
         M25 34Q34 35.5 43 34V38Q34 36.5 25 38Z"
      fill={app.hue}
    />
    <path d="M18 12H23.5L13 36H7.5Z" fill={pages} />
    <path d="M38 12H43.5L33 36H27.5Z" fill={pages} />
  </g>
</svg>
