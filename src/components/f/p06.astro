---
/**
 * p06 · Jog wheel
 *
 * A bare shuttle dial with the pair and its lock slot punched through the
 * working face. The slot keeps the intentional eyes reading awake.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p06-${Math.random().toString(36).slice(2, 9)}`;
const Z = {
  y: 13,
  w: 10.5,
  h: 15,
  bar: 3.2,
  diag: 5.8,
  cap: 'angled' as const,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} jog wheel mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 10.5 })} fill="#000" />
      <path d={zPath({ ...Z, x: 27 })} fill="#000" />
      <rect x="19.5" y="32" width="9" height="2.6" rx="1.3" fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <circle cx="24" cy="24" r="21" fill={app.deep} />
    <circle cx="24" cy="24" r="17.5" fill={app.hue} />
  </g>
</svg>
