---
/**
 * p06 · Shuttle slots
 *
 * A jog wheel with two open-ended grip slots cut through its face. The Z bars
 * meet the wheel's rim and the lower lock slot keeps the face reading awake.
 */
import { zPath } from '../../data/zstroke';
import { APP_BY_KEY } from '../../data/brand';

interface Props {
  size?: number;
  ground?: 'light' | 'dark';
}
const { size = 96, ground = 'light' } = Astro.props as Props;
const app = APP_BY_KEY.plozz;
const uid = `p06-${Math.random().toString(36).slice(2, 9)}`;

const Z = {
  y: 12.2,
  w: 11.2,
  h: 16.8,
  bar: 3,
  diag: 5.8,
  cap: 'angled' as const,
  round: 0.5,
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={`${app.name} shuttle wheel mark`}
>
  <defs>
    <mask id={uid}>
      <rect width="48" height="48" fill="#fff" />
      <path d={zPath({ ...Z, x: 10.2 })} fill="#000" />
      <path d={zPath({ ...Z, x: 26.6 })} fill="#000" />
      <rect x="18.5" y="33" width="11" height="2.8" rx="1.4" fill="#000" />
    </mask>
  </defs>

  <g mask={`url(#${uid})`}>
    <circle cx="24" cy="24" r="21" fill={app.deep} />
    <circle cx="24" cy="24" r="17.5" fill={app.hue} />
    <path
      d="M8.3 14.2A18.8 18.8 0 0 1 37.7 11.5L34.8 14.1A15 15 0 0 0 11.4 16.3Z"
      fill={ground === 'dark' ? app.light : app.light}
      opacity="0.78"
    />
  </g>

  <g fill={app.deep}>
    <path d="M21.8 2.2H26.2L25.6 6H22.4Z" />
    <path d="M21.8 45.8H26.2L25.6 42H22.4Z" />
    <path d="M2.2 21.8V26.2L6 25.6V22.4Z" />
    <path d="M45.8 21.8V26.2L42 25.6V22.4Z" />
    <path d="M7.2 6L10.3 2.9L12.5 6L10.3 8.2Z" />
    <path d="M40.8 6L37.7 2.9L35.5 6L37.7 8.2Z" />
    <path d="M7.2 42L10.3 45.1L12.5 42L10.3 39.8Z" />
    <path d="M40.8 42L37.7 45.1L35.5 42L37.7 39.8Z" />
  </g>
</svg>
