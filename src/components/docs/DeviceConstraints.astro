---
/**
 * The three iOS facts that decide whether an automatic destination appears to
 * work, repeated on every destination page.
 *
 * Repeating this is deliberate. Someone setting up MQTT reads the MQTT page
 * and nothing else, and "your export did not run" is the most common
 * disappointment in this category of app. A link they will not follow is not
 * an explanation.
 */
import Callout from './Callout.astro';
---

<Callout kind="warn" title="iOS controls background timing">
  <ul>
    <li>
      Health may be unreadable while the phone is locked.
    </li>
    <li>
      A cadence is a request. Most Health types are capped near hourly.
    </li>
    <li>
      Force-quitting Hozz stops background launches until you reopen it.
    </li>
  </ul>
  <p><a href="/docs/background-sync/">Background sync details.</a></p>
</Callout>
