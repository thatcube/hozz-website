---
/**
 * "The Open Current" — the selected direction, promoted to the homepage.
 *
 * Lives here rather than in a page so that `/` and `/w/w12/` render one
 * source and cannot drift apart. The style block is `is:global` and carries
 * its own @font-face set, so this component deliberately does NOT go through
 * Layout.astro — two global stylesheets would fight.
 */
import '../../styles/foundation.css';
import Mark from '../mark/logos/c45.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  CATEGORIES,
  STREAM_LANES,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
  SIBLINGS,
} from '../../data/site';

const hueByCategory = Object.fromEntries(CATEGORIES.map((category) => [category.key, category.hue]));

const heroRecords = [
  { ...STREAM_LANES[0][0], x: 22, y: 18, scale: 1.06, delay: -1.2 },
  { ...STREAM_LANES[0][2], x: 53, y: 7, scale: 0.76, delay: -4.8 },
  { ...STREAM_LANES[1][0], x: 86, y: 22, scale: 0.9, delay: -7.1 },
  { ...STREAM_LANES[0][3], x: 18, y: 48, scale: 0.78, delay: -3.4 },
  { ...STREAM_LANES[0][4], x: 88, y: 53, scale: 0.72, delay: -5.6 },
  { ...STREAM_LANES[3][4], x: 25, y: 76, scale: 1, delay: -8.4 },
  { ...STREAM_LANES[2][0], x: 52, y: 90, scale: 0.78, delay: -2.6 },
  { ...STREAM_LANES[2][1], x: 83, y: 84, scale: 1.08, delay: -6.2 },
];

const categorySamples = CATEGORIES.map((category) => ({
  ...category,
  sample: STREAM_LANES.flat().find((record) => record.category === category.key),
}));
---

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="#top" aria-label="Hozz, back to top">
          <Mark size={30} />
          <span>Hozz</span>
        </a>
        <nav aria-label="Main">
          <a href="#data">What it reads</a>
          <a href="#destinations">Destinations</a>
          <a href="#formats">Formats</a>
          <a href="#how">How it works</a>
          <a href="#status">Status</a>
          <a href="/docs/" class="header-docs">Docs</a>
        </nav>
        <a class="header-source" href={GITHUB_URL}>Source ↗</a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Apple Health export · free and open source</p>
            <h1 id="hero-title">Your data,<br /><em>out in the open.</em></h1>
            <p class="hero-lede">
              Hozz carries your Apple Health records from your iPhone to places
              you own — your Mac, a folder, your dashboard, database, endpoint,
              or broker.
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#how">See how it moves</a>
              <a class="button button-quiet" href={GITHUB_URL}>Inspect the source</a>
            </div>
            <p class="hero-note">
              No account. No subscription. No Hozz cloud. Nothing leaves until
              you add a destination and confirm it.
            </p>
          </div>

          <figure class="record-field" aria-labelledby="record-caption">
            <div class="landscape-field" aria-hidden="true">
              <svg class="current-lines" viewBox="0 0 700 700" preserveAspectRatio="none">
                <defs>
                  <radialGradient id="w12-lens-glow">
                    <stop offset="0" stop-color="#ffffff" stop-opacity="0.96" />
                    <stop offset="0.42" stop-color="#cae1f1" stop-opacity="0.42" />
                    <stop offset="1" stop-color="#96c2e0" stop-opacity="0" />
                  </radialGradient>
                </defs>
                <circle cx="350" cy="350" r="174" fill="url(#w12-lens-glow)" />
                <ellipse cx="350" cy="350" rx="238" ry="218" />
                <ellipse class="inner-line" cx="350" cy="350" rx="145" ry="132" />
                <path d="M350 350 C310 285 235 190 154 126" />
                <path class="faint-line" d="M350 350 C360 245 372 140 371 49" />
                <path d="M350 350 C420 310 515 220 602 154" />
                <path class="faint-line" d="M350 350 C275 335 205 325 126 336" />
                <path class="faint-line" d="M350 350 C445 340 525 370 616 371" />
                <path d="M350 350 C290 405 230 470 175 532" />
                <path class="faint-line" d="M350 350 C350 445 370 540 364 630" />
                <path d="M350 350 C430 420 515 520 581 588" />
              </svg>

              <div class="source-orb">
                <span class="source-halo"></span>
                <Mark size={88} />
                <span class="source-label">Apple Health<br /><b>on your iPhone</b></span>
              </div>

              {
                heroRecords.map((record, index) => (
                  <div
                    class="record-card"
                    style={`--x:${record.x}%;--y:${record.y}%;--scale:${record.scale};--delay:${record.delay}s;--cat:${hueByCategory[record.category]};--z:${index % 3};`}
                  >
                    <span class="record-category">{record.category}</span>
                    <code>{record.id}</code>
                    <strong>{record.sample}</strong>
                  </div>
                ))
              }
            </div>

            <div class="portrait-field" aria-hidden="true">
              <svg class="portrait-lines" viewBox="0 0 360 700" preserveAspectRatio="none">
                <path d="M180 344 C70 260 63 139 121 20" />
                <path d="M180 344 C292 258 299 135 244 18" />
                <path d="M180 344 C60 428 58 552 122 685" />
                <path d="M180 344 C300 433 294 562 232 690" />
                <ellipse cx="180" cy="344" rx="104" ry="145" />
              </svg>

              <div class="source-orb portrait-source">
                <span class="source-halo"></span>
                <Mark size={72} />
                <span class="source-label">Apple Health<br /><b>on your iPhone</b></span>
              </div>

              {
                heroRecords.slice(0, 7).map((record, index) => (
                  <div
                    class={`portrait-card portrait-card-${index + 1}`}
                    style={`--delay:${record.delay}s;--cat:${hueByCategory[record.category]};`}
                  >
                    <span class="record-category">{record.category}</span>
                    <code>{record.id}</code>
                    <strong>{record.sample}</strong>
                  </div>
                ))
              }
            </div>

            <ul class="sr-only">
              {
                heroRecords.map((record) => (
                  <li>
                    Example {record.category} record: {record.id}, {record.sample}.
                  </li>
                ))
              }
            </ul>
            <figcaption id="record-caption">
              Real HealthKit identifiers with example readings. The lines trace
              every record back to its source; the colours name its category.
            </figcaption>
          </figure>
        </div>
      </section>

      <aside class="truth-band" aria-label="Hozz privacy conditions">
        <div class="shell truth-inner">
          <p>
            <strong>Your data is the interface.</strong> Every label is a real
            HealthKit identifier with an example reading, so the page needs
            neither an invented dashboard nor abstract particles.
          </p>
          <ul>
            <li>on-device source</li>
            <li>user-chosen route</li>
            <li>open output</li>
          </ul>
        </div>
      </aside>

      <section class="section data-section" id="data" aria-labelledby="data-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">What Hozz can read</p>
              <h2 id="data-title">Not a health score.<br />The <em>records themselves.</em></h2>
            </div>
            <p class="section-lede">
              Hozz keeps HealthKit’s real type names intact. Each example below
              is drawn from the data the app handles; the reading beside it is
              an example, never a claim about a person.
            </p>
          </div>

          <ul class="category-grid">
            {
              categorySamples.map((category) => (
                <li style={`--cat:${category.hue};`}>
                  <div class="category-top">
                    <span class="category-dot"></span>
                    <span>{category.label}</span>
                  </div>
                  {category.sample && (
                    <div class="category-record">
                      <code>{category.sample.id}</code>
                      <strong>{category.sample.sample}</strong>
                    </div>
                  )}
                  <p>{category.note}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section destinations-section" id="destinations" aria-labelledby="destinations-title">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow">Six destinations · no middleman</p>
            <h2 id="destinations-title">Let each record<br /><em>land where you choose.</em></h2>
            <p class="section-lede">
              Every route ends at somewhere you control. Each destination keeps
              its own Health types, schedule, and place in the queue.
            </p>
          </div>

          <ul class="destination-grid">
            {
              DESTINATIONS.map((destination) => (
                <li style={`--cat:${hueByCategory[destination.category]};`}>
                  <span class="destination-line" aria-hidden="true"></span>
                  <h3>{destination.title}</h3>
                  <p>{destination.body}</p>
                  <code>{destination.fact}</code>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section formats-section" id="formats" aria-labelledby="formats-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">Seven open forms</p>
              <h2 id="formats-title">Useful now.<br /><em>Readable later.</em></h2>
            </div>
            <p class="section-lede">
              Pick the shape the next tool needs. Hozz says when a format keeps
              every field and when it deliberately leaves detail behind.
            </p>
          </div>

          <div class="formats-wrap">
            <table>
              <caption>Export formats, their uses, and what each retains</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">Good for</th>
                  <th scope="col">Fidelity</th>
                </tr>
              </thead>
              <tbody>
                {
                  FORMATS.map((format) => (
                    <tr>
                      <th scope="row">{format.name}</th>
                      <td>{format.use}</td>
                      <td>{format.note}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section how-section" id="how" aria-labelledby="how-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">How to export Apple Health data</p>
              <h2 id="how-title">One source.<br /><em>Three choices.</em></h2>
            </div>
            <p class="section-lede">
              Nothing starts in secret. You choose a destination, choose what it
              receives, and choose when it runs.
            </p>
          </div>

          <ol class="steps">
            {
              STEPS.map((step, index) => (
                <li style={`--cat:${hueByCategory[step.category]};`}>
                  <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="step-current" aria-hidden="true"></span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="privacy-note">
            <Mark size={56} />
            <p>
              <strong>Nothing leaves your phone until you add a destination and confirm it.</strong>
              Hozz has no default destination and no hosted relay to receive a copy.
            </p>
          </div>
        </div>
      </section>

      <section class="section durability-section" id="honest" aria-labelledby="durability-title">
        <div class="shell">
          <div class="section-heading">
            <p class="eyebrow">A current that keeps its place</p>
            <h2 id="durability-title">Interrupted,<br /><em>never quietly skipped.</em></h2>
            <p class="section-lede">
              Each Health type advances only after its records are durably staged.
              An interruption can repeat work; it cannot skip records.
            </p>
          </div>

          <div class="durability-grid">
            <ul>
              {
                DURABILITY.map((item) => (
                  <li>
                    <code>{item.fact}</code>
                    <h3>{item.title}</h3>
                    <p>{item.body}</p>
                  </li>
                ))
              }
            </ul>

            <aside class="honesty-card">
              <p class="eyebrow">No false certainty</p>
              <h3>Hozz reports the state Apple actually gives it.</h3>
              <p>
                There is no invented progress percentage. Health will not reveal
                a total without reading every record first.
              </p>
              <dl>
                {
                  COVERAGE_STATES.map((item) => (
                    <div>
                      <dt><span class={`state state-${item.tone}`}></span>{item.state}</dt>
                      <dd>{item.body}</dd>
                    </div>
                  ))
                }
              </dl>
            </aside>
          </div>
        </div>
      </section>

      <section class="section promises-section" aria-labelledby="promises-title">
        <div class="shell">
          <div class="section-heading split-heading">
            <div>
              <p class="eyebrow">Private by construction</p>
              <h2 id="promises-title">The clearest promises<br />start with <em>no.</em></h2>
            </div>
            <p class="section-lede">
              Hozz’s privacy story is not a policy wrapped around a service. It
              is the absence of the service that would collect your data.
            </p>
          </div>
          <ul class="promise-grid">
            {
              PROMISES.map((promise) => (
                <li>
                  <span aria-hidden="true">—</span>
                  <div>
                    <h3>{promise.title}</h3>
                    <p>{promise.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="never-write">
            Hozz will never write anything back into Apple Health. Re-importing
            would erase where a record came from and could silently create duplicates.
          </p>
        </div>
      </section>

      <section class="section status-section" id="status" aria-labelledby="status-title">
        <div class="shell">
          <div class="status-heading">
            <div>
              <p class="eyebrow">Project state · early alpha</p>
              <h2 id="status-title">Working now.<br /><em>Coverage is partial.</em></h2>
            </div>
            <p>
              Hozz is not in the App Store yet. One developer is building it in
              the open, and the repository is available now.
            </p>
          </div>
          <div class="status-columns">
            <article>
              <h3><span class="status-light working"></span>Working today</h3>
              <ul>{WORKING.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <h3><span class="status-light pending"></span>Not yet</h3>
              <ul>{NOT_YET.map((item) => <li>{item}</li>)}</ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section faq-section" aria-labelledby="faq-title">
        <div class="shell faq-grid">
          <div class="section-heading">
            <p class="eyebrow">Plain answers</p>
            <h2 id="faq-title">Before you trust<br /><em>the current.</em></h2>
          </div>
          <div class="faq-list">
            {
              FAQ.map((item) => (
                <details>
                  <summary>{item.q}<span aria-hidden="true">+</span></summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing-glow" aria-hidden="true"></div>
        <div class="shell closing-inner">
          <Mark size={82} />
          <p class="eyebrow">Free forever · open source</p>
          <h2 id="closing-title">Your history.<br /><em>Your place to keep it.</em></h2>
          <p>
            Hozz is open source so you can read how it works before trusting it
            with anything.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href={GITHUB_URL}>Open the repository ↗</a>
            <a class="button button-quiet" href={DONATE_URL}>Sponsor the work</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-grid">
        <div>
          <a class="brand" href="#top"><Mark size={26} /><span>Hozz</span></a>
          <p>Apple Health export, without a middleman. Built by Brandon Moore.</p>
        </div>
        <div>
          <h2>Project</h2>
          <a href="/docs/">Documentation</a>
          <a href={GITHUB_URL}>Source</a>
          <a href={LICENSE_URL}>GPL-3.0 licence</a>
          <a href="/privacy/">Privacy</a>
        </div>
        <div>
          <h2>Also by Brandon</h2>
          {SIBLINGS.map((sibling) => <a href={sibling.href}>{sibling.name} — {sibling.body}</a>)}
        </div>
      </div>
      <div class="shell footer-base">
        <span>No cookies, analytics, storage, or third-party requests.</span>
        <code>early alpha</code>
      </div>
    </footer>

<style is:global>
  /* Typefaces and palette tokens live in src/styles/foundation.css, imported
     above, so the documentation renders in exactly this design rather than a
     second copy of it. Everything below is specific to this page. */


  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--air);
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--air);
    color: var(--ink);
    font-family: 'General Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.62;
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 1px;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 4px;
    border-radius: 4px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--ink);
    font-family: 'Sentient', Georgia, serif;
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  h1 em,
  h2 em {
    color: #355f80;
    font-weight: 400;
  }

  code,
  .eyebrow,
  .step-number,
  footer h2 {
    font-family: 'IBM Plex Mono', monospace;
  }

  .shell {
    width: min(100% - var(--gutter) * 2, var(--max));
    margin-inline: auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    background: var(--ink);
    color: white;
    transform: translateY(-180%);
  }

  .skip-link:focus {
    transform: none;
  }

  .site-header {
    position: absolute;
    z-index: 20;
    inset: 0 0 auto;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 5rem;
    border-bottom: 1px solid rgba(93, 140, 176, 0.22);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    color: var(--ink);
    font-family: 'Sentient', Georgia, serif;
    font-size: 1.32rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .header-inner nav {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .header-inner nav a,
  .header-source {
    text-decoration: none;
  }

  .header-inner nav a:hover,
  .header-source:hover {
    text-decoration: underline;
  }

  .header-source {
    justify-self: end;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero {
    position: relative;
    min-height: 58rem;
    padding: 8.5rem 0 5rem;
    overflow: hidden;
    isolation: isolate;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 251, 253, 0.82) 43%, rgba(220, 236, 246, 0.42) 100%),
      var(--air);
  }

  /* The glow box used to begin hard at 38%, and 14px of blur could not hide a
     box edge that size — it read as a seam down the middle of the hero. It now
     starts at 20% and dissolves across a mask ramp instead. The gradient origins
     moved 48% → 58% to compensate for the wider box, so the light still lands
     in exactly the same place on the page. */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -2;
    inset: -15% -12% 0 20%;
    background:
      radial-gradient(ellipse at 58% 44%, rgba(255, 255, 255, 0.94) 0 9%, transparent 38%),
      conic-gradient(
        from 205deg at 58% 44%,
        rgba(237, 246, 252, 0) 0deg,
        rgba(202, 225, 241, 0.55) 29deg,
        rgba(255, 255, 255, 0) 58deg,
        rgba(185, 215, 235, 0.4) 90deg,
        rgba(255, 255, 255, 0) 124deg
      );
    filter: blur(22px);
    transform: rotate(-8deg);
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.18) 18%,
      rgba(0, 0, 0, 0.55) 34%,
      rgba(0, 0, 0, 0.85) 45%,
      #000 56%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.18) 18%,
      rgba(0, 0, 0, 0.55) 34%,
      rgba(0, 0, 0, 0.85) 45%,
      #000 56%
    );
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    width: 46rem;
    height: 46rem;
    top: 18%;
    right: 6%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.92), rgba(202, 225, 241, 0.28) 45%, transparent 72%);
    filter: blur(6px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.72fr) minmax(35rem, 1.28fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: center;
  }

  .hero-copy {
    position: relative;
    z-index: 4;
    padding-block: 4rem;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1.25rem;
    color: var(--ink-muted);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.115em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
    box-shadow: 0 0 0 5px rgba(93, 140, 176, 0.1);
  }

  .hero h1 {
    max-width: 9ch;
    margin-bottom: 1.8rem;
    font-size: clamp(4.4rem, 6.5vw, 7.4rem);
