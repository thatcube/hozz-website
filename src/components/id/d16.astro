---
/** 16 · River — a linked ZZ is the background channel dividing two broad forms. */
import { APP_BY_KEY, type AppKey } from '../../data/brand';

interface Props {
  app: AppKey;
  size?: number;
}

const { app, size = 96 } = Astro.props;
const a = APP_BY_KEY[app];
const gradientId = `g-d16-${app}`;
const maskId = `m-d16-${app}`;
---

<svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label={`${a.name} mark`} style="display:block">
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={a.light} />
      <stop offset="0.78" stop-color={a.hue} />
      <stop offset="1" stop-color={a.deep} />
    </linearGradient>
    <mask id={maskId}>
      <rect width="64" height="64" fill="#000" />
      <path d="M13 7h38c3.3 0 6 2.7 6 6v38c0 3.3-2.7 6-6 6H13c-3.3 0-6-2.7-6-6V13c0-3.3 2.7-6 6-6Z" fill="#fff" />
      <path
        d="M5 19h27L17 31h18L21 44h38"
        fill="none"
        stroke="#000"
        stroke-width="6"
        stroke-linecap="square"
        stroke-linejoin="round"
      />
    </mask>
  </defs>
  <path
    d="M13 7h38c3.3 0 6 2.7 6 6v38c0 3.3-2.7 6-6 6H13c-3.3 0-6-2.7-6-6V13c0-3.3 2.7-6 6-6Z"
    fill={`url(#${gradientId})`}
    mask={`url(#${maskId})`}
  />
</svg>
