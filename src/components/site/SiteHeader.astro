---
/**
 * The one header, in two states.
 *
 * The site used to carry two of these — one written into the homepage and one
 * written into the documentation shell — with different heights, different type
 * sizes and a different word for the same link. Two headers that share a logo
 * is what makes two surfaces read as two sites, so there is now one component
 * and a `surface` prop.
 *
 * The rule it follows, in a sentence: the wordmark always takes you home, the
 * badge beside it says which part of the site you are in, and the right-hand
 * cluster is the places you can go that are not on this page.
 *
 * That is why the documentation header carries no "Home" link — the wordmark is
 * the way home on every site anyone has ever used, and it now behaves that way
 * here — and why the homepage's cluster is "Docs" and the documentation's is
 * nothing but the source.
 */
import { Icon } from 'astro-icon/components';
import Mark from '../mark/logos/c45.astro';
import { GITHUB_URL, HOME_SECTIONS, SURFACES, type SurfaceKey } from '../../data/site';

interface Props {
  /** Which part of the site this page belongs to. */
  surface: SurfaceKey;
  /**
   * The path being rendered, so the badge is a link everywhere except on the
   * page it points at — where it becomes plain text marked as current.
   *
   * A brand element that does nothing when pressed was the complaint that
   * started this rewrite, and answering it with a link back to the page you are
   * already reading would only move the problem.
   */
  path?: string;
}

const { surface, path } = Astro.props;
const here = SURFACES[surface];
const atIndex = path === here.href;

/**
 * The homepage's own sections belong to the homepage, so the 404 page — which
 * also belongs to no section and uses this surface — does not offer links to
 * anchors that are not on it.
 */
const atHome = surface === 'home' && atIndex;

/** Home is reached by the wordmark, so it is never repeated here. */
const elsewhere = surface === 'home' ? [SURFACES.docs] : [];
---

<header class:list={['site-header', `on-${surface}`, !atHome && 'no-sections']}>
  <div class="bar">
    <div class="lockup">
      <!-- On the homepage the top of the page *is* home, so the wordmark
           scrolls rather than reloading. Everywhere else it leaves for the
           homepage, which is what a logo does. -->
      <a class="brand" href={atHome ? '#top' : '/'} aria-label="Hozz — home">
        <Mark size={30} />
        <span class="wordmark">Hozz</span>
      </a>

      {
        here.badge &&
          (atIndex ? (
            <span class="badge" aria-current="page">
              {here.badge}
            </span>
          ) : (
            <a class="badge" href={here.href}>
              {here.badge}
            </a>
          ))
      }
    </div>

    {
      atHome && (
        <nav class="sections" aria-label="Page sections">
          {HOME_SECTIONS.map((section) => (
            <a href={section.href}>{section.label}</a>
          ))}
        </nav>
      )
    }

    <nav class="elsewhere" aria-label="Site">
      {elsewhere.map((target) => <a href={target.href}>{target.label}</a>)}
      <a class="repo" href={GITHUB_URL} rel="noopener">
        <Icon name="ph:github-logo" aria-hidden="true" />
        GitHub
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    z-index: 20;
  }

  /* Over the hero, which is a picture: a band across it would cut it in half. */
  .site-header.on-home {
    position: absolute;
    inset: 0 0 auto;
  }

  /*
    In the documentation the header is a fixture of a document you scroll, so it
    stays put — and it sits on its own tint rather than on the page's, which is
    the quietest way to say "this is a different part of the site" without
    repainting anything a reader is trying to read.
  */
  .site-header.on-docs {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--mist) 90%, transparent);
    /* Unprefixed only. The minifier collapses a prefixed/standard pair to
       whichever it sees last, so there is no way to ship both; Safari has
       supported the standard property since 18, and an older one keeps the
       90%-opaque tint and simply loses the blur. */
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: grid;
    align-items: center;
    column-gap: clamp(1rem, 2.2vw, 2.25rem);
    width: min(100% - var(--gutter) * 2, var(--max));
    margin-inline: auto;
  }

  /* Brand, page, site — so the homepage's own sections sit in the middle. */
  .on-home .bar {
    grid-template-columns: 1fr auto 1fr;
    min-height: 5rem;
    border-bottom: 1px solid rgba(93, 140, 176, 0.22);
  }

  /* The 404 page shares this surface and has no sections of its own, so there
     is no middle column for the site links to fall into. */
  .on-home.no-sections .bar {
    grid-template-columns: auto 1fr;
  }

  .on-docs .bar {
    grid-template-columns: auto 1fr;
    min-height: 4.4rem;
  }

  .lockup {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }

  /*
    The wordmark and the badge are the same face at the same size, so they share
    a baseline by construction. The badge used to be a much smaller mono label
    centred against a serif and then pushed down by a fixed 0.25rem — a number
    that cannot follow a font size, and did not.
  */
  .wordmark,
  .badge {
    font-family: 'Young Serif', Georgia, serif;
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-start: 0.7rem;
    padding-inline-start: 0.85rem;
    color: var(--blue-deep);
    text-decoration: none;
  }

  /* Sized in em, so the rule grows with the words it separates. */
  .badge::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 50%;
    width: 1px;
    height: 1.15em;
    transform: translateY(-50%);
    background: var(--line);
  }

  .badge[href]:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sections,
  .elsewhere {
    display: flex;
    gap: clamp(1rem, 2.2vw, 2.25rem);
    align-items: center;
    color: var(--ink-soft);
    font-size: 0.82rem;
  }

  .elsewhere {
    justify-self: end;
  }

  .sections a,
  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    min-height: 44px;
    /* Stated rather than inherited from a page stylesheet: this component is
       used by pages that carry different ones, and a link left to the browser's
       default came out royal blue on one of them. */
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .sections a:hover,
  .elsewhere a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  /*
    It said "Source" in small capitals, which is this site's own convention for a
    machine fact — and the name of a website is not one. The mark is inlined at
    build time from an icon set in the repository, so a page arguing against
    third-party requests does not make one in order to say so.
  */
  .repo :global(svg) {
    width: 1.15em;
    height: 1.15em;
  }

  @media (max-width: 1100px) {
    /* The five in-page links go: there is no room, and everything they point at
       is reachable by scrolling the page you are already on. The footer keeps
       the same list for anyone who would rather jump. */
    .sections {
      display: none;
    }

    .on-home .bar {
      grid-template-columns: auto 1fr;
    }

    .bar {
      column-gap: 1.35rem;
    }
  }
</style>
