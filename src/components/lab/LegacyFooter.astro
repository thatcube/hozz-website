---
/**
 * The footer of the superseded first design, kept for /w/v1/ alone. The live
 * site's footer is src/components/site/SiteFooter.astro.
 */
import Mark from '../Mark.astro';
import { GITHUB_URL, DONATE_URL, LICENSE_URL, SIBLINGS } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="about">
        <a href="/" class="brand">
          <Mark size={30} />
          <span class="wordmark">Hozz</span>
        </a>
        <p>
          Free, open source, and built by Brandon Moore. Exports your Apple
          Health data to places you already own.
        </p>
      </div>

      <nav aria-label="Hozz">
        <h2>Hozz</h2>
        <ul>
          <li><a href={GITHUB_URL} rel="noopener">Source on GitHub</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href={LICENSE_URL} rel="noopener">GPL-3.0 licence</a></li>
          <li><a href={DONATE_URL} rel="noopener">Sponsor the work</a></li>
        </ul>
      </nav>

      <nav aria-label="Other apps">
        <h2>Other apps</h2>
        <ul>
          {SIBLINGS.map((s) => (
            <li>
              <a href={s.href} rel="noopener">{s.name}</a>
              <span>{s.body}</span>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="base">
      <p>© {year} Brandon Moore. Not affiliated with Apple.</p>
      <p class="mono">Apple Health and HealthKit are trademarks of Apple Inc.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule-soft);
    padding-block: clamp(3rem, 6vw, 5rem) 2.5rem;
    background: var(--paper-sunk);
  }

  .top {
    display: grid;
    gap: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
  }

  .about p {
    color: var(--ink-2);
    font-size: var(--fs-small);
    max-width: 34ch;
  }

  .site-footer h2 {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 1.1rem;
  }

  .site-footer li {
    margin-bottom: 0.7rem;
    font-size: var(--fs-small);
  }

  .site-footer li span {
    display: block;
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  .site-footer a {
    text-decoration: none;
    color: var(--ink);
  }

  .site-footer a:hover {
    color: var(--leaf);
    text-decoration: underline;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.82rem;
  }

  .base .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }

  @media (min-width: 760px) {
    .top {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
