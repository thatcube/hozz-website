---
/**
 * 06 — The question
 *
 * Chips settle into a single line you could actually type. The answer is
 * assembled from your own records, on your own machine, by an assistant you
 * chose — so the figure has to be explicit that the assistant is yours and the
 * question is an example, not a feature of Hozz.
 */
import { CHIPS } from '../../data/chips';

const feed = [CHIPS[1], CHIPS[0], CHIPS[4], CHIPS[6]];
---

<div class="q">
  <div class="feed">
    {
      feed.map((c, i) => (
        <span class="chip" style={`--hue: var(--h-${c.cat}); --i: ${i}`}>
          <i aria-hidden="true"></i>{c.name}
        </span>
      ))
    }
  </div>

  <div class="rail" aria-hidden="true"><span class="pip"></span></div>

  <div class="ask">
    <p class="prompt">
      <span class="caret">Has my resting heart rate drifted since March?</span>
    </p>
    <p class="ans">
      Reads <code>restingHeartRate</code> from the copy on your Mac. Read-only,
      over stdio, on your machine.
    </p>
  </div>

  <p class="fine">
    An example of a question you can ask <em>your own</em> assistant. Hozz has no
    chat and answers nothing itself — it exposes a read-only MCP server and stops
    there.
  </p>
</div>

<style>
  .q {
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    text-align: center;
  }

  .feed {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem 0.3rem 0.55rem;
    border-radius: 999px;
    border: 1px solid #e2e4e8;
    background: #fff;
    font-size: 0.78125rem;
    font-weight: 500;
    color: #23262b;
    animation: settle 9s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.12s);
  }

  .chip i {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--hue);
  }

  /* The chips lean in toward the question, then release. */
  @keyframes settle {
    0%, 8% { transform: translateY(0); opacity: 1; }
    22%, 62% { transform: translateY(5px); opacity: 0.45; }
    80%, 100% { transform: translateY(0); opacity: 1; }
  }

  .rail {
    position: relative;
    inline-size: 1px;
    block-size: 2rem;
    background: linear-gradient(#d8dbe0, transparent);
  }

  .pip {
    position: absolute;
    inset-inline-start: -3px;
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background: var(--h-mind);
    animation: drop 9s ease-in-out infinite;
  }

  @keyframes drop {
    0%, 10% { top: -4px; opacity: 0; }
    18% { opacity: 1; }
    34%, 100% { top: calc(100% - 3px); opacity: 0; }
  }

  .ask {
    inline-size: min(100%, 34rem);
    padding: 1.05rem 1.25rem;
    border-radius: 16px;
    border: 1px solid #e2e4e8;
    background: #fff;
    text-align: left;
  }

  .prompt {
    font-family: var(--mono);
    font-size: 0.875rem;
    color: #14161a;
    white-space: nowrap;
    overflow: hidden;
  }

  /* Typed, then held long enough to read. */
  .caret {
    display: inline-block;
    max-inline-size: 100%;
    overflow: hidden;
    white-space: nowrap;
    border-inline-end: 2px solid var(--h-mind);
    animation: type 9s steps(46, end) infinite;
  }

  @keyframes type {
    0%, 26% { inline-size: 0; }
    52%, 88% { inline-size: 46ch; }
    100% { inline-size: 0; }
  }

  .ans {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #4d525a;
    opacity: 0;
    animation: reveal 9s ease-in-out infinite;
  }

  .ans code {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: #14161a;
  }

  @keyframes reveal {
    0%, 56% { opacity: 0; }
    64%, 88% { opacity: 1; }
    100% { opacity: 0; }
  }

  .fine {
    inline-size: min(100%, 40ch);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #5c6169;
  }

  .fine em {
    font-style: normal;
    font-weight: 600;
    color: #14161a;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Everything resolves to its finished state: the question typed, the answer
       shown, the chips settled. */
    .chip,
    .pip,
    .caret,
    .ans {
      animation: none;
    }
    .caret {
      inline-size: auto;
      border-inline-end: 0;
    }
    .ans {
      opacity: 1;
    }
    .rail {
      display: none;
    }
  }
</style>
