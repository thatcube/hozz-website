---
import { CHIPS, OUTCOMES } from '../../../data/chips';

const ring = [
  { source: CHIPS[0], replacement: CHIPS[1], angle: 0, delay: '0s' },
  { source: CHIPS[4], replacement: CHIPS[6], angle: 90, delay: '12s' },
  { source: CHIPS[2], replacement: CHIPS[3], angle: 180, delay: '24s' },
  { source: CHIPS[8], replacement: CHIPS[10], angle: 270, delay: '36s' },
  { source: CHIPS[5], angle: 45 },
  { source: CHIPS[9], angle: 135 },
  { source: CHIPS[12], angle: 225 },
  { source: CHIPS[13], angle: 315 },
];

const flights = [
  {
    chip: CHIPS[0],
    delay: '0s',
    start: '50%; 9%',
    middle: '34%; 25%',
    dock: '24%; 40%',
  },
  {
    chip: CHIPS[4],
    delay: '12s',
    start: '50%; 91%',
    middle: '68%; 73%',
    dock: '75%; 43%',
  },
  {
    chip: CHIPS[2],
    delay: '24s',
    start: '50%; 9%',
    middle: '34%; 27%',
    dock: '27%; 61%',
  },
  {
    chip: CHIPS[8],
    delay: '36s',
    start: '50%; 91%',
    middle: '68%; 74%',
    dock: '76%; 60%',
  },
].map((flight) => {
  const [sx, sy] = flight.start.split('; ');
  const [mx, my] = flight.middle.split('; ');
  const [dx, dy] = flight.dock.split('; ');
  return { ...flight, sx, sy, mx, my, dx, dy };
});

const labels = Object.fromEntries(
  OUTCOMES.map((outcome) => [outcome.key, outcome.title.split(' ')[0]]),
);
---

<figure
  class="switchyard"
  role="img"
  aria-label="Health records orbit a cluster labelled Keep, Ask, Build and Run. One record at a time leaves the ring and docks beside an outcome."
>
  <svg class="guide" viewBox="0 0 100 100" aria-hidden="true">
    <circle class="guide-ring" cx="50" cy="50" r="39" />
    <circle class="guide-dots" cx="50" cy="50" r="39" />
    <path d="M50 18 C42 25 34 31 29 40" />
    <path d="M50 82 C60 73 68 60 71 43" />
  </svg>

  <div class="orbit" aria-hidden="true">
    {
      ring.map((record) => (
        <span class="slot" style={`--angle:${record.angle}deg;--delay:${record.delay ?? '0s'}`}>
          <span class="holder">
            <span class="counter">
              <span
                class:list={['chip', record.replacement && 'source']}
                style={`--hue:var(--h-${record.source.cat})`}
              >
                <i />
                {record.source.name}
              </span>
              {
                record.replacement && (
                  <span
                    class="chip replacement"
                    style={`--hue:var(--h-${record.replacement.cat})`}
                  >
                    <i />
                    {record.replacement.name}
                  </span>
                )
              }
            </span>
          </span>
        </span>
      ))
    }
  </div>

  <div class="outcomes">
    <span style="--hue:var(--h-other)"><i aria-hidden="true" />{labels.keep}</span>
    <span style="--hue:var(--h-mind)"><i aria-hidden="true" />{labels.ask}</span>
    <span style="--hue:var(--h-nutrition)"><i aria-hidden="true" />{labels.build}</span>
    <span style="--hue:var(--h-mobility)"><i aria-hidden="true" />{labels.run}</span>
  </div>

  {
    flights.map((flight) => (
      <span
        class="chip flight"
        style={`--hue:var(--h-${flight.chip.cat});--delay:${flight.delay};--sx:${flight.sx};--sy:${flight.sy};--mx:${flight.mx};--my:${flight.my};--dx:${flight.dx};--dy:${flight.dy}`}
      >
        <i aria-hidden="true" />
        {flight.chip.name}
      </span>
    ))
  }
</figure>

<style>
  .switchyard {
    position: relative;
    container-type: inline-size;
    inline-size: 100%;
    max-inline-size: 34rem;
    aspect-ratio: 1;
    margin: 0;
    overflow: hidden;
    isolation: isolate;
    font-family: var(--sans);
  }

  .guide {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
    fill: none;
    stroke: #d8dde3;
    stroke-width: 0.22;
    vector-effect: non-scaling-stroke;
  }

  .guide path {
    stroke: #dce1e6;
    stroke-width: 0.28;
    stroke-dasharray: 0.7 1.8;
  }

  .guide-dots {
    stroke: #bfc6ce;
    stroke-linecap: round;
    stroke-dasharray: 0.16 2.9;
    animation: guide-turn 48s linear infinite;
    transform-origin: 50px 50px;
  }

  .orbit {
    position: absolute;
    inset: max(11%, 2.4rem);
    animation: orbit-turn 48s linear infinite;
  }

  .slot {
    position: absolute;
    inset: 0;
    rotate: var(--angle);
  }

  .holder {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 50%;
    translate: -50% -50%;
  }

  .counter {
    position: relative;
    display: grid;
    place-items: center;
    transform: rotate(calc(-1 * var(--angle)));
    animation: orbit-turn 48s linear infinite reverse;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.26rem, 1.25cqi, 0.4rem);
    padding: clamp(0.24rem, 1cqi, 0.32rem) clamp(0.45rem, 1.8cqi, 0.65rem)
      clamp(0.24rem, 1cqi, 0.32rem) clamp(0.38rem, 1.55cqi, 0.54rem);
    border: 1px solid #d9dee4;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 3px 12px rgba(25, 31, 38, 0.04);
    color: #252a31;
    font-size: clamp(0.5625rem, 1.95cqi, 0.75rem);
    font-weight: 550;
    letter-spacing: -0.012em;
    line-height: 1;
    white-space: nowrap;
  }

  .chip i {
    inline-size: clamp(0.3rem, 1.2cqi, 0.4rem);
    block-size: clamp(0.3rem, 1.2cqi, 0.4rem);
    flex: none;
    border-radius: 50%;
    background: var(--hue);
  }

  .source {
    grid-area: 1 / 1;
    animation: source-swap 48s linear infinite;
    animation-delay: var(--delay);
  }

  .replacement {
    grid-area: 1 / 1;
    opacity: 0;
    animation: replacement-swap 48s linear infinite;
    animation-delay: var(--delay);
  }

  .outcomes {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: min(39%, 11.75rem);
    translate: -50% -50%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.25rem, 1.3cqi, 0.45rem);
  }

  .outcomes::before,
  .outcomes::after {
    content: '';
    position: absolute;
    z-index: -1;
    background: #e0e4e8;
  }

  .outcomes::before {
    inset-block: 18%;
    inset-inline-start: 50%;
    inline-size: 1px;
  }

  .outcomes::after {
    inset-inline: 18%;
    inset-block-start: 50%;
    block-size: 1px;
  }

  .outcomes span {
    position: relative;
    display: inline-flex;
    min-inline-size: 0;
    align-items: center;
    justify-content: center;
    gap: clamp(0.2rem, 0.8cqi, 0.32rem);
    padding: clamp(0.36rem, 1.6cqi, 0.56rem) clamp(0.28rem, 1.2cqi, 0.45rem);
    border: 1px solid #d8dde3;
    border-radius: 999px;
    background: #fff;
    color: #1e242a;
    font-size: clamp(0.625rem, 2.2cqi, 0.82rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .outcomes span::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inline-size: clamp(0.32rem, 1.6cqi, 0.55rem);
    border-block-start: 1px dotted #c9cfd6;
  }

  .outcomes span:nth-child(odd)::after {
    inset-inline-end: 100%;
  }

  .outcomes span:nth-child(even)::after {
    inset-inline-start: 100%;
  }

  .outcomes i {
    inline-size: clamp(0.22rem, 0.9cqi, 0.34rem);
    block-size: clamp(0.22rem, 0.9cqi, 0.34rem);
    flex: none;
    border-radius: 50%;
    background: var(--hue);
  }

  .flight {
    position: absolute;
    z-index: 3;
    inset-block-start: var(--sy);
    inset-inline-start: var(--sx);
    translate: -50% -50%;
    opacity: 0;
    animation: depart 48s linear infinite;
    animation-delay: var(--delay);
  }

  @keyframes orbit-turn {
    to {
      rotate: 360deg;
    }
  }

  @keyframes guide-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes source-swap {
    0%,
    1% {
      opacity: 1;
    }
    3%,
    100% {
      opacity: 0;
    }
  }

  @keyframes replacement-swap {
    0%,
    1% {
      opacity: 0;
    }
    4%,
    96% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes depart {
    0% {
      inset-block-start: var(--sy);
      inset-inline-start: var(--sx);
      opacity: 0;
      scale: 1;
    }
    0.8%,
    2% {
      inset-block-start: var(--sy);
      inset-inline-start: var(--sx);
      opacity: 1;
      scale: 1;
    }
    5.5% {
      inset-block-start: var(--my);
      inset-inline-start: var(--mx);
      opacity: 1;
      scale: 0.93;
      animation-timing-function: cubic-bezier(0.22, 0.7, 0.2, 1);
    }
    9%,
    11.5% {
      inset-block-start: var(--dy);
      inset-inline-start: var(--dx);
      opacity: 1;
      scale: 0.82;
    }
    12.5%,
    100% {
      inset-block-start: var(--dy);
      inset-inline-start: var(--dx);
      opacity: 0;
      scale: 0.82;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide-dots,
    .orbit,
    .counter,
    .source,
    .replacement,
    .flight {
      animation: none;
    }

    .source {
      /* Removed rather than faded: an invisible chip that still occupies its
         slot is read by assistive tech and confuses the still frame. */
      display: none;
    }

    .replacement {
      opacity: 1;
    }

    .flight {
      inset-block-start: var(--dy);
      inset-inline-start: var(--dx);
      opacity: 1;
      scale: 0.82;
    }
  }
</style>
