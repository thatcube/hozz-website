---
import { CHIPS } from '../../../data/chips';

const wanted = new Set([
  'Heart Rate',
  'Steps',
  'Sleep',
  'Blood Oxygen',
  'Mindful Minutes',
  'Protein',
]);
const chips = CHIPS.filter((chip) => wanted.has(chip.name));
const lanes = [chips.filter((_, i) => i % 2 === 0), chips.filter((_, i) => i % 2 === 1)];
const still = [
  [
    [25, 21],
    [50, 12],
    [75, 23],
  ],
  [
    [25, 71],
    [50, 79],
    [75, 69],
  ],
];
---

<figure
  class="bypass"
  role="img"
  aria-label="After you choose and confirm a destination, real HealthKit data types travel from your iPhone directly to your destination on paths that bend around an empty developer relay."
>
  <svg class="routes routes--wide" viewBox="0 0 600 336" aria-hidden="true">
    <path d="M 70 158 C 154 46, 247 37, 304 94 C 360 39, 456 56, 530 158" />
    <path d="M 70 185 C 150 290, 245 302, 304 244 C 366 299, 458 279, 530 185" />
    <path class="arrow" d="M 518 147 L 530 158 L 516 164" />
    <path class="arrow" d="M 516 179 L 530 185 L 519 198" />
  </svg>

  <svg class="routes routes--narrow" viewBox="0 0 280 336" aria-hidden="true">
    <path d="M 140 40 C 61 73, 45 127, 57 190 C 68 237, 93 272, 140 298" />
    <path d="M 140 40 C 219 73, 235 127, 223 190 C 212 237, 187 272, 140 298" />
    <path class="arrow" d="M 129 289 L 140 298 L 126 302" />
    <path class="arrow" d="M 151 289 L 140 298 L 154 302" />
  </svg>

  <div class="endpoint endpoint--phone" aria-hidden="true">
    <span class="endpoint-k">From</span>
    <span class="endpoint-v">Your iPhone</span>
  </div>

  <div class="endpoint endpoint--place" aria-hidden="true">
    <span class="endpoint-k">To</span>
    <span class="endpoint-v">Your destination</span>
    <span class="endpoint-s">you choose + confirm</span>
  </div>

  <div class="void" aria-hidden="true">
    <span class="void-mark">∅</span>
    <span class="void-k">No relay</span>
    <span class="void-v">developer gets no copy</span>
  </div>

  {
    lanes.map((lane, laneIndex) => (
      <div class:list={['lane', `lane--${laneIndex === 0 ? 'a' : 'b'}`]}>
        {lane.map((chip, index) => (
          <span
            class="traveller"
            style={`--delay: -${index * 28 + laneIndex * 14}s; --sx: ${still[laneIndex][index][0]}%; --sy: ${still[laneIndex][index][1]}%;`}
          >
            <span class="chip" style={`--hue: var(--h-${chip.cat})`}>
              <span class="chip-name"><i aria-hidden="true" />{chip.name}</span>
              <span class="chip-id">{chip.id}</span>
            </span>
          </span>
        ))}
      </div>
    ))
  }
</figure>

<style>
  .bypass {
    position: relative;
    container: bypass / inline-size;
    inline-size: 100%;
    max-inline-size: 37.5rem;
    block-size: 21rem;
    margin: 0;
    overflow: hidden;
    color: #171a1f;
    font-family: var(--sans);
  }

  .routes {
    position: absolute;
    inset: 0;
    z-index: 0;
    inline-size: 100%;
    block-size: 100%;
    fill: none;
    stroke: #bdc3ca;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 2 6;
    vector-effect: non-scaling-stroke;
  }

  .routes .arrow {
    stroke: #858c95;
    stroke-dasharray: none;
  }

  .routes--narrow {
    display: none;
  }

  .endpoint {
    position: absolute;
    z-index: 4;
    display: grid;
    gap: 0.08rem;
    inline-size: 5.8rem;
    padding: 0.55rem 0.6rem;
    border: 1px solid #d8dce1;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 3px 12px rgb(23 26 31 / 4%);
  }

  .endpoint--phone {
    inset-inline-start: 0;
    inset-block-start: 50%;
    translate: 0 -50%;
  }

  .endpoint--place {
    inset-inline-end: 0;
    inset-block-start: 50%;
    translate: 0 -50%;
  }

  .endpoint-k,
  .endpoint-s,
  .void-k {
    font-family: var(--mono);
    text-transform: uppercase;
  }

  .endpoint-k {
    font-size: 0.5rem;
    line-height: 1;
    letter-spacing: 0.08em;
    color: #626a73;
  }

  .endpoint-v {
    font-size: 0.6875rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.018em;
    color: #171a1f;
  }

  .endpoint-s {
    margin-block-start: 0.12rem;
    font-size: 0.4rem;
    line-height: 1.25;
    letter-spacing: 0.025em;
    color: #626a73;
  }

  .void {
    position: absolute;
    z-index: 2;
    inset-inline-start: 50%;
    inset-block-start: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    align-content: center;
    inline-size: 7.25rem;
    aspect-ratio: 1;
    padding: 0.75rem;
    border: 1px dashed #aeb4bc;
    border-radius: 50%;
    background: #fafbfc;
    box-shadow: 0 0 0 0.75rem #fafbfc;
    text-align: center;
  }

  .void-mark {
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1;
    color: #171a1f;
  }

  .void-k {
    margin-block-start: 0.3rem;
    font-size: 0.5625rem;
    line-height: 1;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: #30353b;
  }

  .void-v {
    margin-block-start: 0.25rem;
    font-size: 0.5625rem;
    line-height: 1.25;
    color: #59616a;
  }

  .traveller {
    position: absolute;
    z-index: 3;
    inset-inline-start: var(--sx);
    inset-block-start: var(--sy);
    translate: -50% -50%;
    animation: route-a 84s linear infinite;
    animation-delay: var(--delay);
  }

  .lane--b .traveller {
    animation-name: route-b;
  }

  .chip {
    display: grid;
    gap: 0.12rem;
    inline-size: clamp(5.8rem, 22cqi, 7.4rem);
    padding: 0.38rem 0.52rem 0.36rem;
    border: 1px solid #d8dce1;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 2px 10px rgb(23 26 31 / 5%);
    white-space: nowrap;
  }

  .chip-name {
    display: flex;
    align-items: center;
    gap: 0.34rem;
    overflow: hidden;
    font-size: clamp(0.6rem, 1.9cqi, 0.72rem);
    line-height: 1.05;
    font-weight: 650;
    letter-spacing: -0.012em;
    color: #20242a;
    text-overflow: ellipsis;
  }

  .chip-name i {
    inline-size: 0.42rem;
    block-size: 0.42rem;
    flex: none;
    border-radius: 50%;
    background: var(--hue);
  }

  .chip-id {
    overflow: hidden;
    padding-inline-start: 0.76rem;
    font-family: var(--mono);
    font-size: clamp(0.45rem, 1.35cqi, 0.53rem);
    line-height: 1.05;
    color: #5c646d;
    text-overflow: ellipsis;
  }

  @keyframes route-a {
    0% {
      inset-inline-start: 7%;
      inset-block-start: 47%;
      opacity: 0;
    }
    6% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    28% {
      inset-inline-start: 28%;
      inset-block-start: 17%;
    }
    52% {
      inset-inline-start: 51%;
      inset-block-start: 14%;
    }
    76% {
      inset-inline-start: 74%;
      inset-block-start: 23%;
    }
    93% {
      opacity: 1;
    }
    94%,
    100% {
      inset-inline-start: 93%;
      inset-block-start: 47%;
      opacity: 0;
    }
  }

  @keyframes route-b {
    0% {
      inset-inline-start: 7%;
      inset-block-start: 55%;
      opacity: 0;
    }
    6% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    28% {
      inset-inline-start: 28%;
      inset-block-start: 80%;
    }
    52% {
      inset-inline-start: 51%;
      inset-block-start: 84%;
    }
    76% {
      inset-inline-start: 74%;
      inset-block-start: 75%;
    }
    93% {
      opacity: 1;
    }
    94%,
    100% {
      inset-inline-start: 93%;
      inset-block-start: 55%;
      opacity: 0;
    }
  }

  @container bypass (max-width: 24rem) {
    .routes--wide {
      display: none;
    }

    .routes--narrow {
      display: block;
    }

    .endpoint {
      inline-size: 7.6rem;
      justify-items: center;
      text-align: center;
    }

    .endpoint--phone {
      inset-inline-start: 50%;
      inset-block-start: 0;
      translate: -50% 0;
    }

    .endpoint--place {
      inset-inline-end: auto;
      inset-inline-start: 50%;
      inset-block-start: auto;
      inset-block-end: 0;
      translate: -50% 0;
    }

    .void {
      inline-size: 3.5rem;
      padding: 0.28rem;
      box-shadow: 0 0 0 0.5rem #fafbfc;
    }

    .void-mark {
      font-size: 0.6875rem;
    }

    .void-k {
      margin-block-start: 0.18rem;
      font-size: 0.425rem;
    }

    .void-v {
      margin-block-start: 0.14rem;
      font-size: 0.4rem;
    }

    .chip {
      inline-size: clamp(5rem, 38cqi, 5.65rem);
      padding: 0.32rem 0.38rem 0.3rem;
    }

    .chip-name {
      gap: 0.25rem;
      font-size: 0.525rem;
    }

    .chip-name i {
      inline-size: 0.34rem;
      block-size: 0.34rem;
    }

    .chip-id {
      padding-inline-start: 0.59rem;
      font-size: 0.375rem;
    }

    .traveller {
      animation-name: route-a-narrow;
    }

    .lane--b .traveller {
      animation-name: route-b-narrow;
    }
  }

  @keyframes route-a-narrow {
    0% {
      inset-inline-start: 50%;
      inset-block-start: 12%;
      opacity: 0;
    }
    6% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    30% {
      inset-inline-start: 19%;
      inset-block-start: 31%;
    }
    58% {
      inset-inline-start: 17%;
      inset-block-start: 56%;
    }
    80% {
      inset-inline-start: 26%;
      inset-block-start: 75%;
    }
    93% {
      opacity: 1;
    }
    94%,
    100% {
      inset-inline-start: 50%;
      inset-block-start: 88%;
      opacity: 0;
    }
  }

  @keyframes route-b-narrow {
    0% {
      inset-inline-start: 50%;
      inset-block-start: 12%;
      opacity: 0;
    }
    6% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    30% {
      inset-inline-start: 81%;
      inset-block-start: 31%;
    }
    58% {
      inset-inline-start: 83%;
      inset-block-start: 56%;
    }
    80% {
      inset-inline-start: 74%;
      inset-block-start: 75%;
    }
    93% {
      opacity: 1;
    }
    94%,
    100% {
      inset-inline-start: 50%;
      inset-block-start: 88%;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .traveller {
      inset-inline-start: var(--sx);
      inset-block-start: var(--sy);
      opacity: 1;
      animation: none;
    }
  }

  @container bypass (max-width: 24rem) {
    @media (prefers-reduced-motion: reduce) {
      .lane--a .traveller:nth-child(1) {
        inset-inline-start: 19%;
        inset-block-start: 28%;
      }
      .lane--a .traveller:nth-child(2) {
        inset-inline-start: 17%;
        inset-block-start: 50%;
      }
      .lane--a .traveller:nth-child(3) {
        inset-inline-start: 26%;
        inset-block-start: 71%;
      }
      .lane--b .traveller:nth-child(1) {
        inset-inline-start: 81%;
        inset-block-start: 28%;
      }
      .lane--b .traveller:nth-child(2) {
        inset-inline-start: 83%;
        inset-block-start: 50%;
      }
      .lane--b .traveller:nth-child(3) {
        inset-inline-start: 74%;
        inset-block-start: 71%;
      }
    }
  }
</style>
