---
import { CHIPS } from '../../../data/chips';

const selected = [CHIPS[2], CHIPS[4], CHIPS[5], CHIPS[10], CHIPS[12], CHIPS[0]];
---

<figure
  class="orb08"
  data-orb08
  role="img"
  aria-label="Health data records moving around a rounded rectangular track into an export.ndjson file, one streamable record per line"
>
  <svg class="guide" aria-hidden="true">
    <path class="rail" />
    <path class="rail rail--dash" />
  </svg>

  {
    selected.map((chip, index) => (
      <span
        class="runner"
        style={`--start: ${(index / selected.length) * 100}%; --delay: ${index * -7}s;`}
      >
        <span class="chip" style={`--chip-hue: var(--h-${chip.cat})`}>
          <i aria-hidden="true" />
          {chip.name}
        </span>
      </span>
    ))
  }

  <div class="file">
    <span class="file__tab" aria-hidden="true">ND</span>
    <span class="file__name">export.ndjson</span>
    <span class="file__rule" aria-hidden="true"></span>
    <span class="file__detail">one record per line</span>
    <span class="file__detail file__detail--strong">streamable</span>
    <span class="file__lines" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
  </div>
</figure>

<script>
  const initialized = new WeakSet<Element>();

  document.querySelectorAll<HTMLElement>('[data-orb08]').forEach((figure) => {
    if (initialized.has(figure)) return;
    initialized.add(figure);

    const rail = figure.querySelectorAll<SVGPathElement>('.rail');
    const runners = figure.querySelectorAll<HTMLElement>('.runner');

    const draw = () => {
      const width = figure.clientWidth;
      const height = figure.clientHeight;
      const x = Math.max(46, Math.min(68, width * 0.11));
      const y = Math.max(40, Math.min(47, height * 0.15));
      const right = width - x;
      const bottom = height - y;
      const radius = Math.min(56, (right - x) * 0.2, (bottom - y) * 0.26);
      const path = [
        `M ${x + radius} ${y}`,
        `H ${right - radius}`,
        `A ${radius} ${radius} 0 0 1 ${right} ${y + radius}`,
        `V ${bottom - radius}`,
        `A ${radius} ${radius} 0 0 1 ${right - radius} ${bottom}`,
        `H ${x + radius}`,
        `A ${radius} ${radius} 0 0 1 ${x} ${bottom - radius}`,
        `V ${y + radius}`,
        `A ${radius} ${radius} 0 0 1 ${x + radius} ${y}`,
        'Z',
      ].join(' ');

      rail.forEach((line) => line.setAttribute('d', path));
      runners.forEach((runner) => {
        runner.style.offsetPath = `path("${path}")`;
      });
    };

    const observer = new ResizeObserver(draw);
    observer.observe(figure);
    draw();
  });
</script>

<style>
  .orb08 {
    position: relative;
    inline-size: 100%;
    max-inline-size: 40rem;
    block-size: clamp(12rem, 50vw, 20rem);
    margin: 0 auto;
    overflow: hidden;
    isolation: isolate;
    font-family: var(--sans);
  }

  .guide {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .rail {
    fill: none;
    stroke: #d9dde2;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .rail--dash {
    stroke: #aeb5bd;
    stroke-dasharray: 1 8;
    stroke-linecap: round;
  }

  .runner {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 2;
    inline-size: max-content;
    offset-path: path("M 100 46 H 540 A 54 54 0 0 1 594 100 V 220 A 54 54 0 0 1 540 274 H 100 A 54 54 0 0 1 46 220 V 100 A 54 54 0 0 1 100 46 Z");
    offset-distance: var(--start);
    offset-anchor: 50% 50%;
    offset-rotate: 0deg;
    animation: belt-lap 42s linear infinite;
    animation-delay: var(--delay);
    will-change: offset-distance;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
    padding: 0.31rem 0.58rem 0.31rem 0.5rem;
    border: 1px solid #daddE2;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 2px 8px rgb(20 24 30 / 5%);
    color: #262a30;
    font-size: clamp(0.66rem, 0.59rem + 0.25vw, 0.78rem);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.012em;
    white-space: nowrap;
  }

  .chip i {
    inline-size: 0.43rem;
    block-size: 0.43rem;
    flex: none;
    border-radius: 50%;
    background: var(--chip-hue);
  }

  .file {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: 1;
    inline-size: min(54%, 12.5rem);
    min-inline-size: 8.2rem;
    translate: -50% -50%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.22rem 0.42rem;
    box-sizing: border-box;
    padding: clamp(0.68rem, 2.4vw, 0.9rem);
    border: 1px solid #d8dce1;
    border-radius: 0.9rem;
    background:
      linear-gradient(135deg, rgb(247 248 250 / 0%) 68%, #f5f6f8 68%),
      #fff;
    box-shadow:
      0 12px 30px rgb(27 31 36 / 7%),
      0 1px 2px rgb(27 31 36 / 5%);
  }

  .file__tab {
    display: grid;
    grid-row: 1;
    grid-column: 1;
    place-items: center;
    inline-size: 1.38rem;
    block-size: 1.38rem;
    border: 1px solid #cdd2d8;
    border-radius: 0.36rem;
    color: #4c545d;
    font-family: var(--mono);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .file__name {
    grid-row: 1;
    grid-column: 2;
    color: #16191d;
    font-family: var(--mono);
    font-size: clamp(0.58rem, 0.51rem + 0.3vw, 0.82rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  .file__rule {
    grid-column: 1 / -1;
    block-size: 1px;
    margin-block: 0.16rem 0.08rem;
    background: #e1e4e8;
  }

  .file__detail {
    grid-column: 1 / -1;
    color: #59616a;
    font-size: clamp(0.56rem, 0.5rem + 0.24vw, 0.69rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .file__detail--strong {
    color: #333941;
    font-weight: 650;
  }

  .file__lines {
    position: absolute;
    inset-inline-end: clamp(0.68rem, 2.4vw, 0.9rem);
    inset-block-end: clamp(0.75rem, 2.5vw, 0.96rem);
    display: grid;
    gap: 0.16rem;
    inline-size: 1.45rem;
  }

  .file__lines i {
    display: block;
    block-size: 1px;
    background: #cfd4da;
  }

  .file__lines i:nth-child(2) {
    inline-size: 72%;
  }

  .file__lines i:nth-child(3) {
    inline-size: 86%;
  }

  @keyframes belt-lap {
    from {
      offset-distance: 0%;
    }

    to {
      offset-distance: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .runner {
      animation: none;
      will-change: auto;
    }
  }
</style>
