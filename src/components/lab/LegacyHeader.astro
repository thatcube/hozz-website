---
/**
 * The chrome of the superseded first design, kept for /w/v1/ alone.
 *
 * The live site's header is src/components/site/SiteHeader.astro. This one
 * survives only so the concept archive still renders what was actually built at
 * the time, which is the whole point of keeping an archive. Its link list comes
 * from src/data/archive.ts, because the anchors it points at exist on those
 * pages and nowhere on the live site.
 */
import Mark from '../Mark.astro';
import { GITHUB_URL } from '../../data/site';
import { ARCHIVE_NAV_LINKS as NAV_LINKS } from '../../data/archive';
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand">
      <Mark size={30} />
      <span class="wordmark">Hozz</span>
    </a>

    <nav aria-label="Sections">
      <ul>
        {NAV_LINKS.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--ghost repo" href={GITHUB_URL} rel="noopener">
      Source
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  /* The rule only appears once the page has moved, so the header sits on the
     hero without drawing a line across it. */
  :global(body.is-scrolled) .site-header {
    border-bottom-color: var(--rule-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    margin-inline-end: auto;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  nav ul {
    display: none;
    gap: 1.6rem;
  }

  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--fs-small);
  }

  nav a:hover {
    color: var(--ink);
  }

  .repo {
    padding-block: 0.6rem;
    padding-inline: 1.1rem;
  }

  @media (min-width: 860px) {
    nav ul {
      display: flex;
    }
  }
</style>
