---
/**
 * Device frames.
 *
 * Two treatments each, because the open question is whether real screenshots
 * are needed at all:
 *
 *   empty  — a labelled slot, sized correctly, waiting for a real capture.
 *   filled — no app UI. The frame holds the *data*: real type names, real file
 *            names, real ports. This is the honest version, and if it reads
 *            well enough it removes the need for a screenshot entirely.
 *
 * The chrome is generic macOS and iPhone furniture, not a depiction of Hozz's
 * interface, which is not public. Nothing inside claims to be a screenshot.
 */
import { CHIPS } from '../../data/chips';

interface Props {
  device: 'mac' | 'ios';
  mode: 'empty' | 'filled';
}
const { device, mode } = Astro.props;

const rows = CHIPS.slice(0, 5);
const bars = [42, 61, 38, 74, 55, 68, 47, 80, 59, 71, 44, 63];
---

<figure class={`dev dev--${device} dev--${mode}`}>
  {
    device === 'mac' ? (
      <div class="chrome">
        <span class="dots" aria-hidden="true"><i /><i /><i /></span>
        <span class="title">{mode === 'filled' ? 'hozz-received.sqlite' : 'Mac app'}</span>
      </div>
    ) : (
      <div class="notch" aria-hidden="true" />
    )
  }

  <div class="screen">
    {
      mode === 'empty' ? (
        <div class="slot">
          <span class="slot-k">{device === 'mac' ? 'Mac screenshot' : 'iPhone screenshot'}</span>
          <span class="slot-d">{device === 'mac' ? '2560 × 1600' : '1290 × 2796'}</span>
        </div>
      ) : device === 'mac' ? (
        <div class="mac-body">
          <div class="chart" aria-hidden="true">
            {bars.map((h, i) => (
              <span style={`--h: ${h}%; --i: ${i}`} />
            ))}
          </div>
          <ul class="rows">
            {rows.map((c) => (
              <li style={`--hue: var(--h-${c.cat})`}>
                <span class="dot" aria-hidden="true" />
                <span class="nm">{c.name}</span>
                <code>{c.id}</code>
              </li>
            ))}
          </ul>
          <p class="foot"><span class="live" aria-hidden="true" />Receiving on <code>_hozz._tcp</code> · port <code>54330</code></p>
        </div>
      ) : (
        <div class="ios-body">
          <p class="k">Last delivery</p>
          <p class="v">2 min ago</p>
          <ul class="dests">
            <li style="--hue: var(--h-other)"><span class="dot" aria-hidden="true" />This Mac</li>
            <li style="--hue: var(--h-nutrition)"><span class="dot" aria-hidden="true" />Folder</li>
            <li style="--hue: var(--h-mobility)"><span class="dot" aria-hidden="true" />MQTT</li>
          </ul>
          <p class="note">Nothing moves until you add a destination and confirm it.</p>
        </div>
      )
    }
  </div>

  <figcaption>
    {
      mode === 'empty'
        ? `Slot for a real ${device === 'mac' ? 'Mac' : 'iPhone'} capture.`
        : 'Not a screenshot — the data, drawn from real type names, file names and ports.'
    }
  </figcaption>
</figure>

<style>
  .dev {
    margin: 0;
    display: grid;
    gap: 0.7rem;
    justify-items: center;
  }

  .dev--mac .chrome,
  .dev--mac .screen {
    inline-size: min(100%, 26rem);
  }

  .dev--ios .screen {
    inline-size: min(100%, 11.5rem);
  }

  /* ── Chrome ───────────────────────────────────────────────────────────── */
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #d9dce1;
    border-block-end: 0;
    border-radius: 12px 12px 0 0;
    background: #f3f4f6;
  }

  .dots {
    display: inline-flex;
    gap: 5px;
  }

  .dots i {
    inline-size: 9px;
    block-size: 9px;
    border-radius: 50%;
    background: #d3d6db;
  }

  .title {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: #6a6f77;
  }

  .notch {
    inline-size: 3.4rem;
    block-size: 0.35rem;
    border-radius: 999px;
    background: #d9dce1;
    margin-block-end: -0.35rem;
    position: relative;
    z-index: 1;
  }

  .screen {
    position: relative;
    background: #fff;
    border: 1px solid #d9dce1;
    overflow: hidden;
  }

  .dev--mac .screen {
    aspect-ratio: 16 / 10;
    border-radius: 0 0 12px 12px;
  }

  .dev--ios .screen {
    aspect-ratio: 9 / 17;
    border-radius: 22px;
    padding-block-start: 1rem;
  }

  /* ── Empty slot ───────────────────────────────────────────────────────── */
  .slot {
    block-size: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.25rem;
    background:
      repeating-linear-gradient(135deg, #f5f6f8 0 8px, #fafbfc 8px 16px);
  }

  .slot-k {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #6a6f77;
  }

  .slot-d {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: #9aa0a8;
  }

  /* ── Filled: the data, not the app ────────────────────────────────────── */
  .mac-body {
    block-size: 100%;
    padding: 0.85rem 0.95rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.7rem;
  }

  .chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    block-size: 3.1rem;
  }

  .chart span {
    flex: 1;
    block-size: var(--h);
    border-radius: 2px;
    background: color-mix(in oklab, var(--h-heart) 42%, #eceef1);
    animation: rise 0.5s cubic-bezier(0.3, 0.7, 0.3, 1) both;
    animation-delay: calc(var(--i) * 42ms);
    transform-origin: 50% 100%;
  }

  .chart span:last-child {
    background: var(--h-heart);
  }

  @keyframes rise {
    from { transform: scaleY(0.15); opacity: 0; }
  }

  .rows {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .rows li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.6875rem;
  }

  .dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--hue);
    flex: none;
  }

  .nm {
    font-weight: 600;
    color: #23262b;
  }

  .rows code {
    font-family: var(--mono);
    font-size: 0.625rem;
    color: #8a8f97;
    margin-inline-start: auto;
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.625rem;
    color: #6a6f77;
  }

  .foot code {
    font-family: var(--mono);
    color: #23262b;
  }

  .live {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--h-nutrition);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .ios-body {
    block-size: 100%;
    padding: 0.9rem 0.8rem;
    display: grid;
    align-content: start;
    gap: 0.15rem;
  }

  .k {
    font-family: var(--mono);
    font-size: 0.5625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #8a8f97;
  }

  .v {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: #14161a;
  }

  .dests {
    margin-block-start: 0.8rem;
    display: grid;
    gap: 0.42rem;
  }

  .dests li {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    font-size: 0.6875rem;
    font-weight: 500;
    color: #23262b;
  }

  .note {
    margin-block-start: auto;
    font-size: 0.5625rem;
    line-height: 1.4;
    color: #6a6f77;
  }

  figcaption {
    font-size: 0.75rem;
    color: #5c6169;
    text-align: center;
    max-inline-size: 26rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .chart span,
    .live {
      animation: none;
    }
    .chart span {
      opacity: 1;
      transform: none;
    }
  }
</style>
