---
/**
 * The family face, placed and centred.
 *
 * It centres on whatever point you give it, so the job is to pass the
 * container's *optical* middle — the middle of the screen, of the disc, of the
 * card — not the middle of the 32-box. Plozz's face sits at (16, 18) because
 * that is the middle of its screen, not of its TV.
 *
 * Choose the smile to suit how much room there is: `wide` when the container is
 * open, `compact` when it has detail to protect (Plozz does this), `small` when
 * it is tight. The eyes never change — they are the family signature.
 *
 * There is deliberately no scale, skew or rotate. A concept places and sizes
 * the face; it cannot redraw it.
 */
import { facePaths, type Smile } from '../../data/mark';

interface Props {
  cx?: number;
  cy?: number;
  smile?: Smile;
  gap?: number;
  fill?: string;
  opacity?: number | string;
}

const { cx = 16, cy = 16, smile = 'wide', gap = 2, fill = '#000', opacity } = Astro.props;
---

<g fill={fill} opacity={opacity} shape-rendering="crispEdges">
  {facePaths({ cx, cy, smile, gap }).map((d) => <path d={d} />)}
</g>
