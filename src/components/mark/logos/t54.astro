---
/**
 * t54 · Carrier Falloff
 *
 * Same body, tail and keyline. This is the restrained one: the light bands are
 * pushed hard into the tail with a power curve, so five of the eight tones are
 * spent in the bottom eighth of the mark and the rest of the bubble is one
 * calm field closed by two deep tones at the rim. Fewest edges of the four,
 * which is what survives being drawn 16 pixels wide.
 *
 * The face is the exact family 8×8 — `facePathsAt` at `md` with the
 * `compact` smile and a 2-row gap — centred on the body at (16, 14), tail
 * ignored, with 8 rows of air above it and 7 below. Nothing is cleared
 * for it: the calm field is sized from the glyph itself, so no band edge can
 * reach the face, and white on that one tone measures 5.94:1.
 *
 * 8 purple tones, one ink keyline, no gradients, nothing fetched.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Twozz — Carrier Falloff">
  <path d="M6 2h20v1h-20z M4 3h2v1h-2z M26 3h2v1h-2z M3 4h1v1h-1z M28 4h1v1h-1z M3 5h1v1h-1z M28 5h1v1h-1z M2 6h1v1h-1z M29 6h1v1h-1z M2 7h1v1h-1z M29 7h1v1h-1z M2 8h1v1h-1z M29 8h1v1h-1z M2 9h1v1h-1z M29 9h1v1h-1z M2 10h1v1h-1z M29 10h1v1h-1z M2 11h1v1h-1z M29 11h1v1h-1z M2 12h1v1h-1z M29 12h1v1h-1z M2 13h1v1h-1z M29 13h1v1h-1z M2 14h1v1h-1z M29 14h1v1h-1z M2 15h1v1h-1z M29 15h1v1h-1z M2 16h1v1h-1z M29 16h1v1h-1z M2 17h1v1h-1z M29 17h1v1h-1z M2 18h1v1h-1z M29 18h1v1h-1z M2 19h1v1h-1z M29 19h1v1h-1z M2 20h1v1h-1z M29 20h1v1h-1z M3 21h1v1h-1z M28 21h1v1h-1z M3 22h1v1h-1z M28 22h1v1h-1z M4 23h2v1h-2z M26 23h2v1h-2z M6 24h1v1h-1z M15 24h11v1h-11z M6 25h1v1h-1z M13 25h2v1h-2z M6 26h1v1h-1z M11 26h2v1h-2z M6 27h1v1h-1z M9 27h2v1h-2z M6 28h1v1h-1z M8 28h1v1h-1z M6 29h2v1h-2z" fill="#1a0e33" />
