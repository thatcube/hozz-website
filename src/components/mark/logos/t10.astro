---
/**
 * t10 · Calm
 *
 * The plainest bubble that still has weight. Radius 5, so the corners are
 * genuinely round rather than chamfered; the tail is a short pennant that
 * reaches the bottom of the safe area without dragging; and the only shading is
 * a single row of ground under the body, carried down through the tail — enough
 * to seat the shape, not enough to notice.
 *
 * Two fills and a face. No keyline, no highlight, no pip. If a plain purple
 * bubble is the right answer, this is the best-made version of it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
