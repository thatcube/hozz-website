---
/**
 * 35 · One Breath
 *
 * One circle, the largest the safe area allows, and nothing else in it.
 * Hozz is one held breath — the whole argument is that your own data can
 * sit somewhere calm and unwatched — so the mark is the calmest shape
 * there is, and the face gets more room here than in any other mark on the
 * board: six clear pixels above, below and to each side.
 *
 * The circle is the shipped Mozz disc, taken whole rather than rasterised
 * from a radius — the doubled rows and the four, four, two, two shoulder
 * are what stop it reading as an octagon.
 *
 * Six tones, every one taken off that silhouette. A dark keyline, two rings
 * of bevel stepping in from deep teal to the hue, then a light field with a
 * near-white arc over the top of it and a soft one under the bottom — one
 * ring cut at its waist, so the light has a direction without a shadow being
 * painted anywhere.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

