---
/**
 * 24 · Rosette, Bloom
 *
 * This replaces a lattice mark that was lovely at 96 pixels and mud at
 * 24. An app icon lives at small sizes, so this one is designed at the
 * small size and allowed to be plain at the large one.
 *
 * Six petals again, but bigger — `circles.circle(16)` on a ring of six —
 * and turned point-up rather than flat-up, so it stands vertically where
 * the six lies horizontally and the two cannot be confused. It is the
 * only portrait mark in the set.
 *
 * The banding is cut coarse on purpose: a one-pixel fringe, then two wide
 * steps, then everything from the fourth overlap inward as a single
 * lightest area. That last band is the six-pointed star, and cutting it
 * at four rather than five is what makes its points long enough to reach
 * out past the face instead of hiding behind it. Four areas survive being
 * four pixels across; a fine gradient does not.
 *
 * At this ring distance the petals overlap too far to leave a cleft in
 * the outline, so unlike the six the flower is carried entirely by the
 * star inside it. That is the trade: a bitten rim is the first thing to
 * go when the mark has to survive being twenty-four pixels wide.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Rosette, Bloom">
  <path d="M13 3h6v1h-6z M11 4h10v1h-10z M10 5h12v1h-12z M8 6h16v1h-16z M6 7h9v1h-9z M17 7h9v1h-9z M6 8h9v1h-9z M17 8h9v1h-9z M5 9h9v1h-9z M18 9h9v1h-9z M5 10h9v1h-9z M18 10h9v1h-9z M4 11h4v1h-4z M24 11h4v1h-4z M4 12h5v1h-5z M23 12h5v1h-5z M4 13h5v1h-5z M23 13h5v1h-5z M4 14h6v1h-6z M22 14h6v1h-6z M5 15h5v1h-5z M22 15h5v1h-5z M5 16h5v1h-5z M22 16h5v1h-5z M4 17h6v1h-6z M22 17h6v1h-6z M4 18h5v1h-5z M23 18h5v1h-5z M4 19h5v1h-5z M23 19h5v1h-5z M4 20h4v1h-4z M24 20h4v1h-4z M5 21h9v1h-9z M18 21h9v1h-9z M5 22h9v1h-9z M18 22h9v1h-9z M6 23h9v1h-9z M17 23h9v1h-9z M6 24h9v1h-9z M17 24h9v1h-9z M8 25h16v1h-16z M10 26h12v1h-12z M11 27h10v1h-10z M13 28h6v1h-6z" fill="#067567" />
