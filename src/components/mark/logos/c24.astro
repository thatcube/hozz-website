---
/**
 * 24 · Pocket
 *
 * A wallet with the pages still in it. Three sheets stand proud of the rim,
 * and the thumb-notch cut into the front panel shows the paper behind — the
 * notch is the whole idea: you can get the file out again.
 *
 * The face is centred on the front panel at (16, 21), which is the middle of
 * the pocket rather than of the mark, and sits below the notch.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

