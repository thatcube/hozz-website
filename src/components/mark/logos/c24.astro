---
/**
 * 24 · Pocket
 *
 * A sheet held in a wallet band. The band runs the full width and the sheet
 * is narrower, so the paper reads as tucked in rather than laid on top; the
 * earlier rim, thumb-notch and three-page fan have all gone, because they ate
 * the air around the face and added nothing the band does not already say.
 *
 * The face is centred on the paper *above* the band at (16, 11) — the middle
 * of the part you can still see.
 *
 * Drawn against the shared face geometry in `src/data/mark.ts` rather than a
 * hand-placed copy of it, so the eyes stay the family's eyes.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;

const face = facePathsAt({ cx: 16, cy: 11, size: 'sm', smile: 'wide' });
---

<MarkFrame size={size} title="Hozz — Pocket">
  <path d="M4 2h23v1h-23z" fill="#23291f" />
  <path d="M27 2h1v26h-1z" fill="#23291f" />
  <path d="M4 3h1v25h-1z" fill="#23291f" />
  <path d="M5 27h22v1h-22z" fill="#23291f" />
  <path d="M5 3h22v24h-22z" fill="#f8f5ec" />
  <path d="M2 20h9v1h-9z" fill="#23291f" />
  <path d="M21 20h9v1h-9z" fill="#23291f" />
  <path d="M2 21h1v8h-1z" fill="#23291f" />
  <path d="M10 21h1v2h-1z" fill="#23291f" />
  <path d="M21 21h1v2h-1z" fill="#23291f" />
  <path d="M29 21h1v8h-1z" fill="#23291f" />
  <path d="M11 22h1v1h-1z" fill="#23291f" />
  <path d="M20 22h1v1h-1z" fill="#23291f" />
  <path d="M11 23h3v1h-3z" fill="#23291f" />
  <path d="M18 23h3v1h-3z" fill="#23291f" />
  <path d="M13 24h6v1h-6z" fill="#23291f" />
  <path d="M2 29h28v1h-28z" fill="#23291f" />
  <path d="M3 21h7v4h-7z" fill="#5c6e5f" />
  <path d="M22 21h7v4h-7z" fill="#5c6e5f" />
  <path d="M10 23h1v1h-1z" fill="#5c6e5f" />
  <path d="M21 23h1v1h-1z" fill="#5c6e5f" />
  <path d="M10 24h3v1h-3z" fill="#5c6e5f" />
  <path d="M19 24h3v1h-3z" fill="#5c6e5f" />
  <path d="M3 25h26v4h-26z" fill="#5c6e5f" />
  <g fill="#23291f" shape-rendering="crispEdges">
    {face.map((d) => <path d={d} />)}
  </g>
</MarkFrame>
