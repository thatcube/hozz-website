---
/**
 * 24 · Rosette, Lattice
 *
 * Eight petals again, but each one is the *outline* of the canonical
 * circle rather than the filled disc — two pixels of it, peeled off by
 * erosion so the ring keeps the circle profile instead of needing a
 * second radius guessed to fit inside the first.
 *
 * The ring is rolled half a step so no petal sits on the horizontal axis.
 * That was worth finding: with a petal squarely on it, the two rows at
 * the equator were the only ones at full width and stood off the rim as a
 * pair of tabs. Rolled, the width climbs and falls smoothly.
 *
 * The rings cross, and the crossings — two rings deep — are the brightest
 * tone in the mark, brighter than the centre. That is the one place the
 * overlap rule is visible as light rather than as shape, and it leaves a
 * ring of dark cells ribbed apart by bright arcs.
 *
 * The silhouette is still the filled union, so there are no holes to the
 * paper; the lattice is painted inside it. The centre is a plain circle,
 * wide enough that the arcs which would otherwise cross the eyes are
 * absorbed into it.
 *
 * Busiest of the four by a distance. It holds at 32 and is ornament at
 * 16, which is an honest cost of the idea rather than a fault in it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

