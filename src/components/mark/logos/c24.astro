---
/**
 * 24 · Rosette, Bloom
 *
 * This replaces a lattice mark that was lovely at 96 pixels and mud at
 * 24. An app icon lives at small sizes, so this one is designed at the
 * small size and allowed to be plain at the large one.
 *
 * Six petals again, but bigger — `circles.circle(16)` on a ring of six —
 * and turned point-up rather than flat-up, so it stands vertically where
 * the six lies horizontally and the two cannot be confused.
 *
 * Everything narrow has been merged away. Depths one and two are one
 * band, three is a second, and everything deeper is the centre, which is
 * a canonical circle of near-white. What is left is three areas, not a
 * gradient: a mid-teal rim, a pale six-pointed star where the petals
 * agree, and a light middle with the face on it. Three areas survive
 * being four pixels across; eight rays do not.
 *
 * At this ring distance the petals overlap too far to leave a cleft in the
 * outline, so unlike the six the flower is carried entirely by the star
 * inside it. That is the trade: a bitten rim is the first thing to go
 * when the mark has to survive being twenty-four pixels wide.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Rosette, Bloom">
