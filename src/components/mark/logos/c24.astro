---
/**
 * 24 · Rosette, Lattice
 *
 * The same six-petal geometry, but each petal is an annulus two pixels
 * thick rather than a filled disc. The rings cross, and the crossings —
 * two rings deep — are the brightest tone in the mark, brighter than the
 * centre. That is the one place the overlap rule is visible as light
 * rather than as shape, and it leaves six dark cells ribbed apart by
 * bright arcs.
 *
 * The silhouette is still the filled union, so there are no holes to the
 * paper and the row-width rule holds; the lattice is painted inside it.
 * The centre is a plain disc, wide enough that the arcs which would
 * otherwise cross the eyes are absorbed into it and the face still reads
 * at 28 pixels.
 *
 * Busiest of the four by a distance. It holds at 48 and is ornament by
 * 16, which is an honest cost of the idea rather than a fault in it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

