---
/**
 * 16 · Breath
 *
 * Two soft lobes, bilateral, notched top and bottom, nested three deep so the
 * form reads as expanding outward from its own centre — a breath being taken.
 * The oldest measure there is, and nearly unused as a mark. No anatomy, no
 * trachea, no diagram: just a symmetry that looks like it is filling.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
