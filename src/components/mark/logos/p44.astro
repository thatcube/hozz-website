---
/**
 * p44 · Throw
 *
 * The same bevel as the Aperture, but lit. Ring depth still sets the level
 * lines — they follow the contour, so the structure is the object's, not a
 * pattern laid over it — while the *value* of each ring is pushed by its
 * angle to a source off-frame at the upper left.
 *
 * The result is a wall that runs bright along the top-left and deep along the
 * bottom-right without a single straight-edged band anywhere in it. The face
 * field is untouched by the push and stays one flat tone.
 *
 * 9 tones. Face: `md` + `compact` + gap 2, which is exactly 8x8,
 * centred on the container with 9 px of air either side and 6 above
 * and below. Nothing is cleared for it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Plozz — Throw">
