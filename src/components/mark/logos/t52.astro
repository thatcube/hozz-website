---
/**
 * t52 · Carrier Crest
 *
 * Same silhouette and same keyline as t51. What changes is that the light is
 * not a monotonic fade. A wave has a crest and a trough, so the four bands
 * nearest the tail run bright, back half a step, bright again, then fall — and
 * only after that does the ramp behave. It reads as a front passing through
 * the shape instead of a lamp shining into it.
 *
 * The face is the exact family 8×8 — `facePathsAt` at `md` with the
 * `compact` smile and a 2-row gap — centred on the body at (16, 14), tail
 * ignored, with 8 rows of air above it and 7 below. Nothing is cleared
 * for it: the calm field is sized from the glyph itself, so no band edge can
 * reach the face, and white on that one tone measures 5.94:1.
 *
 * 11 purple tones, one ink keyline, no gradients, nothing fetched.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

