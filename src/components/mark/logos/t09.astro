---
/**
 * t09 · Void
 *
 * The same bubble, knocked out of the purple instead of drawn on it. Nothing is
 * added — the square and the bubble were both already there, as figure and as
 * ground; this swaps which one is which, and the face inverts with it.
 *
 * The frame is 3 px so it survives the 16 px column, which a 2 px one does not.
 * The face is centred on the bubble body (16, 13) — 7 px of air left and right,
 * 5 above and below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Twozz — Void">
