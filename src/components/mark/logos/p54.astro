---
/**
 * p54 · Iris
 *
 * The corners cut straight at forty-five degrees instead of rounded. It is
 * the only silhouette in this set that is not a rectangle at 16px, which is
 * the whole reason it exists: the cuts survive being drawn four times
 * smaller, and the mark stays identifiable when the tones inside it have
 * collapsed into one.
 *
 * Light from above, and the sill cut deepest — four steps down from the
 * head, five down the jambs, six up from the sill — so the opening reads as
 * an iris stopped down rather than as a plate with a bevel. The contour does
 * the work of holding those three different depths together: because every
 * pixel is stepped by its distance from the silhouette, the rings meet the
 * chamfers square on instead of breaking across them.
 *
 * 14 by 10 of plain field, eight blues including the family keyline, and the
 * supplied face at md/compact, 8 by 8, centred at (16, 16).
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

