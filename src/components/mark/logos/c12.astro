---
/**
 * 12 · Preserve Jar
 *
 * A pale glass body and a warm lid, with no internal glint competing with the
 * face. The face is centred on the glass body alone; the lid is ignored.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 19, size: 'sm', smile: 'wide' } as const;
const box = faceBoxAt(face);
---

<MarkFrame size={size} title="Hozz — Preserve Jar">
  <path d="M9 2h14v1h-14z M7 3h18v1h-18z M6 4h20v1h-20z M6 5h20v1h-20z M6 6h20v1h-20z M7 7h18v1h-18z M5 8h22v1h-22z M3 9h26v1h-26z M2 10h28v1h-28z M2 11h28v1h-28z M2 12h28v1h-28z M2 13h28v1h-28z M2 14h28v1h-28z M2 15h28v1h-28z M2 16h28v1h-28z M2 17h28v1h-28z M2 18h28v1h-28z M2 19h28v1h-28z M2 20h28v1h-28z M2 21h28v1h-28z M2 22h28v1h-28z M2 23h28v1h-28z M2 24h28v1h-28z M2 25h28v1h-28z M2 26h28v1h-28z M2 27h28v1h-28z M3 28h26v1h-26z M6 29h20v1h-20z" fill="#31544b" />
  <path d="M8 3h16v1h-16z M7 4h18v1h-18z M7 5h18v1h-18z M8 6h16v1h-16z" fill="#b59b6a" />
  <path d="M5 9h22v1h-22z M3 10h26v1h-26z M3 11h26v1h-26z M3 12h26v1h-26z M3 13h26v1h-26z M3 14h26v1h-26z M3 15h26v1h-26z M3 16h26v1h-26z M3 17h26v1h-26z M3 18h26v1h-26z M3 19h26v1h-26z M3 20h26v1h-26z M3 21h26v1h-26z M3 22h26v1h-26z M3 23h26v1h-26z M3 24h26v1h-26z M3 25h26v1h-26z M3 26h26v1h-26z M3 27h26v1h-26z M4 28h24v1h-24z" fill="#cde2bd" />
  <g fill="#31544b" shape-rendering="crispEdges" data-face-box={`${box.x},${box.y},${box.w},${box.h}`}>
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
