---
/**
 * 10 · Ripple
 *
 * One record, and everywhere it reaches. The face rests on still water and the
 * wave it made is already on its way out - two rings seen almost edge-on, the
 * inner one still strong, the outer nearly given up. Not a bullseye: the rings
 * run behind the body and come out the other side, which is the point. It
 * leaves once, and only where you sent it.
 *
 * The rings carry the mark out to x 2 and 29 and down to y 29; the body carries
 * it up to y 2, so the silhouette fills the 28 safe area. The face is centred on
 * the body at (16, 13) - the middle of the thing it sits on, not of the box -
 * and the rings are concentric on x = 16 so they read as even either side.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Ripple">
