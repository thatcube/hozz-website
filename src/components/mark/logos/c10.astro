---
/**
 * 10 · Ripple
 *
 * One record, and everywhere it reaches. The face rests on still water and the
 * wave it made is already on its way out — two rings seen almost edge-on, the
 * near one still strong, the far one nearly given up. Not a bullseye: the rings
 * pass behind the body, which is the point. It leaves once, and only where you
 * sent it.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

