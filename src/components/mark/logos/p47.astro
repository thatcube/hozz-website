---
/**
 * p47 - Curved House
 *
 * A wide home-theatre panel with a real bend in it, carried on two blade feet.
 * The cabinet is milled straight, so the silhouette stays a clean rectangle,
 * and the curve is stated where a curve is actually visible: in the picture,
 * and in the side rails, which are a pixel deeper than the top and bottom
 * because the ends of a curved cabinet turn toward the room and show their
 * flank.
 *
 * The picture shades by column and by nothing else - no row here is ever
 * brighter or darker than the row above it. It falls three steps from the
 * middle out to each end as the glass turns away: ten flat columns through the
 * centre for the face to sit on, then 9, 8 and 7 outward. The frame is mitred,
 * so each border pixel belongs to whichever face of the moulding it is nearest
 * and the corners join at 45, and it lifts one step along its inside edge
 * where the picture spills onto it. The feet are lit from above by the screen
 * and go dark where they meet the floor.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

