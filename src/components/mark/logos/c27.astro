---
/**
 * 27 · Sage Heart
 *
 * Green is the colour health data is usually reported in when nothing
 * is wrong, which is the tone Hozz wants.
 *
 * The silhouette is shared across 26–30 so the five read as one colour study
 * rather than five ideas. It is a heart drawn wide: crowns four pixels across,
 * a cleft carved four rows deep, shoulders held out to the full 28 until row
 * 12, and a straight diagonal to a two-pixel tip. The edge tone is a deeper
 * step of the body rather than near-black, which is the single thing that
 * stops a 32×32 heart reading as a game sprite.
 *
 * Three fills: edge (the ring and the rim under the lobes are the same
 * colour), body, and the face’s ink.
 *
 * The face is the small one, eyes only. A heart narrows fast, so a smile would
 * have had to sit in the taper; two Zs on their own sit in open field. It is
 * centred at (16, 14) — the shape’s measured centroid is y 14.2, well above
 * the box centre, which is where a heart’s optical middle actually is.
 * Measured air: 8 left, 8 right, 5 above, 7 below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Sage Heart">
  <path d="M8 2h4v1h-4z M20 2h4v1h-4z M6 3h2v1h-2z M12 3h1v1h-1z M19 3h1v1h-1z M24 3h2v1h-2z M5 4h1v1h-1z M13 4h1v1h-1z M18 4h1v1h-1z M26 4h1v1h-1z M4 5h1v1h-1z M14 5h1v1h-1z M17 5h1v1h-1z M27 5h1v1h-1z M3 6h1v1h-1z M15 6h2v1h-2z M28 6h1v1h-1z M2 7h1v1h-1z M29 7h1v1h-1z M2 8h1v1h-1z M29 8h1v1h-1z M2 9h1v1h-1z M29 9h1v1h-1z M2 10h1v1h-1z M29 10h1v1h-1z M2 11h1v1h-1z M29 11h1v1h-1z M2 12h1v1h-1z M29 12h1v1h-1z M3 13h1v1h-1z M28 13h1v1h-1z M3 14h1v1h-1z M28 14h1v1h-1z M3 15h1v1h-1z M28 15h1v1h-1z M4 16h1v1h-1z M27 16h1v1h-1z M4 17h1v1h-1z M27 17h1v1h-1z M5 18h1v1h-1z M26 18h1v1h-1z M5 19h1v1h-1z M26 19h1v1h-1z M6 20h1v1h-1z M25 20h1v1h-1z M7 21h1v1h-1z M24 21h1v1h-1z M8 22h1v1h-1z M23 22h1v1h-1z M9 23h1v1h-1z M22 23h1v1h-1z M10 24h1v1h-1z M21 24h1v1h-1z M11 25h1v1h-1z M20 25h1v1h-1z M12 26h1v1h-1z M19 26h1v1h-1z M13 27h1v1h-1z M18 27h1v1h-1z M14 28h1v1h-1z M17 28h1v1h-1z M15 29h2v1h-2z" fill="#5f8455" />
  <path d="M8 3h4v1h-4z M20 3h4v1h-4z M6 4h7v1h-7z M19 4h7v1h-7z M5 5h9v1h-9z M18 5h9v1h-9z M4 6h11v1h-11z M17 6h11v1h-11z M3 7h26v1h-26z M3 8h26v1h-26z M3 9h26v1h-26z M3 10h26v1h-26z M3 11h26v1h-26z M3 12h26v1h-26z M4 13h24v1h-24z M4 14h24v1h-24z M4 15h24v1h-24z M5 16h22v1h-22z M5 17h22v1h-22z M6 18h20v1h-20z M6 19h20v1h-20z M7 20h18v1h-18z M8 21h16v1h-16z M9 22h14v1h-14z M10 23h12v1h-12z M11 24h10v1h-10z M12 25h8v1h-8z M13 26h6v1h-6z M14 27h4v1h-4z M15 28h2v1h-2z" fill="#93b177" />
