---
/**
 * 34 · Warm Centre
 *
 * A warm, unusually wide centre keeps health human and gives the floating face the quietest breath in the set.
 *
 * Two narrow warm rings leave an 18-row centre covering two thirds of the mark. The field is 66.7% of the painted area, leaving
 * the rings subordinate to the face rather than turning the mark into a bevel.
 *
 * The face uses the measured sm/gap2 geometry:
 * field y4-21,
 * 5px air above and 5px below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
