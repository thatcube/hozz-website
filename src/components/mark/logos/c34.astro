---
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'sm', smile: 'none' } as const;
const box = faceBoxAt(face);
const air = [box.x - 7, 25 - box.right, box.y - 7, 25 - box.bottom];
if (Math.min(...air) < 6) throw new Error('c34 face needs six clear pixels');
---

<MarkFrame size={size} title="Hozz — Near Moon">
  <path d="M13 8h7v1h-7z M10 9h13v1h-13z M9 10h14v1h-14z M9 11h14v1h-14z M8 12h15v1h-15z M8 13h15v1h-15z M8 14h15v1h-15z M8 15h15v1h-15z M8 16h15v1h-15z M8 17h15v1h-15z M8 18h14v1h-14z M8 19h14v1h-14z M8 20h13v1h-13z M9 21h11v1h-11z M10 22h7v1h-7z" fill="#d8cfb3" />
  <path d="M22 8h1v1h-1z M23 9h1v1h-1z M23 10h1v1h-1z M23 11h2v1h-2z M23 12h2v1h-2z M23 13h2v1h-2z M23 14h2v1h-2z M23 15h2v1h-2z M23 16h2v1h-2z M23 17h2v1h-2z M22 18h3v1h-3z M22 19h3v1h-3z M21 20h3v1h-3z M20 21h4v1h-4z M8 22h2v1h-2z M17 22h6v1h-6z M9 23h13v1h-13z M12 24h7v1h-7z" fill="#b9a873" />
  <path d="M24 10h1v1h-1z M25 12h1v1h-1z M25 13h1v1h-1z M25 14h1v1h-1z M25 15h1v1h-1z M25 16h1v1h-1z M25 17h1v1h-1z M25 18h1v1h-1z M25 19h1v1h-1z M24 20h2v1h-2z M24 21h1v1h-1z M23 22h2v1h-2z M22 23h2v1h-2z M10 24h2v1h-2z M19 24h4v1h-4z M13 25h7v1h-7z" fill="#938046" />
  <path d="M13 7h7v1h-7z M10 8h3v1h-3z M20 8h2v1h-2z M9 9h1v1h-1z M8 10h1v1h-1z M8 11h1v1h-1z M7 12h1v1h-1z M7 13h1v1h-1z M7 14h1v1h-1z M7 15h1v1h-1z M7 16h1v1h-1z M7 17h1v1h-1z M7 18h1v1h-1z M7 19h1v1h-1z M7 20h1v1h-1z M8 21h1v1h-1z" fill="#e4dfce" />
  <path d="M13 6h7v1h-7z M10 7h3v1h-3z M20 7h3v1h-3z M9 8h1v1h-1z M23 8h1v1h-1z M8 9h1v1h-1z M24 9h1v1h-1z M7 10h1v1h-1z M25 10h1v1h-1z M7 11h1v1h-1z M25 11h1v1h-1z M6 12h1v1h-1z M26 12h1v1h-1z M6 13h1v1h-1z M26 13h1v1h-1z M6 14h1v1h-1z M26 14h1v1h-1z M6 15h1v1h-1z M26 15h1v1h-1z M6 16h1v1h-1z M26 16h1v1h-1z M6 17h1v1h-1z M26 17h1v1h-1z M6 18h1v1h-1z M26 18h1v1h-1z M6 19h1v1h-1z M26 19h1v1h-1z M6 20h1v1h-1z M26 20h1v1h-1z M7 21h1v1h-1z M25 21h1v1h-1z M7 22h1v1h-1z M25 22h1v1h-1z M8 23h1v1h-1z M24 23h1v1h-1z M9 24h1v1h-1z M23 24h1v1h-1z M10 25h3v1h-3z M20 25h3v1h-3z M13 26h7v1h-7z" fill="#4c4223" />
  <g fill="#344740" shape-rendering="crispEdges">
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
