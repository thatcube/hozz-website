---
/**
 * 34 · Set, Console
 *
 * The same set with the bezel taken almost all the way off.
 *
 * One pixel of case between the keyline and the glass — as thin as it goes
 * while still being a frame — so the tube carries the depth on its own. The
 * two steps of shadow the bezel throws across the top and left of the screen
 * are doing the work that a three-pixel frame does in p33, which is the point:
 * the depth was never in the frame's width.
 *
 * Because the frame is thin the case can be square-cornered at one step, and
 * because there is no neck the stand is a single wide plinth fused straight to
 * the case bottom. The result is the most screen of the four and the flattest
 * stance — a console rather than a portable.
 *
 * Same light, same tones, same face, centred on the screen.
 *
 * Measured: case 26×20, bezel 1 at the sides and 1 at the top,
 * screen 22×16, and a flat core of 19×13 with the face on it —
 * 5 clear pixels to its left, 6 to its right, 2 above and 3 below.
 * 10 tones, one light, upper left.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Plozz — Set, Console">
