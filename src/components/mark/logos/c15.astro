---
/**
 * 15 · Cadence
 *
 * A pulse written as rhythm rather than as a waveform. One beat and its
 * decay, notated under the face as four marks that shorten and lighten —
 * a measure, not an ECG trace. They differ in *width*, which is the one
 * difference that survives being halved twice, and the figure is asymmetric,
 * which is what stops a row of marks under a face reading as teeth. Rhythm is
 * what a body keeps; the squiggle is only how a machine draws it.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

