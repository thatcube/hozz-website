---
/**
 * 33 · Set, Soft
 *
 * The same set with the corners let out and the stand put away.
 *
 * Three steps of corner instead of one, which is as soft as 32 pixels will go
 * before the case stops being a box, and a third pixel of bezel all round so
 * the softness has something to be soft against.
 *
 * The stand is folded into the body: the case runs down past the screen and
 * steps in once at the bottom into a skirt, so the mark stands on itself. That
 * is the whole difference in silhouette, and it is deliberate — this is the
 * variant for places where a protruding foot would be the first thing to break.
 *
 * Same light, same well, same face. The deeper bezel costs the screen two
 * pixels each way, which is the price of the softer case and is visible in the
 * measured air below.
 *
 * Measured: case 26×24, bezel 3 at the sides and 3 at the top,
 * screen 18×16, and a flat core of 15×13 with the face on it —
 * 3 clear pixels to its left, 4 to its right, 2 above and 3 below.
 * 10 tones, one light, upper left.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Plozz — Set, Soft">
