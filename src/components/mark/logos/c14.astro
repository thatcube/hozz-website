---
/**
 * 14 · Close
 *
 * A ring that has almost come round. One measure of one day: a single open arc
 * with a warm head where it has got to, and a quarter still to go. The band is
 * two tones deep — a cool rim with light banked inside it — so it reads as a
 * ring within a ring at size and as one calm rim at 16px. One ring, not three,
 * and nowhere near Apple's hues: the idea is *a day closing*, which is a thing
 * you feel rather than a thing a clinic does to you.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
