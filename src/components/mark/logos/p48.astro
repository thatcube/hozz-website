---
/**
 * p48 - Masking Frame
 *
 * A fixed-frame projection screen. No stand, no housing, no hardware: the
 * whole object is the mask, and the picture is a hole cut in it. The aperture
 * sits high, because a fixed-frame screen carries its deepest rail along the
 * bottom, and that one asymmetry is what stops a plain rectangle reading as a
 * plain rectangle.
 *
 * The mask stands proud of the picture, so it drops a shadow onto the screen
 * that runs the whole way around the aperture. The three rings here are that
 * thickness measured inward, pixel by pixel - not a gradient laid over the top
 * - which is why they turn the corners instead of stopping at the sides. The
 * mask itself is mitred at 45 and lifts wherever the picture comes nearest to
 * it, the screen washing back onto the moulding. Past the third ring the
 * picture is one flat tone, and the face sits in that.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

