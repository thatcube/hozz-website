---
/**
 * 32 · Set, Wide
 *
 * The same set, widened, and low.
 *
 * One variable at a time. The case grows to the full safe width and loses two
 * rows of height, the corners come back from two steps to one so the wider
 * case does not read as soft, and the side bezels take the extra pixel the
 * width bought rather than the screen taking it — a wide set has thick cheeks.
 *
 * The stand is the p31 plinth cut in half and moved out under the ends, which
 * is the one change that alters the silhouette rather than the surface: at
 * 16px this is the variant you recognise by its gap, not by its screen.
 *
 * Same light, same tones, same face, same construction of the well. What is
 * different is proportion, corner rhythm, bezel depth and where the mark
 * touches the ground.
 *
 * Measured: case 28×22, bezel 3 at the sides and 2 at the top,
 * screen 20×16, and a flat core of 17×13 with the face on it —
 * 4 clear pixels to its left, 5 to its right, 2 above and 3 below.
 * 10 tones, one light, upper left.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

