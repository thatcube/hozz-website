---
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'none' } as const;
const box = faceBoxAt(face);
const air = [box.x, 31 - box.right, box.y, 31 - box.bottom];
if (Math.min(...air) < 6) throw new Error('c36 face needs six clear pixels');
---

<MarkFrame size={size} title="Hozz — Just Zs">
  <path d="M12 14h3v1h-3z M13 15h2v1h-2z M12 16h2v1h-2z M12 17h3v1h-3z" fill="#1e2a27" />
  <path d="M17 14h3v1h-3z M18 15h2v1h-2z M17 16h2v1h-2z M17 17h3v1h-3z" fill="#1e2a27" />
  <g fill="#6f9289" shape-rendering="crispEdges">
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
