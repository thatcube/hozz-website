---
/**
 * 36 · Two Circles
 *
 * The plainest of the breath references: two concentric circles, the inner
 * one the field the face sits on and the outer a four-pixel surround — the
 * widest ring on the board. The
 * breath is the inner circle; the room around it is the argument. Hozz keeps
 * your data in a place that has space around it.
 *
 * Both circles are canonical — the shipped Mozz disc at 28 across and the
 * derived one at 22 — so they are the same circle at two sizes rather than
 * two different rasterisations, and they agree.
 *
 * Six tones. The surround carries the Hozz hue so the mark still reads teal
 * at 16px, and it darkens along its underside; the inner circle takes a
 * near-white arc over the top and a soft one beneath. No keyline between the
 * two circles: they meet tone to tone, which is what keeps this the quiet
 * one of the four.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

