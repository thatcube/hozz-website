---
/**
 * t05 · Even
 *
 * The shipped bubble, redrawn rather than redesigned. Nothing is added: no pip,
 * no badge, no second bubble. What changes is craft — the corners step evenly
 * at radius 4 instead of collapsing into a single notch, the tail is a straight
 * pennant off the bottom-left rather than a curl, and the volume comes from one
 * shading step that wraps the right edge into the underside and the tail, so
 * the mark reads as a solid object lit from the upper left.
 *
 * The face sits on the optical centre of the *body* (16, 12.5), not of the
 * silhouette — the tail is chrome, exactly as Plozz treats its legs. At size
 * `md` that leaves 9 px of air left, 5 right, 5 above and 5 below.
 *
 * Body plus keyline fills the 28 safe area, x/y 2–29.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
