---
/**
 * p45 · Reflector
 *
 * Glass, which is the other honest way to say *screen* without drawing a
 * button. A two-pixel case carries a lit upper edge and a shaded lower one,
 * then a black bezel, then a front surface with a rim vignette falling into
 * the corners.
 *
 * Two specular streaks are struck at 45° across the left band. They are
 * deliberately asymmetric — a reflection is a fact about where the light is,
 * and a mirrored pair would read as decoration — and they are clipped a pixel
 * clear of the face box, so the field under the ZZ is one flat tone.
 *
 * 9 tones. Face: `md` + `compact` + gap 2, which is exactly 8x8,
 * centred on the container with 10 px of air either side and 7 above
 * and below. Nothing is cleared for it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Plozz — Reflector">
