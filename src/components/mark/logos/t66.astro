---
/**
 * t66 · Open Wide — dimensional open chat frame.
 *
 * The carrier is a 28-safe outline: a closed band around an explicit
 * interior opening, with the tail cut from the same silhouette so it is part
 * of the frame rather than an appendage. This one is the widest and flattest
 * open frame, a stadium, tail under the left shoulder; key light rakes in
 * almost horizontally from the left.
 *
 * The band is shaded as a half-round tube. Across its 6px width the surface
 * turns from the outer edge to the crest to the inner wall, and every pixel
 * is lit by a point light at (-4, 5, 12), plus a narrow specular and a
 * little bounce on the shadow side. That resolves to nine purples, and a
 * tenth as the one-pixel keyline that holds the silhouette together at
 * favicon sizes. No gradients and no raster: every pixel is a flat fill on
 * the 32 grid.
 *
 * The interior stays pale so the face has maximum contrast, and carries a
 * one-pixel cast shadow on the lit side so the opening reads as depth rather
 * than as a hole-shaped sticker.
 *
 * Face is the shared 8x8 at md / compact / gap 2, centred on (16, 14) -
 * identical across t63 to t66, which is what makes them one family.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;

const face = facePathsAt({ cx: 16, cy: 14, size: 'md', smile: 'compact', gap: 2 });
---

