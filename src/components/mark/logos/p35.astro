---
/**
 * p35 · Panel, Recessed
 *
 * A flat panel, not a television set. The slab is 28 across and 19 down, two
 * pixels wider than its glass on every side, so the keyline and the bezel are
 * separate things and the frame reads as a frame rather than as an outline.
 * The glass is 24 x 14 — the widest sensible rectangle the 28-pixel safe area
 * will carry — and the chin under it is three rows deep against one above.
 *
 * Depth is Hozz's concentric falloff, not stacked bands. A normalised radius is
 * measured from the middle of the glass, mostly Chebyshev so the tones follow
 * the shape of the rectangle, softened with enough Euclidean to turn the
 * corners. The rim is the palest tone and each ring inward is one small step
 * down. Because the glass is wider than it is tall there is more room at the
 * sides than above it, and more of the ramp shows there — which is what a
 * vignette on a wide surface actually does. No tone spans a row without also
 * running down the sides, so nothing reads as a horizontal band.
 *
 * The face field is calm by construction: the field is attenuated to a single
 * value across the face box and blended back out over roughly a pixel, so the
 * ZZ sits on plain glass and no plate edge is ever drawn around it.
 *
 * The plinth is part of the silhouette. The panel's bottom keyline breaks where
 * the neck meets it, and the wedge widens a pixel a row into the foot.
 *
 * 10 tones. The supplied face — facePathsAt, md, compact, gap 2, exactly 8 x 8
 * — centred on the middle of the glass at (16, 13): 8 columns of air either
 * side, 3 rows above and below. The mark is 28 x 24 on the 28 safe area and
 * centres on (16, 16).
 */

import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

