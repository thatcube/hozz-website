---
/**
 * 22 · Rosette, Six
 *
 * Six translucent circles on a ring of 6.0, radius 8.0. Every pixel is
 * toned by how many circles cover it, so the six-lobed star in the middle
 * is not drawn: it is the region three or more petals agree on.
 *
 * The rim is chamfered rather than scalloped. A pixel circle widens by
 * four at its cap, which would be a spur, so each row is clamped to at
 * most two wider than the row above it — done symmetrically about x=16,
 * top-down and bottom-up. The flower therefore reads from the banding
 * inside, which is where the idea lives anyway.
 *
 * The bright centre is a plain concentric disc so the face never sits on
 * a ragged star. Its height and offset come from the measured face table,
 * never computed here.
 *
 * Six tones: keyline, three depth bands, the centre, and the face in the
 * keyline colour. A cooler sea-teal than the brand hue, because the
 * reference this borrows from is teal too.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Rosette, Six">
