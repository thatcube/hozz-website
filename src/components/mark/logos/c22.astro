---
/**
 * 22 · Rosette, Six
 *
 * Six identical circles, each one `circles.circle(14)` translated seven
 * pixels off centre and nothing more. Not a radius test in sight: the
 * petal profile is the one lifted off the shipped Mozz mark, so all six
 * petals are the same shape to the pixel, as they plainly are in the
 * reference.
 *
 * Every pixel is toned by how many circles cover it, so the star is not
 * drawn — it is the region three or more petals agree on. The ring is
 * turned flat-side-up, which puts two petals on the centre line and makes
 * the silhouette widen once and narrow once. That matters: a rosette
 * whose widest row sat halfway up would have a spur, and this one cannot.
 *
 * The bright centre is another canonical circle, concentric, so the face
 * never sits on a ragged star. Its height and offset come from the
 * measured face table, never computed here.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

