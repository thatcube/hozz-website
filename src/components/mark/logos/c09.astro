---
/**
 * 09 · Vapour
 *
 * Breath on a cold morning: a puff caught mid-drift, lit hard from above so the
 * crown burns out almost to nothing and only the underside keeps its grey.
 * Deliberately lumpy and deliberately not flat-bottomed - a flat-bottomed cloud
 * means cloud storage, and Hozz has no cloud. A few specks have already come
 * loose at the edges.
 *
 * The puff fills the 28 safe area, x/y 2-29. Its lumps are uneven but its mass
 * balances on x = 16, so the face sits at (16, 16) - the middle of the body,
 * not of any one lump - with the compact smile, because the silhouette around
 * it is busy.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Vapour">
