---
/**
 * 09 · Vapour
 *
 * Breath on a cold morning: a puff caught mid-drift, lit hard from above so the
 * top edge burns out almost to nothing and only the underside keeps its grey.
 * Deliberately lumpy and stepped, and deliberately not flat-bottomed — a
 * flat-bottomed cloud means cloud storage, and Hozz has no cloud. Two specks
 * have already come loose at the top right.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

