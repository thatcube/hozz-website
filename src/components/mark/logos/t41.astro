---
/**
 * t41 · Rim
 *
 * The oval struck rather than shaded.
 *
 * The other three vary tone with depth into the shape. This one varies it
 * with direction around the shape: a band of fixed thickness — three pixels,
 * in three fixed steps — whose tone turns right round the perimeter, from a
 * near-white catch at the upper left to the deepest violet at the lower
 * right. Inside the band nothing happens at all. The field is one colour, and
 * it stays that colour to the outline.
 *
 * That is the least tone spend of the four, and it is deliberate. A mark this
 * size spends most of its life at 16 and 28 pixels, where soft falloff turns
 * to mud and a struck edge does not. The flat field is also the most generous
 * thing you can put a white face on: one tone, 5.15:1, no gradient creeping
 * under the eyes.
 *
 * The tail is the stubbiest of the four for the same reason — a short, wide
 * pointer holds its shape when a long one has thinned to a smudge. It is
 * still one field with the body, and the perimeter band runs round it without
 * interruption, which is what stops it reading as an attachment.
 *
 * Ten violets.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Strozz — Rim">
  <path d="M12 2h8v1h-8z M9 3h3v1h-3z M20 3h3v1h-3z M7 4h2v1h-2z M23 4h2v1h-2z M6 5h1v1h-1z M25 5h1v1h-1z M5 6h1v1h-1z M26 6h1v1h-1z M4 7h1v1h-1z M27 7h1v1h-1z M3 8h1v1h-1z M28 8h1v1h-1z M3 9h1v1h-1z M28 9h1v1h-1z M2 10h1v1h-1z M29 10h1v1h-1z M2 11h1v1h-1z M29 11h1v1h-1z M2 12h1v1h-1z M29 12h1v1h-1z M2 13h1v1h-1z M29 13h1v1h-1z M2 14h1v1h-1z M29 14h1v1h-1z M3 15h1v1h-1z M28 15h1v1h-1z M3 16h1v1h-1z M28 16h1v1h-1z M3 17h1v1h-1z M28 17h1v1h-1z M4 18h1v1h-1z M27 18h1v1h-1z M5 19h1v1h-1z M26 19h1v1h-1z M6 20h1v1h-1z M25 20h1v1h-1z M7 21h1v1h-1z M23 21h2v1h-2z M8 22h1v1h-1z M19 22h4v1h-4z M9 23h1v1h-1z M16 23h3v1h-3z M9 24h1v1h-1z M14 24h2v1h-2z M9 25h1v1h-1z M13 25h1v1h-1z M10 26h1v1h-1z M12 26h1v1h-1z M10 27h2v1h-2z" fill="#231349" />
