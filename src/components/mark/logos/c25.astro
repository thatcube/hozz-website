---
/**
 * 25 · Rosette, Five
 *
 * Five circles, which is the one count with no mirror pair top to bottom,
 * so the pentafoil sits point-up and the two halves of the mark are
 * genuinely different shapes.
 *
 * The odd count also rules out a circular centre: an odd-row silhouette
 * cannot hold an even-row circle with equal air above and below. So this
 * is the only one of the four whose bright field is the *deep overlap
 * itself* — the region all five petals cover. The five-pointed shape the
 * face sits on is the rule made visible, not a disc laid on top of it.
 *
 * Flattest of the four on purpose. Depths one to three are collapsed into
 * a single band, so what is left is a pentagon outline, one step of shade
 * and the field. Nothing gradates, and it is the one that still reads as
 * a five-sided object at 16 pixels.
 *
 * Soft mint — the least saturated of the set.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

