---
/**
 * 25 · Tag
 *
 * The label you tie to the thing you are keeping: a chamfered kraft tag with a
 * real punched hole and an ochre header rule. The hole is a knockout, so it
 * reads as a hole on paper and on ink.
 *
 * The face is centred on the label field below the rule (16, 21), not on the
 * whole tag — the hole and the header are chrome.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Tag">
  <path d="M11 3h10v1h-10z" fill="#e9dcc0" />
