---
/**
 * 25 · Rosette, Five
 *
 * Five circles, ring 5.0, radius 9.0. Odd counts have no mirror pair top
 * to bottom, so the pentafoil sits off-centre by construction and the
 * face is placed to equalise air against the silhouette, not the grid.
 *
 * Flattest of the four on purpose: the depth map is collapsed to two
 * bands plus a wide centre, so what is left is the outer boundary, one
 * step of shade, and a five-pointed field. Nothing gradates.
 *
 * This is the one that still reads as a single object at 16 pixels, and
 * the one that gives up the most of the flower to get there.
 *
 * Soft mint — the least saturated of the set.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

