---
/**
 * t06 · Quiet
 *
 * t05 with the smile removed. That is the entire change, and it is the point:
 * the two Zs read as a face on their own, and dropping the smile buys five more
 * rows of empty purple, so the face stops sitting *in* the bubble and starts
 * floating in it.
 *
 * Air at size `md`, smile `none`: 9 left, 5 right, 8 above, 7 below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
