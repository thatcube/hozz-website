---
/**
 * t53 · Carrier Shoulder
 *
 * Same body and tail. The focus moves from the tip of the tail to the point
 * where the tail meets the body, which is inside the silhouette rather than at
 * its edge. Contours struck from inside curve far harder: they wrap the lower
 * left and rise across the bubble at a steep angle, with no chance of reading
 * as a slab anywhere.
 *
 * The face is the exact family 8×8 — `facePathsAt` at `md` with the
 * `compact` smile and a 2-row gap — centred on the body at (16, 14), tail
 * ignored, with 8 rows of air above it and 7 below. Nothing is cleared
 * for it: the calm field is sized from the glyph itself, so no band edge can
 * reach the face, and white on that one tone measures 5.94:1.
 *
 * 9 purple tones, one ink keyline, no gradients, nothing fetched.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
