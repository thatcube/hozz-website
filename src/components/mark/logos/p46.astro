---
/**
 * p46 · Well
 *
 * The bevel taken in discrete steps instead of a smooth ramp: three concentric
 * plates, each two pixels deep, receding to the light at the bottom.
 *
 * Each plate is shaded as a recess rather than as a raised lid — the upper
 * wall is in shadow and the lower one catches the light, which is the reverse
 * of a boss and the reason this reads as a hollow you are looking into. The
 * walls are measured against the whole solid at each step, not against the
 * ring, because a ring has two top edges and shading both is what makes a
 * bevel lie flat like a picture frame.
 *
 * 11 tones. Face: `md` + `compact` + gap 2, which is exactly 8x8,
 * centred on the container with 9 px of air either side and 9 above
 * and below. Nothing is cleared for it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

