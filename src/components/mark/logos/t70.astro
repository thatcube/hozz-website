---
/**
 * t70 · Live
 *
 * Mozz's disc is lit by something close to it, and that is why it reads as an
 * object rather than a shape. The same lamp, moved to a bubble.
 *
 * The source is a near point held just off the top-right shoulder, so the
 * falloff is inverse-square rather than linear: a tight bright hotspot, then a
 * long fast drop into shadow across the far half of the mark. A distant light
 * flattens everything; a near one makes a small surface look curved and makes
 * the far side genuinely dark, which is where the sense of presence comes
 * from — a lit thing in a room, caught mid-broadcast.
 *
 * The level lines are therefore circles centred outside the mark, which is the
 * one arrangement none of the other three here use — a straight band, a
 * silhouette contour and an arc struck from the tail. Body and tail take the
 * same lamp and the same falloff, and share one exact outline, so the tail
 * darkens as part of the object rather than as a shape appended to it.
 *
 * The carrier is a plain rounded bubble with a short stepped tail. The face is
 * the family's md/compact/gap-2, flattened to one calm tone so the hotspot
 * stops short of the eyes.
 *
 * 9 tones, deep violet to magenta.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Twozz — Live">
