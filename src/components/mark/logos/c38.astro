---
/**
 * 38 · Held
 *
 * A soft-cornered square with a breath inside it. The square is the thing
 * you own — the phone, the machine under the desk, the app icon itself —
 * and the circle inside is what is being kept there. It is the only one of
 * the four with a container, and it sits closest to the siblings, which are
 * all square in outline.
 *
 * The corner is four pixels deep and no more, so the form reads square and
 * not as a circle that has been squared off — twenty rows of the mark are
 * full width and flat-sided. The circle inside is the canonical one at 22
 * across and it carries its own dark keyline, so it reads as an object set
 * into the square rather than a hole cut out of it. That keyline is the
 * whole difference between this mark and the two-circle one.
 *
 * Six tones. The square stays flat — a container should not compete —
 * and all the light is spent on the circle: near-white over the top of it,
 * soft underneath.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
