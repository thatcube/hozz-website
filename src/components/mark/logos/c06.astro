---
/**
 * 06 · Nightkeep
 *
 * A moon held in shadow with one cool edge. The companion star shares that
 * single light colour, so it distinguishes the silhouette without adding a
 * second highlight treatment.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'wide' } as const;
const box = faceBoxAt(face);
---

<MarkFrame size={size} title="Hozz — Nightkeep">
  <path d="M12 2h8v1h-8z M10 3h12v1h-12z M8 4h16v1h-16z M7 5h18v1h-18z M6 6h20v1h-20z M5 7h22v1h-22z M4 8h24v1h-24z M4 9h24v1h-24z M3 10h26v1h-26z M3 11h26v1h-26z M2 12h28v1h-28z M2 13h28v1h-28z M2 14h28v1h-28z M2 15h28v1h-28z M2 16h28v1h-28z M2 17h28v1h-28z M2 18h28v1h-28z M2 19h28v1h-28z M3 20h26v1h-26z M3 21h26v1h-26z M4 22h24v1h-24z M4 23h24v1h-24z M5 24h22v1h-22z M6 25h20v1h-20z M7 26h18v1h-18z M8 27h16v1h-16z M10 28h12v1h-12z M12 29h8v1h-8z" fill="#131a2b" />
  <path d="M12 3h8v1h-8z M10 4h12v1h-12z M8 5h16v1h-16z M7 6h18v1h-18z M6 7h20v1h-20z M5 8h22v1h-22z M5 9h22v1h-22z M4 10h24v1h-24z M4 11h24v1h-24z M3 12h26v1h-26z M3 13h26v1h-26z M3 14h26v1h-26z M3 15h26v1h-26z M3 16h26v1h-26z M3 17h26v1h-26z M3 18h26v1h-26z M3 19h26v1h-26z M4 20h24v1h-24z M4 21h24v1h-24z M5 22h22v1h-22z M5 23h22v1h-22z M6 24h20v1h-20z M7 25h18v1h-18z M8 26h16v1h-16z M10 27h12v1h-12z M12 28h8v1h-8z" fill="#25334a" />
  <path d="M27 2h1v1h-1z M26 3h3v1h-3z M27 4h1v1h-1z M25 7h1v1h-1z M25 8h2v1h-2z M25 9h2v1h-2z M25 10h3v1h-3z M25 11h3v1h-3z M25 12h4v1h-4z M25 13h4v1h-4z M25 14h4v1h-4z M25 15h4v1h-4z M25 16h4v1h-4z M25 17h4v1h-4z M25 18h4v1h-4z M25 19h4v1h-4z M25 20h3v1h-3z M25 21h3v1h-3z M25 22h2v1h-2z M25 23h2v1h-2z M25 24h1v1h-1z" fill="#647e99" />
  <g fill="#e6edf0" shape-rendering="crispEdges" data-face-box={`${box.x},${box.y},${box.w},${box.h}`}>
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
