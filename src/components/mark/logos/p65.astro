---
/**
 * p65 · Dome
 *
 * A bowed faceplate, the way a tube front is bowed: brightest where the
 * surface is flat to you, banded where it turns away.
 *
 * The depth is not a bevel. Every pixel is scored by its distance from the rim
 * — one at the edge, zero in the middle — so the middle is flat by
 * construction rather than by being cleared. That score is then tilted along
 * the upper-left to lower-right diagonal, so the same curvature reads as a
 * shallow shoulder where the light lands and a steep, compressed fall where it
 * does not. The bands are wide at the top-left and crushed at the bottom-right,
 * which is what curvature under a fixed light actually looks like.
 *
 * The core is the palest stop in the scale, near-white, so the plate reads as
 * lit from behind rather than merely pale. That is the risk in this one: a
 * bright middle inside a blue rim, shrunk to 16px, is the closest of the four
 * to a token. It is held off by the silhouette — 26 across and 22 down with a
 * four-pixel corner cut is squarer than it is round, and the banding is
 * directional rather than concentric, so it never resolves to a ring.
 *
 * 7 rows of air above the face and 7 below, 9 columns either side, all on one
 * flat tone. Face ink is the keyline.
 *
 * 10 tones. 16.4:1 at the face — the highest of the four, and the reason the
 * ZZ survives the small sizes here despite the softer edge.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'compact', gap: 2 } as const;
const box = faceBoxAt(face);
if (box.x !== 12 || box.y !== 12 || box.right !== 19 || box.bottom !== 19) {
  throw new Error(`p65 face geometry changed: ${JSON.stringify(box)}`);
}
---

