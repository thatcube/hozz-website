---
/**
 * 11 · Catalog Card
 *
 * A cream card with a tan divider tab on its *right* edge. Tabs on the top-left
 * are the folder icon every OS ships; a tab on the long edge is a drawer
 * divider, which is the thing this actually is — a copy you can file, find and
 * keep.
 *
 * The face is centred on the card, ignoring the tab, so it keeps six clear
 * pixels on both sides.
 *
 * Drawn against the shared face geometry in `src/data/mark.ts` rather than a
 * hand-placed copy of it, so the eyes stay the family's eyes.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;

const face = facePathsAt({ cx: 13.5, cy: 16, size: 'md', smile: 'wide' });
---

