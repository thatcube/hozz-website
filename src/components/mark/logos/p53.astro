---
/**
 * p53 · Portal
 *
 * A square opening with the corners taken right off, and no direction in it
 * at all: six contour rings, one ramp step each, following the rounding the
 * whole way in. The softest of the four and the closest in temperament to
 * the Hozz lens — depth entirely concentric, the light coming from the
 * opening itself.
 *
 * Because nothing is directional, nothing has to be decided twice. The rings
 * are even on all four sides, so the mitres fall on true diagonals and the
 * shape stays a square while reading as a well.
 *
 * Square is also the argument. Plozz plays widescreen material, but the mark
 * is an app icon before it is a screen, and at 24 by 24 this fills the tile
 * the way its siblings do — the disc and the bubble are both as tall as they
 * are wide.
 *
 * 10 by 10 of plain field at the bottom of it, eight blues including the
 * family keyline, and the supplied face at md/compact, 8 by 8, centred at
 * (16, 16).
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

