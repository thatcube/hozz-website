---
/**
 * 03 · Prism
 *
 * One beam in at the table, a narrow spectrum out at the point. Hozz takes a
 * single stream of health data and sends it to every destination you own, and
 * a cut stone is the honest picture of that: nothing is added, nothing is kept
 * back, the same light simply leaves in more than one direction. The colour
 * starts as a ghost behind the face and only fully separates below it.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

