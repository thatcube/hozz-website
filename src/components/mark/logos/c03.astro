---
/**
 * 03 · Prism
 *
 * One beam in at the table, a narrow spectrum out at the point. Hozz takes a
 * single stream of health data and sends it to every destination you own, and
 * a cut stone is the honest picture of that: nothing is added, nothing is kept
 * back, the same light simply leaves in more than one direction.
 *
 * The stone is mirror-symmetric — every row runs [a, 31−a] — so the drawn
 * centre is exactly 16.0 on every row, and it fills the whole safe area from
 * the table down to the culet. The face sits on the crown, centred on the
 * widest part of the stone, and takes the compact smile because what is under
 * it is busy; the colour only separates below the face, where there is room
 * for five clear bands.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

