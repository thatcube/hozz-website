---
/**
 * 23 · Rosette, Eight
 *
 * Eight circles on a ring of six, each the same translated
 * `circles.circle(14)`. Doubling the petal count from the six halves the
 * angle between them, so the overlaps are narrower and the middle
 * resolves into a sunburst of eight rays instead of a six-pointed star.
 *
 * The ring is rolled half a step so no petal sits on an axis. Eight caps
 * scallop the rim finely enough that it reads as a flower rather than as
 * a disc with dents, and the widest row is still the centre one, so the
 * profile rises once and falls once with no spur anywhere.
 *
 * Depth is grouped into three broad bands rather than left as a gradient,
 * which is what keeps the rays legible once the mark is small enough that
 * individual petals stop resolving.
 *
 * Glacier teal: pushed bluer than the six so the two do not read as the
 * same mark twice.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

