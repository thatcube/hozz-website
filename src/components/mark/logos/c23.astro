---
/**
 * 23 · Rosette, Eight
 *
 * Eight circles on a ring of 6.0, radius 8.5. Doubling the petal count
 * from the six halves the angle between them, so the overlaps are
 * narrower and the centre resolves into a sunburst instead of a star.
 *
 * Same construction as the six: depth counted per pixel, grouped into
 * three broad bands so the lobes read as flat shapes rather than a
 * gradient, rows clamped against spurs, bright centre a plain disc.
 *
 * This is the widest of the four — 28 across, filling the safe box — and
 * the one that survives smallest, because eight lobes around a circle
 * still read as texture when they stop reading as petals.
 *
 * Glacier teal: pushed bluer than the six so the two do not read as the
 * same mark twice.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

