---
/**
 * 23 · Ledger
 *
 * A page still bound into its book: a teal spine stitched down the left edge,
 * and then nothing at all. The earlier version ruled the page with record
 * lines, which crowded the face and made the mark busy at small sizes; the
 * binding alone says ledger, and the paper is left empty for the face.
 *
 * The face is centred on the paper (17.5), not on the mark, so the spine does
 * not push it off-centre optically.
 *
 * Drawn against the shared face geometry in `src/data/mark.ts` rather than a
 * hand-placed copy of it, so the eyes stay the family's eyes.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;

const face = facePathsAt({ cx: 17.5, cy: 16, size: 'md', smile: 'wide' });
---

<MarkFrame size={size} title="Hozz — Ledger">
  <path d="M3 2h25v1h-25z" fill="#24262b" />
  <path d="M28 2h1v28h-1z" fill="#24262b" />
  <path d="M3 3h1v27h-1z" fill="#24262b" />
  <path d="M7 3h1v27h-1z" fill="#24262b" />
  <path d="M4 29h3v1h-3z" fill="#24262b" />
  <path d="M8 29h20v1h-20z" fill="#24262b" />
  <path d="M4 3h3v26h-3z" fill="#2c6a62" />
  <path d="M5 8h1v3h-1z" fill="#24262b" />
  <path d="M5 15h1v3h-1z" fill="#24262b" />
  <path d="M5 22h1v3h-1z" fill="#24262b" />
  <path d="M8 3h20v26h-20z" fill="#f4eee2" />
  <g fill="#24262b" shape-rendering="crispEdges">
    {face.map((d) => <path d={d} />)}
  </g>
</MarkFrame>
