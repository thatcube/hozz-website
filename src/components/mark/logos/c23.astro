---
/**
 * 23 · Ledger
 *
 * NDJSON is one record per line, so the page carries its records as ragged
 * two-pixel rules — long, short, long, short — with a bound teal gutter down
 * the left edge holding them together.
 *
 * The rules are two pixels tall on purpose: one-pixel rules vanish at favicon
 * size, two survive as texture. The small smile keeps the middle of the page
 * quiet so the face never fights the lines.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Ledger">
  <path d="M5 3h22v26h-22z" fill="#f4eee2" />
  <path d="M5 3h2v26h-2z" fill="#2c6a62" />
  <path d="M8 4h17v2h-17z" fill="#8f8674" />
  <path d="M8 8h11v2h-11z" fill="#8f8674" />
  <path d="M8 22h18v2h-18z" fill="#8f8674" />
  <path d="M8 26h8v2h-8z" fill="#8f8674" />
  <path d="M4 2h24v1h-24z" fill="#24262b" />
  <path d="M4 3h1v26h-1z" fill="#24262b" />
  <path d="M27 3h1v26h-1z" fill="#24262b" />
  <path d="M4 29h24v1h-24z" fill="#24262b" />
  <Face cx={16} cy={16} smile="small" fill="#24262b" />
</MarkFrame>
