---
/**
 * 23 · Rosette, Eight
 *
 * Eight circles on a ring of six, each the same translated
 * `circles.circle(14)`. Doubling the petal count from the six halves the
 * angle between them, so the overlaps are narrower and the middle
 * resolves into a sunburst of eight rays instead of a six-pointed star.
 *
 * The ring is rolled half a step so no petal sits on an axis. Eight caps
 * facet the rim finely enough that it reads as a flower rather than as a
 * disc with dents, and the widest row is still the centre one, so the
 * profile rises once and falls once with no spur anywhere.
 *
 * This is the most direct answer to the record: a saturated ground with
 * the eight rays running through it as lighter sheen, and the face laid
 * over the whole thing in the palest tone. Nothing is cut away for the
 * letterforms. The rays pass behind the ZZ and come out the far side, the
 * way the banding on a disc passes behind its label, and at twelve rows
 * and thirty-eight per cent of the width the face is big enough to be the
 * centre of the flower rather than a detail sitting in one.
 *
 * Glacier teal: pushed bluer than the six so the two do not read as the
 * same mark twice.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

