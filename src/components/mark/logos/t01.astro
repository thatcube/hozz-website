---
/**
 * t01 · Loud
 *
 * The shipped bubble with a pulse in it. Same silhouette so it stays the app
 * you already recognise, but the tail kicks out to the left instead of hanging
 * straight down, the highlight is a proper glass L rather than a thin line,
 * and a live pip sits where a live pip sits on every stream you have ever
 * opened.
 *
 * The face is centred on the bubble *body* (16, 13.5) — x 3–28, y 3–23 — not on
 * the whole silhouette, because the tail is chrome, exactly like Plozz's legs.
 * Body plus outline fills the 28 safe area, x/y 2–29.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

