---
/**
 * 07 · Afterglow
 *
 * A broad pale core pushes into four cardinal rays. Removing the concentric
 * rings leaves one clear source and one radiating silhouette.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'wide' } as const;
const box = faceBoxAt(face);
---

<MarkFrame size={size} title="Hozz — Afterglow">
  <path d="M15 2h2v1h-2z M2 15h2v2h-2z M28 15h2v2h-2z M15 29h2v1h-2z" fill="#555f44" />
  <path d="M14 4h4v1h-4z M10 5h12v1h-12z M8 6h16v1h-16z M7 7h18v1h-18z M6 8h20v1h-20z M5 9h22v1h-22z M5 10h22v1h-22z M5 11h22v1h-22z M5 12h22v1h-22z M5 13h22v1h-22z M5 14h22v1h-22z M5 15h22v1h-22z M5 16h22v1h-22z M5 17h22v1h-22z M5 18h22v1h-22z M5 19h22v1h-22z M5 20h22v1h-22z M5 21h22v1h-22z M5 22h22v1h-22z M6 23h20v1h-20z M7 24h18v1h-18z M8 25h16v1h-16z M10 26h12v1h-12z M14 27h4v1h-4z" fill="#b4bf8e" />
  <g fill="#33382b" shape-rendering="crispEdges" data-face-box={`${box.x},${box.y},${box.w},${box.h}`}>
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
