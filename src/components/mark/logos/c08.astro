---
/**
 * 08 · Bead
 *
 * A droplet at rest: narrow at the crown, heavy and round in the belly, sitting
 * a little flat where it meets the surface. Light enters as a hard specular pip
 * on the upper left and comes back out pooled and bright low down, the way it
 * does through real water — so it reads as something you can see through rather
 * than a button.
 *
 * The drop fills the 28 safe area, x/y 2-29, and the face is centred on the
 * middle of the *bulb* (16, 21) rather than of the whole teardrop, because the
 * bulb is what the eye reads as the container. The crown above it is left empty
 * on purpose: that is where the light gets in.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Bead">
