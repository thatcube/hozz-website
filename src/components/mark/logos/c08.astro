---
/**
 * 08 · Bead
 *
 * A single bead of water, holding the record. Light goes in as a hard specular
 * pip at the top left and comes back out pooled and bright in the belly, the
 * way it does through real water — so the mark reads as something you can see
 * through rather than a button. Domed, not pointed: a drop at rest, not a tear
 * and not a map pin.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Bead">
