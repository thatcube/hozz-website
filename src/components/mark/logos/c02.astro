---
/**
 * 02 · Pane
 *
 * A sheet of frosted glass, leaning, with your history behind it. Light falls
 * across the whole pane on one diagonal, catches the top edge, and glints once
 * on the way out; the two rows at the foot are the cut edge of the sheet,
 * where glass is always its own colour. Nothing about it is opaque, and
 * nothing about it is a screen.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

