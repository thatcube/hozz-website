---
/**
 * 02 · Pane
 *
 * A leaning sheet of frosted glass with your history behind it. The lean is a
 * true parallelogram, so the sheet is symmetric about its own centre: it fills
 * x 2–29 and y 2–29, and on the face's own row the glass runs 5–26 — six pixels
 * of gutter either side of the face.
 *
 * All the modelling happens in those gutters and along the edges: light pools
 * at the top and runs down the leading edge, the trailing edge sits in shade,
 * the bottom rows are the cut edge of the sheet. The glass directly behind the
 * face stays one flat, quiet tone, so the face holds at 16px.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

