---
/**
 * 02 · Pane
 *
 * A single leaning sheet of frosted glass. One pale cap is enough to catch the
 * light; the broad uninterrupted pane gives the face its own field.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'wide' } as const;
const box = faceBoxAt(face);
---

<MarkFrame size={size} title="Hozz — Pane">
  <path d="M8 2h22v1h-22z M8 3h22v1h-22z M8 4h22v1h-22z M7 5h22v1h-22z M7 6h22v1h-22z M7 7h22v1h-22z M7 8h22v1h-22z M6 9h22v1h-22z M6 10h22v1h-22z M6 11h22v1h-22z M6 12h22v1h-22z M6 13h22v1h-22z M5 14h22v1h-22z M5 15h22v1h-22z M5 16h22v1h-22z M5 17h22v1h-22z M4 18h22v1h-22z M4 19h22v1h-22z M4 20h22v1h-22z M4 21h22v1h-22z M4 22h22v1h-22z M3 23h22v1h-22z M3 24h22v1h-22z M3 25h22v1h-22z M3 26h22v1h-22z M2 27h22v1h-22z M2 28h22v1h-22z M2 29h22v1h-22z" fill="#a2c2d0" />
  <path d="M8 2h22v1h-22z M8 3h22v1h-22z M8 4h22v1h-22z" fill="#d5e7ef" />
  <g fill="#152229" shape-rendering="crispEdges" data-face-box={`${box.x},${box.y},${box.w},${box.h}`}>
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
