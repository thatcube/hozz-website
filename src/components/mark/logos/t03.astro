---
/**
 * t03 · Sticker
 *
 * Not a logo doing an impression of an emote — an emote. The 7TV / BTTV shelf
 * is stickers: a white die-cut keyline, a hard offset shadow, no gradient, no
 * subtlety, because they are read at chat size and chat size is icon size. The
 * format is already solving the brief.
 *
 * Container is the sticker, so the face sits on its exact middle (15, 15) — the
 * shadow is behind it and gets no vote, exactly like Plozz's legs. Sticker plus
 * shadow fills the 28 safe area on the diagonal, x/y 2–29.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

