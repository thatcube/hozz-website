---
/**
 * t02 · On Air
 *
 * Bubble plus broadcast. The chat bubble is wearing the badge every stream in
 * the world wears — a red tag with a dot on it, clipped to the bottom-left
 * corner exactly where a live badge sits on a thumbnail. The tail moves to the
 * bottom right to make room for it, which also stops this reading as t01.
 *
 * The face is centred on the bubble body (16, 13) — x 3–28, y 3–22 — ignoring
 * tail and badge. Compact smile, because the container has detail to protect;
 * Plozz already does exactly this. Everything drawn, outline included, sits
 * inside x/y 2–29.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

