---
/**
 * 31 · Open Air
 *
 * A single ring floats beyond an empty band, making the ground itself part of one breath expanding outward.
 *
 * One two-tone ring is separated from the field by a fully transparent radial gap. The field is 65.8% of the painted area, leaving
 * the rings subordinate to the face rather than turning the mark into a bevel.
 *
 * The face uses the measured sm/gap2 geometry:
 * field y5-20,
 * 4px air above and 4px below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
