---
/**
 * p43 · Aperture
 *
 * A tunnel rather than a set. Eight contour-following rings step from a deep
 * housing to a lit field, so the eye reads depth going away from it and the
 * ZZ sits at the bottom of the light rather than on the front of a box.
 *
 * No stand, no controls, no triangle. The ring band bends around every corner
 * of the silhouette because each ring is defined by which pixels have a
 * missing neighbour, so nothing here is a rectangle dropped inside an
 * outline. The band stops one pixel clear of the face and the rest is one
 * flat tone: the family rule, measured off Plozz, Mozz and c45 — the centre
 * stays plain and the whole tone spend goes into the band.
 *
 * 9 tones. Face: `md` + `compact` + gap 2, which is exactly 8x8,
 * centred on the container with 10 px of air either side and 9 above
 * and below. Nothing is cleared for it.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
