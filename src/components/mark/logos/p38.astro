---
/**
 * p38 · Panel, Backlit
 *
 * Concentric falloff again, run the other way. p35 is a recessed screen —
 * palest at the rim, settling inward. This is a lit one: the same normalised
 * radius drives the ramp, but the deepest tone is against the bezel and the
 * palest is in the middle, so the glass reads as something with a lamp behind
 * it rather than something catching a room. The face lands on that pale core
 * and has the strongest contrast of the four, which is why this is the one that
 * still works at 16px.
 *
 * The body carries the rest of the difference: the deepest chin in the set at
 * four rows, and two feet stepping out from under the outer corners of the slab
 * instead of a centre column. That is the modern-television reading, and it
 * gives the mark a wide stance without a plinth. 28 x 20 of slab, 24 x 14 of
 * glass.
 *
 * The face field is calmed as in the others — the ZZ sits on one flat tone,
 * with the ramp starting at its edge rather than being cleared for it.
 *
 * 10 tones. The supplied face — facePathsAt, md, compact, gap 2, exactly 8 x 8
 * — at (16, 13): 8 columns either side, 3 rows above and below. 28 x 24
 * overall, centred on (16, 16).
 */

import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
