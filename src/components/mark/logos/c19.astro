---
/**
 * 19 · Ripple, Even
 *
 * Lit from no direction at all — one rim right the way round, so the field is uniform.
 *
 * c10's size and its water, but a true circle: c10's outline has single pixels
 * standing off the sides, which read as little arms. The shading is concentric.
 *
 * Centred by opening the face's gap to 3 rather than by nudging it — the
 * field is 16 rows and the faces are odd, so at the default gap an even
 * split cannot happen. Measured air: 3 above, 3 below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
