---
/**
 * p66 · Recess
 *
 * Not glass on a frame — glass *in* one. The screen is sunk.
 *
 * Same 28x20 pane as p63, same [3, 1] corner, and the opposite sign on the
 * light. A raised surface is bright where the light hits and dark where it
 * falls away; a recess is the reverse, because the wall nearest the light is
 * the wall that casts into it. So the frame is lit along its top and left and
 * dropped along its bottom and right, and then the screen inside it is
 * shadowed along its top and left and bounces light back along its bottom and
 * right. The two inversions meet at the bezel, which is where a real recess
 * announces itself.
 *
 * The bottom bounce is the tell. One row of the palest blue running the full
 * width, hard against the inner wall, is what a lit surface does to the lip
 * below it — and it is a horizontal band, so it says landscape screen at every
 * size, including the one where the frame has collapsed to two pixels.
 *
 * The screen field is a single tone from x6 to x25 and y10 to y21, so the face
 * sits on plain glass with a pixel of margin on every side before anything
 * changes: 6 rows of air above, 6 below, 10 columns either side. The shadow
 * row and the bounce row are outside that box by arithmetic.
 *
 * 10 tones. 13.9:1 at the face.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'compact', gap: 2 } as const;
const box = faceBoxAt(face);
if (box.x !== 12 || box.y !== 12 || box.right !== 19 || box.bottom !== 19) {
  throw new Error(`p66 face geometry changed: ${JSON.stringify(box)}`);
}
---

