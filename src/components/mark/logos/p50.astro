---
/**
 * p50 - Panel and Bar
 *
 * The whole room in two pieces: a bezel-thin panel and the bar sitting under
 * it. Nothing else. At sixteen pixels that is one big block and one small one,
 * which is the most readable silhouette of the four.
 *
 * The picture is deliberately the quietest here - one flat tone across nearly
 * all of it, ringed by the thin shadow the bezel drops onto the glass. The
 * only event on the screen is the bar reflected in its lower edge, and because
 * the bar is eight pixels narrower than the picture that reflection narrows as
 * it rises and dies out past each end of the bar. It is a lobe struck from the
 * object below it, not a stripe laid across rows. The bar is a rounded
 * extrusion: it shades down its section from the lit top face to the shadowed
 * lip, and dims toward both ends where it turns away from the room.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

