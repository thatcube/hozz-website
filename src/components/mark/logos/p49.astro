---
/**
 * p49 - Pedestal Screen
 *
 * A wide panel standing on a column and an oval base. The plainest statement
 * of the family thesis: the panel is lit by the room, and everything below the
 * panel is lit by the panel.
 *
 * The glass holds a reflection of the room centred on the face, so the middle
 * of the picture is one flat tone and only its corners fall away - a radial
 * falloff struck from a point, not a wash laid across rows. The column is a
 * cylinder and shades across its four visible pixels, highlight just left of
 * centre, dark edge on the right. The oval foot brightens toward the column
 * because that is the part of it the screen can see, and darkens along its
 * front lip where it meets the floor.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

