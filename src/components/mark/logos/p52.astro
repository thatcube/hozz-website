  <path d="M27 10h1v1h-1z M27 11h1v1h-1z M27 12h1v1h-1z M27 13h1v1h-1z M27 14h1v1h-1z M27 15h1v1h-1z M27 16h1v1h-1z M27 17h1v1h-1z M27 18h1v1h-1z M27 19h1v1h-1z M27 20h1v1h-1z M6 21h20v1h-20z M27 21h1v1h-1z M27 22h1v1h-1z" fill="#8bd8f5" />
