---
/**
 * p52 · Letterbox
 *
 * The same cut opening in the proportion the thing behind it is actually in,
 * and lit from one direction instead of none. 28 by 18: wide enough that the
 * shape alone says viewport at 16px, without any help from what is inside
 * it.
 *
 * The light comes from above and the opening is cut into the surface rather
 * than raised out of it, so the walls take it the way a recess does — the
 * head wall faces away and goes dark, the sill wall faces up into the light
 * and goes pale, the jambs sit between the two. That is the whole difference
 * between this and p51: same measurement, one light source added. Getting
 * the direction the other way round would have made a raised button of it,
 * which is the one thing a window is not.
 *
 * Three steps a side and no step skipped. Because the light falls across the
 * opening rather than out of it, the field cannot be the palest tone in the
 * ramp; it sits in the middle of it, and the face still reads on it at
 * 8.2:1. 20 by 10 of flat field, with nothing in it.
 *
 * Nine blues including the family keyline, and the supplied face at
 * md/compact, 8 by 8, centred at (16, 16).
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Plozz — Letterbox">
  <path d="M3 8h26v1h-26z" fill="#1b83ad" />
  <path d="M3 9h25v1h-25z M3 10h1v1h-1z M3 11h1v1h-1z M3 12h1v1h-1z M3 13h1v1h-1z M3 14h1v1h-1z M3 15h1v1h-1z M3 16h1v1h-1z M3 17h1v1h-1z M3 18h1v1h-1z M3 19h1v1h-1z M3 20h1v1h-1z M3 21h1v1h-1z M3 22h1v1h-1z M3 23h1v1h-1z" fill="#2b95c1" />
  <path d="M4 10h23v1h-23z M4 11h1v1h-1z M4 12h1v1h-1z M4 13h1v1h-1z M4 14h1v1h-1z M4 15h1v1h-1z M4 16h1v1h-1z M4 17h1v1h-1z M4 18h1v1h-1z M4 19h1v1h-1z M4 20h1v1h-1z M4 21h1v1h-1z M4 22h1v1h-1z" fill="#3ea7d3" />
