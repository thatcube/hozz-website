---
/**
 * t37 · Gable
 *
 * The quietest of the four. Sloped shoulders on a narrower, 26-wide body
 * with a flat base, and a tail that tapers from both sides at once instead
 * of hanging off one of them — a spike, not a hook. It sits left of centre,
 * which is the only thing in the mark that is not balanced about x=16. The
 * body is symmetric about x=16 — 22 rows, 26 across at its widest — and the
 * tail is exempt from that, as it is in every mark in the family. It is cut
 * from the same silhouette rather than stuck on the side of one, so a single
 * keyline runs round the two of them and there is no seam where they meet.
 *
 * The interior is not a flat fill. Eight surface tones are laid down as a
 * 5-pixel contour bevel that follows every facet: each pixel takes its tone
 * from the local surface normal against a light off (12, 3), and from how
 * far it sits from that light, so the highlight gathers on the facets
 * nearest it and falls away across the rest instead of ringing the whole rim
 * evenly. Facets turned away from the light fall two tones below the body
 * colour. Neighbouring pixels never skip a tone.
 *
 * The middle stays plain. The 8-wide md face with the compact smile sits on
 * the core tone with 7 rows of body air above it and 7 below, measured on
 * the body and ignoring the tail, and nothing is cleared behind it.
 *
 * 9 tones, all purple, and a white face at 5.83:1 on the core.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

