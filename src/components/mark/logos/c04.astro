---
/**
 * 04 · Sea glass
 *
 * A tumbled, frosted, imperfect thing that has been kept a long time and is
 * still translucent. The silhouette is worn off centre on purpose — there is
 * not a straight edge anywhere on it — and the light still gets all the way
 * through. Health data as something old and softened and quietly held, rather
 * than something mined.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
