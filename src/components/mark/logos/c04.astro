---
/**
 * 04 · Sea glass
 *
 * The original worn silhouette remains, but its many nested frosted layers are
 * reduced to a dark edge, one glass body and one quiet top light.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'wide' } as const;
const box = faceBoxAt(face);
---

<MarkFrame size={size} title="Hozz — Sea glass">
  <path d="M13 2h6v1h-6z M11 3h10v1h-10z M9 4h14v1h-14z M7 5h19v1h-19z M5 6h22v1h-22z M4 7h25v1h-25z M4 8h25v1h-25z M3 9h27v1h-27z M2 10h28v1h-28z M2 11h28v1h-28z M2 12h28v1h-28z M2 13h28v1h-28z M2 14h28v1h-28z M2 15h28v1h-28z M2 16h28v1h-28z M2 17h27v1h-27z M2 18h27v1h-27z M3 19h26v1h-26z M3 20h26v1h-26z M4 21h24v1h-24z M5 22h23v1h-23z M5 23h22v1h-22z M6 24h21v1h-21z M6 25h20v1h-20z M7 26h18v1h-18z M8 27h16v1h-16z M9 28h14v1h-14z M10 29h11v1h-11z" fill="#2b3a2f" />
  <path d="M13 3h6v1h-6z M11 4h10v1h-10z M9 5h14v1h-14z M7 6h19v1h-19z M5 7h22v1h-22z M5 8h23v1h-23z M4 9h25v1h-25z M3 10h26v1h-26z M3 11h26v1h-26z M3 12h26v1h-26z M3 13h26v1h-26z M3 14h26v1h-26z M3 15h26v1h-26z M3 16h26v1h-26z M3 17h25v1h-25z M3 18h25v1h-25z M4 19h24v1h-24z M4 20h24v1h-24z M5 21h22v1h-22z M6 22h21v1h-21z M6 23h20v1h-20z M7 24h19v1h-19z M7 25h18v1h-18z M8 26h16v1h-16z M9 27h14v1h-14z M10 28h11v1h-11z" fill="#c9e0b7" />
  <path d="M13 3h6v1h-6z M11 4h10v1h-10z M9 5h14v1h-14z" fill="#f1f4de" />
  <g fill="#2b3a2f" shape-rendering="crispEdges" data-face-box={`${box.x},${box.y},${box.w},${box.h}`}>
    {facePathsAt(face).map((d) => <path d={d} />)}
  </g>
</MarkFrame>
