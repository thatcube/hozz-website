---
/**
 * 13 · Keepsake Chest
 *
 * An arched chest makes ownership warm and domestic, while a pale front panel
 * and dawn-lit lid stop the archive from feeling like a heavy vault.
 *
 * The chest fills the safe area. Its compact face is centred at (16, 21) on
 * the front panel alone, excluding the taller arched lid.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
