---
/**
 * 01 · Vessel
 *
 * Your health history as something held: a translucent orb lit from the upper
 * left. Mozz is a hard red disc; this is the same silhouette family with the
 * volume taken out of it.
 *
 * The outline sits outside the fill, so the disc is drawn one pixel short and
 * the ring brings it back out to exactly 2–29 — otherwise the mark spills past
 * the safe area and sits proud of its siblings on a home screen.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

