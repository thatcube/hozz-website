---
/**
 * 01 · Vessel
 *
 * The quietest reading of the brief: your health history as something held.
 * A soft luminous orb with the light falling from the upper left, so the mark
 * reads as translucent rather than as a solid button. Where Mozz is a hard red
 * disc, this is the same silhouette family with the volume taken out of it.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

