---
/**
 * 01 · Vessel
 *
 * A translucent orb lit from the upper left.
 *
 * The light is a real crescent — the disc minus a second disc pushed toward the
 * lower right — not a band across the top. An earlier pass flattened it into a
 * full-width top row plus a thin left strip, which read as a square sitting
 * inside the circle rather than as light falling across a sphere.
 *
 * Face at `md` so it floats: nine clear pixels on every side.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
