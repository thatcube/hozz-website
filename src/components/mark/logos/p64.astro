---
/**
 * p64 · Sheen
 *
 * The one thing a screen does that a disc cannot: it takes a reflection.
 *
 * Same 26x22 faceplate as p65, same [4, 2, 1] corner. Where p65 bows the glass,
 * this one leaves it flat and puts a frame around it, then rakes a specular
 * across the top-left corner.
 *
 * The frame is built the way the shipped Plozz mark builds its case: a keyline,
 * a case ring lit on the top and left and dropped to near-black on the bottom
 * and right, then a black bezel all the way round, then a thin inner lip that
 * catches light on the top and left again. Two lit edges and two dark ones,
 * read at 16px, is a physical object seen from slightly above.
 *
 * The streak is two anti-diagonals wide with a two-pixel gap and a one-pixel
 * companion ahead of it, clipped to the glass so it dies at the lip instead of
 * crossing it. Both bands live entirely on x+y under 20; the padded face box
 * starts at x+y of 20, so the specular can never reach the letterforms. That is
 * arithmetic, not restraint.
 *
 * 7 rows of air above the face and 7 below, 9 columns either side. The field
 * under the ZZ is one tone and the streak stays out of it.
 *
 * 9 tones — the fewest of the four, because a frame does its work in high
 * contrast rather than in steps. 12.6:1 at the face.
 */
import MarkFrame from '../MarkFrame.astro';
import { faceBoxAt, facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
const face = { cx: 16, cy: 16, size: 'md', smile: 'compact', gap: 2 } as const;
const box = faceBoxAt(face);
if (box.x !== 12 || box.y !== 12 || box.right !== 19 || box.bottom !== 19) {
  throw new Error(`p64 face geometry changed: ${JSON.stringify(box)}`);
}
---

