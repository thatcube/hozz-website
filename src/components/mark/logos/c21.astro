---
/**
 * 21 · Dog-ear
 *
 * A square sheet with one corner genuinely turned up: the corner is *missing*
 * from the silhouette and the warm underside lies back across the page. The
 * generic file icon is a portrait rectangle with a token triangle notched out
 * of the top-right; this is square, the fold is at the foot, and the flap is a
 * real piece of paper with its own cut edges.
 *
 * The face sits up and left of centre, in the quarter of the page the fold
 * leaves alone — eight pixels wide with six clear either side.
 *
 * Drawn against the shared face geometry in `src/data/mark.ts` rather than a
 * hand-placed copy of it, so the eyes stay the family's eyes.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;

const face = facePathsAt({ cx: 13, cy: 12, size: 'md', smile: 'compact' });
