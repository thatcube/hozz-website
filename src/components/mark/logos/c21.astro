---
/**
 * 21 · Ripple, Small
 *
 * The small face with the fuller shading — the most air of the set.
 *
 * c10's size and its water, but a true circle: c10's outline has single pixels
 * standing off the sides, which read as little arms. Two steps of shade, small face.
 *
 * Centred by opening the face's gap to 2 rather than by nudging it — the
 * field is 16 rows and the faces are odd, so at the default gap an even
 * split cannot happen. Measured air: 4 above, 4 below.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

<MarkFrame size={size} title="Hozz — Ripple, Small">
