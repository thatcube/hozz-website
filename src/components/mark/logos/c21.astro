  <path d="M13 4h6v1h-6z M10 5h12v1h-12z M9 6h14v1h-14z M8 7h16v1h-16z M7 8h18v1h-18z M7 9h18v1h-18z M7 10h18v1h-18z M6 11h20v1h-20z M6 12h20v1h-20z M6 13h20v1h-20z M6 14h20v1h-20z M7 15h18v1h-18z M7 16h18v1h-18z M7 17h18v1h-18z M8 18h16v1h-16z M9 19h14v1h-14z M10 20h12v1h-12z M13 21h6v1h-6z" fill="#cfe3ef" />
