---
/**
 * t07 · Bare
 *
 * The same bubble as t05 with the black keyline deleted — the ring pixels are
 * simply repainted body purple, so the outer silhouette is identical to the
 * pixel. Only the line is gone.
 *
 * That makes this a controlled test rather than a new drawing: if the mark
 * holds up here, the keyline was carrying weight it did not need to, and two
 * fills will do the job three were doing.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
