---
/**
 * t04 · Company
 *
 * Watching alone is just video. The big bubble is the stream you are in; the
 * small one behind it is the room, mid-sentence — three dots, the most
 * universally understood "someone is about to say something" in software.
 *
 * The face is centred on the big bubble's body (14, 13) — x 3–24, y 3–22 —
 * ignoring its tail and ignoring the second bubble entirely. The pair spans the
 * full 28 safe area on the diagonal, x/y 2–29, and each bubble carries its own
 * outline so the overlap reads as depth.
 */
import MarkFrame from '../MarkFrame.astro';
import Face from '../Face.astro';

interface Props { size?: number }
const { size = 128 } = Astro.props;
---

