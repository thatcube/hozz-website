---
/**
 * 37 · Lit From Above
 *
 * The same two circles, but every circle hangs from the same top edge
 * instead of sitting concentrically, so the ring is one row at the top and
 * six at the bottom. There is no shade layer anywhere in this mark. Every
 * tone is a whole circle; the light is only where the circles sit relative
 * to each other. A breath rising.
 *
 * Six tones and not one of them painted. Five nested circles, each two
 * pixels narrower than the last and each hung from the top, so the crescents
 * they leave uncovered stack into a graded shadow underneath — pale,
 * light, soft, mid, deep, keyline over six rows — while the top of the
 * mark stays one row from the light.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
