---
/**
 * 37 · Lit From Above
 *
 * The same circles, but each one hangs nearer the top of the last instead
 * of sitting concentrically inside it, so the ring is one row above the
 * breath and six below it. There is no shade layer anywhere in this mark.
 * Every tone is a whole circle; the light is only where the circles sit
 * relative to each other. A breath rising.
 *
 * Five tones and not one of them painted — the fewest of the four, which
 * is the price of the idea: four canonical circles leave four bands, and a
 * fifth band would have to be a shade. Twenty-eight, twenty-four, twenty-two
 * and twenty across, each hung a little higher than the one holding it, so
 * the crescents they leave uncovered stack into a graded shadow underneath
 * — light, soft, mid, deep, keyline over six rows — while the top of
 * the mark stays one row from the light.
 */
import MarkFrame from '../MarkFrame.astro';
import { facePathsAt } from '../../../data/mark';

interface Props { size?: number }
const { size = 128 } = Astro.props;
