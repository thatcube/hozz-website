---
/**
 * The shell every documentation page renders inside.
 *
 * Head, sticky header, sidebar navigation, previous/next and footer all come
 * from `src/data/docs-nav.ts`, so adding a page to that list is the whole job
 * of adding a page. A page that is not in the list has no route into it, which
 * is the failure this centralisation exists to prevent.
 */
import '../styles/foundation.css';
import '../styles/docs.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { DOC_SECTIONS, neighbours, sectionOf, type DocPage } from '../data/docs-nav';
import { SITE } from '../data/site';

interface Props {
  /** The page's own entry, so nothing is written down twice. */
  page: DocPage;
}

const { page } = Astro.props;
const section = sectionOf(page.href);
const { prev, next } = neighbours(page.href);

/**
 * Headings become linkable, and the page gets a contents list.
 *
 * These pages are hand-written HTML rather than Markdown, so nothing gives an
 * <h2> an id on its own and a cross-page link to a fragment would land at the
 * top. The slot is rendered to a string here, ids are added where one is not
 * already written by hand, and the same pass collects the contents list — so a
 * heading and its entry cannot disagree, and no script is needed to build it.
 */
const rendered = await Astro.slots.render('default');

const slug = (text: string) =>
  text
    .toLowerCase()
    .replace(/[’']/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

type Heading = { level: number; id: string; text: string };
const headings: Heading[] = [];
const seen = new Set<string>();

/**
 * Ranges of the rendered HTML that sit inside a link.
 *
 * A card on the index page is a link wrapping a heading. Putting an anchor
 * inside that heading nests one <a> in another, which no browser will parse —
 * it closes the outer link early and the card comes apart. Such headings are
 * left exactly as they are: they are already a link to somewhere better.
 */
const linked: Array<[number, number]> = [];
let depth = 0;
let openedAt = 0;
for (const tag of rendered.matchAll(/<a\b[^>]*>|<\/a\s*>/gi)) {
  if (tag[0][1] === '/') {
    depth -= 1;
    if (depth === 0) linked.push([openedAt, tag.index + tag[0].length]);
    if (depth < 0) depth = 0;
  } else {
    if (depth === 0) openedAt = tag.index;
    depth += 1;
  }
}
const insideLink = (at: number) => linked.some(([from, to]) => at >= from && at < to);

const body = rendered.replace(
  /<h([23])([^>]*)>([\s\S]*?)<\/h\1>/g,
  (match: string, level: string, attrs: string, inner: string, offset: number) => {
    if (insideLink(offset)) return match;

    const text = inner
      .replace(/<[^>]*>/g, '')
      .replace(/\s+/g, ' ')
      .trim();

    // An id written by hand is load-bearing: other pages link to it.
    const written = attrs.match(/\sid="([^"]+)"/);
    let id = written ? written[1] : slug(text);
    if (!id) return match;
    while (seen.has(id)) id += '-x';
    seen.add(id);

    headings.push({ level: Number(level), id, text });

    const rest = attrs.replace(/\sid="[^"]*"/, '');
    return (
      `<h${level} id="${id}"${rest}>${inner}` +
      `<a class="heading-link" href="#${id}" aria-label="Link to ${text}">#</a>` +
      `</h${level}>`
    );
  }
);

/**
 * Below four headings a contents list is longer than the thing it indexes, and
 * on a page that is mostly links it repeats the page.
 */
const contents = headings.filter((h) => h.level === 2);
const showContents = contents.length >= 4;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).href;
const ogImage = new URL('/og-image.png', Astro.site ?? SITE).href;

const isCurrent = (href: string) => href === page.href;

/**
 * A documentation page is a technical article, and saying so is the difference
 * between a search engine treating it as one and treating it as a landing page.
 */
const structured = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: page.title,
  description: page.description,
  url: canonical,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Hozz',
    url: SITE,
  },
  about: {
    '@type': 'SoftwareApplication',
    name: 'Hozz',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, macOS',
  },
  author: { '@type': 'Person', name: 'Brandon Moore' },
  publisher: { '@type': 'Person', name: 'Brandon Moore' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Brandon Moore" />
    <meta name="theme-color" content="#f8fbfd" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/sentient-500.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Hozz" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader surface="docs" path={page.href} />

    <div class="docs-shell">
      <!-- A <details> rather than a scripted drawer: it collapses on a phone,
           stays open on a wide screen through CSS alone, and every link stays
           in the DOM once. It ships `open`, so with JavaScript switched off the
           whole navigation is simply present; the script below closes it on
           narrow screens, where an expanded list would bury the page. -->
      <details class="docs-sidebar" id="docs-sidebar" open>
        <summary>
          All documentation
          <svg class="docs-sidebar-caret" viewBox="0 0 16 16" width="16" height="16"
            aria-hidden="true">
            <path d="M3.5 6 8 10.5 12.5 6" fill="none" stroke="currentColor" stroke-width="1.6"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </summary>
        <nav class="docs-nav" aria-label="Documentation">
          <!-- The header's "Docs" badge returns here too, but a reader looking
               at a list of pages should not have to work out that the word
               beside the wordmark is the way back to the top of it. -->
          <div class="docs-nav-section">
            <ul class="docs-nav-list">
              <li>
                <a href="/docs/" aria-current={isCurrent('/docs/') ? 'page' : undefined}>Overview</a>
              </li>
            </ul>
          </div>
          {
            DOC_SECTIONS.map((group) => (
              <div class="docs-nav-section">
                <h2 class="docs-nav-title">{group.title}</h2>
                <ul class="docs-nav-list">
                  {group.pages.map((entry) => (
                    <li>
                      <a
                        href={entry.href}
                        aria-current={isCurrent(entry.href) ? 'page' : undefined}
                      >
                        {entry.nav}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>

      <main class="docs-page" id="main">
        <!-- The header already reads "Hozz / Docs" and both halves are live
             links, so a breadcrumb repeating them was two rows of chrome saying
             one thing. What it alone knew is the section, and that is worth
             more as the page's own eyebrow — the same dot-and-small-capitals
             the homepage marks its sections with. -->
        {section && <p class="docs-eyebrow">{section}</p>}

        <h1>{page.heading}</h1>
        <p class="docs-lede">{page.lede}</p>

        {
          showContents && (
            <nav class="docs-toc" aria-labelledby="docs-toc-title">
              <h2 class="docs-toc-title" id="docs-toc-title">
                On this page
              </h2>
              <ol>
                {contents.map((heading) => (
                  <li>
                    <a href={`#${heading.id}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }

        <div class="prose" set:html={body} />

        {
          (prev || next) && (
            <nav class="docs-pager" aria-label="Documentation pages">
              {prev && (
                <a href={prev.href}>
                  <span>Previous</span>
                  <strong>{prev.nav}</strong>
                </a>
              )}
              {next && (
                <a class="is-next" href={next.href} style={!prev ? 'grid-column: 2' : undefined}>
                  <span>Next</span>
                  <strong>{next.nav}</strong>
                </a>
              )}
            </nav>
          )
        }
      </main>
    </div>

    <SiteFooter surface="docs" />

    <!--
      The sidebar is a disclosure below 60rem and a permanent column above it.
      CSS can hide the summary but cannot open a <details>, so this sets the
      attribute to match the viewport. It runs before paint, touches nothing
      else, and stores nothing.
    -->
    <script is:inline>
      (() => {
        const sidebar = document.getElementById('docs-sidebar');
        if (!sidebar) return;
        const narrow = window.matchMedia('(max-width: 60rem)');
        const apply = () => {
          sidebar.open = !narrow.matches;
        };
        apply();
        narrow.addEventListener('change', apply);
      })();
    </script>
  </body>
</html>
