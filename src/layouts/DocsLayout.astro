---
/**
 * The shell every documentation page renders inside.
 *
 * Head, sticky header, sidebar navigation, previous/next and footer all come
 * from `src/data/docs-nav.ts`, so adding a page to that list is the whole job
 * of adding a page. A page that is not in the list has no route into it, which
 * is the failure this centralisation exists to prevent.
 */
import '../styles/foundation.css';
import '../styles/docs.css';
import Mark from '../components/mark/logos/c45.astro';
import { DOC_SECTIONS, neighbours, type DocPage } from '../data/docs-nav';
import { GITHUB_URL, SITE } from '../data/site';

interface Props {
  /** The page's own entry, so nothing is written down twice. */
  page: DocPage;
  /** Shown between "Docs" and the page name in the breadcrumb. */
  section?: string;
}

const { page, section } = Astro.props;
const { prev, next } = neighbours(page.href);

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).href;
const ogImage = new URL('/og-image.png', Astro.site ?? SITE).href;

const isCurrent = (href: string) => href === page.href;

/**
 * A documentation page is a technical article, and saying so is the difference
 * between a search engine treating it as one and treating it as a landing page.
 */
const structured = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: page.title,
  description: page.description,
  url: canonical,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Hozz',
    url: SITE,
  },
  about: {
    '@type': 'SoftwareApplication',
    name: 'Hozz',
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, macOS',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  author: { '@type': 'Person', name: 'Brandon Moore' },
  publisher: { '@type': 'Person', name: 'Brandon Moore' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Brandon Moore" />
    <meta name="theme-color" content="#f8fbfd" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Hozz" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="docs-header">
      <div class="docs-header-inner">
        <a class="docs-brand" href="/docs/">
          <Mark size={26} />
          <span>Hozz</span>
          <span class="docs-brand-suffix">Docs</span>
        </a>
        <div class="docs-header-links">
          <a href="/">Home</a>
          <a href="/privacy/">Privacy</a>
          <a class="docs-header-source" href={GITHUB_URL}>Source ↗</a>
        </div>
      </div>
    </header>

    <div class="docs-shell">
      <!-- A <details> rather than a scripted drawer: it collapses on a phone,
           stays open on a wide screen through CSS alone, and every link stays
           in the DOM once. It ships `open`, so with JavaScript switched off the
           whole navigation is simply present; the script below closes it on
           narrow screens, where an expanded list would bury the page. -->
      <details class="docs-sidebar" id="docs-sidebar" open>
        <summary>Documentation</summary>
        <nav class="docs-nav" aria-label="Documentation">
          {
            DOC_SECTIONS.map((group) => (
              <div class="docs-nav-section">
                <h2 class="docs-nav-title">{group.title}</h2>
                <ul class="docs-nav-list">
                  {group.pages.map((entry) => (
                    <li>
                      <a
                        href={entry.href}
                        aria-current={isCurrent(entry.href) ? 'page' : undefined}
                      >
                        {entry.nav}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>

      <main class="docs-page" id="main">
        <nav class="docs-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Hozz</a>
          <span aria-hidden="true">/</span>
          <a href="/docs/">Docs</a>
          {
            section && (
              <>
                <span aria-hidden="true">/</span>
                <span>{section}</span>
              </>
            )
          }
        </nav>

        <h1>{page.heading}</h1>
        <p class="docs-lede">{page.lede}</p>

        <div class="prose">
          <slot />
        </div>

        {
          (prev || next) && (
            <nav class="docs-pager" aria-label="Documentation pages">
              {prev && (
                <a href={prev.href}>
                  <span>Previous</span>
                  <strong>{prev.nav}</strong>
                </a>
              )}
              {next && (
                <a class="is-next" href={next.href} style={!prev ? 'grid-column: 2' : undefined}>
                  <span>Next</span>
                  <strong>{next.nav}</strong>
                </a>
              )}
            </nav>
          )
        }
      </main>
    </div>

    <footer class="docs-footer">
      <div class="docs-footer-inner">
        <span>Hozz — Apple Health export, without a middleman.</span>
        <nav aria-label="Site">
          <a href="/">Home</a>
          <a href="/docs/">Docs</a>
          <a href="/privacy/">Privacy</a>
          <a href={GITHUB_URL}>Source ↗</a>
        </nav>
        <span class="docs-footer-note"
          >No cookies, analytics, storage, or third-party requests.</span
        >
      </div>
    </footer>

    <!--
      The sidebar is a disclosure below 60rem and a permanent column above it.
      CSS can hide the summary but cannot open a <details>, so this sets the
      attribute to match the viewport. It runs before paint, touches nothing
      else, and stores nothing.
    -->
    <script is:inline>
      (() => {
        const sidebar = document.getElementById('docs-sidebar');
        if (!sidebar) return;
        const wide = window.matchMedia('(min-width: 60.0625rem)');
        const apply = () => {
          sidebar.open = wide.matches;
        };
        apply();
        wide.addEventListener('change', apply);
      })();
    </script>
  </body>
</html>
