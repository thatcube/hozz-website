---
/**
 * The identity board.
 *
 * Each direction is rendered across all four apps, because cohesion is the
 * whole question — a mark that only works for one of them has not solved
 * anything. Auto-discovers `src/components/id/*.astro` so forty of them can be
 * built in parallel without a shared import list.
 */
import '../styles/sketch-base.css';
import { APPS } from '../data/brand';
import { SITE } from '../data/site';

const mods = import.meta.glob('../components/id/*.astro', { eager: true }) as Record<
  string,
  { default: any }
>;
const metas = import.meta.glob('../components/id/*.meta.ts', { eager: true }) as Record<
  string,
  { default?: { n?: string; name?: string; idea?: string; face?: string; note?: string } }
>;

const items = Object.entries(mods)
  .map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.astro', '');
    const meta = metas[path.replace('.astro', '.meta.ts')]?.default ?? {};
    return { slug, Comp: mod.default, meta };
  })
  .sort((a, b) => a.slug.localeCompare(b.slug));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Identity directions · zz</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`${SITE}/id/`} />
  </head>
  <body>
    <header class="top">
      <p class="eyebrow">Plozz · Mozz · Twozz · Hozz</p>
      <h1>What survived.</h1>
      <p class="lede">
        Forty modern directions were built and thirty-five were cut. The verdict
        on them was blunt and correct: the Zs were generic letterforms with a
        colour swapped, the same shape repeated, and no metaphor left in any of
        it. The pixel marks are better and that is where the work continues.
      </p>
      <p class="lede lede--fine">
        These are the ones worth a second look — not because they are finished,
        but because they at least read as designed marks rather than a font
        recoloured four times. <a href="/logos/">The pixel marks are here.</a>
      </p>
    </header>

    <main>
      {
        items.map((it) => {
          const C = it.Comp;
          const m = it.meta;
          return (
            <section class="card" id={it.slug}>
              <div class="meta">
                <p class="tag">
                  <b>{m.n ?? it.slug}</b>
                  <span>{m.name ?? 'Untitled'}</span>
                  {m.face && <em>{m.face === 'none' ? 'ZZ only' : m.face}</em>}
                </p>
                {m.idea && <p class="idea">{m.idea}</p>}
              </div>

              <div class="grounds">
                <div class="ground ground--light">
                  {APPS.map((a) => (
                    <span class="slot">
                      <C app={a.key} size={72} />
                      <em>{a.name}</em>
                    </span>
                  ))}
                </div>
                <div class="ground ground--dark">
                  {APPS.map((a) => (
                    <span class="slot">
                      <C app={a.key} size={40} />
                      <em>{a.name}</em>
                    </span>
                  ))}
                  <span class="slot slot--tiny">
                    <C app="hozz" size={20} />
                    <em>20</em>
                  </span>
                </div>
              </div>
            </section>
          );
        })
      }
      {items.length === 0 && <p class="empty">Nothing yet.</p>}
    </main>

    <footer class="end">
      <a href="/logos/">Pixel marks</a>
      <a href="/directions/">Site directions</a>
    </footer>
  </body>
</html>

<style>
  body {
    background: #f4f5f7;
    color: #14161a;
    font-family: var(--sans);
  }

  .top {
    width: min(100% - 2.5rem, 1240px);
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7079;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 1.2rem + 3.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.042em;
    line-height: 1.02;
  }

  .lede {
    margin-top: 1.1rem;
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: #4d525a;
  }

  .lede--fine {
    font-size: 0.9375rem;
  }

  main {
    width: min(100% - 2.5rem, 1240px);
    margin-inline: auto;
    display: grid;
    gap: 1.25rem;
    padding-bottom: 4rem;
  }

  .card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.85rem);
    background: #fff;
    border: 1px solid #e4e6ea;
    border-radius: 18px;
  }

  .card > * {
    min-inline-size: 0;
  }

  @media (min-width: 1000px) {
    .card {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: 2.25rem;
      align-items: center;
    }
  }

  .tag {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .tag b {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #6b7079;
  }

  .tag span {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.032em;
  }

  .tag em {
    font-style: normal;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    padding: 0.18rem 0.45rem;
    border-radius: 4px;
    background: #eef0f3;
    color: #5d626a;
  }

  .idea {
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #5c6169;
  }

  .grounds {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 700px) {
    .grounds {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .ground {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.4rem);
    padding: 1.25rem 1rem 0.9rem;
    border-radius: 14px;
    flex-wrap: wrap;
  }

  .ground--light {
    background: #fbfbfc;
    border: 1px solid #eceef1;
  }

  .ground--dark {
    background: #17181c;
    border: 1px solid #17181c;
  }

  .slot {
    display: grid;
    justify-items: center;
    gap: 0.45rem;
  }

  .slot em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.5625rem;
    color: #6b7079;
  }

  .ground--dark .slot em {
    color: #9298a1;
  }

  .empty {
    padding: 4rem 0;
    text-align: center;
    color: #6b7079;
  }

  .end {
    width: min(100% - 2.5rem, 1240px);
    margin: 0 auto 5rem;
    display: flex;
    gap: 1.5rem;
  }

  .end a {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #14161a;
    text-decoration: none;
    border-bottom: 2px solid #c6cad1;
    padding-bottom: 2px;
  }

  .end a:hover {
    border-bottom-color: #14161a;
  }

  :focus-visible {
    outline: 3px solid #0070e0;
    outline-offset: 3px;
  }
</style>
