---
/**
 * The live homepage.
 *
 * Renders the selected direction — "The Open Current" — from the shared
 * component, so this page and the /w/w12/ concept entry cannot drift.
 * The head is production: indexable, canonical, with the full social card.
 */
import OpenCurrent from '../components/concepts/OpenCurrent.astro';
import { structuredData } from '../data/structured';
import { SITE } from '../data/site';

const title = 'Hozz — take your Apple Health data somewhere you own';
const description =
  'A free, open-source iPhone app with a companion Mac app that exports your Apple Health data to a file or a server you control. No subscription, no account, no analytics, and no server in the middle.';

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).href;
const ogImage = new URL('/og-image.png', Astro.site ?? SITE).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Brandon Moore" />
    <meta name="theme-color" content="#f8fbfd" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Self-hosted, so a page about not being tracked does not hand you to a
         font CDN on the way in. Only the faces above the fold preload. -->
    <link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hozz — take your Apple Health data somewhere you own" />
    <meta property="og:site_name" content="Hozz" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <OpenCurrent />
  </body>
</html>
