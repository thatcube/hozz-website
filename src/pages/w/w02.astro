---
import Mark from '../../components/mark/logos/c05.astro';
import {
  SITE,
  GITHUB_URL,
  LICENSE_URL,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
} from '../../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      url: SITE,
      downloadUrl: GITHUB_URL,
      license: LICENSE_URL,
      description:
        'An open-source iPhone app with a companion Mac app that exports Apple Health data to destinations you own.',
      softwareVersion: 'Early alpha',
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Hozz exports your Apple Health history to destinations you own. No account, no analytics, no hosted relay."
    />
    <link rel="canonical" href={`${SITE}/w/w02/`} />
    <title>Hozz — keep your health history at home</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Hozz, back to top">
        <Mark size={28} />
        <span>Hozz</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#export">How it works</a>
        <a href="#destinations">Destinations</a>
        <a href="#trust">Trust</a>
        <a class="source-link" href={GITHUB_URL}>View source <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Your private health archive</p>
          <h1>Bring your health history <em>home.</em></h1>
          <p class="lede">
            Hozz moves Apple Health data from your iPhone to places you own—automatically,
            without an account or a server in the middle.
          </p>
          <div class="hero-actions">
            <a class="button" href="#export">See how it works</a>
            <a class="text-link" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
          </div>
        </div>

        <div class="hearth" aria-label="Your iPhone sends health data directly to your own destinations">
          <div class="cord" aria-hidden="true"></div>
          <div class="lantern">
            <div class="lantern-cap"></div>
            <div class="lantern-pane">
              <Mark size={72} />
              <p>Nothing leaves<br />until you say where.</p>
            </div>
            <div class="lantern-foot"></div>
          </div>
          <div class="shelf">
            <span>iPhone</span>
            <span class="shelf-line"></span>
            <span>Your place</span>
          </div>
        </div>
      </section>

      <section class="quiet-proof" aria-label="Privacy promises">
        {PROMISES.map((item) => (
          <article>
            <strong>{item.title}</strong>
            <span>{item.body}</span>
          </article>
        ))}
      </section>

      <section class="section export" id="export">
        <div class="section-intro">
          <p class="eyebrow">How to export Apple Health data</p>
          <h2>Set the place.<br /><em>Then let it keep.</em></h2>
          <p>
            Install Hozz on your iPhone and the companion app on your Mac if that is your
            destination. Then follow these three steps. Hozz stages each new record and delivers
            it on the schedule you choose.
          </p>
        </div>
        <ol class="steps">
          {STEPS.map((step, index) => (
            <li>
              <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="answer">
          <strong>The short answer</strong>
          <p>
            Add a destination, choose which Health types it receives, and choose when it runs.
            There is no default destination: the first export only happens after you test and
            confirm yours.
          </p>
        </aside>
      </section>

      <section class="section destinations" id="destinations">
        <div class="section-intro split-intro">
          <div>
            <p class="eyebrow">Six places, all yours</p>
            <h2>Put it where<br /><em>you already live.</em></h2>
          </div>
          <p>
            A Mac on your network. A folder in Files. The home server you already run. Hozz has
            no cloud waiting in the middle.
          </p>
        </div>
        <div class="destination-grid">
          {DESTINATIONS.map((destination, index) => (
            <article>
              <div class="card-top">
                <span class="tiny-mark" aria-hidden="true"><Mark size={20} /></span>
                <span class="index">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3>{destination.title}</h3>
              <p>{destination.body}</p>
              <code>{destination.fact}</code>
            </article>
          ))}
        </div>
      </section>

      <section class="section formats" id="formats">
        <div class="section-intro split-intro">
          <div>
            <p class="eyebrow">Files with a long life</p>
            <h2>Readable now.<br /><em>Useful later.</em></h2>
          </div>
          <p>
            Choose the shape that fits the shelf. Lossy formats say so plainly; the originals
            are not quietly flattened.
          </p>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Format</th><th>Made for</th><th>What it preserves</th></tr>
            </thead>
            <tbody>
              {FORMATS.map((format) => (
                <tr>
                  <th scope="row">{format.name}</th>
                  <td>{format.use}</td>
                  <td>
                    {(format.name === 'CSV' || format.name === 'Markdown') && (
                      <span class="lossy">Lossy</span>
                    )}
                    {format.note}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="section trust" id="trust">
        <div class="section-intro trust-intro">
          <p class="eyebrow">Built to remember correctly</p>
          <h2>Interrupted?<br /><em>Nothing gets skipped.</em></h2>
          <p>
            Work may repeat after an interruption, but records do not vanish between the cracks.
            Hozz moves an anchor only after the records behind it are safely staged.
          </p>
          <div class="test-seal" aria-label="475 XCTest tests">
            <strong>475</strong><span>XCTest tests</span>
          </div>
        </div>
        <div class="ledger">
          {DURABILITY.map((item) => (
            <article>
              <code>{item.fact}</code>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section honesty" id="honest">
        <div class="section-intro split-intro">
          <div>
            <p class="eyebrow">No comforting guesses</p>
            <h2>Honesty has<br /><em>five states.</em></h2>
          </div>
          <p>
            Apple does not tell an app whether a type was denied or simply has no data. Hozz
            refuses to turn that uncertainty into a green tick.
          </p>
        </div>
        <ul class="states">
          {COVERAGE_STATES.map((item) => (
            <li>
              <span class:list={['status-dot', item.tone]} aria-hidden="true"></span>
              <strong>{item.state}</strong>
              <span>{item.body}</span>
            </li>
          ))}
        </ul>
        <p class="honesty-note">
          There is no invented progress percentage, either. Health will not reveal the total
          without first reading every record.
        </p>
      </section>

      <section class="section assistant">
        <div class="assistant-window">
          <div class="window-bar">
            <span><Mark size={22} /> Hozz on your Mac</span>
            <code>read-only · local</code>
          </div>
          <div class="assistant-copy">
            <div>
              <p class="eyebrow">Your own assistant can ask</p>
              <h2>A quiet index<br />of <em>your own life.</em></h2>
              <p>
                The Mac app includes a read-only MCP server. It can query the local database,
                but it cannot change or delete anything.
              </p>
            </div>
            <ul class="tool-list">
              {MCP_TOOLS.map((tool) => <li>{tool}</li>)}
            </ul>
          </div>
          <aside class="caveat">
            <strong>Keep the door in view.</strong>
            A cloud assistant may upload whatever it reads. That is the assistant’s behaviour,
            not Hozz’s.
          </aside>
        </div>
      </section>

      <section class="section status" id="status">
        <div class="section-intro split-intro">
          <div>
            <p class="eyebrow">Early alpha</p>
            <h2>Working, partial,<br /><em>said plainly.</em></h2>
          </div>
          <p>
            Hozz is built in public by Brandon Moore. It already exports real data. It does not
            cover every Health type and it is not yet in the App Store.
          </p>
        </div>
        <div class="status-columns">
          <div>
            <h3><span class="status-dot good"></span> Working now</h3>
            <ul>{WORKING.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div>
            <h3><span class="status-dot flat"></span> Not yet</h3>
            <ul>{NOT_YET.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="section faq">
        <div class="section-intro">
          <p class="eyebrow">Plain answers</p>
          <h2>Before you<br /><em>take it home.</em></h2>
        </div>
        <div class="faq-list">
          {FAQ.map((item) => (
            <details>
              <summary>{item.q}<span aria-hidden="true">+</span></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="closing">
        <div class="closing-mark"><Mark size={80} /></div>
        <p class="eyebrow">Open source</p>
        <h2>Your history should outlive<br /><em>the app that collected it.</em></h2>
        <p>Keep it in ordinary files, in ordinary places, under your control.</p>
        <a class="button light-button" href={GITHUB_URL}>Explore Hozz on GitHub <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#top"><Mark size={24} /><span>Hozz</span></a>
      <p>Made by Brandon Moore. No cookies. No analytics. No third-party requests.</p>
      <a href={LICENSE_URL}>GPL-3.0 + App Store exception</a>
    </footer>
  </body>
</html>

<style>
  @font-face {
    font-family: 'Erode';
    src: url('/fonts/erode-g-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Erode';
    src: url('/fonts/erode-g-400-italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'General Sans';
    src: url('/fonts/general-sans-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'General Sans';
    src: url('/fonts/general-sans-600.woff2') format('woff2');
    font-weight: 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) {
    --ink: #321d12;
    --brown: #4b2b18;
    --amber: #a75f24;
    --orange: #d98b37;
    --honey: #f5c664;
    --light: #ffe7a0;
    --paper: #d9d7d2;
    --paper-light: #e9e7e2;
    --line: rgba(75, 43, 24, 0.2);
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: 'General Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
  }
  :global(a) { color: inherit; }
  :global(:focus-visible) {
    outline: 3px solid var(--honey);
    outline-offset: 4px;
  }
  :global(::selection) { color: var(--brown); background: var(--honey); }

  .site-header {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100% - 48px, 1440px);
    min-height: 84px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(255, 231, 160, 0.25);
    color: var(--paper-light);
  }
  .brand {
    display: inline-flex;
    gap: 11px;
    align-items: center;
    font-family: 'Erode', serif;
    font-size: 1.2rem;
    text-decoration: none;
  }
  nav { display: flex; align-items: center; gap: clamp(18px, 2.5vw, 42px); }
  nav a {
    font-size: 0.82rem;
    text-decoration: none;
  }
  nav a:hover { color: var(--light); }
  nav .source-link {
    padding: 9px 14px;
    border: 1px solid rgba(255, 231, 160, 0.45);
    border-radius: 99px;
  }

  main { overflow: hidden; margin-top: -84px; }
  .hero {
    min-height: min(860px, 100svh);
    padding: clamp(150px, 17vh, 210px) max(24px, calc((100vw - 1440px) / 2)) 88px;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    align-items: center;
    gap: 7vw;
    color: var(--paper-light);
    background:
      radial-gradient(circle at 75% 50%, rgba(245, 198, 100, 0.16), transparent 25%),
      linear-gradient(118deg, #28160e, var(--brown) 72%, #5c351d);
  }
  .hero-copy { max-width: 790px; }
  .eyebrow {
    margin: 0 0 20px;
    font: 400 0.72rem/1.2 'IBM Plex Mono', monospace;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .eyebrow::before { content: '◆'; margin-right: 9px; color: var(--orange); font-size: 0.7em; }
  h1, h2 {
    margin: 0;
    font: 400 clamp(3.5rem, 7vw, 7.75rem)/0.89 'Erode', serif;
    letter-spacing: -0.055em;
  }
  h1 em, h2 em { color: var(--brown); font-weight: 400; }
  h2 em { text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 0.08em; text-underline-offset: 0.08em; }
  h1 em { color: var(--honey); }
  .lede {
    max-width: 620px;
    margin: 34px 0 0;
    color: #e9e0d3;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.55;
  }
  .hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 38px; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 21px;
    border-radius: 4px;
    background: var(--honey);
    color: var(--brown);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--amber);
  }
  .button:hover { transform: translate(-1px, -1px); box-shadow: 6px 6px 0 var(--amber); }
  .text-link { text-underline-offset: 5px; }

  .hearth { position: relative; display: grid; place-items: center; min-height: 500px; }
  .cord { position: absolute; top: -110px; width: 1px; height: 170px; background: var(--amber); }
  .cord::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: -4px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--honey);
    border-radius: 50%;
  }
  .lantern { filter: drop-shadow(0 18px 38px rgba(245, 198, 100, 0.22)); }
  .lantern-cap, .lantern-foot { width: 150px; height: 16px; margin: auto; background: #29170f; }
  .lantern-cap { clip-path: polygon(8% 100%, 20% 0, 80% 0, 92% 100%); }
  .lantern-foot { clip-path: polygon(0 0, 100% 0, 83% 100%, 17% 100%); }
  .lantern-pane {
    width: min(310px, 72vw);
    min-height: 330px;
    padding: 62px 32px 42px;
    display: grid;
    justify-items: center;
    align-content: center;
    border: 13px solid var(--amber);
    border-width: 13px 20px;
    clip-path: polygon(12% 0, 88% 0, 100% 8%, 100% 92%, 88% 100%, 12% 100%, 0 92%, 0 8%);
    color: var(--brown);
    background:
      linear-gradient(90deg, transparent 49.7%, rgba(75, 43, 24, 0.17) 50%, transparent 50.3%),
      linear-gradient(rgba(255, 231, 160, 0.7), rgba(245, 198, 100, 0.92));
    text-align: center;
  }
  .lantern-pane p { margin: 25px 0 0; font: 400 1.15rem/1.4 'Erode', serif; }
  .shelf { position: absolute; bottom: 0; display: flex; align-items: center; width: 100%; color: #cbbfae; font: 0.65rem 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .shelf-line { height: 1px; flex: 1; margin: 0 12px; background: rgba(255, 231, 160, 0.28); }

  .quiet-proof {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-bottom: 1px solid var(--line);
    background: #ceccc6;
  }
  .quiet-proof article { min-height: 114px; padding: 24px 18px; border-right: 1px solid var(--line); }
  .quiet-proof article:last-child { border-right: 0; }
  .quiet-proof strong, .quiet-proof span { display: block; }
  .quiet-proof strong { margin-bottom: 5px; font: 400 1.05rem 'Erode', serif; }
  .quiet-proof span { font-size: 0.75rem; line-height: 1.45; }

  .section { padding: clamp(88px, 11vw, 165px) max(24px, calc((100vw - 1280px) / 2)); }
  .section-intro { max-width: 780px; }
  .section-intro h2 { font-size: clamp(3rem, 6.3vw, 6.5rem); }
  .section-intro > p:last-child {
    max-width: 610px;
    margin: 30px 0 0;
    font-size: 1.05rem;
  }
  .split-intro { max-width: none; display: grid; grid-template-columns: 1.2fr 0.8fr; align-items: end; gap: 8vw; }
  .split-intro > p:last-child { margin-bottom: 7px; }

  .export { background: var(--paper-light); }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; padding: 0; margin: 80px 0 0; list-style: none; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: auto 1fr; gap: 20px; min-height: 210px; padding: 34px 30px 34px 0; border-right: 1px solid var(--line); }
  .steps li + li { padding-left: 30px; }
  .steps li:last-child { border-right: 0; }
  .step-number, .index { font: 0.68rem 'IBM Plex Mono', monospace; color: #73421f; }
  h3 { margin: 0 0 10px; font: 400 1.4rem/1.2 'Erode', serif; }
  .steps p, .destination-grid p, .ledger p { margin: 0; font-size: 0.9rem; line-height: 1.6; }
  .answer { display: grid; grid-template-columns: 1fr 2fr; gap: 30px; margin-top: 40px; padding: 24px 28px; border: 1px solid var(--line); background: #d1cfca; }
  .answer strong { font-family: 'Erode', serif; }
  .answer p { margin: 0; }

  .destinations { background: var(--paper); }
  .destination-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin-top: 72px; background: var(--line); border: 1px solid var(--line); }
  .destination-grid article { min-height: 270px; padding: 26px; display: flex; flex-direction: column; background: #d1cfca; }
  .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 38px; }
  .tiny-mark { opacity: 0.8; }
  .destination-grid h3 { font-size: 1.55rem; }
  .destination-grid code { margin-top: auto; padding-top: 25px; color: #653716; font: 0.67rem/1.5 'IBM Plex Mono', monospace; overflow-wrap: anywhere; }

  .formats { background: #cbc8c1; }
  .table-wrap { margin-top: 70px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  th, td { padding: 21px 18px; border-bottom: 1px solid rgba(75, 43, 24, 0.27); text-align: left; vertical-align: top; }
  thead th { color: #653716; font: 0.66rem 'IBM Plex Mono', monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  tbody th { width: 16%; font: 400 1.25rem 'Erode', serif; }
  tbody td:nth-child(2) { width: 39%; }
  .lossy { display: inline-block; margin-right: 9px; padding: 2px 6px; border: 1px solid #75431f; color: #5c2f12; font: 0.62rem 'IBM Plex Mono', monospace; text-transform: uppercase; }

  .trust { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 8vw; color: var(--paper-light); background: var(--brown); }
  .trust-intro { position: relative; }
  .trust-intro h2 { font-size: clamp(3.2rem, 5.5vw, 6rem); }
  .trust h2 em, .closing h2 em { color: var(--honey); }
  .trust-intro > p:last-of-type { color: #dfd4c6; }
  .test-seal { display: inline-flex; align-items: baseline; gap: 12px; margin-top: 45px; padding: 18px 22px; border: 1px solid rgba(255, 231, 160, 0.35); }
  .test-seal strong { color: var(--honey); font: 400 2.5rem 'Erode', serif; }
  .test-seal span { font: 0.68rem 'IBM Plex Mono', monospace; text-transform: uppercase; }
  .ledger { border-top: 1px solid rgba(255, 231, 160, 0.27); }
  .ledger article { display: grid; grid-template-columns: 145px 0.8fr 1.2fr; gap: 24px; padding: 28px 0; border-bottom: 1px solid rgba(255, 231, 160, 0.27); }
  .ledger code { color: var(--honey); font: 0.65rem 'IBM Plex Mono', monospace; overflow-wrap: anywhere; }
  .ledger p { color: #dfd4c6; }

  .honesty { background: var(--paper-light); }
  .states { padding: 0; margin: 68px 0 0; border-top: 1px solid var(--line); list-style: none; }
  .states li { display: grid; grid-template-columns: 14px 190px 1fr; gap: 18px; align-items: center; padding: 20px 4px; border-bottom: 1px solid var(--line); }
  .states strong { font: 400 1.15rem 'Erode', serif; text-transform: capitalize; }
  .states span:last-child { font-size: 0.9rem; }
  .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #62574c; box-shadow: 0 0 0 4px rgba(75, 43, 24, 0.08); }
  .status-dot.good { background: #43633a; }
  .status-dot.unknown { background: #9a641e; }
  .status-dot.bad { background: #8a3e2c; }
  .honesty-note { max-width: 650px; margin: 34px 0 0 auto; font-family: 'Erode', serif; font-size: 1.2rem; }

  .assistant { background: #c7c4bd; }
