---
/**
 * Concept 12 — "The Open Current". SELECTED, and now the live homepage.
 *
 * Kept at this URL so the concepts board keeps working and nothing is lost,
 * but it renders the same shared component as `/`, so the two cannot drift.
 * noindex + canonical to `/` because this is now a duplicate of the homepage.
 */
import OpenCurrent from '../../components/concepts/OpenCurrent.astro';
import { SITE } from '../../data/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Hozz exports Apple Health data to destinations you own, in formats you can keep."
    />
    <meta name="theme-color" content="#f8fbfd" />
    <title>12 · The Open Current — selected, now live at /</title>
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/young-serif-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <OpenCurrent />
  </body>
</html>
