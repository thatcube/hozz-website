          </ul>
        </div>
      </section>

      <section class="section" id="status" aria-labelledby="status-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Early alpha</p>
            <h2 id="status-h">It works. Coverage is <em class="em">partial.</em></h2>
            <p class="section-lede">Both halves of that are true, so both are printed.</p>
          </div>
          <div class="status-grid">
            <div class="status-col">
              <h3 class="h-tiny">Working today</h3>
              <ul class="tick">{WORKING.map((w) => <li>{w}</li>)}</ul>
            </div>
            <div class="status-col">
              <h3 class="h-tiny">Not yet</h3>
              <ul class="cross">{NOT_YET.map((n) => <li>{n}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section tint-sleep faq" id="faq" aria-labelledby="faq-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Questions</p>
            <h2 id="faq-h">Straight <em class="em">answers.</em></h2>
