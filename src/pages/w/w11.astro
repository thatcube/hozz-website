---
/**
 * w11 · Dispersion — built on c45 "Ripple, Lens".
 *
 * The mark is a lens sitting in water, so the page takes the lens literally.
 * One Apple Health archive enters as a single undispersed beam, meets Hozz, and
 * separates into the seven real export formats — thick and deep where the format
 * keeps everything, thin, pale and broken where it throws information away. Data
 * types ride the bands they can honestly survive in; the six real destinations sit
 * at the outer edge on dotted hairlines that all trace back to the one source.
 *
 * Nothing in the composition is invented. Every band is a row of FORMATS, every
 * chip is a HealthKit identifier from STREAM_LANES with its own example reading,
 * every plate is a row of DESTINATIONS with its checkable fact. There is no
 * shape in the hero that exists only to look nice.
 */
import Mark from '../../components/mark/logos/c45.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  NAV_LINKS,
  CATEGORIES,
  STREAM_LANES,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
  SIBLINGS,
} from '../../data/site';

const hue = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.hue])) as Record<string, string>;
const label = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.label])) as Record<string, string>;

/** Look a real identifier up rather than retyping it, so the reading always matches site.ts. */
const lane = (id: string) => {
  for (const row of STREAM_LANES) {
    const found = row.find((x) => x.id === id);
    if (found) return found;
  }
  throw new Error(`w11: unknown HealthKit identifier ${id}`);
};

const format = (name: string) => {
  const found = FORMATS.find((f) => f.name === name);
  if (!found) throw new Error(`w11: unknown format ${name}`);
  return found;
};

/** Four words for what a format keeps, derived from the note rather than restated. */
const keeps = (note: string) =>
  note.startsWith('Lossless') ? 'lossless' : note.startsWith('Lossy') ? 'lossy' : note.startsWith('A filter') ? 'routes only' : 'values over time';

/**
 * The fan, ordered by what survives: deepest and thickest at the top keeps
 * everything, palest and thinnest at the bottom keeps the least and is drawn
 * broken because that is what lossy means.
 *
 * `type` is the identifier that rides each band, and each pairing is a claim the
 * page could defend: routes only ride GPX, a waveform rides the format that
 * keeps the original record, a daily total rides the format that is a daily
 * note, a number in a grid rides CSV.
 */
const BANDS = [
  { name: 'NDJSON', tone: '#4c7da4', weight: 1, type: 'stateOfMind' },
  { name: 'SQLite', tone: '#5d8cb0', weight: 0.87, type: 'electrocardiogram' },
  { name: 'JSON', tone: '#7ba7c9', weight: 0.75, type: 'dietaryProtein' },
  { name: 'Metrics JSON', tone: '#96c2e0', weight: 0.6, type: 'respiratoryRate' },
  { name: 'GPX', tone: '#a7cce6', weight: 0.48, type: 'workoutRoute' },
  { name: 'CSV', tone: '#b3d2e9', weight: 0.38, type: 'walkingSpeed' },
  { name: 'Markdown', tone: '#c3dcef', weight: 0.3, type: 'sleepAnalysis' },
].map((b) => {
  const f = format(b.name);
  const l = lane(b.type);
  return { ...b, use: f.use, note: f.note, keeps: keeps(f.note), id: l.id, sample: l.sample, category: l.category };
});

const OUT = ['Your Mac', 'Folder', 'Home Assistant', 'Web address', 'InfluxDB', 'MQTT'].map(
  (title) => DESTINATIONS.find((d) => d.title === title)!
);

/**
 * Both compositions are laid out by naming the point on the stage a thing should
 * land on and solving for the spoke that reaches it, rather than by guessing
 * angles. Units are percentages of the stage; `aspect` converts the horizontal
 * ones so a degree means the same thing in both axes.
 */
const rad = (deg: number) => (deg * Math.PI) / 180;
const spokeTo = (aspect: number, lx: number, ly: number, x: number, y: number) => {
  const dx = (x - lx) * aspect;
  const dy = y - ly;
  return {
    a: +((Math.atan2(dy, dx) * 180) / Math.PI).toFixed(3),
    len: +(Math.hypot(dx, dy) / aspect).toFixed(3),
  };
};
/** How far along a band of length `len` a rider must sit to land on row `y`. */
const rideTo = (aspect: number, ly: number, len: number, angle: number, y: number, fallbackR: number) => {
  const s = Math.sin(rad(angle));
  const r = Math.abs(s) < 1e-6 ? fallbackR : (y - ly) / s;
  return +((r / ((len / 100) * aspect * 100)) * 100).toFixed(3);
};

/* ---- landscape: lens at 47% / 40% of a 1600 × 900 stage ---- */
const AL = 1600 / 850;
const LX = 47;
const LY = 40;
/** Long enough that each band is still running when it passes under its chip. */
const LEN_L = 40;
/** Seven evenly spaced rows, so the chips read as one sorted ladder. */
const CHIP_STEP = 7.2;

const bandsL = BANDS.map((b, i) => {
  const angle = (i - 3) * 10;
  const y = LY + (i - 3) * CHIP_STEP;
  return { ...b, angle, d: rideTo(AL, LY, LEN_L, angle, y, 41.5) };
});

/** Where each destination sits on the stage, chosen to clear the chip ladder. */
const platesL = [
  { d: OUT[0], x: 88, y: 10 },
  { d: OUT[1], x: 92, y: 22 },
  { d: OUT[2], x: 93, y: 35 },
  { d: OUT[3], x: 93, y: 50 },
  { d: OUT[4], x: 90, y: 65 },
  { d: OUT[5], x: 89, y: 80 },
].map((p) => ({ ...p.d, ...spokeTo(AL, LX, LY, p.x, p.y) }));

/** The archive, up and left of the lens, and the undispersed beam back to it. */
const SRC_L = { x: 37, y: 8 };
const beamL = (() => {
  const s = spokeTo(AL, LX, LY, SRC_L.x, SRC_L.y);
  return { a: s.a, len: +(s.len * 0.72).toFixed(3) };
})();

/* ---- portrait: lens at 50% / 18% of a 390 × 940 stage ---- */
const AP = 390 / 1080;
const PLY = 18;
const LEN_P = 240;
/** The first row clears the lens and its halo; the rest step down evenly. */
const CARD_Y_P = [30, 36, 42, 48, 54, 60, 66];

const bandsP = BANDS.map((b, i) => {
  const angle = +(98 - i * (16 / 6)).toFixed(3);
  return { ...b, angle, d: rideTo(AP, PLY, LEN_P, angle, CARD_Y_P[i], 30) };
});

const platesP = [
  { d: OUT[0], x: 25, y: 74 },
  { d: OUT[1], x: 75, y: 74 },
  { d: OUT[2], x: 25, y: 84 },
  { d: OUT[3], x: 75, y: 84 },
  { d: OUT[4], x: 25, y: 94 },
  { d: OUT[5], x: 75, y: 94 },
].map((p) => ({ ...p.d, ...spokeTo(AP, 50, PLY, p.x, p.y) }));

const SRC_P = { x: 50, y: 5.5 };
const beamP = (() => {
  const s = spokeTo(AP, 50, PLY, SRC_P.x, SRC_P.y);
  return { a: s.a, len: +(s.len * 0.66).toFixed(3) };
})();

/** Every identifier the site documents, for the section that grounds the hero chips. */
const allTypes = STREAM_LANES.flat();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      url: SITE,
      downloadUrl: GITHUB_URL,
      isAccessibleForFree: true,
      license: LICENSE_URL,
      softwareVersion: 'Early alpha',
      author: { '@type': 'Person', name: 'Brandon Moore' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'A free, open-source iPhone app with a companion Mac app that exports Apple Health data to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, any web endpoint or MQTT. No account, no analytics, no hosted relay and no default destination.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Hozz separates your Apple Health archive into the formats and destinations you choose — your Mac, a folder, Home Assistant, InfluxDB, a URL or MQTT. Free, open source, no account, no analytics, no server in the middle."
    />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6fbfe" />
    <link rel="canonical" href={`${SITE}/w/w11/`} />
    <title>Hozz — one archive in, the shapes you chose out</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="#top">
          <Mark size={30} />
          <span>Hozz</span>
        </a>
        <nav class="topnav" aria-label="Sections">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
          <a class="topnav-source" href={GITHUB_URL}>Source <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <figure class="prism">
          <!-- ---------------- landscape composition ----------------
               Four passes over one rotation system, so the paint order is the
               same as the physical order: hairlines run under the fan, the fan
               runs under what rides it, and the destinations sit on top. -->
          <div class="stage stage-land">
            <div class="art art-land" aria-hidden="true">
              {
                platesL.map((p) => (
                  <div class="spoke wire" style={`--a:${p.a}deg; --len:${p.len}%`}>
                    <i class="hair" />
                  </div>
                ))
              }

              <div class="beam" style={`--a:${beamL.a}deg; --len:${beamL.len}%`}>
                <i class="beam-rail" />
              </div>

              {
                bandsL.map((b) => (
                  <div
                    class:list={['band', b.keeps === 'lossy' && 'is-lossy']}
                    style={`--a:${b.angle}deg; --len:${LEN_L}%; --w:${b.weight}; --tone:${b.tone}`}
                  >
                    <i class="rail" />
                  </div>
                ))
              }

              {
                bandsL.map((b) => (
                  <div class="band rider" style={`--a:${b.angle}deg; --len:${LEN_L}%; --w:${b.weight}; --tone:${b.tone}`}>
                    <span class="chip" style={`--d:${b.d}%; --hue:${hue[b.category]}`}>
                      <span class="chip-fmt">
                        <i class:list={['chip-bar', b.keeps === 'lossy' && 'is-lossy']} />
                        <b class="mono">{b.name}</b>
                        <em class="mono">{b.keeps}</em>
                      </span>
                      <span class="chip-type">
                        <i class="chip-hue" />
                        <b class="mono">{b.id}</b>
                        <em class="mono">{b.sample}</em>
                      </span>
                    </span>
                  </div>
                ))
              }

              {
                platesL.map((p) => (
                  <div class="spoke" style={`--a:${p.a}deg; --len:${p.len}%`}>
                    <span class="plate">
                      <b>
                        <i class="cat-dot" style={`--hue:${hue[p.category]}`} />
                        {p.title}
                      </b>
                      <span class="mono">{p.fact}</span>
                    </span>
                  </div>
                ))
              }

              <div class="source" style={`--x:${SRC_L.x}%; --y:${SRC_L.y}%`}>
                <span class="mono src-k">Apple Health</span>
                <b>One archive</b>
                <span class="mono src-f">HKAnchoredObjectQuery</span>
              </div>

              <div class="lens"><Mark size={128} /></div>
            </div>

            <div class="hero-copy">
              <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Apple Health export · early alpha</p>
              <h1>One archive in. Out in the shapes <em class="em">you</em> chose.</h1>
              <p class="lede">
                Hozz copies your Apple Health history off your iPhone and separates it into the
                formats and destinations you picked. Free, open source, one developer. No account,
                no analytics, no server of mine.
              </p>
              <div class="actions">
                <a class="btn" href="#export">How to export your data</a>
                <a class="btn-quiet" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>

          <!-- ---------------- portrait composition ----------------
               Not the landscape one squashed: the fan runs down the page, the
               riders stack instead of fanning sideways, and the six
               destinations sit in a grid the hairlines reach down into. -->
          <div class="stage-port">
            <div class="hero-copy port-copy">
              <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Apple Health export · early alpha</p>
              <h1>One archive in. Out in the shapes <em class="em">you</em> chose.</h1>
              <p class="lede">
                Hozz copies your Apple Health history off your iPhone and separates it into the
                formats and destinations you picked. Free, open source, one developer. No account,
                no analytics, no server of mine.
              </p>
              <div class="actions">
                <a class="btn" href="#export">How to export your data</a>
                <a class="btn-quiet" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
              </div>
            </div>

            <div class="art art-port" aria-hidden="true">
              {
                platesP.map((p) => (
                  <div class="spoke wire" style={`--a:${p.a}deg; --len:${p.len}%`}>
                    <i class="hair" />
                  </div>
                ))
              }

              <div class="beam" style={`--a:${beamP.a}deg; --len:${beamP.len}%`}>
                <i class="beam-rail" />
              </div>

              {
                bandsP.map((b) => (
                  <div
                    class:list={['band', b.keeps === 'lossy' && 'is-lossy']}
                    style={`--a:${b.angle}deg; --len:${LEN_P}%; --w:${b.weight}; --tone:${b.tone}`}
                  >
                    <i class="rail" />
                  </div>
                ))
              }

              {
                bandsP.map((b) => (
                  <div class="band rider" style={`--a:${b.angle}deg; --len:${LEN_P}%; --w:${b.weight}; --tone:${b.tone}`}>
                    <span class="chip" style={`--d:${b.d}%; --hue:${hue[b.category]}`}>
                      <span class="chip-fmt">
                        <i class:list={['chip-bar', b.keeps === 'lossy' && 'is-lossy']} />
                        <b class="mono">{b.name}</b>
                        <em class="mono">{b.keeps}</em>
                      </span>
                      <span class="chip-type">
                        <i class="chip-hue" />
                        <b class="mono">{b.id}</b>
                        <em class="mono">{b.sample}</em>
                      </span>
                    </span>
                  </div>
                ))
              }

              {
                platesP.map((p) => (
                  <div class="spoke" style={`--a:${p.a}deg; --len:${p.len}%`}>
                    <span class="plate">
                      <b>
                        <i class="cat-dot" style={`--hue:${hue[p.category]}`} />
                        {p.title}
                      </b>
                      <span class="mono">{p.fact}</span>
                    </span>
                  </div>
                ))
              }

              <div class="source" style={`--x:${SRC_P.x}%; --y:${SRC_P.y}%`}>
                <span class="mono src-k">Apple Health</span>
                <b>One archive</b>
                <span class="mono src-f">HKAnchoredObjectQuery</span>
              </div>

              <div class="lens lens-port"><Mark size={104} /></div>
            </div>
          </div>


          <p class="sr-only">
            A diagram: one Apple Health archive enters a lens and separates into seven export
            formats — NDJSON, SQLite, JSON, Metrics JSON, GPX, CSV and Markdown — carrying real
            HealthKit identifiers out to six destinations: your Mac, a folder, Home Assistant, a web
            address, InfluxDB and MQTT. Every name in it is listed again in the sections below.
          </p>

          <ul class="key" aria-hidden="true">
            {
              BANDS.map((b) => (
                <li>
                  <i
                    class:list={['key-bar', b.keeps === 'lossy' && 'is-lossy']}
                    style={`--w:${b.weight}; --tone:${b.tone}`}
                  />
                  <b class="mono">{b.name}</b>
                  <span class="mono">{b.keeps}</span>
                </li>
              ))
            }
          </ul>

          <figcaption>
            <span>
              The fan is ordered by what survives: thick and deep keeps everything, thin and broken
              throws information away and says so. Each band is named on the card riding it, and
              each card carries a real HealthKit identifier that band could honestly hold — the
              readings beside them are examples, not your data. The dotted lines run out to the six
              real destinations, and every one of them starts at the same archive, because nothing
              here is invented.
            </span>
          </figcaption>
        </figure>
      </section>

      <section class="section tint-mind" aria-labelledby="split-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>What separation buys you</p>
            <h2 id="split-h">A phone gives you one shape. You need <em class="em">several.</em></h2>
            <p class="section-lede">
              The same night’s sleep is a row in a spreadsheet, a line in a dashboard, a paragraph in
              a journal and a record in an archive. One export format cannot be all four, so Hozz
              does not pretend otherwise — it splits the stream and tells you what each branch costs.
            </p>
          </div>
          <ul class="counts">
            <li>
              <span class="mono big">1</span>
              <h3>archive in</h3>
              <p>Read through Apple’s anchored query, type by type, so an interruption repeats work rather than skipping records.</p>
            </li>
            <li>
              <span class="mono big">7</span>
              <h3>formats out</h3>
              <p>Three keep everything. Two throw information away. Two are projections. All seven say which, here and in the app.</p>
            </li>
            <li>
              <span class="mono big">6</span>
              <h3>places you own</h3>
              <p>Each destination gets its own types, its own schedule and its own place in the queue. None of them is mine.</p>
            </li>
          </ul>
        </div>
      </section>

      <section class="section" id="export" aria-labelledby="export-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>The question people actually ask</p>
            <h2 id="export-h">How do I export my <em class="em">Apple Health</em> data?</h2>
            <p class="section-lede">
              Install Hozz on your iPhone — and the companion app on your Mac, if that is where you
              want the data. Then three steps, once. After that new records leave on their own, on
              the schedule you set, to the destination you named.
            </p>
          </div>
          <ol class="steps">
            {
              STEPS.map((step, i) => (
                <li style={`--hue:${hue[step.category]}`}>
                  <span class="mono step-n">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
          <p class="aside">
            No default destination exists. Until you add one and confirm it, Hozz reads nothing and
            sends nothing.
          </p>
        </div>
      </section>

      <section class="section tint-body" id="destinations" aria-labelledby="dest-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Six destinations</p>
            <h2 id="dest-h">Where the bands <em class="em">land.</em></h2>
            <p class="section-lede">
              The six plates in the hero, at full size. Each one is a place you already run, anchored
              by a fact you could check — a Bonjour service type, a port, an endpoint, a protocol.
              There is no relay in the middle.
            </p>
          </div>
          <ul class="dests">
            {
              DESTINATIONS.map((d) => (
                <li style={`--hue:${hue[d.category]}`}>
                  <h3><i class="cat-dot" aria-hidden="true" />{d.title}</h3>
                  <p>{d.body}</p>
                  <p class="mono fact">{d.fact}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section" id="formats" aria-labelledby="fmt-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Seven formats</p>
            <h2 id="fmt-h">Files, not a <em class="em">database you rent.</em></h2>
            <p class="section-lede">
              The seven bands of the fan, in the order they leave the lens. The bar beside each one
              is the same weight it has in the hero, because that weight is the point: two of these
              throw information away, and finding that out later is the bad outcome.
            </p>
          </div>
          <div class="table-wrap">
            <table class="formats">
              <caption class="sr-only">Export formats, what each is for, and what each keeps</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">What it is for</th>
                  <th scope="col">What it keeps</th>
                </tr>
              </thead>
              <tbody>
                {
                  BANDS.map((b) => (
                    <tr class:list={[b.keeps === 'lossy' && 'lossy']}>
                      <th scope="row">
                        <i
                          class:list={['key-bar', b.keeps === 'lossy' && 'is-lossy']}
                          style={`--w:${b.weight}; --tone:${b.tone}`}
                        />
                        <span class="mono">{b.name}</span>
                      </th>
                      <td>{b.use}</td>
                      <td>
                        {b.keeps === 'lossy' && <span class="tag mono">lossy</span>}
                        <span class="note">{b.note.replace(/^Lossy — /, '')}</span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="aside">
            The pairing in the hero is not decoration either: a route can only ride GPX, a waveform
            needs a format that keeps its original record, and a night’s sleep total is exactly what
            a daily Markdown note can hold.
          </p>
        </div>
      </section>

      <section class="section tint-heart" id="types" aria-labelledby="types-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>What rides the bands</p>
            <h2 id="types-h">Real identifiers, so you can <em class="em">check.</em></h2>
            <p class="section-lede">
              These are Apple’s own API names. Showing them is the honest version of “it reads a lot
              of things”: anyone who knows HealthKit can check the claim, and anyone who does not
              still reads the breadth. The readings are examples — this page never touches Health.
            </p>
          </div>
          <ul class="cats">
            {
              CATEGORIES.map((c) => (
                <li>
                  <i class="cat-dot" style={`--hue:${c.hue}`} />
                  <b>{c.label}</b>
                  <span>{c.note}</span>
                </li>
              ))
            }
          </ul>
          <ul class="types">
            {
              allTypes.map((t) => (
                <li style={`--hue:${hue[t.category]}`}>
                  <i class="chip-hue" />
                  <b class="mono">{t.id}</b>
                  <em class="mono">{t.sample}</em>
                  <span class="sr-only">{label[t.category]}</span>
                </li>
              ))
            }
          </ul>
          <p class="aside">Coverage is partial and the app says which types it has and has not read.</p>
        </div>
      </section>

      <section class="section slab" id="trust" aria-labelledby="trust-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Durability</p>
            <h2 id="trust-h">An interruption can repeat work. It cannot <em class="em">skip a record.</em></h2>
            <p class="section-lede">
              That sentence is the whole design. Every mechanism below exists to make it true, and
              475 XCTest tests exist to keep it true.
            </p>
          </div>
          <ul class="durability">
            {
              DURABILITY.map((d) => (
                <li>
                  <h3>{d.title}</h3>
                  <p>{d.body}</p>
                  <p class="mono fact">{d.fact}</p>
                </li>
              ))
            }
          </ul>
          <p class="tests">
            <span class="mono big">475</span>
            <span>XCTest tests in the repository, and you can run them yourself.</span>
          </p>
        </div>
      </section>

      <section class="section" id="honest" aria-labelledby="honest-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Honesty</p>
            <h2 id="honest-h">Where it cannot know, it <em class="em">says so.</em></h2>
            <p class="section-lede">
              Apple will not let an app tell “you denied this type” from “you have no data”. So Hozz
              does not print a green tick it has not earned. These are the five states it reports.
            </p>
          </div>
          <div class="table-wrap">
            <table class="states">
              <caption class="sr-only">Coverage states Hozz reports for each Health type</caption>
              <thead>
                <tr><th scope="col">State</th><th scope="col">What it means</th></tr>
              </thead>
              <tbody>
                {
                  COVERAGE_STATES.map((s) => (
                    <tr>
                      <th scope="row"><span class={`mono state tone-${s.tone}`}>{s.state}</span></th>
                      <td>{s.body}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <ul class="honest-notes">
            <li>
              <h3>No progress percentage</h3>
              <p>
                Health will not say how many records a type holds without reading all of them. Any
                fraction would be invented, so Hozz reports how many types are complete and how far
                back they reach instead.
              </p>
            </li>
            <li>
              <h3>iOS decides when it runs</h3>
              <p>
                Background work happens when the system allows it, so most types land near hourly.
                Health cannot be read at all while the phone is locked.
              </p>
            </li>
            <li>
              <h3>It will never write back into Health</h3>
              <p>
                Health stamps provenance permanently and HealthKit has no upsert, so a re-import
                would both launder the origin of every reading and silently double your records.
              </p>
            </li>
          </ul>
        </div>
      </section>

      <section class="section tint-respiratory" id="assistant" aria-labelledby="mcp-h">
        <div class="shell mcp-grid">
          <div>
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>The assistant</p>
            <h2 id="mcp-h">Ask your own <em class="em">questions.</em></h2>
            <p class="section-lede">
              The Mac app ships a read-only MCP server over the database your phone keeps current. A
              question costs a lookup, not a re-parse of a stale XML export. It cannot change or
              delete anything.
            </p>
            <p class="caveat">
              <strong>The honest caveat:</strong> a cloud assistant may upload whatever it reads.
              That is the assistant’s behaviour, not Hozz’s — which is a good reason to point a local
              one at it.
            </p>
          </div>
          <div>
            <h3 class="h-tiny">What it can read</h3>
            <ul class="mcp-list">
              {MCP_TOOLS.map((t) => <li class="mono">{t}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section tint-mobility" aria-labelledby="prom-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Refusals</p>
