      }

      :root {
        /* c45 — Ripple, Lens. The keyline is the ink; the water and the lens ramp
           are everything else. Text only ever uses the top three. */
        --ink: #132638;
        --slate: #2f4a63;
        --muted: #3a5a76;

        --paper: #f6fbfe;
        --wash-1: #eff6fc;
        --wash-2: #e6f1fa;
        --line: #cddeeb;
        --rule: #b9d7eb;
        --water: #5d8cb0;

        --shell: 1240px;

        --display: 'Sentient', Georgia, serif;
        --body: 'General Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;

        --step-0: clamp(0.98rem, 0.94rem + 0.2vw, 1.08rem);
        --step-1: clamp(1.1rem, 1.02rem + 0.36vw, 1.32rem);
        --step-2: clamp(1.4rem, 1.26rem + 0.66vw, 1.85rem);
        --step-3: clamp(1.9rem, 1.55rem + 1.55vw, 3rem);
        --step-4: clamp(2.35rem, 1.2rem + 2.6vw, 4.6rem);
        --gap: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
        --pad-y: clamp(3.4rem, 2.3rem + 4.2vw, 7rem);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        font-size: var(--step-0);
        line-height: 1.62;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        font-family: var(--display);
        font-weight: 500;
        letter-spacing: -0.018em;
        margin: 0;
        text-wrap: balance;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
      }

      ::selection {
        background: #cae1f1;
        color: var(--ink);
      }

      :focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .shell {
        width: 100%;
        max-width: var(--shell);
        margin-inline: auto;
        padding-inline: clamp(1.15rem, 0.6rem + 2.4vw, 3rem);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.7rem 1rem;
        z-index: 30;
        text-decoration: none;
      }
      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      .mono {
        font-family: var(--mono);
        font-size: 0.82em;
        letter-spacing: -0.01em;
      }

      /* ---------- header ---------- */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgb(246 251 254 / 0.94);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 60px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        font-family: var(--display);
        font-weight: 500;
        font-size: 1.18rem;
        letter-spacing: -0.02em;
      }

      .topnav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 0.4rem + 1.2vw, 1.9rem);
        font-size: 0.92rem;
      }

      .topnav a {
        text-decoration: none;
        color: var(--slate);
        padding-block: 0.3rem;
        border-bottom: 1px solid transparent;
      }

      .topnav a:hover {
        color: var(--ink);
        border-bottom-color: var(--ink);
      }

      .topnav-source {
        font-weight: 500;
        color: var(--ink) !important;
      }

      @media (max-width: 760px) {
        .topnav a:not(.topnav-source) {
          display: none;
        }
      }

      /* ---------- the prism ---------- */

      .hero {
        background: linear-gradient(104deg, #ffffff 0%, #f4fafd 40%, #e4f0fa 100%);
        border-bottom: 1px solid var(--line);
      }

      .prism {
        margin: 0;
      }

      /* Everything in the art is sized in em off this one value, so the
         composition scales as a unit and the hand-solved geometry holds. */
      .stage {
        position: relative;
        width: 100%;
        max-width: 1680px;
        margin-inline: auto;
        aspect-ratio: 1600 / 850;
      }

      .art {
        position: absolute;
        inset: 0;
        overflow: hidden;
        font-size: clamp(10px, 0.75vw, 13px);
        --tk: 1.1em;
        --lx: 47%;
        --ly: 40%;
      }

      /* Bands, spokes and the beam share one mechanism: a zero-height rail
         pinned at the lens and rotated, so anything riding one is glued to it
         and every hairline provably starts at the source. */
      .band,
      .spoke,
      .beam {
        position: absolute;
        left: var(--lx);
        top: var(--ly);
        width: var(--len);
        height: 0;
        transform-origin: 0 0;
        transform: rotate(var(--a));
      }

      /* Paint order is the physical order. */
      .wire {
        z-index: 0;
      }
      .beam {
        z-index: 1;
      }
      .band {
        z-index: 2;
      }
      .rider {
        z-index: 3;
      }
      .spoke:not(.wire) {
        z-index: 4;
      }
      .lens {
        z-index: 5;
      }
      .source {
        z-index: 6;
      }

      .rail {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: calc(var(--tk) * var(--w));
        transform: translateY(-50%);
        background: var(--tone);
        -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0) 0, rgb(0 0 0 / 0.4) 5%, #000 15%, #000 80%, rgb(0 0 0 / 0) 100%);
        mask-image: linear-gradient(90deg, rgb(0 0 0 / 0) 0, rgb(0 0 0 / 0.4) 5%, #000 15%, #000 80%, rgb(0 0 0 / 0) 100%);
      }

      /* Lossy formats are drawn broken, because that is what lossy is. */
      .is-lossy .rail {
        background: repeating-linear-gradient(90deg, var(--tone) 0 0.75em, rgb(0 0 0 / 0) 0.75em 1.35em);
      }

      .beam-rail {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: calc(var(--tk) * 1.6);
        transform: translateY(-50%);
        background: linear-gradient(90deg, #7ba7c9 0%, #a7cce6 60%, #dcecf6 100%);
        -webkit-mask-image: linear-gradient(90deg, #000 0, #000 42%, rgb(0 0 0 / 0) 100%);
        mask-image: linear-gradient(90deg, #000 0, #000 42%, rgb(0 0 0 / 0) 100%);
      }

      /* The beam is light, so it spills — done with a vertical gradient rather
         than a coloured shadow, which keeps the falloff under control. */
      .beam-rail::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        width: 100%;
        height: 320%;
        transform: translateY(-50%);
        background: linear-gradient(180deg, rgb(167 204 230 / 0) 0%, rgb(167 204 230 / 0.5) 50%, rgb(167 204 230 / 0) 100%);
        z-index: -1;
      }

      .hair {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 0;
        border-top: 1px dotted var(--water);
        opacity: 0.8;
      }

      .lens {
        position: absolute;
        left: var(--lx);
        top: var(--ly);
        transform: translate(-50%, -50%);
      }

      /* The dispersion happens inside the lens, so the fan is not allowed to
         read as seven lines that merely pass behind it. */
      .lens::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        width: 300%;
        height: 300%;
        transform: translate(-50%, -50%);
        background: radial-gradient(circle, rgb(255 255 255 / 0.96) 0 32%, rgb(255 255 255 / 0) 70%);
        z-index: -1;
      }

      .lens :global(svg) {
        width: 9.6em;
        height: auto;
        filter: drop-shadow(0 6px 18px rgb(19 38 56 / 0.14));
      }

      /* the archive that goes in */
      .source {
        position: absolute;
        left: var(--x);
        top: var(--y);
        transform: translate(-50%, -50%);
        display: grid;
        gap: 0.1em;
        padding: 0.7em 0.95em;
        background: rgb(255 255 255 / 0.96);
        border: 1px solid var(--ink);
        box-shadow: 0 4px 16px rgb(19 38 56 / 0.07);
        white-space: nowrap;
      }

      .source b {
        font-family: var(--display);
        font-weight: 500;
        font-size: 1.5em;
        letter-spacing: -0.02em;
        line-height: 1.15;
      }

      .src-k {
        font-size: 0.92em;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .src-f {
        font-size: 0.95em;
        color: var(--slate);
      }

      /* A rider names its own band and carries a real identifier, so pointing at
         any one of them answers both questions at once. */
      .chip {
        position: absolute;
        left: var(--d);
        top: 0;
        transform-origin: 0 0;
        transform: rotate(calc(-1 * var(--a))) translate(-50%, -50%);
        display: grid;
        gap: 0.15em;
        padding: 0.45em 0.6em;
        background: rgb(255 255 255 / 0.97);
        border: 1px solid var(--line);
        box-shadow: 0 3px 12px rgb(19 38 56 / 0.08);
        white-space: nowrap;
        animation: drift 19s ease-in-out infinite alternate;
      }

      .chip-fmt,
      .chip-type {
        display: flex;
        align-items: center;
        gap: 0.45em;
      }

      .chip-fmt b {
        font-size: 1.02em;
        font-weight: 500;
        color: var(--ink);
      }

      .chip-fmt em {
        font-style: normal;
        font-size: 0.92em;
        color: var(--muted);
      }

      .chip-type b {
        font-size: 0.95em;
        font-weight: 400;
        color: var(--ink);
      }

      .chip-type em {
        font-style: normal;
        font-size: 0.95em;
        font-weight: 500;
        color: var(--slate);
        margin-left: auto;
        padding-left: 0.5em;
      }

      .chip-bar {
        width: 1.5em;
        height: calc(0.16em + 0.66em * var(--w));
        flex: none;
        background: var(--tone);
      }

      .chip-bar.is-lossy {
        background: repeating-linear-gradient(90deg, var(--tone) 0 0.3em, rgb(0 0 0 / 0) 0.3em 0.52em);
      }

      .chip-hue {
        width: 0.32em;
        height: 1.1em;
        flex: none;
        background: var(--hue);
      }

      /* a real destination at the end of a hairline */
      .plate {
        position: absolute;
        left: 100%;
        top: 0;
        transform-origin: 0 0;
        transform: rotate(calc(-1 * var(--a))) translate(-50%, -50%);
        display: grid;
        gap: 0.25em;
        width: 15.5em;
        padding: 0.7em 0.8em;
        background: rgb(255 255 255 / 0.94);
        backdrop-filter: blur(6px);
        border: 1px solid var(--line);
        box-shadow: 0 6px 20px rgb(19 38 56 / 0.09);
        animation: drift 24s ease-in-out infinite alternate;
      }

      .plate b {
        display: flex;
        align-items: center;
        gap: 0.45em;
        font-family: var(--display);
        font-weight: 500;
        font-size: 1.45em;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--ink);
      }

      .plate .mono {
        font-size: 0.92em;
        line-height: 1.45;
        color: var(--slate);
        overflow-wrap: anywhere;
      }

      .plate .cat-dot {
        width: 0.55em;
        height: 0.55em;
      }

      .cat-dot {
        width: 8px;
        height: 8px;
        flex: none;
        border-radius: 50%;
        background: var(--hue);
      }

      @keyframes drift {
        from {
          translate: 0 -3px;
        }
        to {
          translate: 0 3px;
        }
      }

      .rider:nth-of-type(3n) .chip {
        animation-delay: -7s;
      }

      .rider:nth-of-type(3n + 1) .chip {
        animation-delay: -13s;
      }

      .spoke:nth-of-type(2n) .plate {
        animation-delay: -11s;
      }

      .spoke:nth-of-type(3n) .plate {
        animation-delay: -17s;
      }

      /* the copy, kept on plain paper so nothing about its contrast is a gradient */
      .hero-copy {
        position: absolute;
        left: clamp(1.15rem, 0.6rem + 2.4vw, 3rem);
        top: 26%;
        width: min(42%, 620px);
        z-index: 7;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 1.2rem;
      }

      .dot {
        width: 7px;
        height: 7px;
        background: var(--tint, var(--water));
        flex: none;
      }

      h1 {
        font-size: var(--step-4);
        line-height: 0.98;
        letter-spacing: -0.035em;
      }

      .em {
        font-style: italic;
        font-weight: 400;
        color: var(--tint, #2c5a80);
      }

      .lede {
        font-size: var(--step-1);
        line-height: 1.5;
        max-width: 34ch;
        margin-top: 1.35rem;
        color: var(--slate);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.9rem 1.5rem;
        margin-top: 1.9rem;
      }

      .btn {
        display: inline-block;
        background: var(--ink);
        color: var(--paper);
        text-decoration: none;
        font-weight: 500;
        padding: 0.82rem 1.45rem;
        border: 1px solid var(--ink);
      }

      .btn:hover {
        background: var(--slate);
        border-color: var(--slate);
      }

      .btn-quiet {
        text-decoration: none;
        font-weight: 500;
        color: var(--slate);
        border-bottom: 1px solid var(--rule);
        padding-bottom: 2px;
      }

      .btn-quiet:hover {
        color: var(--ink);
        border-bottom-color: var(--ink);
      }

      /* The key is the legend that makes the fan readable rather than pretty:
         same tone, same weight, same break as the band it names. */
      .key,
      .prism figcaption {
        max-width: 1680px;
        margin-inline: auto;
        padding-inline: clamp(1.15rem, 0.6rem + 2.4vw, 3rem);
      }

      .key {
        list-style: none;
        margin-block: 0;
        padding-top: clamp(1.2rem, 0.8rem + 1.2vw, 2rem);
        display: grid;
        gap: 0.55rem 1.4rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 188px), 1fr));
      }

      /* Seven columns above the fold width, so the legend is the fan, in order. */
      @media (min-width: 1100px) {
        .key {
          grid-template-columns: repeat(7, minmax(0, 1fr));
        }
      }

      .key li {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .key b {
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--ink);
      }

      .key span {
        font-size: 0.74rem;
        color: var(--muted);
      }

      .key-bar {
        width: 26px;
        height: calc(3px + 13px * var(--w));
        flex: none;
        background: var(--tone);
      }

      .key-bar.is-lossy {
        background: repeating-linear-gradient(90deg, var(--tone) 0 5px, rgb(0 0 0 / 0) 5px 9px);
      }

      .prism figcaption {
        padding-top: 1.1rem;
        padding-bottom: clamp(2.4rem, 1.6rem + 2vw, 3.6rem);
        color: var(--slate);
        font-size: 0.88rem;
        line-height: 1.55;
      }

      .prism figcaption span {
        display: block;
        max-width: 62ch;
      }

      /* ---------- portrait composition ---------- */

      .stage-port {
        display: none;
      }

      @media (max-width: 1199px) {
        .stage-land {
          display: none;
        }

        .stage-port {
          display: grid;
          gap: clamp(1.8rem, 1rem + 3vw, 3rem);
          max-width: 1680px;
          margin-inline: auto;
          padding: clamp(2.6rem, 2rem + 3vw, 4rem) clamp(1.15rem, 0.6rem + 2.4vw, 3rem) 0;
        }

        .port-copy {
          position: static;
          width: auto;
          max-width: 34rem;
        }

        .art-port {
          position: relative;
          inset: auto;
          width: 100%;
          max-width: 420px;
          margin-inline: auto;
          aspect-ratio: 390 / 1080;
          font-size: clamp(10px, 2.9vw, 12px);
          --tk: 0.9em;
        }

        .art-port {
          --lx: 50%;
          --ly: 18%;
        }

        .art-port .lens :global(svg) {
          width: 7.4em;
        }

        .art-port .rail {
          -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0) 0, rgb(0 0 0 / 0.4) 3%, #000 9%, #000 74%, rgb(0 0 0 / 0) 100%);
          mask-image: linear-gradient(90deg, rgb(0 0 0 / 0) 0, rgb(0 0 0 / 0.4) 3%, #000 9%, #000 74%, rgb(0 0 0 / 0) 100%);
        }

        .art-port .plate {
          width: 15em;
        }
      }

      /* Between phone and desktop the portrait art has room to sit beside the
         copy rather than under it. */
      @media (min-width: 760px) and (max-width: 1199px) {
        .stage-port {
          grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
          align-items: center;
        }

        .art-port {
          max-width: 380px;
          font-size: 11px;
        }
      }

      /* ---------- sections ---------- */

      .section {
        padding-block: var(--pad-y);
        scroll-margin-top: 60px;
        border-top: 1px solid var(--line);
      }

      .tint-mind {
        --tint: #7a56a0;
        background: var(--wash-1);
      }
      .tint-body {
        --tint: #2f6c96;
        background: var(--wash-2);
      }
      .tint-heart {
        --tint: #a8443a;
        background: var(--wash-1);
      }
      .tint-respiratory {
        --tint: #2b6f6f;
        background: var(--wash-2);
      }
      .tint-mobility {
        --tint: #4b7530;
        background: var(--wash-1);
      }
      .tint-sleep {
        --tint: #55589f;
        background: var(--wash-2);
      }

      .section-head {
        max-width: 48ch;
        margin-bottom: clamp(2.1rem, 1.4rem + 2vw, 3.3rem);
      }

      h2 {
        font-size: var(--step-3);
        line-height: 1.05;
      }

      .h-tiny {
        font-family: var(--mono);
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 500;
        margin-bottom: 1rem;
      }

      .section-lede {
        margin-top: 1.15rem;
        color: var(--slate);
        font-size: var(--step-1);
        line-height: 1.55;
      }

      .aside {
        margin-top: clamp(1.9rem, 1.3rem + 1.4vw, 2.9rem);
        padding-top: 1rem;
        border-top: 1px solid var(--line);
        max-width: 62ch;
        color: var(--slate);
      }

      /* ---------- the split ---------- */

      .counts {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
      }

      .counts li {
        border-right: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding: 1.4rem clamp(1rem, 0.7rem + 0.9vw, 1.7rem) 1.6rem 0;
      }

      .counts li:not(:first-child) {
        padding-left: clamp(1rem, 0.7rem + 0.9vw, 1.7rem);
      }

      .counts li:last-child {
        border-right: 0;
        padding-right: 0;
      }

      .big {
        font-size: clamp(2.1rem, 1.5rem + 2.2vw, 3.4rem);
        font-weight: 500;
        letter-spacing: -0.05em;
        line-height: 1;
        color: var(--ink);
      }

      .counts h3 {
        margin-top: 0.35rem;
        font-size: var(--step-1);
      }

      .counts p {
        margin-top: 0.5rem;
        color: var(--slate);
      }

      @media (max-width: 800px) {
        .counts {
          grid-template-columns: minmax(0, 1fr);
        }
        .counts li,
        .counts li:not(:first-child),
        .counts li:last-child {
          padding: 1.2rem 0 1.3rem;
          border-right: 0;
        }
      }

      /* ---------- steps ---------- */

      .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--gap);
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .steps li {
        border-top: 2px solid var(--hue);
        padding-top: 1rem;
      }

      .step-n {
        display: block;
        color: var(--muted);
        margin-bottom: 0.8rem;
      }

      .steps h3 {
        font-size: var(--step-2);
        line-height: 1.12;
      }

      .steps p {
        margin-top: 0.55rem;
        color: var(--slate);
      }

      @media (max-width: 780px) {
        .steps {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- destinations ---------- */

      .dests {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
      }

      .dests li {
        border-bottom: 1px solid var(--rule);
        border-right: 1px solid var(--rule);
        padding: clamp(1.25rem, 1rem + 0.8vw, 1.85rem);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .dests h3,
      .prom-list h3 {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }

      .dests h3 .cat-dot,
      .prom-list h3 .cat-dot {
        align-self: center;
      }

      .dests h3 {
        font-size: var(--step-1);
      }

      .dests p {
        color: var(--slate);
      }

      .fact {
        margin-top: auto;
        padding-top: 0.85rem;
        color: var(--ink);
        overflow-wrap: anywhere;
      }

      @media (max-width: 900px) {
        .dests {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 560px) {
        .dests {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- tables ---------- */

      .table-wrap {
        overflow-x: auto;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }

      thead th {
        font-family: var(--mono);
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 0 0 0.7rem;
        border-bottom: 1px solid var(--ink);
      }

      tbody th,
      tbody td {
        padding: 0.95rem 1.4rem 0.95rem 0;
        border-bottom: 1px solid var(--line);
        vertical-align: baseline;
        font-weight: 400;
        color: var(--slate);
      }

      tbody th {
        color: var(--ink);
        white-space: nowrap;
        padding-right: 1.8rem;
      }

      .formats tbody th {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .formats tbody th .mono {
        font-size: 0.95rem;
        font-weight: 500;
      }

      .formats td:last-child,
      .states td:last-child {
        padding-right: 0;
      }

      .tag {
        display: inline-block;
        margin-right: 0.55rem;
        padding: 0.1rem 0.42rem;
        border: 1px solid #a8443a;
        color: var(--ink);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        vertical-align: 1px;
      }

      .lossy th,
      .lossy td {
        background: var(--wash-2);
      }

      .state {
        display: inline-block;
        padding: 0.16rem 0.5rem;
        background: var(--wash-2);
        color: var(--ink);
        font-weight: 500;
      }

      .tone-good {
        background: var(--ink);
        color: var(--paper);
      }

      .tone-unknown {
        background: #cae1f1;
        box-shadow: inset 0 0 0 1px var(--water);
      }

      @media (max-width: 640px) {
        table,
        thead,
        tbody,
        tr,
        th,
        td {
          display: block;
          width: 100%;
        }
        thead {
          display: none;
        }
        tbody tr {
          border-bottom: 1px solid var(--line);
          padding-block: 1.05rem;
        }
        tbody th,
        tbody td {
          border-bottom: 0;
          padding: 0 0 0.35rem;
          white-space: normal;
        }
        tbody th {
          padding-bottom: 0.5rem;
        }
        .formats tbody th {
          display: flex;
        }
      }

      /* ---------- types ---------- */

      .cats {
        list-style: none;
        margin: 0 0 clamp(1.8rem, 1.2rem + 1.6vw, 2.8rem);
        padding: 0;
        display: grid;
        gap: 0.5rem 1.6rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
      }

      .cats li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-size: 0.88rem;
      }

      .cats .cat-dot {
        align-self: center;
      }

      .cats b {
        font-weight: 600;
        color: var(--ink);
      }

      .cats span {
        color: var(--slate);
      }

      .types {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 232px), 1fr));
      }

      .types li {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.6rem;
        background: #ffffff;
        border: 1px solid var(--line);
        min-width: 0;
      }

      .types b {
        font-weight: 400;
        font-size: 0.72rem;
        color: var(--ink);
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .types em {
        margin-left: auto;
        font-style: normal;
        font-weight: 500;
        font-size: 0.72rem;
        color: var(--slate);
        white-space: nowrap;
      }

      /* ---------- slab ---------- */

      .slab {
        --tint: #a7cce6;
        background: var(--ink);
        color: var(--paper);
        border-top: 0;
      }

      .slab .eyebrow,
      .slab .section-lede,
      .slab p {
        color: #b9d7eb;
      }

      .slab .em {
        color: #a7cce6;
      }

      .durability {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--slate);
      }

      .durability li {
        padding: 1.4rem clamp(1rem, 0.7rem + 0.8vw, 1.6rem) 1.6rem 0;
        border-right: 1px solid var(--slate);
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
      }

      .durability li:not(:first-child) {
        padding-left: clamp(1rem, 0.7rem + 0.8vw, 1.6rem);
      }

      .durability li:last-child {
        border-right: 0;
        padding-right: 0;
      }

      .durability h3 {
        font-size: var(--step-1);
        color: var(--paper);
      }

      .durability .fact {
        color: var(--paper);
        margin-top: auto;
        padding-top: 0.6rem;
      }

      @media (max-width: 900px) {
        .durability {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .durability li:nth-child(2n) {
          border-right: 0;
          padding-right: 0;
        }
        .durability li:nth-child(odd) {
          padding-left: 0;
        }
        .durability li:nth-child(-n + 2) {
          border-bottom: 1px solid var(--slate);
        }
      }

      @media (max-width: 560px) {
        .durability {
          grid-template-columns: minmax(0, 1fr);
        }
        .durability li {
          border-right: 0;
          border-bottom: 1px solid var(--slate);
          padding: 1.25rem 0 1.35rem !important;
        }
        .durability li:last-child {
          border-bottom: 0;
        }
      }

      .tests {
        margin-top: clamp(1.9rem, 1.3rem + 1.4vw, 2.8rem);
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        flex-wrap: wrap;
      }

      .tests .big {
        color: var(--paper);
      }

      /* ---------- honesty ---------- */

      .honest-notes {
        list-style: none;
        margin: clamp(2.2rem, 1.5rem + 2vw, 3.2rem) 0 0;
        padding: 0;
        display: grid;
        gap: var(--gap);
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .honest-notes li {
        border-top: 1px solid var(--rule);
        padding-top: 0.95rem;
      }

      .honest-notes h3 {
        font-size: var(--step-1);
      }

      .honest-notes p {
        margin-top: 0.45rem;
        color: var(--slate);
      }

      @media (max-width: 820px) {
        .honest-notes {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- assistant ---------- */

      .mcp-grid {
        display: grid;
        gap: clamp(2rem, 1.2rem + 3vw, 4rem);
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
        align-items: start;
      }

      .caveat {
        margin-top: 1.5rem;
        padding: 1rem 1.2rem;
        background: #ffffff;
        border: 1px solid var(--rule);
        color: var(--slate);
        max-width: 54ch;
      }

      .caveat strong {
        color: var(--ink);
        font-weight: 600;
      }

      .mcp-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--rule);
      }

      .mcp-list li {
        padding: 0.55rem 0;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
      }

      @media (max-width: 820px) {
        .mcp-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- refusals ---------- */

      .prom-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
      }

      .prom-list li {
        border-bottom: 1px solid var(--rule);
        border-right: 1px solid var(--rule);
        padding: clamp(1.15rem, 0.9rem + 0.8vw, 1.65rem);
      }

      .prom-list h3 {
        font-size: var(--step-1);
      }

      .prom-list p {
        margin-top: 0.3rem;
        color: var(--slate);
      }

      @media (max-width: 820px) {
        .prom-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 520px) {
        .prom-list {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- status ---------- */

      .status-grid {
        display: grid;
        gap: clamp(2rem, 1.2rem + 2.4vw, 3.6rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .tick,
      .cross {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .tick li,
      .cross li {
        position: relative;
        padding: 0.5rem 0 0.5rem 1.85rem;
        border-bottom: 1px solid var(--line);
      }

      .tick li::before,
      .cross li::before {
        position: absolute;
        left: 0;
        font-family: var(--mono);
        font-size: 0.9rem;
        color: var(--muted);
      }

      .tick li::before {
        content: '✓';
        color: var(--ink);
      }

      .cross li::before {
        content: '—';
      }

      .cross li {
        color: var(--slate);
      }

      @media (max-width: 620px) {
        .status-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- faq ---------- */

      .faq-list {
        margin: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(2rem, 1.2rem + 2.4vw, 3.6rem);
        border-top: 1px solid var(--rule);
      }

      .faq-item {
        padding: 1.3rem 0 1.4rem;
        border-bottom: 1px solid var(--rule);
      }

      .faq-item dt {
        font-family: var(--display);
        font-weight: 500;
        font-size: var(--step-1);
        letter-spacing: -0.02em;
      }

      .faq-item dd {
        margin: 0.45rem 0 0;
        color: var(--slate);
        max-width: 58ch;
      }

      @media (max-width: 780px) {
        .faq-list {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- close ---------- */

      .close {
        background: linear-gradient(168deg, #ffffff 0%, #e6f1fa 100%);
      }

      .close-inner {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.1rem;
      }

      .close h2 {
        max-width: 16ch;
      }

      .close > .shell > p,
      .close p {
        max-width: 52ch;
        color: var(--slate);
        font-size: var(--step-1);
        line-height: 1.55;
      }

      .siblings {
        list-style: none;
        margin: clamp(1.6rem, 1.2rem + 1.4vw, 2.6rem) 0 0;
        padding: 1.1rem 0 0;
        border-top: 1px solid var(--rule);
        width: 100%;
        display: grid;
        gap: 0.5rem 2rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
      }

      .siblings li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        font-size: 0.88rem;
      }

      .siblings a {
        font-weight: 600;
        text-decoration: none;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
      }

      .siblings a:hover {
        border-bottom-color: var(--ink);
      }

      .siblings span {
        color: var(--slate);
      }

      /* ---------- footer ---------- */

      .footer {
        background: var(--ink);
        color: #b9d7eb;
        padding-block: 2.3rem;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 2rem;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.9rem;
      }

      .footer-links {
        display: flex;
        gap: 1.4rem;
      }

      .footer a {
        color: var(--paper);
        text-decoration: none;
        border-bottom: 1px solid var(--slate);
      }

      .footer a:hover {
        border-bottom-color: var(--paper);
      }

      .footer :focus-visible {
        outline-color: var(--paper);
      }

      /* ---------- reduced motion: the drift stops, the positions stay ---------- */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .chip,
        .plate {
          animation: none !important;
          translate: none !important;
        }
