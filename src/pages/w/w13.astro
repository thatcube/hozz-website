---
/**
 * w13 · Ripple — built entirely out of c45 "Ripple, Lens".
 *
 * The identity and the page come from one idea rather than two. The mark is a
 * disc resting on water, its interior stepping through six close tones from a
 * near-white rim to a deeper core, sending rings outward. So:
 *
 *   • The hero is that mark at page scale. One archive enters at a single
 *     point, strikes the lens, and six rings carry it outward. Each ring is one
 *     of the six real destinations, drawn in the mark's water tones and
 *     labelled with a fact you could check. Riding those rings are real
 *     HealthKit identifiers with example readings. Every hairline runs back to
 *     the one point where the data entered, because nothing here is invented.
 *
 *   • The page is the disc's bevel unrolled. Section washes walk the six lens
 *     tones in order — #edf6fc → #96c2e0 — so scrolling is travelling from the
 *     rim to the core. No single step announces itself; the whole descent does.
 *     Section boundaries are ring crests, not straight rules.
 *
 *   • The footer is the keyline, #132638, the one dark value the mark owns.
 *
 * Landscape and portrait are separate compositions, not one squashed. Both are
 * built from the same ring/arm/pin geometry, so a label is always exactly on
 * its ring at any width.
 */
import Mark from '../../components/mark/logos/c45.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  NAV_LINKS,
  CATEGORIES,
  STREAM_LANES,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
  SIBLINGS,
} from '../../data/site';

const hue = (key: string) => CATEGORIES.find((c) => c.key === key)?.hue ?? '#5d8cb0';

/* The six ripple rings, outward from the disc. Diameter is a share of the
   stage width with a hard cap, so the composition stops growing once it has
   the room it needs and every label stays on its own ring. Stroke tones step
   through the mark's water colours, palest furthest from the drop. */
const RINGS = [
  { d: '21%', cap: '300px', stroke: '#5d8cb0' },
  { d: '30%', cap: '430px', stroke: '#6b98ba' },
  { d: '40%', cap: '580px', stroke: '#79a4c4' },
  { d: '52%', cap: '750px', stroke: '#87b0ce' },
  { d: '62%', cap: '880px', stroke: '#96bcd6' },
  { d: '75%', cap: '1040px', stroke: '#a6c8de' },
];

/* Portrait rings are wider than the phone on purpose — the outer two run off
   both edges, which is what a ripple does when you are standing in it. */
const RINGS_P = [
  { d: '46%', cap: '258px', stroke: '#5d8cb0' },
  { d: '68%', cap: '380px', stroke: '#6b98ba' },
  { d: '94%', cap: '524px', stroke: '#79a4c4' },
  { d: '126%', cap: '704px', stroke: '#87b0ce' },
  { d: '164%', cap: '916px', stroke: '#96bcd6' },
  { d: '208%', cap: '1162px', stroke: '#a6c8de' },
];

/* Ring n carries destination n. Short facts here, full facts in the section
   below — every one of them is still a thing you could go and check. */
const SHORT: Record<string, string> = {
  'Your Mac': '_hozz._tcp · :54330',
  Folder: 'Files picker',
  'Home Assistant': 'Metrics JSON',
  'Web address': 'POST · NDJSON',
  InfluxDB: '/api/v2/write',
  MQTT: 'mqtts:// · QoS 0',
};

/* Angles measured from three o'clock, clockwise, so 90deg is straight down —
   away from the drop at the top of the stage. */
const DEST_A = ['103deg', '345deg', '33deg', '217deg', '39deg', '48deg'];
const DEST_A_P = ['122deg', '14deg', '131deg', '116deg', '112deg', '78deg'];

/* What rides the rings: real HealthKit identifiers, coloured by the category
   they belong to. The readings are examples and the caption says so. */
const RIDERS = [
  { ring: 2, a: '216deg', category: 'heart', id: 'heartRateVariabilitySDNN', sample: '48 ms' },
  { ring: 3, a: '12deg', category: 'sleep', id: 'sleepAnalysis', sample: '7h 12m' },
  { ring: 3, a: '83deg', category: 'activity', id: 'workoutRoute', sample: '6.2 mi' },
  { ring: 4, a: '145deg', category: 'heart', id: 'electrocardiogram', sample: 'sinus rhythm' },
  { ring: 4, a: '327deg', category: 'respiratory', id: 'vo2Max', sample: '44.1' },
  { ring: 5, a: '124deg', category: 'mind', id: 'stateOfMind', sample: 'pleasant' },
];

const RIDERS_P = [
  { ring: 2, a: '69deg', category: 'heart', id: 'heartRateVariabilitySDNN', sample: '48 ms' },
  { ring: 3, a: '78deg', category: 'sleep', id: 'sleepAnalysis', sample: '7h 12m' },
  { ring: 4, a: '68deg', category: 'heart', id: 'electrocardiogram', sample: 'sinus rhythm' },
  { ring: 5, a: '76deg', category: 'mind', id: 'stateOfMind', sample: 'pleasant' },
];

const allTypes = STREAM_LANES.flat();

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      url: SITE,
      downloadUrl: GITHUB_URL,
      isAccessibleForFree: true,
      license: LICENSE_URL,
      softwareVersion: 'Early alpha',
      author: { '@type': 'Person', name: 'Brandon Moore' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'A free, open-source iPhone app with a companion Mac app that exports Apple Health data to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, any web endpoint or MQTT. No account, no analytics, no hosted relay and no default destination.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Hozz exports your Apple Health history to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, a URL or MQTT. Free, open source, no account, no analytics, no server in the middle."
    />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7fbfd" />
    <link rel="canonical" href={`${SITE}/w/w13/`} />
    <title>Hozz — drop it once, it reaches everywhere you own</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="#top">
          <Mark size={30} />
          <span>Hozz</span>
        </a>
        <nav class="topnav" aria-label="Sections">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
          <a class="topnav-source" href={GITHUB_URL}>Source <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ================= hero ================= -->
      <section class="hero" id="top">
       <div class="herogrid">
        <div class="shell hero-copy">
          <div class="hero-say">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              Apple Health export · early alpha
            </p>
            <h1>Drop it once. It reaches everywhere you <em class="em">own.</em></h1>
            <p class="lede">
              Your Apple Health history, copied off your iPhone into places you already run.
              Free, open source, one developer.
            </p>
            <div class="actions">
              <a class="btn" href="#export">How to export your data</a>
              <a class="btn-quiet" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <dl class="hero-facts">
            <div>
              <dt>It reads</dt>
              <dd><b class="fnum">{allTypes.length}</b> Health record types, across {STREAM_LANES.length} lanes</dd>
            </div>
            <div>
              <dt>It writes to</dt>
              <dd><b class="fnum">{DESTINATIONS.length}</b> destinations, in {FORMATS.length} formats</dd>
            </div>
            <div>
              <dt>It sends me</dt>
              <dd><b class="fnum">0</b> bytes — there is no server of mine</dd>
            </div>
          </dl>
        </div>

        <figure class="stagewrap">
          <!-- landscape composition -->
          <div class="stage stage-l" role="img" aria-label="One archive enters at a single point and six rings carry it outward — one ring for each of the six destinations Hozz can send to, with real HealthKit record types riding them.">
            <span class="entry" aria-hidden="true"></span>
            <div class="pin pin-src src" aria-hidden="true">
              <b>Apple Health</b>
              <span class="mono">HKAnchoredObjectQuery</span>
            </div>

            {RINGS.map((ring, i) => (
              <div class="ring" style={`--d:${ring.d};--cap:${ring.cap};--stroke:${ring.stroke}`} aria-hidden="true">
                <div class="arm arm-dest" style={`--a:${DEST_A[i]}`}></div>
                {RIDERS.filter((r) => r.ring === i + 1).map((r) => (
                  <div class="arm arm-ride" style={`--a:${r.a}`}></div>
                ))}
              </div>
            ))}

            <div class="layer layer-pins">
              {RINGS.map((ring, i) => (
                <div class="ring bare" style={`--d:${ring.d};--cap:${ring.cap}`} aria-hidden="true">
                  <div class="arm" style={`--a:${DEST_A[i]}`}>
                    <div class="tip">
                      <div class="pin pin-dest">
                        <i class="bead" style={`--c:${hue(DESTINATIONS[i].category)}`}></i>
                        <b>{DESTINATIONS[i].title}</b>
                        <span class="mono">{SHORT[DESTINATIONS[i].title]}</span>
                      </div>
                    </div>
                  </div>
                  {RIDERS.filter((r) => r.ring === i + 1).map((r) => (
                    <div class="arm" style={`--a:${r.a}`}>
                      <div class="tip">
                        <div class="pin pin-ride" style={`--c:${hue(r.category)}`}>
                          <span class="ridline"><i class="bead"></i><span class="mono rid">{r.id}</span></span>
                          <span class="mono rsample">{r.sample}</span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>

            <div class="disc" aria-hidden="true"><Mark size={132} /></div>
          </div>

          <!-- portrait composition: recomposed, not squashed -->
          <div class="stage stage-p" role="img" aria-label="One archive enters at a single point and six rings carry it outward — one ring for each of the six destinations Hozz can send to, with real HealthKit record types riding them.">
            <span class="entry" aria-hidden="true"></span>
            <div class="pin pin-src src" aria-hidden="true">
              <b>Apple Health</b>
              <span class="mono">HKAnchoredObjectQuery</span>
            </div>

            {RINGS_P.map((ring, i) => (
              <div class="ring" style={`--d:${ring.d};--cap:${ring.cap};--stroke:${ring.stroke}`} aria-hidden="true">
                <div class="arm arm-dest" style={`--a:${DEST_A_P[i]}`}></div>
                {RIDERS_P.filter((r) => r.ring === i + 1).map((r) => (
                  <div class="arm arm-ride" style={`--a:${r.a}`}></div>
                ))}
              </div>
            ))}

            <div class="layer layer-pins">
              {RINGS_P.map((ring, i) => (
                <div class="ring bare" style={`--d:${ring.d};--cap:${ring.cap}`} aria-hidden="true">
                  <div class="arm" style={`--a:${DEST_A_P[i]}`}>
                    <div class="tip">
                      <div class="pin pin-dest">
                        <i class="bead" style={`--c:${hue(DESTINATIONS[i].category)}`}></i>
                        <b>{DESTINATIONS[i].title}</b>
                        <span class="mono">{SHORT[DESTINATIONS[i].title]}</span>
                      </div>
                    </div>
                  </div>
                  {RIDERS_P.filter((r) => r.ring === i + 1).map((r) => (
                    <div class="arm" style={`--a:${r.a}`}>
                      <div class="tip">
                        <div class="pin pin-ride" style={`--c:${hue(r.category)}`}>
                          <span class="ridline"><i class="bead"></i><span class="mono rid">{r.id}</span></span>
                          <span class="mono rsample">{r.sample}</span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              ))}
            </div>

            <div class="disc" aria-hidden="true"><Mark size={104} /></div>
          </div>
        </figure>

        <div class="shell notewrap">
          <p class="stagenote">
            Six rings, six real destinations, each with a fact you could check. Riding them are
            real HealthKit identifiers — the readings beside them are examples, not your data.
            Nothing on this page ever touches Health.
          </p>
        </div>
       </div>
      </section>

      <!-- ================= the lens ================= -->
      <section class="sec t1" aria-labelledby="lens-h">
        <svg class="crest" viewBox="0 0 1200 48" preserveAspectRatio="none" aria-hidden="true"
          ><path d="M0 48C280-8 920-8 1200 48Z"></path></svg
        >
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              The lens
            </p>
            <h2 id="lens-h">A lens does not <em class="em">change</em> the light it passes.</h2>
            <p class="lede">
              Hozz reads your Health records and hands them on. It does not interpret them, keeps
              nothing on anything of mine, and cannot put a single reading back.
            </p>
          </div>
          <ul class="cards three">
            <li>
              <h3>It reads by anchor</h3>
              <p>
                Every Health type carries its own opaque anchor, advanced only once records are
                durably staged. A resumed export carries on rather than re-reading your history.
              </p>
              <p class="mono fact">HKAnchoredObjectQuery</p>
            </li>
            <li>
              <h3>Nothing sits in the middle</h3>
              <p>
                Your phone talks to your destination directly. There is no relay of mine between
                them, which means there is nothing of mine to breach, subpoena or shut down.
              </p>
              <p class="mono fact">no hosted service</p>
            </li>
            <li>
              <h3>It never writes back</h3>
              <p>
                Health stamps every sample with the app that wrote it, so a returned reading would
                launder its own origin. Hozz reads, and that is all it can do.
              </p>
              <p class="mono fact">read-only, permanently</p>
            </li>
          </ul>
        </div>
      </section>

      <!-- ================= how to export ================= -->
      <section class="sec t1" id="export" aria-labelledby="export-h">
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              The question people actually ask
            </p>
            <h2 id="export-h">How do I <em class="em">export</em> my Apple Health data?</h2>
            <p class="lede">
              Install Hozz on your iPhone — and the companion app on your Mac, if that is where the
              data should land. Then three steps, once. After that new records leave on their own.
            </p>
          </div>
          <ol class="steps">
            {STEPS.map((step, i) => (
              <li style={`--c:${hue(step.category)}`}>
                <span class="mono step-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <p class="aside">
            There is no default destination. Until you add one and confirm it, Hozz reads nothing
            and sends nothing.
          </p>
        </div>
      </section>

      <!-- ================= destinations ================= -->
      <section class="sec t2" id="destinations" aria-labelledby="dest-h">
        <svg class="crest" viewBox="0 0 1200 48" preserveAspectRatio="none" aria-hidden="true"
          ><path d="M0 48C280-8 920-8 1200 48Z"></path></svg
        >
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              Six rings
            </p>
            <h2 id="dest-h">Every one of them somewhere you <em class="em">own.</em></h2>
            <p class="lede">
              These are the six rings in the picture above, written out. Each is a place you
              already run, and each is anchored by something you could go and verify.
            </p>
          </div>
          <ul class="dests">
            {DESTINATIONS.map((d, i) => (
              <li style={`--c:${hue(d.category)}`}>
                <svg class="rip" viewBox="0 0 44 44" aria-hidden="true">
                  <circle cx="22" cy="22" r="3.4" fill="var(--c)" />
                  <circle cx="22" cy="22" r="8.6" fill="none" stroke="var(--c)" stroke-width="1.6" opacity=".6" />
                  <circle cx="22" cy="22" r="14" fill="none" stroke="var(--c)" stroke-width="1.6" opacity=".36" />
                  <circle cx="22" cy="22" r="19.4" fill="none" stroke="var(--c)" stroke-width="1.6" opacity=".18" />
                </svg>
                <p class="mono ringno">ring {String(i + 1).padStart(2, '0')}</p>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
                <p class="mono fact">{d.fact}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ================= formats ================= -->
      <section class="sec t2" id="formats" aria-labelledby="fmt-h">
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              Seven formats
            </p>
            <h2 id="fmt-h"><em class="em">Files,</em> not a database you rent.</h2>
            <p class="lede">
              What the records wear when they arrive. Two of these throw information away — both
              say so here and both say so in the app, because a lossy export is a fine thing to
              want and a bad thing to discover later.
            </p>
          </div>
          <div class="tablewrap">
            <table class="formats">
              <caption class="sr-only">Export formats, what each is for, and what each keeps</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">What it is for</th>
                  <th scope="col">What it keeps</th>
                </tr>
              </thead>
              <tbody>
                {FORMATS.map((f) => {
                  const lossy = f.note.startsWith('Lossy');
                  return (
                    <tr class={lossy ? 'lossy' : undefined}>
                      <th scope="row"><span class="mono">{f.name}</span></th>
                      <td>{f.use}</td>
                      <td>
                        {lossy && <span class="mono tag">lossy</span>}
                        <span>{f.note.replace(/^Lossy — /, '')}</span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ================= what it reads ================= -->
      <section class="sec t3" id="reads" aria-labelledby="reads-h">
        <svg class="crest" viewBox="0 0 1200 48" preserveAspectRatio="none" aria-hidden="true"
          ><path d="M0 48C280-8 920-8 1200 48Z"></path></svg
        >
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              What rides the rings
            </p>
            <h2 id="reads-h">Real identifiers, so you can <em class="em">check</em> the claim.</h2>
            <p class="lede">
              These are Apple's own API names, not invented ones. Anyone who knows HealthKit can
              verify them; anyone who does not still reads the breadth. The values are examples —
              this page has never seen your data, and coverage is still partial.
            </p>
          </div>

          <ul class="cats">
            {CATEGORIES.map((c) => (
              <li style={`--c:${c.hue}`}>
                <i></i>
                {c.label}
              </li>
            ))}
          </ul>

          <ul class="types">
            {allTypes.map((t) => (
              <li style={`--c:${hue(t.category)}`}>
                <i></i>
                <span class="mono tid">{t.id}</span>
                <span class="mono tval">{t.sample}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- ================= durability ================= -->
      <section class="sec t3" id="durability" aria-labelledby="dur-h">
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              Durability
            </p>
            <h2 id="dur-h">An interruption can repeat work. It cannot <em class="em">skip</em> a record.</h2>
            <p class="lede">
              That sentence is the whole design. Everything below exists to make it true, and 475
              XCTest tests exist to keep it true.
            </p>
          </div>
          <ul class="cards four">
            {DURABILITY.map((d) => (
              <li>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
                <p class="mono fact">{d.fact}</p>
              </li>
            ))}
          </ul>
          <p class="aside">
            <span class="mono big">475</span> XCTest tests in the repository, and you can run them
            yourself.
          </p>
        </div>
      </section>

      <!-- ================= honesty ================= -->
      <section class="sec t4" id="honest" aria-labelledby="honest-h">
        <svg class="crest" viewBox="0 0 1200 48" preserveAspectRatio="none" aria-hidden="true"
          ><path d="M0 48C280-8 920-8 1200 48Z"></path></svg
        >
        <div class="shell">
          <div class="head">
            <p class="eyebrow">
              <svg class="glyph" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="2" fill="currentColor" />
                <circle cx="8" cy="8" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55" />
                <circle cx="8" cy="8" r="7.4" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".28" />
              </svg>
              Honesty
            </p>
            <h2 id="honest-h">Where it cannot know, it <em class="em">says</em> so.</h2>
            <p class="lede">
              Apple will not let an app tell “you denied this type” from “you have no data”. So
              Hozz does not print a tick it has not earned. These are the five states it reports.
            </p>
          </div>
          <div class="tablewrap">
            <table class="states">
              <caption class="sr-only">Coverage states Hozz reports for each Health type</caption>
              <thead>
                <tr><th scope="col">State</th><th scope="col">What it means</th></tr>
              </thead>
              <tbody>
                {COVERAGE_STATES.map((s) => (
                  <tr>
                    <th scope="row"><span class={`mono state tone-${s.tone}`}>{s.state}</span></th>
                    <td>{s.body}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="cards three flat">
            <li>
              <h3>No progress percentage</h3>
              <p>
                Health will not say how many records a type holds without reading all of them, so
                any fraction would be invented. Hozz reports how many types are complete and how
                far back they reach instead.
              </p>
            </li>
            <li>
              <h3>iOS decides when it runs</h3>
              <p>
                Background work happens when the system allows it, so most types land near hourly.
                Health cannot be read at all while the phone is locked.
              </p>
            </li>
            <li>
              <h3>Coverage is partial</h3>
              <p>
                Not every Health type is handled yet. A type this version cannot parse is
                quarantined and named, then added once a newer version can read it.
              </p>
            </li>
          </ul>
        </div>
      </section>

      <!-- ================= assistant ================= -->
