        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-500.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }

      :root {
        /* c45 · Ripple, Lens — the whole palette, nothing imported.
           The six lens tones are the page's washes, rim to core. */
        --air: #f7fbfd;
        --t1: #edf6fc;
        --t2: #dcecf6;
        --t3: #cae1f1;
        --t4: #b9d7eb;
        --t5: #a7cce6;
        --t6: #96c2e0;
        /* the water the disc rests in */
        --w1: #96bcd6;
        --w2: #5d8cb0;
        /* keyline and face */
        --ink: #132638;
        /* one step off the keyline, for the word that carries the argument */
        --em: #1d3b57;
        /* the quietest text this page allows: 5.4:1 on the deepest wash */
        --mid: #2e4256;
        --hair: #a9c6db;
        --rule: #bcd6e7;

        --shell: 1240px;

        --display: 'Sentient', Georgia, serif;
        --body: 'General Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;

        --step--1: clamp(0.78rem, 0.75rem + 0.12vw, 0.85rem);
        --step-0: clamp(1rem, 0.96rem + 0.2vw, 1.1rem);
        --step-1: clamp(1.25rem, 1.1rem + 0.52vw, 1.42rem);
        --step-2: clamp(1.58rem, 1.36rem + 0.86vw, 2.05rem);
        --step-3: clamp(1.95rem, 1.5rem + 1.6vw, 2.85rem);
        --step-4: clamp(2.5rem, 1.75rem + 2.9vw, 4.35rem);

        --gap: clamp(1.2rem, 0.9rem + 1.2vw, 2rem);
        --pad-y: clamp(3.4rem, 2.2rem + 4.2vw, 7rem);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--air);
        color: var(--ink);
        font-family: var(--body);
        font-size: var(--step-0);
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        margin: 0;
        font-family: var(--display);
        font-weight: 500;
        letter-spacing: -0.016em;
        text-wrap: balance;
      }

      p {
        margin: 0;
      }

      ul,
      ol,
      dl,
      dd {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      a {
        color: inherit;
      }

      img,
      svg {
        display: block;
        max-width: 100%;
      }

      .mono {
        font-family: var(--mono);
        font-variant-ligatures: none;
      }

      .em {
        font-style: italic;
        color: var(--em);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--ink);
        color: var(--t1);
        padding: 0.7rem 1.1rem;
        border-radius: 0 0 10px 0;
        text-decoration: none;
      }

      .skip:focus {
        left: 0;
      }

      :focus-visible {
        outline: 3px solid var(--em);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .shell {
        width: min(100% - 2.5rem, var(--shell));
        margin-inline: auto;
      }

      /* ---------------- topbar ---------------- */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        background: color-mix(in srgb, var(--air) 86%, transparent);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--rule);
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.7rem;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        font-family: var(--display);
        font-size: 1.16rem;
        font-weight: 500;
        letter-spacing: -0.02em;
      }

      .topnav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 1.6vw, 1.7rem);
        font-size: 0.92rem;
        font-weight: 500;
      }

      .topnav a {
        text-decoration: none;
        color: var(--mid);
        white-space: nowrap;
      }

      .topnav a:hover {
        color: var(--ink);
      }

      .topnav-source {
        color: var(--ink) !important;
        border-bottom: 1.5px solid var(--hair);
        padding-bottom: 1px;
      }

      @media (max-width: 900px) {
        .topnav a:not(.topnav-source) {
          display: none;
        }
      }

      /* ---------------- hero ---------------- */

      .hero {
        position: relative;
        z-index: 0;
        background: var(--air);
        padding-top: clamp(1.6rem, 1.1rem + 1.8vw, 2.8rem);
        padding-bottom: clamp(2rem, 1.4rem + 2vw, 3.4rem);
        overflow: hidden;
      }

      .hero-copy {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 17.5rem);
        gap: clamp(1.8rem, 1rem + 3.4vw, 4.5rem);
        align-items: end;
      }

      .hero-say {
        max-width: 46rem;
      }

      /* Wide: the reader meets the diagram, not a description of it. The copy
         column and the ripple share one grid cell — the drop sits right of the
         text and the outer rings pass behind it, so the first screen is the
         thing spreading. The copy stays on .shell, so its left edge is the
         same x as the nav mark at every width. */
      @media (min-width: 1240px) {
        .herogrid {
          display: grid;
          grid-template-rows: auto auto;
        }

        .hero-copy,
        .stagewrap {
          grid-column: 1;
          grid-row: 1;
        }

        .hero-copy {
          align-self: start;
          grid-template-columns: minmax(0, 1fr);
          gap: clamp(1.5rem, 1rem + 1.2vw, 2.2rem);
          align-items: start;
          width: min(100% - 2.5rem, var(--shell));
          margin-inline: auto;
          pointer-events: none;
        }

        .hero-copy > * {
          max-width: 25.5rem;
          pointer-events: auto;
        }

        .hero-say {
          max-width: 25.5rem;
        }

        .stage {
          margin-top: 0;
        }

        .hero-say h1 {
          font-size: clamp(2.35rem, 1.2rem + 2vw, 3.05rem);
        }

        .notewrap {
          grid-column: 1;
          grid-row: 2;
        }
      }

      .notewrap {
        margin-top: clamp(1rem, 0.7rem + 1vw, 1.7rem);
      }

      .stagenote {
        margin: 0;
        max-width: 46rem;
        font-size: var(--step--1);
        line-height: 1.62;
        color: var(--mid);
      }

      .hero-facts {
        margin: 0 0 0.5rem;
        border-top: 1px solid rgba(93, 140, 176, 0.32);
      }

      .hero-facts > div {
        padding: 0.72rem 0;
        border-bottom: 1px solid rgba(93, 140, 176, 0.32);
      }

      .hero-facts dt {
        font-family: var(--mono);
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--mid);
      }

      .hero-facts dd {
        margin: 0.18rem 0 0;
        font-size: 0.94rem;
        line-height: 1.4;
        color: var(--mid);
      }

      .fnum {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 1.08rem;
        color: var(--ink);
      }

      /* Narrow: the copy column dissolves so the ripple can rise to just under
         the buttons. The statement, the thing spreading, what it means, then
         the counts — the diagram is met, not described. */
      @media (max-width: 900px) {
        .herogrid {
          display: flex;
          flex-direction: column;
        }

        .hero-copy {
          display: contents;
        }

        .hero-say,
        .hero-facts {
          width: min(100% - 2.5rem, var(--shell));
          margin-inline: auto;
        }

        .hero-say {
          order: 1;
        }

        .stagewrap {
          order: 2;
        }

        .notewrap {
          order: 3;
        }

        .hero-facts {
          order: 4;
          margin-top: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
          margin-bottom: 0;
        }
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: var(--step--1);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--mid);
        margin-bottom: 0.9rem;
      }

      .glyph {
        width: 15px;
        height: 15px;
        flex: none;
        color: var(--w2);
      }

      h1 {
        font-size: var(--step-4);
        line-height: 0.98;
        max-width: 16ch;
      }

      .lede {
        margin-top: 1.15rem;
        max-width: 58ch;
        font-size: var(--step-1);
        line-height: 1.52;
        color: var(--mid);
      }

      .actions {
        margin-top: 1.7rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.9rem 1.6rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--ink);
        color: var(--t1);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.98rem;
        padding: 0.72rem 1.25rem;
        border-radius: 999px;
      }

      .btn:hover {
        background: #0c1a28;
      }

      .btn-quiet {
        font-weight: 600;
        font-size: 0.98rem;
        text-decoration: none;
        border-bottom: 2px solid var(--hair);
        padding-bottom: 2px;
      }

      .btn-quiet:hover {
        border-bottom-color: var(--ink);
      }

      /* ---------------- the ripple stage ---------------- */

      .stagewrap {
        margin: 0;
      }

      .stage {
        position: relative;
        z-index: 1;
        width: 100%;
        overflow: hidden;
        margin-top: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
        background: radial-gradient(
          128% 96% at var(--ox) var(--oy),
          #ffffff 0%,
          #f3f9fd 34%,
          #e7f1fa 66%,
          #dbebf6 100%
        );
      }

      /* The drop sits right of centre and a little above it, so the rings have
         room to spread in every direction rather than only downward. Same
         origin at every landscape width, so the composition is one thing that
         scales rather than two that disagree. */
      .stage-l {
        --ox: 64%;
        --oy: 38%;
        --disc: clamp(84px, 8.4vw, 132px);
        height: clamp(660px, 4rem + 44vw, 796px);
      }

      .stage-p {
        --ox: 50%;
        --oy: 20%;
        --disc: clamp(76px, 20vw, 104px);
        height: clamp(680px, 182vw, 880px);
      }

      /* Landscape is the default; the phone gets its own composition. */
      .stage-p {
        display: none;
      }

      @media (max-width: 860px) {
        .stage-l {
          display: none;
        }
        .stage-p {
          display: block;
        }
        .stage-p .pin-ride {
          max-width: 10.4rem;
        }
        .stage-p .pin-ride .rid {
          font-size: 0.61rem;
        }
        .stage-p .pin-ride .rsample {
          font-size: 0.61rem;
        }
        .stage-p .pin-dest {
          max-width: 8.6rem;
        }
        .stage-p .pin {
          padding: 0.36rem 0.54rem;
        }
      }

      /* The one point everything traces back to. */
      .entry {
        position: absolute;
        left: var(--ox);
        top: 0;
        width: 0;
        height: calc(var(--oy) - var(--disc) / 2);
        border-left: 1px dashed var(--w1);
      }

      .disc {
        position: absolute;
        left: var(--ox);
        top: var(--oy);
        width: var(--disc);
        aspect-ratio: 1;
        translate: -50% -50%;
        z-index: 2;
        filter: drop-shadow(0 10px 22px rgba(19, 38, 56, 0.13));
      }

      .disc :global(svg) {
        width: 100%;
        height: auto;
      }

      /* Two layers over one origin: every dashed line is painted first, every
         label second, so no line can ever cross a word. Each .arm rotates, and
         a rotation makes its own stacking context, so z-index inside an arm
         cannot lift a label above a sibling arm's line — separate layers can. */
      .layer {
        position: absolute;
        inset: 0;
      }

      .layer-pins {
        z-index: 3;
      }

      .ring.bare {
        border-color: transparent;
        animation: none;
        opacity: 1;
      }

      /* Ring n is destination n. Diameter is a share of the stage width with a
         cap, so once the composition has its room it stops growing. */
      .ring {        position: absolute;
        left: var(--ox);
        top: var(--oy);
        width: min(var(--d), var(--cap));
        aspect-ratio: 1;
        translate: -50% -50%;
        border: 1px solid var(--stroke);
        border-radius: 50%;
      }

      /* An arm is exactly the ring's radius, so anything at its far end sits
         precisely on the ring at any viewport. */
      .arm {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 50%;
        height: 0;
        transform-origin: 0 0;
        rotate: var(--a);
      }

      .arm-dest {
        border-top: 1px dashed color-mix(in srgb, var(--stroke) 70%, transparent);
      }

      /* Zero-size pivot that undoes the arm's rotation, so labels stay level. */
      .tip {
        position: absolute;
        left: 100%;
        top: 0;
        width: 0;
        height: 0;
        transform-origin: 0 0;
        rotate: calc(-1 * var(--a));
      }

      .pin {
        position: absolute;
        left: 0;
        top: 0;
        translate: -50% -50%;
        width: max-content;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(9px);
        -webkit-backdrop-filter: blur(9px);
        border: 1px solid rgba(93, 140, 176, 0.28);
        border-radius: 11px;
        box-shadow: 0 6px 18px rgba(19, 38, 56, 0.08);
        padding: 0.42rem 0.66rem;
        line-height: 1.3;
      }

      @supports not (backdrop-filter: blur(1px)) {
        .pin {
          background: #fbfdfe;
        }
      }

      .pin b {
        display: flex;
        align-items: center;
        gap: 0.38rem;
        font-weight: 600;
        font-size: clamp(0.8rem, 0.74rem + 0.2vw, 0.92rem);
        letter-spacing: -0.01em;
      }

      .pin .mono {
        display: block;
        font-size: clamp(0.63rem, 0.58rem + 0.16vw, 0.72rem);
        color: var(--mid);
        letter-spacing: -0.005em;
        white-space: nowrap;
      }

      .pin-dest {
        max-width: 15rem;
      }

      .bead {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--c);
        flex: none;
      }

      .pin-ride {
        max-width: 14rem;
      }

      .ridline {
        display: flex;
        align-items: center;
        gap: 0.38rem;
      }

      .pin-ride .rid {
        font-size: clamp(0.63rem, 0.58rem + 0.18vw, 0.74rem);
        font-weight: 500;
        color: var(--ink);
        white-space: nowrap;
      }

      .pin-ride .rsample {
        display: block;
        padding-left: calc(8px + 0.38rem);
        font-size: clamp(0.63rem, 0.58rem + 0.14vw, 0.7rem);
        color: var(--mid);
      }

      .pin-src {
        left: var(--ox);
        top: clamp(28px, 3vw, 32px);
        z-index: 3;
      }

      .stagewrap figcaption {
        margin-top: 1rem;
        padding-bottom: clamp(2.4rem, 1.6rem + 2.4vw, 4rem);
        font-size: var(--step--1);
        line-height: 1.6;
        color: var(--mid);
        max-width: 78ch;
      }

      /* The ripple's energy travels outward; the geometry never moves, so no
         label ever leaves its ring. Inert under reduced motion. */
      @keyframes travel {
        0%,
        100% {
          opacity: 0.55;
        }
        18% {
          opacity: 1;
        }
      }

      .ring {
        animation: travel 9s ease-in-out infinite;
        animation-delay: calc(var(--i, 0) * 0.6s);
      }

      .stage .ring:nth-of-type(1) {
        --i: 0;
      }
      .stage .ring:nth-of-type(2) {
        --i: 1;
      }
      .stage .ring:nth-of-type(3) {
        --i: 2;
      }
      .stage .ring:nth-of-type(4) {
        --i: 3;
      }
      .stage .ring:nth-of-type(5) {
        --i: 4;
      }
      .stage .ring:nth-of-type(6) {
        --i: 5;
      }

      /* ---------------- sections ---------------- */

      .sec {
        position: relative;
        z-index: 0;
        background: var(--wash);
        padding-block: var(--pad-y);
      }

      .sec > .shell {
        position: relative;
        z-index: 2;
      }

      .t1 {
        --wash: var(--t1);
      }
      .t2 {
        --wash: var(--t2);
      }
      .t3 {
        --wash: var(--t3);
      }
      .t4 {
        --wash: var(--t4);
      }
      .t5 {
        --wash: var(--t5);
      }
      .t6 {
        --wash: var(--t6);
      }

      /* Section boundaries are ring crests, not rules. */
      .crest {
        position: absolute;
        left: 0;
        bottom: 100%;
        z-index: 1;
        width: 100%;
        height: clamp(22px, 3.2vw, 48px);
        fill: var(--wash);
        pointer-events: none;
      }

      .crest-dark {
        fill: var(--ink);
      }

      .head {
        max-width: 62rem;
        margin-bottom: clamp(2rem, 1.4rem + 1.8vw, 3.2rem);
      }

      .head h2 {
        font-size: var(--step-3);
        line-height: 1.04;
        max-width: 20ch;
      }

      .head .lede {
        font-size: var(--step-1);
        max-width: 62ch;
      }

      .aside {
        margin-top: clamp(1.4rem, 1rem + 1.2vw, 2.2rem);
        padding-left: 1rem;
        border-left: 2px solid var(--w1);
        color: var(--mid);
        max-width: 60ch;
      }

      .mono.big {
        font-size: var(--step-2);
        font-weight: 500;
        color: var(--ink);
      }

      .fact {
        margin-top: 0.7rem;
        font-size: var(--step--1);
        color: var(--mid);
        letter-spacing: -0.01em;
      }

      .tiny {
        font-family: var(--mono);
        font-size: var(--step--1);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--mid);
        margin-bottom: 0.9rem;
      }

      /* ---------------- card grids ---------------- */

      .cards {
        display: grid;
        gap: var(--gap);
      }

      .cards li {
        background: rgba(255, 255, 255, 0.56);
        border: 1px solid rgba(93, 140, 176, 0.22);
        border-radius: 16px;
        padding: clamp(1.15rem, 0.9rem + 0.9vw, 1.7rem);
      }

      .cards.flat li {
        background: none;
        border: 0;
        border-top: 1px solid var(--rule);
        border-radius: 0;
        padding: 1.1rem 0 0;
      }

      .cards h3 {
        font-size: var(--step-2);
        line-height: 1.12;
        margin-bottom: 0.55rem;
      }

      .cards p {
        color: var(--mid);
        max-width: 44ch;
      }

      @media (min-width: 700px) {
        .cards.three {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .cards.four {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 1060px) {
        .cards.four {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }
      }

      /* ---------------- steps ---------------- */

      .steps {
        display: grid;
        gap: var(--gap);
      }

      @media (min-width: 760px) {
        .steps {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .steps li {
        padding-top: 1.1rem;
        border-top: 2px solid var(--c);
      }

      .step-n {
        font-size: var(--step--1);
        color: var(--mid);
      }

      .steps h3 {
        margin: 0.5rem 0 0.4rem;
        font-size: var(--step-2);
        line-height: 1.14;
      }

      .steps p {
        color: var(--mid);
        max-width: 40ch;
      }

      /* ---------------- destinations ---------------- */

      .dests {
        display: grid;
        gap: var(--gap);
      }

      @media (min-width: 700px) {
        .dests {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 1060px) {
        .dests {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .dests li {
        position: relative;
        background: rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(93, 140, 176, 0.22);
        border-radius: 16px;
        padding: clamp(1.15rem, 0.9rem + 0.9vw, 1.7rem);
      }

      .rip {
        width: 44px;
        height: 44px;
        margin-bottom: 0.8rem;
      }

      .ringno {
        font-size: var(--step--1);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--mid);
      }

      .dests h3 {
        margin: 0.3rem 0 0.5rem;
        font-size: var(--step-2);
        line-height: 1.14;
      }

      .dests > li > p:not(.fact):not(.ringno) {
        color: var(--mid);
        max-width: 40ch;
      }

      /* ---------------- tables ---------------- */

      .tablewrap {
        overflow-x: auto;
        border: 1px solid rgba(93, 140, 176, 0.28);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.6);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        min-width: 36rem;
      }

      thead th {
        text-align: left;
        font-family: var(--mono);
        font-size: var(--step--1);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--mid);
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid var(--rule);
      }

      tbody th,
      tbody td {
        text-align: left;
        font-weight: 400;
        vertical-align: top;
        padding: 0.85rem 1.1rem;
        border-bottom: 1px solid rgba(93, 140, 176, 0.18);
      }

      tbody tr:last-child th,
      tbody tr:last-child td {
        border-bottom: 0;
      }

      tbody th .mono {
        font-weight: 500;
        font-size: 0.95rem;
      }

      tbody td {
        color: var(--mid);
      }

      .tag {
        display: inline-block;
        margin-right: 0.5rem;
        font-size: 0.66rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #7a2b21;
        background: rgba(221, 101, 88, 0.2);
        border-radius: 999px;
        padding: 0.1rem 0.45rem;
        vertical-align: 1px;
      }

      .state {
        font-weight: 500;
        font-size: 0.9rem;
        white-space: nowrap;
      }

      .tone-good {
        color: #2f5f3a;
      }
      .tone-bad {
        color: #7a2b21;
      }
      .tone-unknown {
        color: #6b4a12;
      }
      .tone-flat {
        color: var(--mid);
      }

      /* ---------------- what it reads ---------------- */

      .cats {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 0.55rem;
        margin-bottom: 1.4rem;
      }

      .cats li {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.84rem;
        font-weight: 500;
        padding: 0.24rem 0.6rem 0.24rem 0.45rem;
        border: 1px solid rgba(93, 140, 176, 0.3);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.55);
      }

      .cats i {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--c);
      }

      .types {
        display: grid;
        gap: 0.5rem;
        grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
      }

      .types li {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        min-width: 0;
        padding: 0.5rem 0.7rem;
        background: rgba(255, 255, 255, 0.55);
        border: 1px solid rgba(93, 140, 176, 0.2);
        border-radius: 10px;
      }

      .types i {
        width: 8px;
        height: 8px;
        flex: none;
        border-radius: 50%;
        background: var(--c);
        translate: 0 -1px;
      }

      .tid {
        flex: 1 1 auto;
        min-width: 0;
        font-size: 0.75rem;
        overflow-wrap: anywhere;
      }

      .tval {
        flex: none;
        font-size: 0.72rem;
        color: var(--mid);
      }

      /* ---------------- assistant ---------------- */

      .mcp {
        display: grid;
        gap: clamp(1.8rem, 1.2rem + 2.4vw, 3.6rem);
      }

      @media (min-width: 900px) {
        .mcp {
          grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
        }
      }

      .mcp h2 {
        font-size: var(--step-3);
        line-height: 1.05;
        max-width: 14ch;
      }

      .caveat {
        margin-top: 1.1rem;
        padding-left: 1rem;
        border-left: 2px solid var(--w1);
        color: var(--mid);
        max-width: 54ch;
      }

      .caveat strong {
        color: var(--ink);
        font-weight: 600;
      }

      .mcp-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .mcp-list li {
        font-size: 0.82rem;
        padding: 0.3rem 0.66rem;
        border: 1px solid rgba(93, 140, 176, 0.3);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.55);
      }

      /* ---------------- refusals ---------------- */

      .proms {
        display: grid;
        gap: var(--gap);
      }

      @media (min-width: 640px) {
        .proms {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (min-width: 1000px) {
        .proms {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .proms li {
        padding-top: 0.95rem;
        border-top: 2px solid var(--c);
      }

      .proms h3 {
        font-size: var(--step-2);
        line-height: 1.14;
        margin-bottom: 0.3rem;
      }

      .proms p {
        color: var(--mid);
      }

      /* ---------------- status ---------------- */

      .status {
        display: grid;
        gap: clamp(1.8rem, 1.2rem + 2.2vw, 3.4rem);
      }

      @media (min-width: 760px) {
        .status {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .tick li,
      .cross li {
        position: relative;
        padding-left: 1.7rem;
        padding-block: 0.42rem;
        border-bottom: 1px solid rgba(93, 140, 176, 0.24);
      }

      .tick li::before,
      .cross li::before {
        position: absolute;
        left: 0;
        top: 0.42rem;
        font-family: var(--mono);
        font-size: 0.9rem;
      }

      .tick li::before {
        content: '✓';
        color: #2f5f3a;
      }

      .cross li::before {
        content: '·';
        color: var(--mid);
      }

      .cross li {
        color: var(--mid);
      }

      /* ---------------- faq ---------------- */

      .faq {
        display: grid;
        gap: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
      }

      @media (min-width: 900px) {
        .faq {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .faq > div {
        border-top: 1px solid var(--rule);
        padding-top: 1.1rem;
      }

      .faq dt {
        font-family: var(--display);
        font-size: var(--step-2);
        font-weight: 500;
        line-height: 1.16;
        letter-spacing: -0.016em;
      }

      .faq dd {
        margin-top: 0.55rem;
        color: var(--mid);
        max-width: 56ch;
      }

      /* ---------------- close ---------------- */

      .close-in {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 1.1rem;
      }

      .close-mark {
        filter: drop-shadow(0 8px 18px rgba(19, 38, 56, 0.14));
      }

      .close h2 {
        font-size: var(--step-3);
        line-height: 1.04;
        max-width: 18ch;
      }

      .close p {
        max-width: 46ch;
        font-size: var(--step-1);
        line-height: 1.5;
        color: var(--mid);
      }

      .close .actions {
        justify-content: center;
      }

      /* ---------------- footer ---------------- */

      .footer {
        position: relative;
        z-index: 0;
        background: var(--ink);
        color: var(--t3);
        padding-block: clamp(2.4rem, 1.8rem + 1.8vw, 3.6rem);
      }

      .foot-in {
        position: relative;
        z-index: 2;
        display: grid;
        gap: 2rem;
      }

      @media (min-width: 760px) {
        .foot-in {
          grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
          gap: 3rem;
        }
      }

      .foot-lead {
        max-width: 44ch;
        font-size: 0.95rem;
      }

      .foot-links {
        margin-top: 1rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.4rem;
        font-size: 0.95rem;
      }

      .footer .tiny {
        color: var(--t4);
      }

      .footer a {
        color: var(--t1);
        text-decoration: none;
        border-bottom: 1px solid rgba(150, 188, 214, 0.55);
      }

      .footer a:hover {
        border-bottom-color: var(--t1);
      }

      .footer :focus-visible {
        outline-color: var(--t2);
      }

      .sibs {
        display: grid;
        gap: 0.55rem;
        font-size: 0.95rem;
      }

      .sibs li {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.5rem;
      }

      .sibs span {
        color: var(--t4);
        font-size: 0.88rem;
      }

      /* ---------------- reduced motion ---------------- */

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .ring {
          animation: none;
          opacity: 1;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </body>
</html>
