---
/**
 * w01 · Held — built on mark c01 "Vessel".
 *
 * The mark is a translucent orb lit from the upper left: your history as
 * something held. So the page is a near-white sheet the teal only ever tints,
 * the type is set like a quiet editorial page, and every claim is anchored to a
 * real artefact — an identifier, a port, a format, a state Apple's API actually
 * reports.
 */
import Mark from '../../components/mark/logos/c01.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
  STREAM_LANES,
  SIBLINGS,
} from '../../data/site';

const title = 'Hozz — your Apple Health history, in a file you own';
const description =
  'A free, open-source iPhone app with a companion Mac app. It exports Apple Health to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, a URL or MQTT. No account, no server, no default destination.';

/** Six real HealthKit identifiers for the hero specimen, with example values. */
const specimen = [
  STREAM_LANES[0][0],
  STREAM_LANES[1][1],
  STREAM_LANES[2][1],
  STREAM_LANES[0][2],
  STREAM_LANES[3][4],
  STREAM_LANES[2][4],
];

const glyphs: Record<string, string> = {
  mac: 'M3 5.2h18v10.6H3zM8.4 19.4h7.2M12 15.8v3.6',
  folder: 'M3.2 6.4h6l1.8 2.2h9.8v9.8H3.2zM3.2 6.4v11.9',
  house: 'M3.4 11.2 12 4.4l8.6 6.8M5.8 10.1v9.4h12.4v-9.4M10.2 19.5v-5h3.6v5',
  globe: 'M12 3.6a8.4 8.4 0 1 0 0 16.8 8.4 8.4 0 0 0 0-16.8ZM3.6 12h16.8M12 3.6c4.6 5 4.6 11.8 0 16.8M12 3.6c-4.6 5-4.6 11.8 0 16.8',
  broadcast:
    'M12 10.4a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2ZM8 8a5.6 5.6 0 0 0 0 8M16 8a5.6 5.6 0 0 1 0 8M5.2 5.2a9.6 9.6 0 0 0 0 13.6M18.8 5.2a9.6 9.6 0 0 1 0 13.6',
};

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      description:
        'A free, open-source app that exports Apple Health data to destinations you own: a Mac running the companion app, a folder, Home Assistant, InfluxDB, any web endpoint, or MQTT. No account, no analytics, no hosted relay and no default destination.',
      url: `${SITE}/`,
      license: 'https://www.gnu.org/licenses/gpl-3.0.html',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Brandon Moore' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      softwareVersion: 'Early alpha',
      codeRepository: GITHUB_URL,
      featureList: WORKING,
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I export my Apple Health data?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Install Hozz on your iPhone, add a destination you own — your Mac, a folder, Home Assistant, InfluxDB, a web address or an MQTT broker — choose which Health types to send and how often, then leave it. New records go on their own, and each destination keeps its own place in the queue.',
          },
        },
        ...FAQ.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7faf8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <style is:global>
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-400-italic.woff2') format('woff2');
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500-italic.woff2') format('woff2');
        font-weight: 500;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-400.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-500.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-600.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-500.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }

      :root {
        --paper: #f8fbfa;
        --sheet: #ffffff;
        --wash: #eef5f2;
        --wash-deep: #e4eeeb;
        --ink: #0b2b26;
        --ink-soft: #33534d;
        --ink-mute: #4a655f;
        --line: #d7e4e0;
        --line-soft: #e6eeeb;
        --deep: #0b3b35;
        --teal: #2f8d7e;
        --teal-ink: #17766a;
        --teal-mid: #57bda9;
        --teal-pale: #8fe3d0;
        --ink-inverse: #eaf6f2;

        --serif: 'Sentient', Georgia, 'Times New Roman', serif;
        --sans: 'General Sans', ui-sans-serif, system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

        --gutter: clamp(1.25rem, 4.2vw, 4rem);
        --measure: 68rem;
        --step: clamp(3.5rem, 7vw, 7.5rem);
      }

      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: clamp(1.0625rem, 0.35vw + 1rem, 1.1875rem);
        line-height: 1.62;
        letter-spacing: -0.004em;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      img,
      svg {
        max-width: 100%;
      }
      a {
        color: var(--deep);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.22em;
        text-decoration-color: color-mix(in srgb, var(--teal) 55%, transparent);
      }
      a:hover {
        text-decoration-color: var(--deep);
      }
      :focus-visible {
        outline: 2px solid var(--deep);
        outline-offset: 3px;
        border-radius: 3px;
      }
      ::selection {
        background: var(--teal-pale);
        color: var(--deep);
      }

      h1,
      h2,
      h3 {
        font-family: var(--serif);
        font-weight: 400;
        letter-spacing: -0.018em;
        color: var(--deep);
        margin: 0;
        text-wrap: balance;
      }
      p {
        margin: 0;
      }
      .em {
        font-style: italic;
        color: var(--teal-ink);
      }

      .wrap {
        width: min(100%, var(--measure));
        margin-inline: auto;
        padding-inline: var(--gutter);
      }
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--sheet);
        color: var(--deep);
        padding: 0.7rem 1rem;
        z-index: 20;
      }
      .skip:focus {
        left: 0.75rem;
        top: 0.75rem;
      }

      /* ---------- header ---------- */
      .site-head {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--line-soft);
      }
      .head-in {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        min-height: 4.25rem;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        margin-right: auto;
      }
      .brand b {
        font-family: var(--serif);
        font-size: 1.3rem;
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--deep);
      }
      .site-nav {
        display: none;
        gap: 1.6rem;
      }
      .site-nav a {
        font-size: 0.95rem;
        color: var(--ink-soft);
        text-decoration: none;
      }
      .site-nav a:hover {
        color: var(--deep);
      }
      .head-cta {
        font-size: 0.92rem;
        font-weight: 500;
        color: var(--deep);
        text-decoration: none;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.45rem 0.95rem;
        background: var(--sheet);
        white-space: nowrap;
      }
      .head-cta:hover {
        border-color: var(--teal);
      }
      @media (min-width: 62rem) {
        .site-nav {
          display: flex;
        }
      }

      /* ---------- shared bits ---------- */
      .eyebrow {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-mute);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }
      .eyebrow::before {
        content: '';
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--teal);
        flex: none;
      }
      section {
        padding-block: var(--step);
        border-top: 1px solid var(--line-soft);
      }
      section.plain {
        border-top: 0;
      }
      .lede {
        font-size: clamp(1.15rem, 0.6vw + 1rem, 1.4rem);
        line-height: 1.55;
        color: var(--ink-soft);
        max-width: 34ch;
      }
      .sec-head {
        display: grid;
        gap: 1rem;
        max-width: 46rem;
        margin-bottom: clamp(2.5rem, 4vw, 3.75rem);
      }
      .sec-head h2 {
        font-size: clamp(2rem, 3.4vw, 3.1rem);
        line-height: 1.06;
      }
      .sec-head p {
        color: var(--ink-soft);
        max-width: 52ch;
      }
      .mono {
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: -0.01em;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--sans);
        font-weight: 500;
        font-size: 1rem;
        text-decoration: none;
        border-radius: 999px;
        padding: 0.8rem 1.5rem;
        border: 1px solid transparent;
      }
      .btn-solid {
        background: var(--deep);
        color: #f3fbf8;
      }
      .btn-solid:hover {
        background: #072a26;
      }
      .btn-ghost {
        border-color: var(--line);
        background: var(--sheet);
        color: var(--deep);
      }
      .btn-ghost:hover {
        border-color: var(--teal);
      }

      /* ---------- hero ---------- */
      .hero {
        position: relative;
        padding-block: clamp(3.25rem, 7vw, 6.5rem) clamp(3.5rem, 7vw, 7rem);
        overflow: hidden;
      }
      .hero::before {
        content: '';
        position: absolute;
        inset: -30% -10% auto -10%;
        height: 70%;
        background: radial-gradient(
          46% 60% at 62% 30%,
          color-mix(in srgb, var(--teal-pale) 34%, transparent),
          transparent 70%
        );
        pointer-events: none;
      }
      .hero-in {
        position: relative;
        display: grid;
        gap: clamp(3rem, 6vw, 4.5rem);
        align-items: center;
      }
      @media (min-width: 62rem) {
        .hero-in {
          grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        }
      }
      .hero h1 {
        font-size: clamp(2.85rem, 6.4vw, 5.15rem);
        line-height: 0.98;
        margin-block: 1.4rem 1.5rem;
        letter-spacing: -0.03em;
      }
      .hero .lede {
        max-width: 38ch;
      }
      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
      }
      .fine {
        margin-top: 1.15rem;
        font-size: 0.9rem;
        color: var(--ink-mute);
      }

      .vessel {
        position: relative;
        margin: 0;
        display: grid;
        justify-items: center;
        isolation: isolate;
      }
      .orb {
        width: min(19rem, 54vw);
        aspect-ratio: 1;
        border-radius: 50%;
        background:
          radial-gradient(32% 28% at 30% 23%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 62%),
          radial-gradient(64% 64% at 74% 84%, color-mix(in srgb, var(--teal-pale) 58%, transparent), transparent 60%),
          radial-gradient(80% 80% at 33% 26%, var(--teal-pale), var(--teal-mid) 40%, var(--teal) 70%, #135049 100%);
        box-shadow:
          inset 0 -0.8rem 1.4rem -0.7rem rgba(255, 255, 255, 0.4),
          0 2.25rem 3.5rem -1.75rem rgba(17, 28, 26, 0.28);
        animation: breathe 9s ease-in-out infinite;
      }
      @keyframes breathe {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-0.55rem);
        }
      }
      .card {
        width: min(29rem, 100%);
        margin-top: -3.25rem;
        background: var(--sheet);
        border: 1px solid var(--line);
        border-radius: 1.1rem;
        box-shadow: 0 1.25rem 2.5rem -1.75rem rgba(17, 28, 26, 0.35);
        padding: 1.15rem 1.25rem 1rem;
        position: relative;
        z-index: 1;
      }
      .card-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: 0.7rem;
        border-bottom: 1px solid var(--line-soft);
      }
      .card-head span {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ink-mute);
      }
      .card ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .card li {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.42rem 0;
        border-bottom: 1px dotted var(--line);
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--ink-soft);
      }
      .card li:last-of-type {
        border-bottom: 0;
      }
      .card li b {
        font-weight: 500;
        color: var(--deep);
        white-space: nowrap;
      }
      .card li i {
        font-style: normal;
        overflow-wrap: anywhere;
      }
      .caption {
        margin-top: 0.7rem;
        font-size: 0.78rem;
        line-height: 1.5;
        color: var(--ink-mute);
      }

      /* ---------- steps ---------- */
      .answer {
        max-width: 44rem;
        font-size: clamp(1.1rem, 0.5vw + 1rem, 1.3rem);
        line-height: 1.55;
        color: var(--ink-soft);
      }
      .answer strong {
        color: var(--deep);
        font-weight: 500;
      }
      .steps {
        list-style: none;
        counter-reset: s;
        margin: clamp(2.5rem, 4vw, 3.5rem) 0 0;
        padding: 0;
        display: grid;
        gap: 2rem;
      }
      @media (min-width: 48rem) {
        .steps {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: clamp(1.5rem, 3vw, 3rem);
        }
      }
      .steps li {
        counter-increment: s;
        padding-top: 1.1rem;
        border-top: 2px solid var(--teal-mid);
      }
      .steps li::before {
        content: counter(s, decimal-leading-zero);
        font-family: var(--mono);
        font-size: 0.76rem;
        letter-spacing: 0.12em;
        color: var(--teal-ink);
      }
      .steps h3 {
        font-size: 1.5rem;
        margin: 0.4rem 0 0.5rem;
      }
      .steps p {
        color: var(--ink-soft);
        font-size: 1rem;
      }

      /* ---------- destinations ---------- */
      .tinted {
        background: var(--wash);
        border-top: 1px solid var(--line-soft);
      }
      .dest {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        border-radius: 1rem;
        overflow: hidden;
      }
      @media (min-width: 40rem) {
        .dest {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 66rem) {
        .dest {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      .dest li {
        background: var(--sheet);
        padding: 1.6rem 1.5rem 1.4rem;
        display: grid;
        gap: 0.5rem;
        align-content: start;
      }
      .dest svg {
        color: var(--teal-ink);
      }
      .dest h3 {
        font-size: 1.35rem;
        margin-top: 0.35rem;
      }
      .dest p {
        color: var(--ink-soft);
        font-size: 0.98rem;
      }
      .dest .fact {
        font-family: var(--mono);
        font-size: 0.74rem;
        color: var(--deep);
        background: var(--wash-deep);
        border-radius: 0.4rem;
        padding: 0.3rem 0.5rem;
        justify-self: start;
        max-width: 100%;
        overflow-wrap: anywhere;
        margin-top: 0.35rem;
      }

      /* ---------- formats ---------- */
      .table-scroll {
        overflow-x: auto;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.98rem;
      }
      @media (min-width: 46rem) {
        table {
          min-width: 34rem;
        }
      }
      caption {
        text-align: left;
        color: var(--ink-mute);
        font-size: 0.88rem;
        padding-bottom: 0.9rem;
      }
      th,
      td {
        text-align: left;
        padding: 0.95rem 1rem 0.95rem 0;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      thead th {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        border-bottom-color: var(--deep);
      }
      tbody th {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--deep);
        white-space: nowrap;
        padding-right: 1.5rem;
      }
      td {
        color: var(--ink-soft);
      }
      .tag {
        display: inline-block;
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.18rem 0.45rem;
        border-radius: 0.35rem;
        margin-right: 0.5rem;
        vertical-align: 1px;
      }
      .tag-lossy {
        background: #fdeee8;
        color: #8a3410;
      }
      .tag-loss {
        background: var(--wash-deep);
        color: var(--deep);
      }
      @media (max-width: 45.99rem) {
        thead {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip-path: inset(50%);
          white-space: nowrap;
        }
        table,
        tbody,
        tbody tr,
        tbody th,
        tbody td {
          display: block;
          width: 100%;
        }
        caption {
          display: block;
        }
        tbody tr {
          padding-block: 1.1rem;
          border-bottom: 1px solid var(--line);
        }
        tbody th,
        tbody td {
          border: 0;
          padding: 0;
        }
        tbody th {
          font-size: 1.05rem;
          margin-bottom: 0.3rem;
        }
        tbody td {
          padding-top: 0.3rem;
        }
      }

      /* ---------- trust ---------- */
      .split {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4rem);
      }
      @media (min-width: 60rem) {
        .split {
          grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        }
      }
      .dur {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1.6rem;
      }
      .dur li {
        display: grid;
        gap: 0.35rem;
        padding-left: 1.25rem;
        border-left: 2px solid var(--teal-mid);
      }
      .dur h3 {
        font-size: 1.2rem;
      }
      .dur p {
        color: var(--ink-soft);
        font-size: 0.98rem;
      }
      .dur code {
        font-family: var(--mono);
        font-size: 0.74rem;
        color: var(--teal-ink);
      }
      .stat {
        background: var(--sheet);
        border: 1px solid var(--line);
        border-radius: 1rem;
        padding: 1.6rem;
        display: grid;
        gap: 0.35rem;
        margin-bottom: 2rem;
      }
      .stat b {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(3rem, 6vw, 4.25rem);
        line-height: 1;
        color: var(--deep);
      }
      .stat span {
        color: var(--ink-soft);
        font-size: 0.98rem;
      }
      .states {
        margin: 0;
        display: grid;
        gap: 0.9rem;
      }
      .states div {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.35rem;
        align-items: baseline;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid var(--line);
      }
      @media (min-width: 30rem) {
        .states div {
          grid-template-columns: minmax(8.5rem, auto) minmax(0, 1fr);
          gap: 0.4rem 1rem;
        }
      }
      .states dt {
        font-family: var(--mono);
        font-size: 0.82rem;
        color: var(--deep);
      }
      .states dd {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }
      .dot {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        margin-right: 0.5rem;
        background: var(--teal);
      }
      .tone-unknown {
        background: #b8901f;
      }
      .tone-flat {
        background: #93a8a3;
      }
      .tone-bad {
        background: #c0533f;
      }

      /* ---------- promises ---------- */
      .no {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--line);
        border-block: 1px solid var(--line);
      }
      @media (min-width: 40rem) {
        .no {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 60rem) {
        .no {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      .no li {
        background: var(--paper);
        padding: 1.4rem 1.2rem 1.4rem 0;
        display: grid;
        gap: 0.2rem;
      }
      @media (min-width: 40rem) {
        .no li {
          padding-left: 1.2rem;
        }
        .no li:nth-child(2n + 1) {
          padding-left: 0;
        }
      }
      @media (min-width: 60rem) {
        .no li:nth-child(2n + 1) {
          padding-left: 1.2rem;
        }
        .no li:nth-child(3n + 1) {
          padding-left: 0;
        }
      }
      .no b {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 1.2rem;
        color: var(--deep);
      }
      .no span {
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      /* ---------- assistant ---------- */
      .dark {
        background: var(--deep);
        color: var(--ink-inverse);
        border-top: 0;
      }
      .dark h2,
      .dark h3 {
        color: #ffffff;
      }
      .dark .em {
        color: var(--teal-pale);
      }
      .dark .sec-head p,
      .dark p {
        color: #cfe8e1;
      }
      .dark .eyebrow {
        color: #a9cfc7;
      }
      .dark .eyebrow::before {
        background: var(--teal-pale);
      }
      .tools {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .tools li {
        font-family: var(--mono);
        font-size: 0.78rem;
        border: 1px solid #2c6259;
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        color: #d6efe9;
      }
      .caveat {
        margin-top: 2rem;
        border-left: 2px solid var(--teal-pale);
        padding: 0.15rem 0 0.15rem 1.25rem;
      }
      .caveat p {
        color: #d6efe9;
      }
      .dark .fine {
        color: #a9cfc7;
      }

      /* ---------- status ---------- */
      .cols {
        display: grid;
        gap: clamp(2.5rem, 5vw, 4rem);
      }
      @media (min-width: 54rem) {
        .cols {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .cols h3 {
        font-size: 1.35rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 1rem;
      }
      .ticks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.6rem;
      }
      .ticks li {
        display: grid;
        grid-template-columns: 1.4rem minmax(0, 1fr);
        align-items: baseline;
        color: var(--ink-soft);
        font-size: 1rem;
      }
      .ticks li::before {
        font-family: var(--mono);
        font-size: 0.85rem;
        color: var(--teal-ink);
      }
      .ticks.yes li::before {
        content: '✓';
      }
      .ticks.not li::before {
        content: '—';
        color: var(--ink-mute);
      }

      /* ---------- faq ---------- */
      .faq {
        display: grid;
        gap: 2.25rem;
      }
      @media (min-width: 60rem) {
        .faq {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 2.5rem clamp(2.5rem, 5vw, 4rem);
        }
      }
      .faq h3 {
        font-size: 1.3rem;
        margin-bottom: 0.5rem;
      }
      .faq p {
        color: var(--ink-soft);
        font-size: 1rem;
      }

      /* ---------- close ---------- */
      .close {
        text-align: center;
        display: grid;
        justify-items: center;
        gap: 1.25rem;
      }
      .close h2 {
        font-size: clamp(2.2rem, 4.6vw, 3.6rem);
        line-height: 1.04;
        max-width: 18ch;
      }
      .close p {
        color: var(--ink-soft);
        max-width: 46ch;
      }

      /* ---------- footer ---------- */
      footer {
        border-top: 1px solid var(--line);
        padding-block: 3rem 3.5rem;
        font-size: 0.92rem;
        color: var(--ink-mute);
      }
      .foot-in {
        display: grid;
        gap: 2rem;
      }
      @media (min-width: 54rem) {
        .foot-in {
          grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
        }
      }
      footer h2 {
        font-size: 0.72rem;
        font-family: var(--mono);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: 0.75rem;
      }
      footer ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.45rem;
      }
      footer a {
        color: var(--ink-soft);
      }
      .colophon {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line-soft);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        justify-content: space-between;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="wrap head-in">
        <a class="brand" href="#main">
          <Mark size={28} />
          <b>Hozz</b>
        </a>
        <nav class="site-nav" aria-label="Sections">
          <a href="#export">How to export</a>
          <a href="#destinations">Destinations</a>
          <a href="#formats">Formats</a>
          <a href="#trust">Honesty</a>
          <a href="#status">Status</a>
        </nav>
        <a class="head-cta" href={GITHUB_URL}>Source on GitHub</a>
      </div>
    </header>

    <main id="main">
      <section class="hero plain">
        <div class="wrap hero-in">
          <div>
            <p class="eyebrow">Free · open source · early alpha</p>
            <h1>Your health history, in a file you <span class="em">own</span>.</h1>
            <p class="lede">
              Hozz is a free iPhone app that copies your Apple Health data out to
              somewhere of your choosing — your Mac, a folder, your own dashboard —
              and keeps it current on its own.
            </p>
            <div class="cta">
              <a class="btn btn-solid" href={GITHUB_URL}>Read the source</a>
              <a class="btn btn-ghost" href="#export">How the export works</a>
            </div>
            <p class="fine">
              No account. No subscription. No server of mine. There is no default
              destination, so nothing leaves your phone until you add one and
              confirm it.
            </p>
          </div>

          <figure class="vessel">
            <div class="orb" aria-hidden="true"></div>
            <div class="card">
              <div class="card-head">
                <span>Sample of what it reads</span>
                <span class="mono">HealthKit</span>
              </div>
              <ul>
                {
                  specimen.map((s) => (
                    <li>
                      <i>{s.id}</i>
                      <b>{s.sample}</b>
                    </li>
                  ))
                }
              </ul>
              <figcaption class="caption">
                The identifiers are real HealthKit type names. The readings beside
                them are examples, not anyone's data. Hozz also exports ECG voltage
                waveforms, audiograms, workout routes, State of Mind and medication
                doses.
              </figcaption>
            </div>
          </figure>
        </div>
      </section>

      <section id="export">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">How to export</p>
            <h2>How do I export my Apple Health data?</h2>
          </div>
          <p class="answer">
            Apple can hand you one enormous zipped XML file, once, when you ask.
            Hozz does the other thing: you <strong>add a destination you own</strong>,
            <strong>pick the types and a schedule</strong>, and then new records go
            there by themselves — as NDJSON, SQLite, JSON, CSV, Markdown or GPX.
            Nothing is uploaded to anyone in the middle, because there is no middle.
          </p>
          <ol class="steps">
            {
              STEPS.map((s) => (
                <li>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <section id="destinations" class="tinted">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">Where it sends</p>
            <h2>Six places, all of them <span class="em">yours</span>.</h2>
            <p>
              Every destination is somewhere you already run or already pay for.
              Test one before you trust it; each keeps its own place in the queue.
            </p>
          </div>
          <ul class="dest">
            {
              DESTINATIONS.map((d) => (
                <li>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d={glyphs[d.icon]}
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  <h3>{d.title}</h3>
                  <p>{d.body}</p>
                  <span class="fact">{d.fact}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section id="formats">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">What comes out</p>
            <h2>A file you can still open in <span class="em">ten years</span>.</h2>
            <p>
              Seven formats, and the page says plainly which ones throw something
              away. SQLite is the archival one: every row keeps its original record
              in <code class="mono">raw</code>.
            </p>
          </div>
          <div class="table-scroll">
            <table>
              <caption>Formats, what each is for, and what it costs you.</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">Good for</th>
                  <th scope="col">Fidelity</th>
                </tr>
              </thead>
              <tbody>
                {
                  FORMATS.map((f) => {
                    const lossy = f.note.startsWith('Lossy');
                    const lossless = f.note.startsWith('Lossless');
                    const rest = f.note.replace(/^Loss(y|less)\s*(—\s*)?/, '');
                    return (
                      <tr>
                        <th scope="row">{f.name}</th>
                        <td>{f.use}</td>
                        <td>
                          {lossy && <span class="tag tag-lossy">Lossy</span>}
                          {lossless && <span class="tag tag-loss">Lossless</span>}
                          {rest}
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="trust" class="tinted">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">Why it can be trusted</p>
            <h2>An interruption can repeat work. It cannot <span class="em">skip</span> a record.</h2>
          </div>
          <div class="split">
            <ul class="dur">
              {
                DURABILITY.map((d) => (
                  <li>
                    <h3>{d.title}</h3>
                    <p>{d.body}</p>
                    <code>{d.fact}</code>
                  </li>
                ))
              }
            </ul>
            <div>
              <p class="stat">
                <b>475</b>
                <span>
                  XCTest tests covering the export path — the anchors, the retries,
                  the parsing and the formats.
                </span>
              </p>
              <h3 style="font-size:1.35rem;margin-bottom:0.75rem;">
                And where it cannot be certain, it says so
              </h3>
              <p style="color:var(--ink-soft);font-size:1rem;margin-bottom:1.5rem;">
                Apple will not let an app tell “you denied this type” from “you have
                no data”, so Hozz shows a state instead of a green tick. These are
                the five it reports.
              </p>
              <dl class="states">
                {
                  COVERAGE_STATES.map((c) => (
                    <div>
                      <dt>
                        <span class={`dot tone-${c.tone}`} aria-hidden="true" />
                        {c.state}
                      </dt>
                      <dd>{c.body}</dd>
                    </div>
                  ))
                }
              </dl>
              <p style="color:var(--ink-soft);font-size:0.95rem;margin-top:1.25rem;">
                There is no progress percentage either. Health will not say how many
                records a type holds without reading them all, so any fraction would
                be invented.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section id="promises">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">The refusals</p>
            <h2>Written as things it will <span class="em">never</span> do.</h2>
          </div>
          <ul class="no">
            {
              PROMISES.map((p) => (
                <li>
                  <b>{p.title}</b>
                  <span>{p.body}</span>
                </li>
              ))
            }
          </ul>
          <p style="margin-top:2rem;color:var(--ink-soft);max-width:52ch;">
            One more, and it is permanent: Hozz will never write anything back into
            Apple Health. Health stamps provenance on every sample and HealthKit has
            no upsert, so a re-import would both launder the record's origin and
            silently double your history.
          </p>
        </div>
      </section>

      <section id="assistant" class="dark">
        <div class="wrap">
          <div class="split">
            <div class="sec-head" style="margin-bottom:0;">
              <p class="eyebrow">The assistant</p>
              <h2>Ask your own assistant, <span class="em">read-only</span>.</h2>
              <p>
                The Mac app ships an MCP server that reads the database your phone
                keeps current. A question costs a lookup instead of re-parsing a
                stale XML export — and the server cannot change or delete anything.
              </p>
            </div>
            <div>
              <ul class="tools">
                {MCP_TOOLS.map((t) => <li>{t}</li>)}
              </ul>
              <div class="caveat">
                <p>
                  Worth printing plainly: a cloud assistant may upload whatever it
                  reads. That is the assistant's behaviour, not Hozz's. Point a local
                  model at it if that matters to you.
                </p>
              </div>
              <p class="fine">Runs on your Mac, on your network. Nothing is exposed to the internet.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="status">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">Status · early alpha</p>
            <h2>It works. Coverage is <span class="em">partial</span>.</h2>
            <p>
              One developer, in the open. Both halves of that sentence are the
              truth, so here is each of them as a list.
            </p>
          </div>
          <div class="cols">
            <div>
              <h3>Working today</h3>
              <ul class="ticks yes">
                {WORKING.map((w) => <li><span>{w}</span></li>)}
              </ul>
            </div>
            <div>
              <h3>Not yet</h3>
              <ul class="ticks not">
                {NOT_YET.map((n) => <li><span>{n}</span></li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="faq" class="tinted">
        <div class="wrap">
          <div class="sec-head">
            <p class="eyebrow">Questions</p>
            <h2>The awkward ones, answered.</h2>
          </div>
          <div class="faq">
            {
              FAQ.map((f) => (
                <div>
                  <h3>{f.q}</h3>
                  <p>{f.a}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="close">
        <div class="wrap close">
          <Mark size={64} />
          <h2>Your history, held where you put it.</h2>
          <p>
            Free forever, GPL-3.0, no paid tier planned. Read the code before you
            trust it with anything — that is rather the point.
          </p>
          <div class="cta" style="justify-content:center;">
            <a class="btn btn-solid" href={GITHUB_URL}>Get it on GitHub</a>
            <a class="btn btn-ghost" href={DONATE_URL}>Sponsor the work</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot-in">
        <div>
          <a class="brand" href="#main" style="margin-bottom:0.75rem;">
            <Mark size={24} />
            <b>Hozz</b>
          </a>
          <p>
            An Apple Health export app for iPhone, with a companion Mac app. By
            Brandon Moore.
          </p>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href={GITHUB_URL}>Source</a></li>
            <li><a href={LICENSE_URL}>GPL-3.0 licence</a></li>
            <li><a href={DONATE_URL}>Sponsor</a></li>
            <li><a href="/privacy/">Privacy</a></li>
          </ul>
        </div>
        <div>
          <h2>Also</h2>
          <ul>
            {
              SIBLINGS.map((s) => (
                <li>
                  <a href={s.href}>{s.name}</a> — {s.body}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="wrap colophon">
        <span>No cookies, no analytics, no third-party requests on this page.</span>
        <span class="mono">early alpha</span>
      </div>
    </footer>
  </body>
</html>
