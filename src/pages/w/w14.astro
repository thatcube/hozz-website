---
/**
 * w14 · No Leap — built on c45 "Ripple, Lens".
 *
 * The hero is a crossing rather than a cloud. Every floating foothold is a real
 * state in Hozz's export path: ask from the last HealthKit anchor, stage the
 * record durably, deliver with a content-derived id, and only then arrive
 * somewhere the user controls. An interruption may put a foot down twice; it
 * cannot open a gap in the crossing.
 */
import Mark from '../../components/mark/logos/c45.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  CATEGORIES,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
} from '../../data/site';

const hue = Object.fromEntries(CATEGORIES.map((category) => [category.key, category.hue])) as Record<
  string,
  string
>;

const crossing = [
  {
    number: '01',
    label: 'Ask from the last anchor',
    fact: 'HKAnchoredObjectQuery',
    note: 'No date window to leave a crack between runs.',
  },
  {
    number: '02',
    label: 'Stage the records',
    fact: 'checkpointed',
    note: 'The anchor waits until the copy is durable.',
  },
  {
    number: '03',
    label: 'Deliver safely',
    fact: 'Idempotency-Key',
    note: 'A repeated send is still one record.',
  },
  {
    number: '04',
    label: 'Advance the anchor',
    fact: 'no skipped records',
    note: 'The next run starts exactly where this one ended.',
  },
];

const destinationIcons: Record<string, string> = {
  mac: 'M4 5.5h16v10H4zM8 19h8M12 15.5V19',
  folder: 'M3.5 7h6l2 2h9v9h-17z',
  house: 'M3.5 11 12 4l8.5 7M6 10v10h12V10',
  globe:
    'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18M3 12h18M12 3c4.5 5 4.5 13 0 18M12 3c-4.5 5-4.5 13 0 18',
  broadcast:
    'M12 10.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M8 8a5.5 5.5 0 0 0 0 8M16 8a5.5 5.5 0 0 1 0 8M5 5a9.5 9.5 0 0 0 0 14M19 5a9.5 9.5 0 0 1 0 14',
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      url: `${SITE}/w/w14/`,
      codeRepository: GITHUB_URL,
      license: LICENSE_URL,
      isAccessibleForFree: true,
      softwareVersion: 'Early alpha',
      author: { '@type': 'Person', name: 'Brandon Moore' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'A free, open-source iPhone app with a companion Mac app that exports Apple Health records to destinations the user controls.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8fcff" />
    <meta
      name="description"
      content="Hozz makes a durable copy of your Apple Health history in a place you control. Free, open source, no account, no analytics and no hosted relay."
    />
    <link rel="canonical" href={`${SITE}/w/w14/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sentient-500.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>Hozz — move your Apple Health history without leaving gaps</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="mast">
      <div class="shell mast-in">
        <a class="brand" href="#top" aria-label="Hozz, back to top">
          <Mark size={28} />
          <span>Hozz</span>
        </a>
        <nav aria-label="Page sections">
          <a href="#how">How it works</a>
          <a href="#destinations">Destinations</a>
          <a href="#formats">Formats</a>
          <a href="#status">Status</a>
        </nav>
        <a class="source" href={GITHUB_URL}>Source <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="shell hero-copy">
          <p class="eyebrow">Apple Health export · free · open source</p>
          <h1>Move your health history without taking a <em class="em">leap</em>.</h1>
          <p class="lede">
            Apple Health holds the original. Hozz makes the copy you control — and moves its place
            forward only after every record behind it is safe.
          </p>
          <div class="actions">
            <a class="button primary" href={GITHUB_URL}>Read the source</a>
            <a class="button secondary" href="#how">Follow the crossing</a>
          </div>
          <p class="conditions">
            No account{' '}<span aria-hidden="true">·</span>{' '}No subscription{' '}<span
              aria-hidden="true">·</span
            >{' '}No default destination
          </p>
        </div>

        <!-- Landscape and portrait are separately composed, not one squashed diagram. -->
        <figure class="crossing crossing-landscape" aria-labelledby="crossing-caption">
          <svg class="route-lines" viewBox="0 0 1440 510" preserveAspectRatio="none" aria-hidden="true">
            <path d="M-40 366 C140 352 210 315 332 280 S560 355 678 324 S855 220 982 233 S1200 321 1480 222" />
            <path class="echo" d="M-40 382 C135 368 218 330 336 296 S552 371 682 340 S854 237 986 250 S1205 338 1480 239" />
          </svg>

          <div class="origin float">
            <div class="origin-mark"><Mark size={42} /></div>
            <div>
              <span class="float-label">Original remains in</span>
              <strong>Apple Health</strong>
              <code>sleepAnalysis · 7h 12m</code>
            </div>
          </div>

          {
            crossing.map((step, index) => (
              <article class={`foothold foothold-${index + 1} float`}>
                <span class="step-number">{step.number}</span>
                <h2>{step.label}</h2>
                <code>{step.fact}</code>
                <p>{step.note}</p>
              </article>
            ))
          }

          <div class="arrival float">
            <span class="float-label">The copy arrives at</span>
            <strong>A place you own</strong>
            <code>Your Mac · _hozz._tcp · :54330</code>
          </div>
          <figcaption id="crossing-caption">
            The four floating steps are the actual durability sequence — not progress theatre.
          </figcaption>
        </figure>

        <figure class="crossing crossing-portrait" aria-labelledby="portrait-caption">
          <div class="portrait-route" aria-hidden="true"></div>
          <div class="origin float">
            <div class="origin-mark"><Mark size={38} /></div>
            <div>
              <span class="float-label">Original remains in</span>
              <strong>Apple Health</strong>
              <code>sleepAnalysis · 7h 12m</code>
            </div>
          </div>
          {
            crossing.map((step, index) => (
              <article class={`foothold portrait-step-${index + 1} float`}>
                <span class="step-number">{step.number}</span>
                <h2>{step.label}</h2>
                <code>{step.fact}</code>
                <p>{step.note}</p>
              </article>
            ))
          }
          <div class="arrival float">
            <span class="float-label">The copy arrives at</span>
            <strong>A place you own</strong>
            <code>Your Mac · _hozz._tcp · :54330</code>
          </div>
          <figcaption id="portrait-caption">
            The anchor moves only after the records behind it are safe.
          </figcaption>
        </figure>
      </section>

      <section class="thesis" aria-label="The Hozz promise">
        <div class="shell thesis-grid">
          <p class="thesis-big">
            An interruption can repeat a step. It cannot <em>skip</em> a record.
          </p>
          <p>
            That is not a slogan laid over the product. It is the product: per-type HealthKit
            anchors, durable staging, checkpoints and content-derived ids.
          </p>
        </div>
      </section>

      <section class="section how" id="how" aria-labelledby="how-title">
        <div class="shell">
          <div class="section-head split-head">
            <div>
              <p class="eyebrow">How to export</p>
              <h2 id="how-title">A second copy, in three <em class="em">ordinary</em> choices.</h2>
            </div>
            <p class="lead">
              Hozz does not move the original or write anything back. It reads the types you
              permit and sends new records directly to the place you configure.
            </p>
          </div>

          <ol class="steps">
            {
              STEPS.map((step, index) => (
                <li style={`--category:${hue[step.category]}`}>
                  <span class="big-number">{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="fine">
            iOS decides when background work runs, so most types land near hourly. Health cannot
            be read while the phone is locked. Hozz reports both facts instead of promising a
            schedule the operating system does not.
          </p>
        </div>
      </section>

      <section class="section destinations" id="destinations" aria-labelledby="destinations-title">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow">Six landing places</p>
            <h2 id="destinations-title">The far side is somewhere <em class="em">you</em> chose.</h2>
            <p class="lead">
              There is no hosted relay and no default destination. Each route keeps its own place
              in the queue, so one unavailable destination does not hold up another.
            </p>
          </div>

          <ul class="destination-grid">
            {
              DESTINATIONS.map((destination, index) => (
                <li style={`--category:${hue[destination.category]}`}>
                  <div class="destination-top">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={destinationIcons[destination.icon]} />
                    </svg>
                    <span>{String(index + 1).padStart(2, '0')} / 06</span>
                  </div>
                  <h3>{destination.title}</h3>
                  <p>{destination.body}</p>
                  <code>{destination.fact}</code>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section formats" id="formats" aria-labelledby="formats-title">
        <div class="shell">
          <div class="section-head split-head">
            <div>
              <p class="eyebrow">Seven forms for the copy</p>
              <h2 id="formats-title">The label tells you what gets <em class="em">lost</em>.</h2>
            </div>
            <p class="lead">
              A spreadsheet cannot hold nested workout detail. A daily note is not the records
              behind it. Hozz says “lossy” where it is lossy, then lets you choose.
            </p>
          </div>

          <div class="format-table">
            <table>
              <caption>Hozz export formats, their use, and their fidelity.</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">Useful for</th>
                  <th scope="col">Fidelity</th>
                </tr>
              </thead>
              <tbody>
                {
                  FORMATS.map((format) => {
                    const lossless = format.note.startsWith('Lossless');
                    const lossy = format.note.startsWith('Lossy');
                    return (
                      <tr>
                        <th scope="row"><code>{format.name}</code></th>
                        <td data-label="Useful for">{format.use}</td>
                        <td data-label="Fidelity">
                          {(lossless || lossy) && (
                            <span class={`fidelity ${lossless ? 'is-lossless' : 'is-lossy'}`}>
                              {lossless ? 'Lossless' : 'Lossy'}
                            </span>
                          )}
                          {format.note}
                        </td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
          <p class="fine">
            SQLite is the archival choice. Every row keeps its original record in <code>raw</code>,
            so a later version can recover detail this one did not yet understand.
          </p>
        </div>
      </section>

      <section class="section reliability" id="reliability" aria-labelledby="reliability-title">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow">Why the crossing holds</p>
            <h2 id="reliability-title">No gap depends on <em class="em">good luck</em>.</h2>
            <p class="lead">
              The visual path at the top is backed by four specific mechanisms. Each answers a
              different way an export can be interrupted.
            </p>
          </div>

          <ol class="durability-grid">
            {
              DURABILITY.map((item, index) => (
                <li>
                  <span class="ripple-index">{String(index + 1).padStart(2, '0')}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <code>{item.fact}</code>
                </li>
              ))
            }
          </ol>

          <div class="test-note">
            <strong>475</strong>
            <div>
              <h3>XCTest tests</h3>
              <p>
                The current suite exercises the export path — anchors, retries, parsing, formats
                and the edge cases between them.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section refusals" id="privacy" aria-labelledby="privacy-title">
        <div class="shell refusal-layout">
          <div class="section-head">
            <p class="eyebrow">The boundaries</p>
            <h2 id="privacy-title">Nothing crosses a line you did not <em class="em">draw</em>.</h2>
            <p class="lead">
              Hozz has no service waiting to receive your data. Until you add a destination and
              confirm it, nothing leaves your phone.
            </p>
          </div>
          <ul class="refusal-list">
            {
              PROMISES.map((promise) => (
                <li style={`--category:${hue[promise.category]}`}>
                  <span aria-hidden="true">—</span>
                  <div>
                    <h3>{promise.title}</h3>
                    <p>{promise.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="shell permanent">
          <p class="permanent-label">One permanent refusal</p>
          <p>
            Hozz will never write records back into Apple Health. Re-importing would replace each
            record’s original provenance with Hozz and, because HealthKit has no upsert, could
            silently double your history.
          </p>
        </div>
      </section>

      <section class="section assistant" aria-labelledby="assistant-title">
        <div class="shell assistant-grid">
          <div class="section-head">
            <p class="eyebrow">After the copy lands on your Mac</p>
            <h2 id="assistant-title">Ask questions. Keep the archive <em class="em">read-only</em>.</h2>
            <p class="lead">
              The Mac app ships an MCP server over its local database. It can inspect the copy;
              the server cannot change or delete it.
            </p>
            <p class="fine caveat">
              A cloud assistant may upload whatever it reads. That is the assistant’s behaviour,
              not Hozz’s. Choose the assistant accordingly.
            </p>
          </div>
          <div class="tool-panel">
            <div class="panel-head">
              <span>Local query surface</span>
              <code>READ_ONLY</code>
            </div>
            <ul>
              {MCP_TOOLS.map((tool) => <li>{tool}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section status" id="status" aria-labelledby="status-title">
        <div class="shell">
          <div class="section-head split-head">
            <div>
              <p class="eyebrow">Early alpha</p>
              <h2 id="status-title">Working now. Coverage still <em class="em">partial</em>.</h2>
            </div>
            <p class="lead">
              Both halves matter. This is one developer building in the open, so the unfinished
              edge is listed beside the working one.
            </p>
          </div>

          <div class="status-columns">
            <article>
              <h3><span class="status-dot working" aria-hidden="true"></span>Working today</h3>
              <ul>{WORKING.map((item) => <li>{item}</li>)}</ul>
            </article>
            <article>
              <h3><span class="status-dot pending" aria-hidden="true"></span>Not yet</h3>
              <ul>{NOT_YET.map((item) => <li>{item}</li>)}</ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section faq" aria-labelledby="faq-title">
        <div class="shell faq-grid">
          <div class="section-head">
            <p class="eyebrow">Plain answers</p>
            <h2 id="faq-title">Before you make the <em class="em">copy</em>.</h2>
          </div>
          <div class="questions">
            {
              FAQ.map(({ q, a }) => (
                <details>
                  <summary>
                    {q}<span aria-hidden="true">+</span>
                  </summary>
                  <p>{a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section class="close" aria-labelledby="close-title">
        <div class="shell close-grid">
          <div class="close-mark"><Mark size={82} /></div>
          <div>
            <p class="eyebrow">Free forever · GPL-3.0</p>
            <h2 id="close-title">Make the copy you can <em class="em">keep</em>.</h2>
            <p>
              No account, no subscription, no server of mine. Read the source before you trust it
              with anything — that is the point of building Hozz in the open.
            </p>
          </div>
          <div class="actions">
            <a class="button primary" href={GITHUB_URL}>Open the repository</a>
            <a class="button secondary" href={DONATE_URL}>Sponsor the work</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="shell footer-grid">
        <a class="brand" href="#top"><Mark size={24} /><span>Hozz</span></a>
        <p>Apple Health export for iPhone, with a companion Mac app. By Brandon Moore.</p>
        <div class="footer-links">
          <a href={LICENSE_URL}>GPL-3.0 + App Store exception</a>
          <a href={GITHUB_URL}>GitHub</a>
        </div>
      </div>
      <p class="shell privacy-line">
        No cookies, no analytics, no storage and no third-party requests on this page.
      </p>
    </footer>

    <style is:global>
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-400-italic.woff2') format('woff2');
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-600.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --paper: #f8fcff;
        --paper-blue: #f0f7fb;
        --mist: #edf6fc;
        --sky: #dcecf6;
        --sky-deep: #cae1f1;
        --water: #96bcd6;
        --water-deep: #5d8cb0;
        --ink: #132638;
        --ink-soft: #40566a;
        --ink-muted: #496176;
        --line: #cbdde8;
        --line-soft: #dfebf2;
        --white: #ffffff;
        --display: 'Sentient', Georgia, serif;
        --body: 'General Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;
        --shell: 1180px;
        --gutter: clamp(1.15rem, 4vw, 3.25rem);
        --section: clamp(4.5rem, 8vw, 8rem);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 5rem;
        background: var(--paper);
      }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--paper);
        font-family: var(--body);
        font-size: clamp(1rem, 0.97rem + 0.16vw, 1.08rem);
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
        overflow-x: clip;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      a {
        color: inherit;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.22em;
      }
      a:focus-visible,
      summary:focus-visible {
        outline: 3px solid var(--water-deep);
        outline-offset: 4px;
        border-radius: 4px;
      }
      ::selection {
        background: var(--sky-deep);
        color: var(--ink);
      }
      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }
      h1,
      h2,
      h3 {
        color: var(--ink);
        font-family: var(--display);
        font-weight: 500;
        text-wrap: balance;
      }
      h1 {
        margin-bottom: 1.45rem;
        font-size: clamp(3.25rem, 7.4vw, 6.8rem);
        line-height: 0.96;
        letter-spacing: -0.045em;
      }
      h2 {
        margin-bottom: 1.25rem;
        font-size: clamp(2.3rem, 4.7vw, 4.65rem);
        line-height: 1.02;
        letter-spacing: -0.035em;
      }
      h3 {
        font-size: 1.32rem;
        line-height: 1.2;
        letter-spacing: -0.014em;
      }
      code,
      .eyebrow,
      .float-label,
      .step-number,
      .big-number,
      .ripple-index {
        font-family: var(--mono);
      }
      code {
        overflow-wrap: anywhere;
      }
      .em {
        color: #315f83;
        font-style: italic;
        font-weight: 400;
      }
      .shell {
        width: min(100% - var(--gutter) * 2, var(--shell));
        margin-inline: auto;
      }
      .skip {
        position: fixed;
        z-index: 100;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 1rem;
        color: var(--white);
        background: var(--ink);
        translate: 0 -180%;
      }
      .skip:focus {
        translate: 0;
      }

      .mast {
        position: relative;
        z-index: 10;
        border-bottom: 1px solid color-mix(in srgb, var(--line) 72%, transparent);
        background: color-mix(in srgb, var(--paper) 88%, transparent);
        backdrop-filter: blur(14px);
      }
      .mast-in {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 1.5rem;
        align-items: center;
        min-height: 4.5rem;
      }
      .brand {
        display: inline-flex;
        gap: 0.65rem;
        align-items: center;
        width: fit-content;
        font-family: var(--display);
        font-size: 1.32rem;
        font-weight: 500;
        text-decoration: none;
      }
      .mast nav {
        display: flex;
        gap: clamp(1rem, 2.4vw, 2.25rem);
        color: var(--ink-soft);
        font-size: 0.86rem;
      }
      .mast nav a,
      .source {
        text-decoration: none;
      }
      .mast nav a:hover,
      .source:hover {
        text-decoration: underline;
      }
      .source {
        justify-self: end;
        font-family: var(--mono);
        font-size: 0.74rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .hero {
        position: relative;
        min-height: 62.5rem;
        overflow: hidden;
        background:
          radial-gradient(60% 55% at 50% 48%, rgba(202, 225, 241, 0.58), transparent 74%),
          radial-gradient(42% 50% at 93% 24%, rgba(237, 246, 252, 0.96), transparent 76%),
          linear-gradient(180deg, #fbfdff, var(--paper-blue));
      }
      .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(112deg, transparent 16%, rgba(255, 255, 255, 0.78) 36%, transparent 58%);
      }
      .hero-copy {
        position: relative;
        z-index: 3;
        padding-top: clamp(3rem, 5.5vw, 5.25rem);
        text-align: center;
      }
      .hero-copy h1 {
        max-width: 15ch;
        margin-inline: auto;
        font-size: clamp(3.25rem, 6.1vw, 5.8rem);
      }
      .hero-copy .lede {
        max-width: 44rem;
        margin: 0 auto 2rem;
      }
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 1rem;
        color: var(--ink-muted);
        font-size: 0.71rem;
        font-weight: 500;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }
      .eyebrow::before {
        content: '';
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--water-deep);
        box-shadow: 0 0 0 5px rgba(150, 188, 214, 0.22);
      }
      .lede {
        color: var(--ink-soft);
        font-size: clamp(1.08rem, 1rem + 0.42vw, 1.3rem);
        line-height: 1.55;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        justify-content: center;
      }
      .button {
        display: inline-flex;
        min-height: 3.15rem;
        padding: 0.78rem 1.35rem;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.64);
        font-size: 0.94rem;
        font-weight: 600;
        text-decoration: none;
      }
      .button.primary {
        border-color: var(--ink);
        color: var(--white);
        background: var(--ink);
      }
      .button:hover {
        border-color: var(--water-deep);
      }
      .button.primary:hover {
        background: #1d3a52;
      }
      .conditions {
        margin: 1.2rem 0 0;
        color: var(--ink-muted);
        font-family: var(--mono);
        font-size: 0.72rem;
      }

      .crossing {
        position: absolute;
        z-index: 2;
        inset: 34rem 0 auto;
        height: 27rem;
        margin: 0;
      }
      .route-lines {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      .route-lines path {
        fill: none;
        stroke: rgba(93, 140, 176, 0.44);
        stroke-width: 1.4;
        stroke-dasharray: 4 8;
        vector-effect: non-scaling-stroke;
      }
      .route-lines .echo {
        stroke: rgba(150, 188, 214, 0.24);
        stroke-dasharray: 1 10;
      }
      .float {
        border: 1px solid rgba(150, 188, 214, 0.52);
        background: rgba(255, 255, 255, 0.72);
        box-shadow:
          inset 0 1px rgba(255, 255, 255, 0.92),
          0 1rem 2rem -1.5rem rgba(0, 0, 0, 0.18);
        backdrop-filter: blur(14px);
      }
      .origin,
      .arrival {
        position: absolute;
        display: flex;
        gap: 0.8rem;
        align-items: center;
        width: 15.5rem;
        padding: 0.8rem 0.9rem;
        border-radius: 1rem;
      }
      .origin {
        left: 2.5%;
        top: 47%;
        rotate: -2deg;
      }
      .arrival {
        right: 2.5%;
        top: -20%;
        display: grid;
        gap: 0.12rem;
        rotate: 2deg;
      }
      .origin-mark {
        flex: none;
      }
      .origin strong,
      .arrival strong {
        display: block;
        font-family: var(--display);
        font-size: 1.04rem;
        line-height: 1.2;
      }
      .origin code,
      .arrival code {
        display: block;
        color: var(--ink-soft);
        font-size: 0.61rem;
        line-height: 1.5;
      }
      .float-label {
        display: block;
        color: #244967;
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .foothold {
        position: absolute;
        width: min(14rem, 17vw);
        min-width: 10.5rem;
        padding: 0.92rem 1rem 1rem;
        border-radius: 1.1rem;
      }
      .foothold::after {
        content: '';
        position: absolute;
        z-index: -1;
        inset: 54% 12% auto;
        height: 52%;
        border: 1px solid rgba(93, 140, 176, 0.2);
        border-radius: 50%;
        transform: scaleX(1.14);
      }
      .foothold-1 {
        left: 13%;
        top: 3%;
        rotate: -2.5deg;
      }
      .foothold-2 {
        left: 38%;
        top: 45%;
        rotate: 1.6deg;
      }
      .foothold-3 {
        left: 65%;
        top: 6%;
        rotate: -1deg;
      }
      .foothold-4 {
        left: 77%;
        top: 43%;
        rotate: 2deg;
      }
      .step-number {
        display: block;
        margin-bottom: 0.38rem;
        color: #426f92;
        font-size: 0.63rem;
        font-weight: 500;
        letter-spacing: 0.08em;
      }
      .foothold h2 {
        margin-bottom: 0.4rem;
        font-size: clamp(1.02rem, 1.3vw, 1.25rem);
        line-height: 1.12;
        letter-spacing: -0.016em;
      }
      .foothold code {
        display: inline-block;
        color: #244d6c;
        font-size: 0.62rem;
        font-weight: 500;
      }
      .foothold p {
        margin: 0.4rem 0 0;
        color: #294b66;
        font-size: 0.75rem;
        line-height: 1.45;
      }
      .crossing figcaption {
        position: absolute;
        right: var(--gutter);
        bottom: 0.5rem;
        color: var(--ink-muted);
        font-size: 0.72rem;
      }
      .crossing-portrait {
        display: none;
      }

      .thesis {
        color: var(--white);
        background: var(--ink);
        padding-block: clamp(3.5rem, 7vw, 6.5rem);
      }
      .thesis-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.55fr);
        gap: clamp(2rem, 8vw, 8rem);
        align-items: end;
      }
      .thesis p {
        margin: 0;
        color: #d5e2eb;
      }
      .thesis .thesis-big {
        color: var(--white);
        font-family: var(--display);
        font-size: clamp(2.25rem, 4.8vw, 4.6rem);
        line-height: 1.05;
        letter-spacing: -0.035em;
      }
      .thesis-big em {
        color: var(--sky-deep);
        font-weight: 400;
      }

      .section {
        padding-block: var(--section);
        border-bottom: 1px solid var(--line-soft);
      }
      .section-head {
        display: grid;
        gap: 0.1rem;
        max-width: 52rem;
        margin-bottom: clamp(2.75rem, 5vw, 4.5rem);
      }
      .section-head h2 {
        max-width: 15ch;
      }
      .section-head .lead {
        max-width: 52ch;
      }
      .split-head {
        grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.55fr);
        gap: clamp(2rem, 7vw, 7rem);
        align-items: end;
        max-width: none;
      }
      .split-head .lead {
        margin-bottom: 1.2rem;
      }
      .fine {
        max-width: 64ch;
        margin: 1.6rem 0 0;
        color: var(--ink-muted);
        font-size: 0.88rem;
        line-height: 1.6;
      }
      .fine code {
        font-size: 0.85em;
      }

      .how {
        background:
          radial-gradient(48% 65% at 90% 12%, rgba(220, 236, 246, 0.55), transparent 70%),
          var(--paper);
      }
      .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--ink);
        list-style: none;
      }
      .steps li {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.1rem;
        padding: 1.5rem clamp(1rem, 2vw, 1.6rem);
        border-right: 1px solid var(--line);
      }
      .steps li:last-child {
        border-right: 0;
      }
      .big-number {
        color: color-mix(in srgb, var(--category) 82%, var(--ink));
        font-size: 0.71rem;
        font-weight: 500;
      }
      .steps h3 {
        margin-bottom: 0.45rem;
      }
      .steps p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .destinations {
        background: var(--paper-blue);
      }
      .destination-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .destination-grid li {
        position: relative;
        display: flex;
        min-height: 18rem;
        padding: 1.4rem;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--line-soft);
        border-radius: 1.4rem;
        background: rgba(255, 255, 255, 0.72);
        box-shadow: 0 1.2rem 2.5rem -2.2rem rgba(0, 0, 0, 0.22);
      }
      .destination-grid li::after {
        content: '';
        position: absolute;
        right: -3rem;
        bottom: -4rem;
        width: 9rem;
        height: 9rem;
        border: 1px solid color-mix(in srgb, var(--category) 38%, transparent);
        border-radius: 50%;
        box-shadow:
          0 0 0 1.25rem color-mix(in srgb, var(--category) 8%, transparent),
          0 0 0 2.5rem color-mix(in srgb, var(--category) 5%, transparent);
      }
      .destination-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        margin-bottom: auto;
      }
      .destination-top svg {
        width: 1.7rem;
        color: color-mix(in srgb, var(--category) 88%, var(--ink));
        fill: none;
        stroke: currentColor;
        stroke-width: 1.4;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .destination-top span {
        color: var(--ink-muted);
        font-family: var(--mono);
        font-size: 0.64rem;
      }
      .destination-grid h3 {
        margin: 3rem 0 0.45rem;
        font-size: 1.55rem;
      }
      .destination-grid p {
        margin: 0 0 1rem;
        color: var(--ink-soft);
        font-size: 0.93rem;
      }
      .destination-grid code {
        position: relative;
        z-index: 1;
        display: block;
        padding-top: 0.8rem;
        border-top: 1px solid var(--line);
        color: #294d69;
        font-size: 0.68rem;
        line-height: 1.45;
      }

      .format-table {
        border: 1px solid var(--line);
        border-radius: 1.3rem;
        overflow: hidden;
        background: var(--white);
      }
      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }
      caption {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
      }
      th,
      td {
        padding: 1rem 1.15rem;
        border-bottom: 1px solid var(--line-soft);
        vertical-align: top;
      }
      thead th {
        color: var(--ink-soft);
        background: var(--mist);
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }
      tbody th {
        width: 15%;
        font-weight: 500;
      }
      tbody th code {
        color: var(--ink);
        font-size: 0.9rem;
      }
      tbody td {
        color: var(--ink-soft);
        font-size: 0.92rem;
      }
      tbody tr:last-child th,
      tbody tr:last-child td {
        border-bottom: 0;
      }
      .fidelity {
        display: inline-block;
        margin-right: 0.55rem;
        padding: 0.14rem 0.42rem;
        border-radius: 999px;
        font-family: var(--mono);
        font-size: 0.62rem;
        line-height: 1.4;
        text-transform: uppercase;
      }
      .is-lossless {
        color: #365d28;
        background: #e9f2e3;
      }
      .is-lossy {
        color: #813627;
        background: #f9e8e3;
      }

      .reliability {
        color: #e8f1f7;
        background:
          radial-gradient(52% 82% at 75% 35%, rgba(93, 140, 176, 0.2), transparent 72%),
          var(--ink);
      }
      .reliability h2,
      .reliability h3 {
        color: var(--white);
      }
      .reliability .em {
        color: var(--sky-deep);
      }
      .reliability .eyebrow,
      .reliability .lead {
        color: #c0d2df;
      }
      .reliability .eyebrow::before {
        background: var(--sky-deep);
      }
      .durability-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        margin: 0;
        padding: 1px;
        border-radius: 1.5rem;
        background: rgba(202, 225, 241, 0.2);
        list-style: none;
      }
      .durability-grid li {
        position: relative;
        min-height: 20rem;
        padding: 1.45rem;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.045);
      }
      .durability-grid li:first-child {
        border-radius: 1.4rem 0 0 1.4rem;
      }
      .durability-grid li:last-child {
        border-radius: 0 1.4rem 1.4rem 0;
      }
      .durability-grid li::after {
        content: '';
        position: absolute;
        right: -3rem;
        bottom: -4rem;
        width: 10rem;
        height: 10rem;
        border: 1px solid rgba(202, 225, 241, 0.16);
        border-radius: 50%;
        box-shadow: 0 0 0 1.8rem rgba(202, 225, 241, 0.04);
      }
      .ripple-index {
        display: block;
        margin-bottom: 4.5rem;
        color: #adc6d7;
        font-size: 0.68rem;
      }
      .durability-grid h3 {
        margin-bottom: 0.55rem;
      }
      .durability-grid p {
        margin-bottom: 1rem;
        color: #c9d7e1;
        font-size: 0.91rem;
      }
      .durability-grid code {
        color: var(--sky-deep);
        font-size: 0.68rem;
      }
      .test-note {
        display: grid;
        grid-template-columns: auto minmax(0, 34rem);
        gap: 1.5rem;
        align-items: end;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(202, 225, 241, 0.2);
      }
      .test-note strong {
        color: var(--white);
        font-family: var(--display);
        font-size: clamp(4.5rem, 9vw, 8rem);
        font-weight: 500;
        line-height: 0.75;
        letter-spacing: -0.06em;
      }
      .test-note h3 {
        margin-bottom: 0.3rem;
      }
      .test-note p {
        margin: 0;
        color: #c9d7e1;
      }

      .refusals {
        background: var(--paper-blue);
      }
      .refusal-layout {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.8fr);
        gap: clamp(3rem, 9vw, 9rem);
        align-items: start;
      }
      .refusal-layout .section-head {
        margin-bottom: 0;
      }
      .refusal-list {
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--line);
        list-style: none;
      }
      .refusal-list li {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        padding: 1.1rem 0;
        border-bottom: 1px solid var(--line);
      }
      .refusal-list > li > span {
        color: color-mix(in srgb, var(--category) 78%, var(--ink));
        font-weight: 600;
      }
      .refusal-list h3 {
        margin-bottom: 0.2rem;
        font-size: 1.16rem;
      }
      .refusal-list p {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.92rem;
      }
      .permanent {
        display: grid;
        grid-template-columns: minmax(10rem, 0.3fr) 1fr;
        gap: 2rem;
        margin-top: clamp(3rem, 6vw, 5rem);
        padding-top: 1.6rem;
        border-top: 1px solid var(--ink);
      }
      .permanent p {
        margin: 0;
      }
      .permanent-label {
        color: var(--ink-muted);
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .assistant-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 0.72fr);
        gap: clamp(3rem, 9vw, 9rem);
        align-items: center;
      }
      .assistant-grid .section-head {
        margin-bottom: 0;
      }
      .caveat {
        padding-left: 1rem;
        border-left: 2px solid var(--water-deep);
      }
      .tool-panel {
        border: 1px solid var(--ink);
        border-radius: 1.4rem;
        overflow: hidden;
        background: var(--ink);
        color: #e8f1f7;
        box-shadow: 0.9rem 0.9rem 0 var(--sky);
      }
      .panel-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        color: #c6d6e1;
        font-family: var(--mono);
        font-size: 0.63rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
      .panel-head code {
        color: var(--sky-deep);
      }
      .tool-panel ul {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        margin: 0;
        padding: 1rem;
        list-style: none;
      }
      .tool-panel li {
        padding: 0.55rem 0.65rem;
        color: #e2ebf2;
        font-family: var(--mono);
        font-size: 0.7rem;
      }
      .tool-panel li::before {
        content: '→';
        margin-right: 0.55rem;
        color: var(--water);
      }

      .status {
        background: var(--paper-blue);
      }
      .status-columns {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        border: 1px solid var(--line);
        border-radius: 1.4rem;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.74);
      }
      .status-columns article {
        padding: clamp(1.4rem, 3vw, 2.5rem);
      }
      .status-columns article + article {
        border-left: 1px solid var(--line);
      }
      .status-columns h3 {
        display: flex;
        gap: 0.65rem;
        align-items: center;
        margin-bottom: 1.2rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid var(--line);
      }
      .status-dot {
        width: 0.65rem;
        height: 0.65rem;
        flex: none;
        border-radius: 50%;
      }
      .status-dot.working {
        background: #5e9140;
      }
      .status-dot.pending {
        background: #c16d4b;
      }
      .status-columns ul {
        display: grid;
        gap: 0.58rem;
        margin: 0;
        padding: 0;
        color: var(--ink-soft);
        font-size: 0.92rem;
        list-style: none;
      }
      .status-columns li {
        position: relative;
        padding-left: 1.4rem;
      }
      .status-columns li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #4e7d35;
        font-weight: 600;
      }
      .status-columns article + article li::before {
        content: '—';
        color: #a24d34;
      }

      .faq-grid {
        display: grid;
        grid-template-columns: minmax(15rem, 0.55fr) minmax(0, 1fr);
        gap: clamp(3rem, 9vw, 8rem);
        align-items: start;
      }
      .faq-grid .section-head {
        position: sticky;
        top: 2rem;
        margin-bottom: 0;
      }
      .questions {
        border-top: 1px solid var(--ink);
      }
      .questions details {
        border-bottom: 1px solid var(--line);
      }
      .questions summary {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
        padding: 1.3rem 0;
        cursor: pointer;
        font-family: var(--display);
        font-size: 1.28rem;
        font-weight: 500;
        line-height: 1.25;
        list-style: none;
      }
      .questions summary::-webkit-details-marker {
        display: none;
      }
      .questions summary span {
        color: #315f83;
        font-family: var(--mono);
        font-size: 1.1rem;
      }
      .questions details[open] summary span {
        rotate: 45deg;
      }
      .questions p {
        max-width: 60ch;
        margin-bottom: 1.5rem;
        color: var(--ink-soft);
      }

      .close {
        position: relative;
        padding-block: clamp(4.5rem, 9vw, 8rem);
        overflow: hidden;
        background: var(--mist);
      }
      .close-grid {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: clamp(1.5rem, 4vw, 3.5rem);
        align-items: center;
      }
      .close h2 {
        margin-bottom: 0.8rem;
      }
