---
import Mark from '../../components/mark/logos/c11.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  DESTINATIONS,
  FORMATS,
  STEPS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
  STREAM_LANES,
} from '../../data/site';

const heroDatum = STREAM_LANES[0][0];
const ndjsonExample = JSON.stringify({
  type: heroDatum.id,
  value: 48,
  unit: 'ms',
  startDate: '2026-08-23T07:12:19Z',
});

const sqliteTables = [
  'sample',
  'workout_detail',
  'electrocardiogram',
  'audiogram',
  'state_of_mind',
  'medication_dose',
  'unhandled_record',
];

const howToAnswer =
  'Install Hozz on your iPhone, grant read access to the Apple Health types you want, and add a destination you control. Test that destination, choose which types it receives and a schedule, then confirm. Hozz continues exporting new records from its last durable checkpoint. Nothing leaves your phone before you add and confirm a destination.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      description:
        'Open-source software that exports Apple Health data from an iPhone to destinations the user controls.',
      url: SITE,
      codeRepository: GITHUB_URL,
      license: LICENSE_URL,
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I export my Apple Health data?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: howToAnswer,
          },
        },
        ...FAQ.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.a,
          },
        })),
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Hozz exports Apple Health data from your iPhone to systems you own."
    />
    <meta name="theme-color" content="#f0d9a2" />
    <title>Hozz — Your health history, in systems you own</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Hozz home">
        <Mark size={28} />
        <span>Hozz</span>
      </a>
      <nav aria-label="Page">
        <a href="#export">Export</a>
        <a href="#destinations">Routes</a>
        <a href="#reliability">Reliability</a>
        <a href="#status">Status</a>
      </nav>
      <a class="source-link" href={GITHUB_URL}>Source ↗</a>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Apple Health export · early alpha</p>
          <h1 id="hero-title">Your history,<br />copied <em>without leaving you.</em></h1>
          <p class="lede">
            Hozz sends Apple Health data from your iPhone to the Mac, broker,
            database, folder or endpoint you already run. Your original stays in
            Health. Your copy stays yours.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#export">Read the field guide</a>
            <a class="button secondary" href={GITHUB_URL}>Inspect the source</a>
          </div>
          <ul class="hero-conditions" aria-label="Privacy conditions">
            <li>No account</li>
            <li>No hosted relay</li>
            <li>No default destination</li>
          </ul>
        </div>

        <figure class="aftercopy" aria-labelledby="aftercopy-caption">
          <div class="sheet sheet-back" aria-hidden="true"></div>
          <div class="sheet sheet-mid" aria-hidden="true"></div>
          <div class="sheet sheet-front">
            <div class="sheet-head">
              <span>sample.ndjson</span>
              <span>example</span>
            </div>
            <code>{ndjsonExample}</code>
            <dl>
              <div><dt>source</dt><dd>Apple Health</dd></div>
              <div><dt>original</dt><dd>stays put</dd></div>
              <div><dt>copy</dt><dd>plain data</dd></div>
            </dl>
          </div>
          <figcaption id="aftercopy-caption">
            One record per line. Stream it, diff it, keep it.
          </figcaption>
        </figure>
      </section>

      <section class="manifesto" aria-label="Hozz's privacy contract">
        <p>Nothing leaves your phone until you add a destination and confirm it.</p>
        <div class="promise-strip">
          {PROMISES.map((promise) => (
            <span>{promise.title}</span>
          ))}
        </div>
      </section>

      <section class="section how" id="export" aria-labelledby="export-title">
        <div class="section-intro">
          <p class="label">How to export Apple Health data</p>
          <h2 id="export-title">Set the route once.<br /><em>Keep the copy forever.</em></h2>
          <p>{howToAnswer}</p>
        </div>
        <ol class="steps">
          {STEPS.map((step, index) => (
            <li>
              <span class="step-index">0{index + 1}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="section routes" id="destinations" aria-labelledby="routes-title">
        <div class="section-intro split-intro">
          <div>
            <p class="label">Six direct routes</p>
            <h2 id="routes-title">Point it at<br /><em>what you run.</em></h2>
          </div>
          <p>
            Hozz does not add a cloud between your phone and your destination.
            Each destination gets its own types, schedule and queue.
          </p>
        </div>

        <ul class="destination-grid">
          {DESTINATIONS.map((destination, index) => (
            <li class={index === 0 ? 'featured' : ''}>
              <div class="destination-top">
                <span class="route-number">route/{String(index + 1).padStart(2, '0')}</span>
                <span class="route-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>{destination.title}</h3>
              <p>{destination.body}</p>
              <code>{destination.fact}</code>
            </li>
          ))}
        </ul>

        <div class="protocol-rail" aria-label="Concrete delivery examples">
          <article>
            <span>LAN discovery</span>
            <strong>_hozz._tcp</strong>
            <code>port 54330</code>
          </article>
          <article>
            <span>InfluxDB line protocol · example</span>
            <strong class="breakable">health,type=heart_rate,source=Apple\ Watch,unit=count/min value=58 1787469139000000000</strong>
            <code>/api/v2/write</code>
          </article>
          <article>
            <span>HTTP replay protection</span>
            <strong>POST /health/import</strong>
            <code>Idempotency-Key: content-derived-id</code>
          </article>
        </div>
      </section>

      <section class="section formats" aria-labelledby="formats-title">
        <div class="section-intro split-intro">
          <div>
            <p class="label">Seven useful shapes</p>
            <h2 id="formats-title">Choose a format<br /><em>every tool can read.</em></h2>
          </div>
          <p>
            Choose for the next tool, not for Hozz. SQLite keeps every original
            record in <code>raw</code>. NDJSON is the streaming default.
          </p>
        </div>

        <div class="table-wrap" tabindex="0" role="region" aria-label="Export formats table">
          <table>
            <thead>
              <tr>
                <th scope="col">Format</th>
                <th scope="col">Use it for</th>
                <th scope="col">What it keeps</th>
              </tr>
            </thead>
            <tbody>
              {FORMATS.map((format) => (
                <tr>
                  <th scope="row">{format.name}</th>
                  <td>{format.use}</td>
                  <td>{format.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <figure class="schema-card" aria-labelledby="schema-caption">
          <figcaption id="schema-caption">
            <span>hozz-received.sqlite</span>
            <span>real table names</span>
          </figcaption>
          <div class="schema-body">
            <div class="schema-table-list">
              {sqliteTables.map((table) => <code>{table}</code>)}
            </div>
            <pre><code><span>SELECT</span> type, value, unit, start_date
<span>FROM</span> sample
<span>WHERE</span> type = 'heartRate'
<span>ORDER BY</span> start_date DESC;</code></pre>
          </div>
        </figure>
      </section>

      <section class="section reliability" id="reliability" aria-labelledby="reliability-title">
        <div class="section-intro">
          <p class="label">Durability, not optimism</p>
          <h2 id="reliability-title">An interruption may repeat work.<br /><em>It cannot skip records.</em></h2>
        </div>
        <div class="reliability-grid">
          <ol class="durability-list">
            {DURABILITY.map((item, index) => (
              <li>
                <span class="durability-index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                  <code>{item.fact}</code>
                </div>
              </li>
            ))}
          </ol>
          <aside class="test-card">
            <span class="test-kicker">Current test suite</span>
            <strong>475</strong>
            <span>XCTest tests</span>
            <p>
              Delivery, checkpoints, retries and edge cases are exercised before
              a record reaches your destination.
            </p>
          </aside>
        </div>
      </section>

      <section class="section honest" id="honest" aria-labelledby="honest-title">
        <div class="section-intro split-intro">
          <div>
            <p class="label">The honest state machine</p>
            <h2 id="honest-title">Hozz reports<br /><em>what Apple allows.</em></h2>
          </div>
          <p>
            Apple does not reveal whether a type was denied or simply has no
            data. Hozz says “denied or empty” instead of inventing certainty.
          </p>
        </div>
        <ul class="state-list">
          {COVERAGE_STATES.map((item) => (
            <li class={`state-${item.tone}`}>
              <span class="state-light" aria-hidden="true"></span>
              <code>{item.state}</code>
              <p>{item.body}</p>
            </li>
          ))}
        </ul>
        <div class="honesty-notes">
          <p>
            <strong>Progress without fiction.</strong> Health will not reveal a total
            without reading every record first, so Hozz reports completed types and
            dates instead of a percentage.
          </p>
          <p>
            <strong>Archive, never re-import.</strong> Writing records back would erase
            provenance and can silently create duplicates, so Hozz will never do it.
          </p>
        </div>
      </section>

      <section class="section assistant" aria-labelledby="assistant-title">
        <div class="assistant-copy">
          <p class="label">On your Mac · read only</p>
          <h2 id="assistant-title">Query the archive<br /><em>with read-only tools.</em></h2>
          <p>
            The companion Mac app includes an MCP server for the local database.
            Your assistant can inspect data, but the server cannot change or delete it.
          </p>
          <div class="caveat">
            <strong>The important caveat</strong>
            <p>
              A cloud assistant may upload whatever it reads. That is the
              assistant’s behaviour, not Hozz’s. Choose the assistant accordingly.
            </p>
          </div>
        </div>
        <div class="tool-list" aria-label="Data available to the MCP server">
          <div class="tool-head">
            <span>hoz z.mcp / query surface</span>
            <span>READ_ONLY</span>
          </div>
          <ul>
            {MCP_TOOLS.map((tool) => (
              <li><span aria-hidden="true">→</span>{tool}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section status" id="status" aria-labelledby="status-title">
        <div class="status-head">
          <div>
            <p class="label">Project state · early alpha</p>
            <h2 id="status-title">Working today.<br /><em>Coverage remains partial.</em></h2>
          </div>
          <p>
            Hozz works, and coverage is partial. The repository is the record:
            inspect the code, follow the tests, or help make the next piece real.
          </p>
        </div>
        <div class="status-columns">
          <article>
            <h3><span class="state-light good"></span>Working</h3>
            <ul>
              {WORKING.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article>
            <h3><span class="state-light pending"></span>Not yet</h3>
            <ul>
              {NOT_YET.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </section>

      <section class="section faq" aria-labelledby="faq-title">
        <div class="section-intro">
          <p class="label">Plain answers</p>
          <h2 id="faq-title">Before you<br /><em>point a route.</em></h2>
        </div>
        <div class="faq-list">
          {FAQ.map((item) => (
            <details>
              <summary>{item.q}<span aria-hidden="true">+</span></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="close" aria-labelledby="close-title">
        <div class="close-copy">
          <p class="label">Open source</p>
          <h2 id="close-title">Your health history<br />should outlive <em>every app.</em></h2>
          <p>
            Hozz is built by Brandon Moore and licensed under GPL-3.0 with an
            App Store exception. No account. No hosted relay.
          </p>
        </div>
        <div class="close-actions">
          <a class="button primary" href={GITHUB_URL}>Open the repository ↗</a>
          <a class="button secondary" href={DONATE_URL}>Support the work</a>
        </div>
        <div class="close-mark" aria-hidden="true"><Mark size={88} /></div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand" href="#top"><Mark size={24} /><span>Hozz</span></a>
      <p>Original in Health. Aftercopy where you choose.</p>
      <div>
        <a href={LICENSE_URL}>GPL-3.0 + App Store exception</a>
        <a href={GITHUB_URL}>GitHub</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Cabinet Grotesk';
    src: url('/fonts/CabinetGrotesk-Variable.woff2') format('woff2');
    font-weight: 100 900;
    font-display: swap;
  }

  @font-face {
    font-family: 'General Sans';
    src: url('/fonts/general-sans-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'General Sans';
    src: url('/fonts/general-sans-600.woff2') format('woff2');
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'IBM Plex Mono';
    src: url('/fonts/ibm-plex-mono-500.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
  }

  :root {
    --graphite: #30383b;
    --slate: #394651;
    --sage: #88a792;
    --coral: #d58d70;
    --coral-readable: #d99073;
    --straw: #f0d9a2;
    --paper: #f8f6ed;
    --paper-deep: #eee9da;
    --ink-muted: #596267;
    --line: rgba(48, 56, 59, 0.22);
    --measure: 78rem;
    --pad: clamp(1.25rem, 4vw, 4.5rem);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    background: var(--paper);
  }

  body {
    margin: 0;
    background:
      linear-gradient(rgba(48, 56, 59, 0.026) 1px, transparent 1px),
      var(--paper);
    background-size: 100% 4rem;
    color: var(--graphite);
    font-family: 'General Sans', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    overflow-x: clip;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:focus-visible,
  summary:focus-visible,
  [tabindex]:focus-visible {
    outline: 3px solid var(--coral);
    outline-offset: 4px;
  }

  code,
  pre,
  .label,
  .eyebrow,
  .route-number,
  .step-index,
  .test-kicker {
    font-family: 'IBM Plex Mono', monospace;
  }

  code,
  pre {
    overflow-wrap: anywhere;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    font-family: 'Cabinet Grotesk', sans-serif;
    line-height: 0.95;
  }

  h1 {
    margin-bottom: 1.6rem;
    font-size: clamp(3.65rem, 7vw, 7.35rem);
    font-weight: 650;
    letter-spacing: -0.065em;
  }

  h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.8rem, 5.4vw, 5.8rem);
    font-weight: 620;
    letter-spacing: -0.055em;
  }

  h3 {
    font-size: 1.45rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  h1 em,
  h2 em {
    color: #8c4b35;
    font-style: normal;
    font-weight: 430;
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.75rem 1rem;
    transform: translateY(-150%);
    background: var(--graphite);
    color: white;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    position: relative;
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(100%, calc(var(--measure) + 2 * var(--pad)));
    margin: auto;
    padding: 1.25rem var(--pad);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    width: fit-content;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    font-size: 0.82rem;
  }

  .site-header nav a,
  .source-link {
    text-decoration: none;
  }

  .site-header nav a:hover,
  .source-link:hover {
    text-decoration: underline;
  }

  .source-link {
    justify-self: end;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .hero,
  .section,
  .close {
    width: min(100%, calc(var(--measure) + 2 * var(--pad)));
    margin: 0 auto;
    padding-inline: var(--pad);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(21rem, 0.92fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
    min-height: min(53rem, calc(100svh - 4.5rem));
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .eyebrow,
  .label {
    color: var(--slate);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.095em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 1.35rem;
  }

  .eyebrow span {
    width: 0.65rem;
    height: 0.65rem;
    background: var(--sage);
    border: 2px solid var(--graphite);
    border-radius: 50%;
  }

  .lede {
    max-width: 39rem;
    margin-bottom: 2rem;
    color: #4d5559;
    font-size: clamp(1.12rem, 1.6vw, 1.35rem);
    line-height: 1.55;
  }

  .hero-actions,
  .close-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    padding: 0.75rem 1.15rem;
    border: 1px solid var(--graphite);
    font-weight: 600;
    text-decoration: none;
  }

  .button.primary {
    background: var(--graphite);
    color: #fff;
  }

  .button.primary:hover {
    background: var(--slate);
  }

  .button.secondary:hover {
    background: var(--straw);
  }

  .hero-conditions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
    margin: 2rem 0 0;
    padding: 0;
    color: var(--ink-muted);
    font-size: 0.82rem;
    list-style: none;
  }

  .hero-conditions li::before {
    content: '— ';
    color: var(--coral);
    font-weight: 700;
  }

  .aftercopy {
    position: relative;
    min-width: 0;
    margin: 0;
    padding: 3rem 1.25rem 2rem 0;
  }

  .sheet {
    border: 1px solid var(--graphite);
    box-shadow: 0.7rem 0.7rem 0 rgba(48, 56, 59, 0.08);
  }

  .sheet-back,
  .sheet-mid {
    position: absolute;
    width: calc(100% - 3.5rem);
    height: calc(100% - 5rem);
  }

  .sheet-back {
    top: 0;
    right: 0;
    background: var(--slate);
  }

  .sheet-mid {
    top: 1.5rem;
    right: 1.75rem;
    background: var(--sage);
  }

  .sheet-front {
    position: relative;
    z-index: 1;
    min-height: 23rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--straw);
  }

  .sheet-head {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4.5rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgba(48, 56, 59, 0.35);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
  }

  .sheet-front > code {
    display: block;
    min-width: 0;
    margin-bottom: 3.5rem;
    font-size: clamp(0.72rem, 1vw, 0.88rem);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .sheet-front dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid rgba(48, 56, 59, 0.35);
  }

  .sheet-front dl div {
    padding: 0.8rem 0.5rem 0 0;
  }

  .sheet-front dt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  .sheet-front dd {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .aftercopy figcaption {
    margin: 1rem 0 0 1rem;
