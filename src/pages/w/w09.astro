---
/**
 * w09 · Against Forgetting — built on c19 "Half Remembered".
 *
 * The mark keeps its face while its lower edges step away into banks of mist.
 * The page makes the argument that follows from it: a phone is not an archive,
 * and data you hold no copy of is data you are slowly losing. Nearly
 * monochrome — slate, mist and paper, with one warm hue used twice.
 */
import Mark from '../../components/mark/logos/c19.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  NAV_LINKS,
  STREAM_LANES,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
} from '../../data/site';

const ledger = STREAM_LANES[0].slice(0, 6);

const losses = [
  { when: 'A phone breaks', then: 'and the only copy went with it.' },
  { when: 'A company is bought', then: 'and the export button quietly leaves.' },
  { when: 'A policy changes', then: 'and last year is suddenly out of reach.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      url: SITE,
      downloadUrl: GITHUB_URL,
      isAccessibleForFree: true,
      license: LICENSE_URL,
      softwareVersion: 'Early alpha',
      author: { '@type': 'Person', name: 'Brandon Moore' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'A free, open-source iPhone app with a companion Mac app that exports Apple Health data to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, any web endpoint or MQTT. No account, no analytics, no hosted relay and no default destination.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Hozz exports your Apple Health history to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, a URL or MQTT. Free, open source, no account, no analytics, no server in the middle."
    />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#eef0e8" />
    <link rel="canonical" href={`${SITE}/w/w09/`} />
    <title>Hozz — a phone is not an archive</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="#top">
          <Mark size={32} />
          <span>Hozz</span>
        </a>
        <nav class="topnav" aria-label="Sections">
          {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
          <a class="topnav-source" href={GITHUB_URL}>Source <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Apple Health export · early alpha</p>
            <h1>A phone is not an <em class="em">archive.</em></h1>
            <p class="lede">
              Hozz copies your Apple Health history off your iPhone and into places you already
              own. Free, open source, one developer. No account, no analytics, no server of mine.
            </p>
            <p class="claim">
              Data you hold no copy of is data you are slowly losing.
            </p>
            <div class="actions">
              <a class="btn" href="#export">How to export your data</a>
              <a class="btn-quiet" href={GITHUB_URL}>Read the source <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <figure class="ledger">
            <div class="ledger-head">
              <span class="mono">HKAnchoredObjectQuery</span>
              <span class="mono">read → staged</span>
            </div>
            <ol class="ledger-rows">
              {ledger.map((row, i) => (
                <li class={`band band-${i}`}>
                  <span class="mono id">{row.id}</span>
                  <span class="mono val">{row.sample}</span>
                </li>
              ))}
            </ol>
            <div class="ledger-mist" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span><span></span>
            </div>
            <figcaption>
              Real HealthKit identifiers. The readings beside them are examples, not your data —
              nothing on this page ever touches Health.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="section why" aria-labelledby="why-h">
        <div class="shell">
          <h2 id="why-h">Everything keeps a copy except <em class="em">you.</em></h2>
          <ul class="losses">
            {losses.map((item) => (
              <li>
                <strong>{item.when}</strong>
                <span>{item.then}</span>
              </li>
            ))}
          </ul>
          <p class="why-note">
            Apple Health is a good place to keep data and a poor place to keep it forever. Hozz does
            not replace it. It writes a second copy, in a file format you can open in ten years,
            somewhere you control.
          </p>
        </div>
      </section>

      <section class="section" id="export" aria-labelledby="export-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>The question people actually ask</p>
            <h2 id="export-h">How do I export my <em class="em">Apple Health</em> data?</h2>
            <p class="section-lede">
              Install Hozz on your iPhone — and the companion app on your Mac, if that is where you
              want the data. Then three steps, once. After that new records leave on their own, on
              the schedule you set, to the destination you named.
            </p>
          </div>
          <ol class="steps">
            {STEPS.map((step, i) => (
              <li>
                <span class="mono step-n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            ))}
          </ol>
          <p class="aside">
            No default destination exists. Until you add one and confirm it, Hozz reads nothing and
            sends nothing.
          </p>
        </div>
      </section>

      <section class="section" id="destinations" aria-labelledby="dest-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Six destinations</p>
            <h2 id="dest-h">Somewhere you <em class="em">own.</em></h2>
            <p class="section-lede">
              Each one is a place you already run. There is no relay in the middle, so there is no
              account of mine holding your history hostage.
            </p>
          </div>
          <ul class="dests">
            {DESTINATIONS.map((d) => (
              <li>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
                <p class="mono fact">{d.fact}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="formats" aria-labelledby="fmt-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Seven formats</p>
            <h2 id="fmt-h">Files, not a <em class="em">database you rent.</em></h2>
            <p class="section-lede">
              Two of them throw information away. Both say so here, and both say so in the app —
              a lossy export is a fine thing to want, and a bad thing to find out later.
            </p>
          </div>
          <div class="table-wrap">
            <table class="formats">
              <caption class="sr-only">Export formats, what each is for, and what each keeps</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">What it is for</th>
                  <th scope="col">What it keeps</th>
                </tr>
              </thead>
              <tbody>
                {FORMATS.map((f) => {
                  const lossy = f.note.startsWith('Lossy');
                  return (
                    <tr class={lossy ? 'lossy' : undefined}>
                      <th scope="row"><span class="mono">{f.name}</span></th>
                      <td>{f.use}</td>
                      <td>
                        {lossy && <span class="tag mono">lossy</span>}
                        <span class="note">{f.note.replace(/^Lossy — /, '')}</span>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section slab" id="trust" aria-labelledby="trust-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Durability</p>
            <h2 id="trust-h">An interruption can repeat work. It cannot <em class="em">skip a record.</em></h2>
            <p class="section-lede">
              That sentence is the whole design. Every mechanism below exists to make it true, and
              475 XCTest tests exist to keep it true.
            </p>
          </div>
          <ul class="durability">
            {DURABILITY.map((d) => (
              <li>
                <h3>{d.title}</h3>
                <p>{d.body}</p>
                <p class="mono fact">{d.fact}</p>
              </li>
            ))}
          </ul>
          <p class="tests"><span class="mono big">475</span> XCTest tests in the repository, and you can run them yourself.</p>
        </div>
      </section>

      <section class="section" id="honest" aria-labelledby="honest-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Honesty</p>
            <h2 id="honest-h">Where it cannot know, it <em class="em">says so.</em></h2>
            <p class="section-lede">
              Apple will not let an app tell “you denied this type” from “you have no data”. So Hozz
              does not print a green tick it has not earned. These are the five states it reports.
            </p>
          </div>
          <div class="table-wrap">
            <table class="states">
              <caption class="sr-only">Coverage states Hozz reports for each Health type</caption>
              <thead>
                <tr><th scope="col">State</th><th scope="col">What it means</th></tr>
              </thead>
              <tbody>
                {COVERAGE_STATES.map((s) => (
                  <tr>
                    <th scope="row"><span class={`mono state tone-${s.tone}`}>{s.state}</span></th>
                    <td>{s.body}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <ul class="honest-notes">
            <li>
              <h3>No progress percentage</h3>
              <p>
                Health will not say how many records a type holds without reading all of them. Any
                fraction would be invented, so Hozz reports how many types are complete and how far
                back they reach instead.
              </p>
            </li>
            <li>
              <h3>iOS decides when it runs</h3>
              <p>
                Background work happens when the system allows it, so most types land near hourly.
                Health cannot be read at all while the phone is locked.
              </p>
            </li>
            <li>
              <h3>It will never write back into Health</h3>
              <p>
                Health stamps provenance permanently and HealthKit has no upsert, so a re-import
                would both launder the origin of every reading and silently double your records.
              </p>
            </li>
          </ul>
        </div>
      </section>

      <section class="section" id="assistant" aria-labelledby="mcp-h">
        <div class="shell mcp-grid">
          <div>
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>The assistant</p>
            <h2 id="mcp-h">Ask your own <em class="em">questions.</em></h2>
            <p class="section-lede">
              The Mac app ships a read-only MCP server over the database your phone keeps current.
              A question costs a lookup, not a re-parse of a stale XML export. It cannot change or
              delete anything.
            </p>
            <p class="caveat">
              <strong>The honest caveat:</strong> a cloud assistant may upload whatever it reads.
              That is the assistant’s behaviour, not Hozz’s — which is a good reason to point a
              local one at it.
            </p>
          </div>
          <div>
            <h3 class="h-tiny">What it can read</h3>
            <ul class="mcp-list">
              {MCP_TOOLS.map((t) => <li class="mono">{t}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="section promises" aria-labelledby="prom-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Refusals</p>
            <h2 id="prom-h">The list of things it <em class="em">will not do.</em></h2>
          </div>
          <ul class="prom-list">
            {PROMISES.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section" id="status" aria-labelledby="status-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Early alpha</p>
            <h2 id="status-h">It works. Coverage is <em class="em">partial.</em></h2>
            <p class="section-lede">Both halves of that are true, so both are printed.</p>
          </div>
          <div class="status-grid">
            <div class="status-col">
              <h3 class="h-tiny">Working today</h3>
              <ul class="tick">{WORKING.map((w) => <li>{w}</li>)}</ul>
            </div>
            <div class="status-col">
              <h3 class="h-tiny">Not yet</h3>
              <ul class="cross">{NOT_YET.map((n) => <li>{n}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section faq" id="faq" aria-labelledby="faq-h">
        <div class="shell">
          <div class="section-head">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Questions</p>
            <h2 id="faq-h">Straight <em class="em">answers.</em></h2>
          </div>
          <dl class="faq-list">
            {FAQ.map((item) => (
              <div class="faq-item">
                <dt>{item.q}</dt>
                <dd>{item.a}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="section close" aria-labelledby="close-h">
        <div class="shell close-inner">
          <Mark size={64} />
          <h2 id="close-h">Keep a copy while you still <em class="em">can.</em></h2>
          <p>
            Free forever, GPL-3.0 with an App Store exception, written by one person. Read every
            line before you trust it with anything.
          </p>
          <div class="actions">
            <a class="btn" href={GITHUB_URL}>Get it on GitHub <span aria-hidden="true">↗</span></a>
            <a class="btn-quiet" href={DONATE_URL}>Sponsor the work <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell footer-inner">
        <p>Hozz — Apple Health export for iPhone, with a companion Mac app. By Brandon Moore.</p>
        <p class="footer-links">
          <a href={GITHUB_URL}>Source</a>
          <a href={LICENSE_URL}>GPL-3.0</a>
          <a href={DONATE_URL}>Sponsor</a>
        </p>
      </div>
    </footer>

    <style>
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-400-italic.woff2') format('woff2');
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500-italic.woff2') format('woff2');
        font-weight: 500;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-400.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-500.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-600.woff2') format('woff2');
        font-weight: 600;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
        font-weight: 400;
        font-display: swap;
      }
      @font-face {
        font-family: 'IBM Plex Mono';
        src: url('/fonts/ibm-plex-mono-500.woff2') format('woff2');
        font-weight: 500;
        font-display: swap;
      }

      :root {
        /* c19 — Half Remembered. Slate holds, mist steps away. */
        --ink: #29343a;
        --slate: #4c585f;
        --mid: #71808a;
        --pale: #aeb8b8;
        --mist: #d9d8d0;
        --paper: #eef0e8;
        --band-1: #e8e9e1;
        --band-2: #e1e2da;
        --band-3: #dadbd3;
        --band-4: #d3d5cd;
        --band-5: #cccfc7;
        /* Used exactly twice on the page: the lossy marks, and one hairline. */
        --warn: #dd6558;

        --rule: #b9c1bf;
        --shell: 1240px;

        --display: 'Sentient', Georgia, serif;
        --body: 'General Sans', system-ui, sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, monospace;

        --step-0: clamp(0.98rem, 0.94rem + 0.2vw, 1.08rem);
        --step-1: clamp(1.1rem, 1.02rem + 0.36vw, 1.32rem);
        --step-2: clamp(1.45rem, 1.3rem + 0.7vw, 1.9rem);
        --step-3: clamp(1.95rem, 1.6rem + 1.6vw, 3.1rem);
        --step-4: clamp(2.6rem, 1.9rem + 3.4vw, 5.6rem);
        --gap: clamp(1.4rem, 1rem + 1.4vw, 2.4rem);
        --pad-y: clamp(3.6rem, 2.4rem + 4.4vw, 7.5rem);
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--body);
        font-size: var(--step-0);
        line-height: 1.62;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      h1,
      h2,
      h3 {
        font-family: var(--display);
        font-weight: 500;
        letter-spacing: -0.015em;
        margin: 0;
        text-wrap: balance;
      }

      p {
        margin: 0;
      }

      a {
        color: inherit;
      }

      :focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .shell {
        width: 100%;
        max-width: var(--shell);
        margin-inline: auto;
        padding-inline: clamp(1.15rem, 0.6rem + 2.4vw, 3rem);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--paper);
        padding: 0.7rem 1rem;
        z-index: 20;
        text-decoration: none;
      }
      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      .mono {
        font-family: var(--mono);
        font-size: 0.82em;
        letter-spacing: -0.01em;
      }

      /* ---------- header ---------- */

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgb(238 240 232 / 0.97);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--rule);
      }

      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 62px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        font-family: var(--display);
        font-weight: 500;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
      }

      .topnav {
        display: flex;
        align-items: center;
        gap: clamp(0.9rem, 0.4rem + 1.2vw, 1.9rem);
        font-size: 0.92rem;
      }

      .topnav a {
        text-decoration: none;
        color: var(--slate);
        padding-block: 0.3rem;
        border-bottom: 1px solid transparent;
      }

      .topnav a:hover {
        color: var(--ink);
        border-bottom-color: var(--ink);
      }

      .topnav-source {
        font-weight: 500;
        color: var(--ink) !important;
      }

      @media (max-width: 720px) {
        .topnav a:not(.topnav-source) {
          display: none;
        }
      }

      /* ---------- hero ---------- */

      .hero {
        padding-block: clamp(3.2rem, 2rem + 4.5vw, 6.5rem) var(--pad-y);
      }

      .hero-grid {
        display: grid;
        gap: clamp(2.4rem, 1.4rem + 3.5vw, 4.5rem);
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
        align-items: start;
      }

      @media (max-width: 900px) {
        .hero-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--slate);
        margin-bottom: 1.4rem;
      }

      .dot {
        width: 7px;
        height: 7px;
        background: var(--mid);
        flex: none;
      }

      h1 {
        font-size: var(--step-4);
        line-height: 0.98;
        letter-spacing: -0.035em;
      }

      .em {
        font-style: italic;
        font-weight: 400;
        color: var(--slate);
      }

      .lede {
        font-size: var(--step-1);
        line-height: 1.5;
        max-width: 34ch;
        margin-top: 1.5rem;
        color: var(--slate);
      }

      .claim {
        margin-top: 2rem;
        padding-top: 1.1rem;
        font-family: var(--display);
        font-size: var(--step-2);
        line-height: 1.24;
        max-width: 24ch;
        position: relative;
      }

      .claim::before {
        content: '';
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        width: 3.5rem;
        height: 2px;
        background: var(--warn);
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.9rem 1.5rem;
        margin-top: 2.2rem;
      }

      .btn {
        display: inline-block;
        background: var(--ink);
        color: var(--paper);
        text-decoration: none;
        font-weight: 500;
        padding: 0.85rem 1.5rem;
        border: 1px solid var(--ink);
      }

      .btn:hover {
        background: var(--slate);
        border-color: var(--slate);
      }

      .btn-quiet {
        text-decoration: none;
        font-weight: 500;
        color: var(--slate);
        border-bottom: 1px solid var(--pale);
        padding-bottom: 2px;
      }

      .btn-quiet:hover {
        color: var(--ink);
        border-bottom-color: var(--ink);
      }

      /* the ledger — mist made of bands, never of faint text */

      .ledger {
        margin: 0;
        border: 1px solid var(--rule);
        background: var(--paper);
        position: relative;
        overflow: hidden;
      }

      .ledger-head {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--rule);
        color: var(--slate);
        background: var(--paper);
      }

      .ledger-rows {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .ledger-rows li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.72rem 1rem;
        color: var(--ink);
      }

      .ledger-rows .id {
        overflow-wrap: anywhere;
      }

      .ledger-rows .val {
        font-weight: 500;
        white-space: nowrap;
      }

      .band-0 { background: var(--paper); }
      .band-1 { background: var(--band-1); }
      .band-2 { background: var(--band-2); }
      .band-3 { background: var(--band-3); }
      .band-4 { background: var(--band-4); }
      .band-5 { background: var(--band-5); }

      .ledger-mist {
        display: block;
        padding: 0.55rem 1rem 1.4rem;
        background: var(--band-5);
      }

      .ledger-mist span {
        display: block;
        background: var(--pale);
        margin-bottom: 7px;
        animation: drift 26s ease-in-out infinite alternate;
      }

      .ledger-mist span:nth-child(1) { width: 46%; height: 5px; margin-left: 0; }
      .ledger-mist span:nth-child(2) { width: 92%; height: 4px; margin-left: 6%; animation-delay: -4s; }
      .ledger-mist span:nth-child(3) { width: 64%; height: 4px; margin-left: 1%; animation-delay: -9s; }
      .ledger-mist span:nth-child(4) { width: 80%; height: 3px; margin-left: 18%; animation-delay: -13s; }
      .ledger-mist span:nth-child(5) { width: 38%; height: 3px; margin-left: 8%; animation-delay: -17s; }
      .ledger-mist span:nth-child(6) { width: 56%; height: 2px; margin-left: 30%; animation-delay: -21s; }

      @keyframes drift {
        from { transform: translateX(-2%); }
        to { transform: translateX(2%); }
      }

      .ledger figcaption {
        padding: 1rem;
        border-top: 1px solid var(--rule);
        background: var(--paper);
        color: var(--slate);
        font-size: 0.86rem;
        line-height: 1.5;
      }

      /* ---------- sections ---------- */

      .section {
        padding-block: var(--pad-y);
        border-top: 1px solid var(--rule);
        scroll-margin-top: 62px;
      }

      .section-head {
        max-width: 46ch;
        margin-bottom: clamp(2.2rem, 1.4rem + 2vw, 3.4rem);
      }

      .why h2,
      .close h2 {
        max-width: 17ch;
      }

      h2 {
        font-size: var(--step-3);
        line-height: 1.04;
      }

      .h-tiny {
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--slate);
        font-weight: 500;
        margin-bottom: 1.1rem;
      }

      .section-lede {
        margin-top: 1.2rem;
        color: var(--slate);
        font-size: var(--step-1);
        line-height: 1.55;
      }

      /* ---------- why ---------- */

      .why {
        background: var(--band-2);
      }

      .losses {
        list-style: none;
        margin: clamp(2rem, 1.4rem + 1.6vw, 3rem) 0 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
      }

      .losses li {
        border-bottom: 1px solid var(--rule);
        border-right: 1px solid var(--rule);
        padding: 1.5rem 1.4rem 1.7rem 0;
      }

      .losses li:first-child {
        padding-left: 0;
      }

      .losses li:not(:first-child) {
        padding-left: 1.4rem;
      }

      .losses li:last-child {
        border-right: 0;
        padding-right: 0;
      }

      .losses strong {
        display: block;
        font-family: var(--display);
        font-weight: 500;
        font-size: var(--step-1);
        letter-spacing: -0.02em;
      }

      .losses span {
        display: block;
        margin-top: 0.35rem;
        color: var(--slate);
      }

      @media (max-width: 720px) {
        .losses {
          grid-template-columns: minmax(0, 1fr);
        }
        .losses li,
        .losses li:not(:first-child),
        .losses li:last-child {
          padding: 1.2rem 0 1.3rem;
          border-right: 0;
        }
      }

      .why-note {
        margin-top: clamp(1.8rem, 1.2rem + 1.4vw, 2.6rem);
        max-width: 56ch;
        color: var(--slate);
        font-size: var(--step-1);
        line-height: 1.55;
      }

      /* ---------- steps ---------- */

      .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--gap);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        counter-reset: none;
      }

      .steps li {
        border-top: 2px solid var(--ink);
        padding-top: 1.1rem;
      }

      .step-n {
        display: block;
        color: var(--slate);
        margin-bottom: 0.9rem;
      }

      .steps h3 {
        font-size: var(--step-2);
        line-height: 1.1;
      }

      .steps p {
        margin-top: 0.6rem;
        color: var(--slate);
      }

      .aside {
        margin-top: clamp(2rem, 1.4rem + 1.4vw, 3rem);
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
        max-width: 54ch;
        color: var(--slate);
      }

      @media (max-width: 780px) {
        .steps {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- destinations ---------- */

      .dests {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
      }

      .dests li {
        border-bottom: 1px solid var(--rule);
        border-right: 1px solid var(--rule);
        padding: clamp(1.3rem, 1rem + 0.8vw, 1.9rem);
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .dests h3 {
        font-size: var(--step-1);
      }

      .dests p {
        color: var(--slate);
      }

      .fact {
        margin-top: auto;
        padding-top: 0.9rem;
        color: var(--ink);
        overflow-wrap: anywhere;
      }

      @media (max-width: 900px) {
        .dests {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 560px) {
        .dests {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- tables ---------- */

      .table-wrap {
        overflow-x: auto;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
      }

      thead th {
        font-family: var(--mono);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--slate);
        padding: 0 0 0.7rem;
        border-bottom: 1px solid var(--ink);
      }

      tbody th,
      tbody td {
        padding: 1rem 1.4rem 1rem 0;
        border-bottom: 1px solid var(--rule);
        vertical-align: baseline;
        font-weight: 400;
        color: var(--slate);
      }

      tbody th {
        color: var(--ink);
        white-space: nowrap;
        padding-right: 1.8rem;
      }

      .formats tbody th .mono {
        font-size: 0.95rem;
        font-weight: 500;
      }

      .formats td:last-child,
      .states td:last-child {
        padding-right: 0;
      }

      .tag {
        display: inline-block;
        margin-right: 0.55rem;
        padding: 0.1rem 0.42rem;
        border: 1px solid var(--warn);
        color: var(--ink);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        vertical-align: 1px;
      }

      .lossy th,
      .lossy td {
        background: var(--band-2);
      }

      .state {
        display: inline-block;
        padding: 0.16rem 0.5rem;
        background: var(--band-3);
        color: var(--ink);
        font-weight: 500;
      }

      .tone-good {
        background: var(--ink);
        color: var(--paper);
      }

      .tone-unknown {
        background: var(--band-5);
        box-shadow: inset 0 0 0 1px var(--pale);
      }

      @media (max-width: 620px) {
        table,
        thead,
        tbody,
        tr,
        th,
        td {
          display: block;
          width: 100%;
        }
        thead {
          display: none;
        }
        tbody tr {
          border-bottom: 1px solid var(--rule);
          padding-block: 1.1rem;
        }
        tbody th,
        tbody td {
          border-bottom: 0;
          padding: 0 0 0.35rem;
          white-space: normal;
        }
        tbody th {
          padding-bottom: 0.5rem;
        }
      }

      /* ---------- slab ---------- */

      .slab {
        background: var(--ink);
        color: var(--paper);
        border-top: 0;
      }

      .slab .eyebrow,
      .slab .section-lede,
      .slab p {
        color: var(--pale);
      }

      .slab .dot {
        background: var(--pale);
      }

      .slab .em {
        color: var(--pale);
      }

      .durability {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-top: 1px solid var(--slate);
      }

      .durability li {
        padding: 1.5rem clamp(1rem, 0.7rem + 0.8vw, 1.6rem) 1.7rem 0;
        border-right: 1px solid var(--slate);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .durability li:not(:first-child) {
        padding-left: clamp(1rem, 0.7rem + 0.8vw, 1.6rem);
      }

      .durability li:last-child {
        border-right: 0;
        padding-right: 0;
      }

      .durability h3 {
        font-size: var(--step-1);
        color: var(--paper);
      }

      .durability .fact {
        color: var(--paper);
        margin-top: auto;
        padding-top: 0.6rem;
      }

      @media (max-width: 900px) {
        .durability {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .durability li:nth-child(2n) {
          border-right: 0;
          padding-right: 0;
        }
        .durability li:nth-child(odd) {
          padding-left: 0;
        }
        .durability li:nth-child(even) {
          padding-left: clamp(1rem, 0.7rem + 0.8vw, 1.6rem);
        }
        .durability li:nth-child(-n + 2) {
          border-bottom: 1px solid var(--slate);
        }
      }

      @media (max-width: 560px) {
        .durability {
          grid-template-columns: minmax(0, 1fr);
        }
        .durability li {
          border-right: 0;
          border-bottom: 1px solid var(--slate);
          padding: 1.3rem 0 1.4rem !important;
        }
        .durability li:last-child {
          border-bottom: 0;
        }
      }

      .tests {
        margin-top: clamp(2rem, 1.4rem + 1.4vw, 3rem);
        display: flex;
        align-items: baseline;
        gap: 0.9rem;
        flex-wrap: wrap;
        color: var(--pale) !important;
      }

      .tests .big {
        font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.6rem);
        font-weight: 500;
        color: var(--paper);
        letter-spacing: -0.04em;
      }

      /* ---------- honesty ---------- */

      .honest-notes {
        list-style: none;
        margin: clamp(2.4rem, 1.6rem + 2vw, 3.4rem) 0 0;
        padding: 0;
        display: grid;
        gap: var(--gap);
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .honest-notes li {
        border-top: 1px solid var(--rule);
        padding-top: 1rem;
      }

      .honest-notes h3 {
        font-size: var(--step-1);
      }

      .honest-notes p {
        margin-top: 0.5rem;
        color: var(--slate);
      }

      @media (max-width: 820px) {
        .honest-notes {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- assistant ---------- */

      .mcp-grid {
        display: grid;
        gap: clamp(2rem, 1.2rem + 3vw, 4rem);
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
        align-items: start;
      }

      .caveat {
        margin-top: 1.6rem;
        padding: 1.1rem 1.3rem;
        background: var(--band-3);
        color: var(--slate);
        max-width: 52ch;
      }

      .caveat strong {
        color: var(--ink);
        font-weight: 600;
      }

      .mcp-list {
        list-style: none;
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--rule);
      }

      .mcp-list li {
        padding: 0.6rem 0;
        border-bottom: 1px solid var(--rule);
        color: var(--ink);
      }

      @media (max-width: 820px) {
        .mcp-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- promises ---------- */

      .promises {
        background: var(--band-2);
      }

      .prom-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: 1px solid var(--rule);
        border-left: 1px solid var(--rule);
      }

      .prom-list li {
        border-bottom: 1px solid var(--rule);
        border-right: 1px solid var(--rule);
        padding: clamp(1.2rem, 0.9rem + 0.8vw, 1.7rem);
      }

      .prom-list h3 {
        font-size: var(--step-1);
      }

      .prom-list p {
        margin-top: 0.3rem;
        color: var(--slate);
      }

      @media (max-width: 820px) {
        .prom-list {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 520px) {
        .prom-list {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- status ---------- */

      .status-grid {
        display: grid;
        gap: clamp(2rem, 1.2rem + 2.4vw, 3.6rem);
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .tick,
      .cross {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .tick li,
      .cross li {
        position: relative;
        padding: 0.55rem 0 0.55rem 1.9rem;
        border-bottom: 1px solid var(--rule);
      }

      .tick li::before,
      .cross li::before {
        position: absolute;
        left: 0;
        font-family: var(--mono);
        font-size: 0.9rem;
        color: var(--slate);
      }

      .tick li::before {
        content: '✓';
        color: var(--ink);
      }

      .cross li::before {
        content: '—';
      }

      .cross li {
        color: var(--slate);
      }

      @media (max-width: 620px) {
        .status-grid {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- faq ---------- */

      .faq-list {
        margin: 0;
        display: grid;
        gap: 0;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: clamp(2rem, 1.2rem + 2.4vw, 3.6rem);
        border-top: 1px solid var(--rule);
      }

      .faq-item {
        padding: 1.4rem 0 1.5rem;
        border-bottom: 1px solid var(--rule);
      }

      .faq-item dt {
        font-family: var(--display);
        font-weight: 500;
        font-size: var(--step-1);
        letter-spacing: -0.02em;
      }

      .faq-item dd {
        margin: 0.5rem 0 0;
        color: var(--slate);
        max-width: 58ch;
      }

      @media (max-width: 780px) {
        .faq-list {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* ---------- close ---------- */

      .close {
        background: var(--band-3);
      }

      .close-inner {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.2rem;
      }

      .close h2 {
        max-width: 16ch;
      }

      .close p {
        max-width: 50ch;
        color: var(--slate);
        font-size: var(--step-1);
        line-height: 1.55;
      }

      .close .btn-quiet {
        border-bottom-color: var(--mid);
      }

      /* ---------- footer ---------- */

      .footer {
        background: var(--ink);
        color: var(--pale);
        padding-block: 2.4rem;
      }

      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem 2rem;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.9rem;
      }

      .footer-links {
        display: flex;
        gap: 1.4rem;
      }

      .footer a {
        color: var(--paper);
        text-decoration: none;
        border-bottom: 1px solid var(--slate);
      }

      .footer a:hover {
        border-bottom-color: var(--paper);
      }

      .footer :focus-visible {
        outline-color: var(--paper);
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .ledger-mist span {
          animation: none;
          transform: none;
        }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.001ms !important;
        }
      }
    </style>
  </body>
</html>
