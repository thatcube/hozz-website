---
/**
 * w07 · The Long Keeping — mark c13, Keepsake Chest.
 *
 * The argument is time. Your Health data is the most detailed longitudinal
 * record that exists about your own body, and it lives in one vendor's app on
 * one device. The page leads with keeping and inheritance, then earns it with
 * the real mechanics: destinations, formats, anchors, honest coverage states.
 */
import Mark from '../../components/mark/logos/c13.astro';
import {
  SITE,
  GITHUB_URL,
  DONATE_URL,
  LICENSE_URL,
  CATEGORIES,
  STREAM_LANES,
  STEPS,
  DESTINATIONS,
  FORMATS,
  DURABILITY,
  COVERAGE_STATES,
  MCP_TOOLS,
  PROMISES,
  WORKING,
  NOT_YET,
  FAQ,
} from '../../data/site';

const hue = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.hue])) as Record<string, string>;

/** Six real identifiers with example readings, for the chest panel in the hero. */
const inTheChest = [
  STREAM_LANES[0][2],
  STREAM_LANES[2][1],
  STREAM_LANES[0][0],
  STREAM_LANES[3][4],
  STREAM_LANES[1][5],
  STREAM_LANES[2][4],
  STREAM_LANES[1][2],
  STREAM_LANES[0][6],
];

const icons: Record<string, string> = {
  mac: 'M3 5.5h18v10H3zM1.5 18.5h21',
  folder: 'M2.5 6.5h7l2 2.5h10v9h-19zM2.5 6.5v11',
  house: 'M2.5 11 12 3.5l9.5 7.5M5.5 10v10h13V10',
  globe: 'M12 2.5a9.5 9.5 0 1 0 0 19 9.5 9.5 0 0 0 0-19M2.5 12h19M12 2.5c5 5.5 5 13.5 0 19M12 2.5c-5 5.5-5 13.5 0 19',
  broadcast: 'M12 10.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M8 8a5.5 5.5 0 0 0 0 8M16 8a5.5 5.5 0 0 1 0 8M5 5a9.5 9.5 0 0 0 0 14M19 5a9.5 9.5 0 0 1 0 14',
};

/** The long view, stated as three keepings rather than three features. */
const KEEPINGS = [
  {
    when: 'In ten years',
    title: 'The phone is gone. The file opens anyway.',
    body: 'NDJSON is lines of text. SQLite is the most deployed database on earth. Neither needs a company to still exist for you to read them.',
  },
  {
    when: 'At the appointment',
    title: 'Bring a record, not a screenshot.',
    body: 'Years of resting heart rate, sleep and weight in one queryable file — with every original record kept beside the parsed one.',
  },
  {
    when: 'After you',
    title: 'A folder can be handed on.',
    body: 'An account cannot. What lives in a drive you own is inheritable in the ordinary way that things you own are.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      url: `${SITE}/w/w07/`,
      codeRepository: GITHUB_URL,
      downloadUrl: GITHUB_URL,
      license: LICENSE_URL,
      isAccessibleForFree: true,
      softwareVersion: 'Early alpha',
      author: { '@type': 'Person', name: 'Brandon Moore' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'A free, open-source iPhone app with a companion Mac app that exports Apple Health records to destinations you own — your Mac, a folder, Home Assistant, InfluxDB, a web endpoint or MQTT — as NDJSON, SQLite, JSON, CSV, Markdown, GPX or Metrics JSON.',
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I export my Apple Health data?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Apple’s Health app can hand you a single zip of XML, by hand, when you remember to ask for it. Hozz does it continuously instead: add a destination you own, choose which Health types and how often, and new records go on their own in NDJSON, SQLite, JSON, CSV, Markdown, GPX or Metrics JSON.',
          },
        },
        ...FAQ.map(({ q, a }) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <meta
      name="description"
      content="Hozz copies your Apple Health history into places you own — your Mac, a folder, InfluxDB, MQTT — so it outlives the phone that recorded it. Free, open source, no account, no analytics."
    />
    <link rel="canonical" href={`${SITE}/w/w07/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/zodiak-k-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>Hozz — keep the long record of your own body</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="lid-strip" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <header class="masthead">
      <div class="shell bar">
        <a class="brand" href="#top">
          <Mark size={28} />
          <span class="brand-name">Hozz</span>
          <span class="brand-sub">keepsake for health data</span>
        </a>
        <nav aria-label="Sections">
          <a href="#export">How to export</a>
          <a href="#destinations">Destinations</a>
          <a href="#formats">Formats</a>
          <a href="#trust">Trust</a>
          <a class="ghost" href={GITHUB_URL} rel="noopener">Source<span aria-hidden="true"> ↗</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- ── Hero ─────────────────────────────────────────────────────── -->
      <section class="hero" id="top">
        <div class="shell hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot" style="--c:#8b6253"></span>Free · open source · early alpha</p>
            <h1>Your health history should <em class="em">outlive</em> the phone that wrote it.</h1>
            <p class="lede">
              Hozz is a free iPhone app with a Mac companion. It copies your Apple Health records into
              somewhere you own — your Mac, a folder, your own database — and keeps copying as new ones
              arrive. Nothing leaves until you add a destination and confirm it.
            </p>
            <p class="actions">
              <a class="btn primary" href={GITHUB_URL} rel="noopener">Read the source</a>
              <a class="btn" href="#export">How to export your data</a>
            </p>
            <ul class="stamps">
              <li>GPL-3.0</li>
              <li>No account</li>
              <li>No analytics</li>
              <li>No server of mine</li>
            </ul>
          </div>

          <figure class="chest">
            <div class="lid" aria-hidden="true">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <figcaption class="chest-head">
              <span class="chest-title">In the chest</span>
              <span class="chest-note">a fraction of what it carries</span>
            </figcaption>
            <ul class="manifest">
              {
                inTheChest.map((row) => (
                  <li>
                    <span class="swatch" style={`--c:${hue[row.category]}`} aria-hidden="true"></span>
                    <code>{row.id}</code>
                    <span class="val">{row.sample}</span>
                  </li>
                ))
              }
            </ul>
            <p class="chest-foot">
              Real HealthKit identifiers. The readings are examples — Hozz never sees anyone’s numbers
              but yours, and neither do I.
            </p>
          </figure>
        </div>
      </section>

      <!-- ── The long view ────────────────────────────────────────────── -->
      <section class="band long" id="why" aria-labelledby="why-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#b9836c"></span>The long view</p>
          <h2 id="why-h">The most detailed record of your body is <em class="em">already written</em>.</h2>
          <p class="wide">
            Every night of sleep since you bought the watch. Every resting heart rate, every walk, every
            weight. It is the longest, closest record that exists about you — and it sits in one vendor’s
            app, on one device, under rules you did not write. Hozz makes the second copy, the one that is
            plainly yours.
          </p>

          <ol class="keepings">
            {
              KEEPINGS.map((k, i) => (
                <li>
                  <p class="when">
                    <span class="num">{String(i + 1).padStart(2, '0')}</span>
                    {k.when}
                  </p>
                  <h3>{k.title}</h3>
                  <p>{k.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ── How to export ────────────────────────────────────────────── -->
      <section class="band" id="export" aria-labelledby="export-h">
        <div class="shell split">
          <div class="split-lead">
            <p class="eyebrow"><span class="dot" style="--c:#8b6253"></span>The question people search</p>
            <h2 id="export-h">How do I export my Apple Health data?</h2>
            <p class="answer">
              Two ways. Apple’s Health app can hand you a single zip of XML, by hand, on the day you
              remember to ask. Hozz does it continuously instead — in a format you choose, to a place you
              already own.
            </p>
            <p class="fineprint">
              iOS decides when background work runs, so most types land near hourly, and Health cannot be
              read at all while the phone is locked. Hozz says so rather than pretending otherwise.
            </p>
          </div>

          <ol class="steps">
            {
              STEPS.map((s, i) => (
                <li style={`--c:${hue[s.category]}`}>
                  <span class="step-n">{i + 1}</span>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ── Destinations ─────────────────────────────────────────────── -->
      <section class="band tinted" id="destinations" aria-labelledby="dest-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#5a4037"></span>Six destinations</p>
          <h2 id="dest-h">It goes where <em class="em">you</em> already keep things.</h2>
          <p class="wide">
            There is no default destination and no relay in the middle. Each one keeps its own place in
            the queue, so a folder that is offline never holds up your Mac.
          </p>

          <ul class="cards">
            {
              DESTINATIONS.map((d) => (
                <li class="card" style={`--c:${hue[d.category]}`}>
                  <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d={icons[d.icon]} />
                  </svg>
                  <h3>{d.title}</h3>
                  <p>{d.body}</p>
                  <p class="fact"><code>{d.fact}</code></p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ── Formats ──────────────────────────────────────────────────── -->
      <section class="band" id="formats" aria-labelledby="fmt-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#d9ad8c"></span>What comes out</p>
          <h2 id="fmt-h">Seven formats, and an <em class="em">honest</em> label on two of them.</h2>
          <p class="wide">
            Lossy is not a flaw here — a spreadsheet cannot hold a workout’s nested detail, and a daily
            note is not meant to. It is only a flaw when nobody tells you. So: told.
          </p>

          <div class="table-wrap">
            <table>
              <caption class="sr">Hozz export formats, what each is for, and whether it is lossless</caption>
              <thead>
                <tr>
                  <th scope="col">Format</th>
                  <th scope="col">What it is for</th>
                  <th scope="col">Fidelity</th>
                </tr>
              </thead>
              <tbody>
                {
                  FORMATS.map((f) => {
                    const lossy = f.note.startsWith('Lossy');
                    return (
                      <tr>
                        <th scope="row"><code>{f.name}</code></th>
                        <td data-label="What it is for">{f.use}</td>
                        <td data-label="Fidelity" class={lossy ? 'lossy' : 'lossless'}>{f.note}</td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
          <p class="fineprint">
            SQLite is the one to keep. Every row holds its original record in <code>raw</code>, so a
            future you can re-derive anything this version of Hozz did not think to parse.
          </p>
        </div>
      </section>

      <!-- ── Trust ────────────────────────────────────────────────────── -->
      <section class="band deep" id="trust" aria-labelledby="trust-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#f0d2ad"></span>Why it can be trusted</p>
          <h2 id="trust-h">An interruption can repeat work. It <em class="em">cannot</em> skip records.</h2>
          <p class="wide">
            That sentence is the whole design. Every mechanism below exists to make it true, and
            <strong> 475 XCTest tests</strong> exist to keep it true.
          </p>

          <ul class="grid4">
            {
              DURABILITY.map((d) => (
                <li>
                  <h3>{d.title}</h3>
                  <p>{d.body}</p>
                  <p class="fact"><code>{d.fact}</code></p>
                </li>
              ))
            }
          </ul>

          <div class="states">
            <h3 class="states-h">And when it cannot know, it says it cannot know</h3>
            <p class="states-lede">
              Apple will not let an app tell “you denied this type” apart from “you have no data”. Other
              apps print a green tick. Hozz prints five states, one of which is a shrug.
            </p>
            <dl class="state-list">
              {
                COVERAGE_STATES.map((s) => (
                  <div class={`state tone-${s.tone}`}>
                    <dt><code>{s.state}</code></dt>
                    <dd>{s.body}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="fineprint pale">
              There is no progress percentage either. Health will not say how many records a type holds
              without reading them all, so any fraction would be invented.
            </p>
          </div>
        </div>
      </section>

      <!-- ── Assistant ────────────────────────────────────────────────── -->
      <section class="band tinted" id="assistant" aria-labelledby="mcp-h">
        <div class="shell split">
          <div class="split-lead">
            <p class="eyebrow"><span class="dot" style="--c:#a173c4"></span>On your Mac</p>
            <h2 id="mcp-h">Ask your own assistant, <em class="em">read-only</em>.</h2>
            <p class="answer">
              The Mac app ships an MCP server over the database your phone keeps current. A question
              costs a lookup, not a re-parse of a stale XML dump. It can read. It cannot change or delete
              anything.
            </p>
            <p class="caveat">
              <strong>The caveat worth printing:</strong> a cloud assistant may upload whatever it reads.
              That is the assistant’s behaviour, not Hozz’s. A local model reads the same database without
              leaving the machine.
            </p>
          </div>
          <div class="mcp-panel">
            <p class="panel-h">What it can be asked about</p>
            <ul class="chips">
              {MCP_TOOLS.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <!-- ── Refusals ─────────────────────────────────────────────────── -->
      <section class="band" id="promises" aria-labelledby="prom-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#8b6253"></span>Written as refusals</p>
          <h2 id="prom-h">Six things Hozz <em class="em">will not</em> do.</h2>
          <ul class="refusals">
            {
              PROMISES.map((p) => (
                <li style={`--c:${hue[p.category]}`}>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                </li>
              ))
            }
          </ul>
          <p class="never">
            And one more, permanently: <strong>Hozz will never write back into Apple Health.</strong>
            Health stamps every sample with the app that wrote it, so a reading your Watch took in 2019
            would return indistinguishable from one Hozz invented — and HealthKit has no way to say
            “store this unless it is already there”, so importing twice would silently double everything.
          </p>
        </div>
      </section>

      <!-- ── Status ───────────────────────────────────────────────────── -->
      <section class="band tinted" id="status" aria-labelledby="status-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#6c9f45"></span>Early alpha</p>
          <h2 id="status-h">It works. Coverage is <em class="em">partial</em>. Both are true.</h2>
          <div class="status-grid">
            <div class="col">
              <h3 class="col-h yes">Working today</h3>
              <ul class="ticks">{WORKING.map((w) => <li>{w}</li>)}</ul>
            </div>
            <div class="col">
              <h3 class="col-h no">Not yet</h3>
              <ul class="ticks minus">{NOT_YET.map((n) => <li>{n}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>

      <!-- ── FAQ ──────────────────────────────────────────────────────── -->
      <section class="band" id="faq" aria-labelledby="faq-h">
        <div class="shell">
          <p class="eyebrow"><span class="dot" style="--c:#4a8fc0"></span>Questions</p>
          <h2 id="faq-h">The ones worth <em class="em">asking</em> first.</h2>
          <dl class="faq">
            {
              FAQ.map(({ q, a }) => (
                <div>
                  <dt>{q}</dt>
                  <dd>{a}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- ── Close ────────────────────────────────────────────────────── -->
      <section class="band close" aria-labelledby="close-h">
        <div class="shell close-grid">
          <div>
            <Mark size={56} />
            <h2 id="close-h">Start the copy <em class="em">today</em>. Twenty years is made of days.</h2>
            <p class="wide">
              Free, and free forever — GPL-3.0 with an App Store exception, built by one person. There is
              nothing to sign up to, nothing held back for a Pro tier, and no default destination waiting
              to catch your data.
            </p>
            <p class="actions">
              <a class="btn primary" href={GITHUB_URL} rel="noopener">Get it from GitHub</a>
              <a class="btn quiet" href={DONATE_URL} rel="noopener">Sponsor the work</a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="shell foot-grid">
        <p class="foot-brand"><Mark size={22} /> <span>Hozz</span></p>
        <p>By Brandon Moore. <a href={LICENSE_URL} rel="noopener">GPL-3.0</a>, with an App Store exception.</p>
        <p class="foot-note">This page loads nothing from anywhere else. No cookies, no storage, no analytics.</p>
      </div>
    </footer>

    <style is:global>
      /* ── Fonts (self-hosted) ─────────────────────────────────────── */
      @font-face {
        font-family: 'Zodiak';
        src: url('/fonts/zodiak-k-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Zodiak';
        src: url('/fonts/zodiak-k-700-italic.woff2') format('woff2');
        font-weight: 700;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Sentient';
        src: url('/fonts/sentient-500-italic.woff2') format('woff2');
        font-weight: 500;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'General Sans';
        src: url('/fonts/general-sans-600.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plex Mono';
        src: url('/fonts/ibm-plex-mono-400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Plex Mono';
        src: url('/fonts/ibm-plex-mono-500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }

      /* ── Tokens ──────────────────────────────────────────────────── */
      :root {
        /* Ground is rose-clay, not cream: it leans mauve, never yellow. */
        --ground: #e9dbd7;
        --ground-2: #dfcbc6;
        --panel: #f5ebe8;
        --line: #cfb2aa;
        --line-soft: #dac2bb;

        --ink: #2b1a15;
        --ink-2: #563b32;
        --ink-3: #6b4c41;

        --deep: #5a4037;
        --clay: #8b6253;
        --accent: #7a4a38;
        --rose: #b9836c;
        --sand: #d9ad8c;
        --peach: #f0d2ad;

        --dark: #2d1d18;
        --dark-2: #3a261f;
        --on-dark: #f4e3d8;
        --on-dark-2: #d9b9a6;

        --display: 'Zodiak', Georgia, serif;
        --head: 'Sentient', Georgia, serif;
        --body: 'General Sans', system-ui, sans-serif;
        --mono: 'Plex Mono', ui-monospace, monospace;

        --shell: 1180px;
        --pad: clamp(1.15rem, 4vw, 2.5rem);
        --r: 14px;
      }

      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--body);
        font-size: clamp(1rem, 0.96rem + 0.2vw, 1.075rem);
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img,
      svg {
        max-width: 100%;
      }
      ::selection {
        background: var(--sand);
        color: var(--ink);
      }
      a {
        color: inherit;
      }
      code {
        font-family: var(--mono);
        font-size: 0.86em;
        letter-spacing: -0.01em;
      }
      .sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
      }
      :focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .deep :focus-visible,
      .foot :focus-visible {
        outline-color: var(--peach);
      }
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--ink);
        color: var(--peach);
        padding: 0.6rem 1rem;
        z-index: 50;
      }
      .skip:focus {
        left: 0.5rem;
        top: 0.5rem;
      }

      .shell {
        width: min(100% - (var(--pad) * 2), var(--shell));
        margin-inline: auto;
      }

      /* ── Masthead ────────────────────────────────────────────────── */
      /* A hairline of the chest's own banding, across the top of the page. */
      .lid-strip {
        display: flex;
        height: 5px;
      }
      .lid-strip span {
        flex: 1;
      }
      .lid-strip span:nth-child(1),
      .lid span:nth-child(1) {
        background: var(--deep);
      }
      .lid-strip span:nth-child(2),
      .lid span:nth-child(2) {
        background: var(--clay);
      }
      .lid-strip span:nth-child(3),
      .lid span:nth-child(3) {
        background: var(--rose);
      }
      .lid-strip span:nth-child(4),
      .lid span:nth-child(4) {
        background: var(--sand);
      }
      .lid-strip span:nth-child(5),
      .lid span:nth-child(5) {
        background: var(--peach);
      }

      /* Paper grain: barely there, but it stops the ground reading as flat. */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 40;
        pointer-events: none;
        background-image: repeating-linear-gradient(
          0deg,
          rgba(90, 64, 55, 0.026) 0 1px,
          transparent 1px 3px
        );
      }

      .masthead {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(233, 219, 215, 0.93);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line-soft);
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 66px;
        padding-block: 0.55rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        flex-wrap: wrap;
      }
      .brand-name {
        font-family: var(--display);
        font-size: 1.3rem;
        letter-spacing: 0.01em;
      }
      .brand-sub {
        font-family: var(--mono);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ink-3);
        border-left: 1px solid var(--line);
        padding-left: 0.6rem;
      }
      .masthead nav {
        display: flex;
        align-items: center;
        gap: clamp(0.7rem, 1.6vw, 1.5rem);
        font-size: 0.93rem;
        font-weight: 500;
      }
      @media (max-width: 56rem) {
        .masthead {
          position: static;
        }
        .bar {
          flex-wrap: wrap;
          padding-bottom: 0;
        }
        .masthead nav {
          flex: 1 0 100%;
          overflow-x: auto;
          gap: 1.1rem;
          padding-block: 0.15rem 0.7rem;
          scrollbar-width: none;
        }
        .masthead nav::-webkit-scrollbar {
          display: none;
        }
        .masthead nav a {
          white-space: nowrap;
        }
      }
      @media (max-width: 34rem) {
        .brand-sub {
          display: none;
        }
      }
      .masthead nav a {
        text-decoration: none;
        color: var(--ink-2);
        padding-block: 0.3rem;
        border-bottom: 1px solid transparent;
      }
      .masthead nav a:hover {
        color: var(--ink);
        border-bottom-color: var(--rose);
      }
      .masthead nav .ghost {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.32rem 0.85rem;
        color: var(--ink);
        background: var(--panel);
      }
      .masthead nav .ghost:hover {
        border-color: var(--clay);
      }

      /* ── Type ────────────────────────────────────────────────────── */
      h1,
      h2,
      h3 {
        margin: 0;
        text-wrap: balance;
      }
      h1 {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(2.4rem, 1.5rem + 3.5vw, 4.15rem);
        line-height: 1.03;
        letter-spacing: -0.022em;
        margin-block: 0.9rem 1.1rem;
      }
      h2 {
        font-family: var(--display);
        font-weight: 400;
        font-size: clamp(1.85rem, 1.25rem + 2.4vw, 3.1rem);
        line-height: 1.08;
        letter-spacing: -0.018em;
        margin-block: 0.7rem 1rem;
      }
      h3 {
        font-family: var(--head);
        font-weight: 500;
        font-size: 1.12rem;
        line-height: 1.3;
        letter-spacing: -0.005em;
      }
      .em {
        font-family: var(--display);
        font-weight: 700;
        font-style: italic;
        color: var(--accent);
      }
      .deep .em,
      .close .em {
        color: var(--sand);
      }
      .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0;
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .dot {
        width: 9px;
        height: 9px;
        border-radius: 2px;
        background: var(--c, var(--clay));
        flex: none;
      }
      .deep .eyebrow,
      .close .eyebrow {
        color: var(--on-dark-2);
      }
      .lede {
        font-size: clamp(1.075rem, 1rem + 0.45vw, 1.28rem);
        line-height: 1.55;
        color: var(--ink-2);
        max-width: 42ch;
        margin: 0 0 1.6rem;
      }
      .wide {
        max-width: 62ch;
        color: var(--ink-2);
        margin: 0 0 2rem;
      }
      .deep .wide,
      .close .wide {
        color: var(--on-dark-2);
      }
      .fineprint {
        font-size: 0.94rem;
        color: var(--ink-3);
        max-width: 60ch;
      }
      .fineprint.pale {
        color: var(--on-dark-2);
      }

      /* ── Buttons ─────────────────────────────────────────────────── */
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin: 0 0 1.6rem;
      }
      .btn {
        display: inline-block;
        font-weight: 600;
        font-size: 0.97rem;
        text-decoration: none;
        padding: 0.72rem 1.25rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--ink);
      }
      .btn:hover {
        border-color: var(--clay);
      }
      .btn.primary {
        background: var(--deep);
        border-color: var(--deep);
        color: #fbf1e7;
      }
      .btn.primary:hover {
        background: var(--ink);
        border-color: var(--ink);
      }
      .close .btn {
        background: transparent;
        border-color: #7a5749;
        color: var(--on-dark);
      }
      .close .btn.primary {
        background: var(--peach);
        border-color: var(--peach);
        color: #3a251c;
      }
      .close .btn.quiet:hover {
        border-color: var(--sand);
      }

      /* ── Hero ────────────────────────────────────────────────────── */
      .hero {
        padding-block: clamp(2.6rem, 5.5vw, 4.6rem) clamp(3rem, 6vw, 5.5rem);
        background:
          radial-gradient(120% 90% at 84% -10%, rgba(240, 210, 173, 0.42), transparent 58%),
          radial-gradient(90% 80% at 4% 24%, rgba(122, 74, 56, 0.13), transparent 66%);
      }
      .hero-grid {
        display: grid;
        gap: clamp(2.2rem, 5vw, 4rem);
        align-items: start;
      }
      @media (min-width: 62rem) {
        .hero-grid {
          grid-template-columns: 1.08fr 0.92fr;
          gap: clamp(2.5rem, 5vw, 5rem);
        }
      }
      .stamps {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.3rem;
        list-style: none;
        margin: 0;
        padding: 0;
        font-family: var(--mono);
        font-size: 0.78rem;
        letter-spacing: 0.03em;
        color: var(--ink-3);
      }
      .stamps li {
        position: relative;
      }
      .stamps li + li::before {
        content: '·';
        position: absolute;
        left: -0.75rem;
      }
      @media (max-width: 40rem) {
        .stamps li + li::before {
          content: none;
        }
        .stamps {
          gap: 0.35rem 1rem;
        }
        .actions .btn {
          flex: 1 1 14rem;
          text-align: center;
        }
      }

      /* The chest: a lid of banded colour over a pale front panel. */
      .chest {
        margin: 0;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 18px 34px -26px rgba(28, 20, 16, 0.42);
      }
      .lid {
        display: flex;
        height: 12px;
      }
      .lid span {
        flex: 1;
      }
      .chest-head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.6rem;
        padding: 1.05rem 1.2rem 0.7rem;
        border-bottom: 1px solid var(--line-soft);
      }
      .chest-title {
        font-family: var(--head);
        font-weight: 500;
        font-size: 1.05rem;
      }
      .chest-note {
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .manifest {
        list-style: none;
        margin: 0;
        padding: 0.3rem 0;
      }
      .manifest li {
        display: grid;
        grid-template-columns: 10px 1fr auto;
        align-items: center;
        gap: 0.7rem;
        padding: 0.6rem 1.2rem;
        border-bottom: 1px solid var(--line-soft);
      }
      .manifest li:last-child {
        border-bottom: 0;
      }
      .swatch {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--c);
      }
      .manifest code {
        color: var(--ink);
        font-size: 0.82rem;
        overflow-wrap: anywhere;
      }
      .manifest .val {
        font-family: var(--mono);
        font-size: 0.82rem;
        color: var(--ink-3);
        white-space: nowrap;
      }
      .chest-foot {
        margin: 0;
        padding: 0.9rem 1.2rem 1.1rem;
        font-size: 0.86rem;
        line-height: 1.5;
        color: var(--ink-3);
        background: var(--ground-2);
        border-top: 1px solid var(--line-soft);
      }

      /* ── Bands ───────────────────────────────────────────────────── */
      .band {
        padding-block: clamp(3.2rem, 7vw, 5.8rem);
        border-top: 1px solid var(--line-soft);
      }
      .band.tinted {
        background: var(--ground-2);
      }
      .band.deep,
      .band.close {
        background: var(--dark);
        color: var(--on-dark);
        border-top: 0;
      }
      .band.deep h3,
      .band.close h3 {
        color: var(--on-dark);
      }

      /* ── The long view ───────────────────────────────────────────── */
      .keepings {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--line-soft);
        border-block: 1px solid var(--line-soft);
      }
      @media (min-width: 52rem) {
        .keepings {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .keepings li {
        background: var(--ground);
        padding: 1.5rem clamp(1rem, 2vw, 1.6rem) 1.7rem;
      }
      .keepings .when {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0 0 0.9rem;
        font-family: var(--mono);
        font-size: 0.76rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .keepings .num {
        font-size: 0.72rem;
        color: #6b4c41;
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.05rem 0.35rem;
      }
      .keepings h3 {
        font-size: 1.28rem;
        margin-bottom: 0.5rem;
      }
      .keepings p:last-child {
        margin: 0;
        color: var(--ink-2);
        font-size: 0.98rem;
      }

      /* ── Split layouts ───────────────────────────────────────────── */
      .split {
        display: grid;
        gap: clamp(2rem, 4vw, 3.5rem);
        align-items: start;
      }
      @media (min-width: 62rem) {
        .split {
          grid-template-columns: 0.95fr 1.05fr;
        }
      }
      .answer {
        font-size: clamp(1.05rem, 1rem + 0.35vw, 1.2rem);
        color: var(--ink-2);
        max-width: 46ch;
      }
      .caveat {
        border-top: 1px solid var(--line);
        padding-top: 1rem;
        color: var(--ink-2);
        font-size: 0.98rem;
        max-width: 48ch;
      }

      .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.9rem;
        counter-reset: s;
      }
      .steps li {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1rem;
        align-items: start;
        background: var(--panel);
        border: 1px solid var(--line-soft);
        border-radius: var(--r);
        padding: 1.15rem 1.25rem;
      }
      .step-n {
        font-family: var(--display);
        font-size: 1.5rem;
        line-height: 1;
        color: var(--c);
        min-width: 1.4rem;
        padding-top: 0.1rem;
      }
      .steps h3 {
        margin-bottom: 0.2rem;
      }
      .steps p {
        margin: 0;
        color: var(--ink-2);
        font-size: 0.98rem;
      }

      /* ── Cards ───────────────────────────────────────────────────── */
      .cards {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: clamp(0.8rem, 1.6vw, 1.1rem);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
      }
      @media (min-width: 60rem) {
        .cards {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      .card {
        background: var(--panel);
        border: 1px solid var(--line-soft);
        border-radius: var(--r);
        padding: 1.3rem 1.25rem 1.4rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
      .card .ico {
        width: 26px;
        height: 26px;
        color: var(--c);
      }
      .card p {
        margin: 0;
        color: var(--ink-2);
        font-size: 0.97rem;
      }
      .fact {
        margin: 0.35rem 0 0;
      }
      .fact code {
        display: inline-block;
        background: var(--ground-2);
        border: 1px solid var(--line-soft);
        border-radius: 6px;
        padding: 0.16rem 0.5rem;
        font-size: 0.78rem;
        color: var(--ink-2);
        overflow-wrap: anywhere;
      }
      .deep .fact code {
        background: #22150f;
        border-color: #4b3227;
        color: var(--on-dark-2);
      }

      /* ── Formats table ───────────────────────────────────────────── */
      .table-wrap {
        overflow-x: auto;
        border: 1px solid var(--line-soft);
        border-radius: var(--r);
        background: var(--panel);
        margin-bottom: 1.4rem;
      }
      table {
        border-collapse: collapse;
        width: 100%;
        min-width: 34rem;
      }
      thead th {
        text-align: left;
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.73rem;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: var(--ink-3);
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--line);
        background: var(--ground-2);
      }
      tbody th,
      tbody td {
        text-align: left;
        font-weight: 400;
        padding: 0.85rem 1rem;
        border-bottom: 1px solid var(--line-soft);
        vertical-align: top;
        font-size: 0.96rem;
      }
      tbody tr:last-child th,
      tbody tr:last-child td {
        border-bottom: 0;
      }
      tbody th code {
        font-weight: 500;
        font-size: 0.9rem;
        color: var(--ink);
      }
      tbody td {
        color: var(--ink-2);
      }
      td.lossy {
        color: #8a3f2c;
      }
      /* Narrow screens: the table becomes one card per format, so the fidelity
         column is never the thing that scrolls out of sight. */
      @media (max-width: 46rem) {
        .table-wrap {
          overflow: visible;
          border: 0;
          background: none;
          border-radius: 0;
        }
        table {
          min-width: 0;
        }
        thead {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
        }
        tbody tr {
          display: block;
          background: var(--panel);
          border: 1px solid var(--line-soft);
          border-radius: var(--r);
          margin-bottom: 0.7rem;
          padding: 0.6rem 0.2rem 0.8rem;
        }
        tbody th,
        tbody td {
          display: block;
          border: 0;
          padding: 0.3rem 1rem;
        }
        tbody td::before {
          content: attr(data-label);
          display: block;
          font-family: var(--mono);
          font-size: 0.68rem;
          letter-spacing: 0.11em;
          text-transform: uppercase;
          color: var(--ink-3);
          margin-bottom: 0.1rem;
        }
      }
      td.lossless {
        color: #3f6030;
      }

      /* ── Trust ───────────────────────────────────────────────────── */
      .grid4 {
        list-style: none;
        margin: 0 0 clamp(2.5rem, 5vw, 4rem);
        padding: 0;
        display: grid;
        gap: 1px;
        background: #4b3227;
        border: 1px solid #4b3227;
        border-radius: var(--r);
        overflow: hidden;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      }
      .grid4 li {
        background: var(--dark-2);
        padding: 1.5rem 1.4rem 1.6rem;
      }
      .grid4 h3 {
        font-size: 1.16rem;
      }
      .grid4 p {
        margin: 0.4rem 0 0;
        color: var(--on-dark-2);
        font-size: 0.96rem;
      }
      .states {
        border-top: 1px solid #4b3227;
        padding-top: clamp(2rem, 4vw, 3rem);
      }
      .states-h {
        font-family: var(--head);
        font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem);
      }
      .states-lede {
        max-width: 58ch;
        color: var(--on-dark-2);
        margin: 0.5rem 0 1.5rem;
      }
      .state-list {
        margin: 0 0 1.4rem;
        display: grid;
        gap: 0.55rem;
      }
      .state {
        display: grid;
        gap: 0.2rem 1rem;
        align-items: baseline;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        background: var(--dark-2);
      }
      @media (min-width: 44rem) {
        .state {
          grid-template-columns: 13rem 1fr;
        }
      }
      .state.tone-good {
        --tone: #7fae5c;
      }
      .state.tone-unknown {
        --tone: var(--peach);
      }
      .state.tone-flat {
        --tone: #6f5245;
      }
      .state.tone-bad {
        --tone: #e08a72;
      }
      .state dt {
        margin: 0;
      }
      .state dt::before {
        content: '';
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        margin-right: 0.55rem;
        background: var(--tone, #8c6a59);
        vertical-align: 0.08em;
      }
      .state dt code {
        font-size: 0.9rem;
        color: var(--on-dark);
        font-weight: 500;
      }
      .state dd {
        margin: 0;
        color: var(--on-dark-2);
        font-size: 0.96rem;
      }

      /* ── Assistant ───────────────────────────────────────────────── */
      .mcp-panel {
        background: var(--panel);
        border: 1px solid var(--line-soft);
        border-radius: var(--r);
        padding: 1.4rem 1.35rem 1.5rem;
      }
      .panel-h {
        margin: 0 0 0.9rem;
        font-family: var(--mono);
        font-size: 0.73rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink-3);
      }
      .chips {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .chips li {
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35rem 0.8rem;
        font-size: 0.9rem;
        color: var(--ink-2);
        background: var(--ground);
      }

      /* ── Refusals ────────────────────────────────────────────────── */
      .refusals {
        list-style: none;
        margin: 0 0 2rem;
        padding: 0;
        display: grid;
        gap: clamp(0.8rem, 1.6vw, 1.1rem);
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
      }
      @media (min-width: 60rem) {
        .refusals {
          grid-template-columns: repeat(3, 1fr);
          gap: 1.6rem clamp(1.1rem, 2.4vw, 2rem);
        }
      }
      .refusals li {
        border-top: 3px solid var(--c);
        padding-top: 0.85rem;
      }
      .refusals h3 {
        font-size: 1.1rem;
      }
      .refusals p {
        margin: 0.25rem 0 0;
        color: var(--ink-2);
        font-size: 0.96rem;
      }
      .never {
        max-width: 70ch;
        color: var(--ink-2);
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--r);
        padding: 1.2rem 1.3rem;
        margin: 0;
      }

      /* ── Status ──────────────────────────────────────────────────── */
      .status-grid {
        display: grid;
        gap: clamp(1.6rem, 4vw, 3rem);
      }
      @media (min-width: 48rem) {
        .status-grid {
          grid-template-columns: 1fr 1fr;
        }
      }
      .col-h {
        font-family: var(--mono);
        font-size: 0.76rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        padding-bottom: 0.7rem;
        border-bottom: 1px solid var(--line);
        margin-bottom: 1rem;
      }
      .col-h.yes {
        color: #3f6030;
      }
      .col-h.no {
        color: #8a3f2c;
      }
      .ticks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.55rem;
      }
      .ticks li {
        position: relative;
        padding-left: 1.6rem;
        color: var(--ink-2);
        font-size: 0.99rem;
      }
      .ticks li::before {
        content: '✓';
        position: absolute;
        left: 0;
        color: #3f6030;
        font-weight: 600;
      }
      .ticks.minus li::before {
        content: '—';
        color: #8a3f2c;
      }

      /* ── FAQ ─────────────────────────────────────────────────────── */
      .faq {
        margin: 0;
        display: grid;
        gap: 0;
        border-top: 1px solid var(--line-soft);
      }
      .faq > div {
        display: grid;
        gap: 0.3rem 2.5rem;
        padding: 1.4rem 0;
        border-bottom: 1px solid var(--line-soft);
      }
      @media (min-width: 56rem) {
        .faq > div {
          grid-template-columns: 22rem 1fr;
        }
      }
      .faq dt {
        font-family: var(--head);
        font-weight: 500;
        font-size: 1.12rem;
        line-height: 1.3;
      }
      .faq dd {
        margin: 0;
        color: var(--ink-2);
        max-width: 64ch;
      }

      /* ── Close ───────────────────────────────────────────────────── */
      .close {
        padding-block: clamp(3.5rem, 8vw, 6.5rem);
      }
      .close-grid > div {
        max-width: 44rem;
      }
      .close h2 {
        margin-top: 1.1rem;
      }

      /* ── Footer ──────────────────────────────────────────────────── */
      .foot {
        background: var(--dark-2);
        color: var(--on-dark-2);
        padding-block: 2.4rem;
        font-size: 0.93rem;
      }
      .foot-grid {
        display: grid;
        gap: 0.55rem;
      }
      .foot p {
        margin: 0;
      }
      .foot a {
        color: var(--peach);
      }
      .foot-brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-family: var(--display);
        font-size: 1.15rem;
        color: var(--on-dark);
      }
      .foot-note {
        color: #b9948188;
        color: #bb9683;
      }

      /* ── Motion ──────────────────────────────────────────────────── */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
      @media (prefers-reduced-motion: no-preference) {
        .chest {
          animation: settle 640ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
        }
        .lid span {
          animation: wake 900ms ease-out both;
        }
        .lid span:nth-child(2) {
          animation-delay: 80ms;
        }
        .lid span:nth-child(3) {
          animation-delay: 160ms;
        }
        .lid span:nth-child(4) {
          animation-delay: 240ms;
        }
        .lid span:nth-child(5) {
          animation-delay: 320ms;
        }
        @keyframes settle {
          from {
            transform: translateY(10px);
            opacity: 0.4;
          }
        }
        @keyframes wake {
          from {
            transform: scaleY(0.2);
            transform-origin: top;
          }
        }
      }
    </style>
  </body>
</html>
