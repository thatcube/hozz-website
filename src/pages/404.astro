---
/**
 * Not found.
 *
 * It used to render in a stylesheet the rest of the site stopped using, which
 * meant the one page you reach by getting lost was the one page that did not
 * look like where you were trying to be. It now uses the same chrome and the
 * same tokens as everything else, and offers the two routes worth offering: the
 * front page, and the documentation.
 */
import '../styles/foundation.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { SITE, SURFACES } from '../data/site';

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Hozz</title>
    <meta
      name="description"
      content="That page is not here. The front page has everything there is."
    />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#f8fbfd" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/sentient-400.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <SiteHeader surface="home" path="/404" />

    <main id="main">
      <div class="lost">
        <p class="eyebrow">404</p>
        <h1>That page isn't <em>here</em>.</h1>
        <p class="lede">
          The link may be old, or the page may never have existed. The front page has everything
          there is so far, and the documentation has the detail.
        </p>
        <div class="ways">
          <a class="button primary" href="/">Back to the start</a>
          <a class="button quiet" href={SURFACES.docs.href}>Read the documentation</a>
        </div>
      </div>
    </main>

    <SiteFooter surface="home" path="/404" />

    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--air);
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--air);
        color: var(--ink);
        font-family: 'General Sans', sans-serif;
        line-height: 1.62;
        overflow-x: clip;
        -webkit-font-smoothing: antialiased;
      }

      a:focus-visible {
        outline: 3px solid var(--blue);
        outline-offset: 4px;
        border-radius: 4px;
      }

      .skip-link {
        position: fixed;
        z-index: 100;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 1rem;
        background: var(--ink);
        color: white;
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: none;
      }
    </style>

    <style>
      .lost {
        width: min(100% - var(--gutter) * 2, 44rem);
        margin-inline: auto;
        padding-block: clamp(5rem, 12vw, 9rem);
      }

      .eyebrow {
        display: inline-flex;
        gap: 0.55rem;
        align-items: center;
        margin: 0 0 1.25rem;
        color: var(--ink-muted);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.115em;
      }

      .eyebrow::before {
        content: '';
        flex: none;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--blue);
        box-shadow: 0 0 0 5px rgba(93, 140, 176, 0.1);
      }

      h1 {
        margin: 0 0 1.1rem;
        font-family: 'Sentient', Georgia, serif;
        font-size: clamp(2.6rem, 1.6rem + 3.2vw, 4rem);
        font-weight: 400;
        line-height: 1.02;
        letter-spacing: -0.042em;
      }

      h1 em {
        color: var(--blue-deep);
        font-style: italic;
      }

      .lede {
        max-width: 34rem;
        margin: 0 0 2.2rem;
        color: var(--ink-soft);
        font-size: clamp(1.08rem, 1.02rem + 0.3vw, 1.24rem);
        line-height: 1.55;
        text-wrap: pretty;
      }

      .ways {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3.2rem;
        padding: 0.8rem 1.35rem;
        border: 1px solid var(--ink);
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
      }

      .primary {
        background: var(--ink);
        color: var(--air);
      }

      .quiet {
        border-color: var(--line);
        color: var(--ink);
      }

      .quiet:hover {
        border-color: var(--blue);
      }

      @media (max-width: 520px) {
        .button {
          width: 100%;
        }
      }
    </style>
  </body>
</html>
