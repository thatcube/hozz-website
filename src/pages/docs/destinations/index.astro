---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Callout from '../../../components/docs/Callout.astro';
import Table from '../../../components/docs/Table.astro';
import { page, DOC_PAGES } from '../../../data/docs-nav';
import { DELIVERY_FORMATS, DESTINATIONS } from '../../../data/docs';

const entry = page('/docs/destinations/');

/** Pair each destination with its own page, so neither list can go stale. */
const cards = DESTINATIONS.map((destination) => ({
  ...destination,
  doc: DOC_PAGES.find((doc) => doc.href === `/docs/destinations/${destination.slug}/`)!,
}));

const formatName = (id: string) => DELIVERY_FORMATS.find((f) => f.id === id)?.name ?? id;
---

<DocsLayout page={entry} section="Destinations">
  <p>
    Each destination has its own Health types, format, cadence and queue position. Nothing leaves
    until you add and confirm one.
  </p>

  <h2>Compare destinations</h2>

  <Table
    caption="Destinations, uses and default formats"
    columns={['Destination', 'Choose it when', 'Default format']}
  >
    {
      cards.map((destination) => (
        <tr>
          <th scope="row">
            <a href={destination.doc.href}>{destination.name}</a>
          </th>
          <td>{destination.who}</td>
          <td>
            <code>{formatName(destination.defaultFormat)}</code>
          </td>
        </tr>
      ))
    }
  </Table>

  <Callout kind="note" title="If you have no strong preference, pick a folder">
    <p>
      <a href="/docs/destinations/folder/">Folder</a> needs no server, open port or VPN, and can sync
      while your computer is off.
    </p>
  </Callout>

  <h2>What every destination has</h2>

  <ul>
    <li>
      <strong>Health types.</strong> Choose what it receives.
    </li>
    <li>
      <strong>Format.</strong> See <a href="/docs/delivery-schema/">delivery schema</a>.
    </li>
    <li>
      <strong>Cadence.</strong> On arrival, hourly, daily or manual. iOS controls timing.
    </li>
    <li>
      <strong>Send a test.</strong> Sends a probe without Health data.
    </li>
    <li>
      <strong>Cursor.</strong> Advances only past accepted records.
    </li>
  </ul>

</DocsLayout>
