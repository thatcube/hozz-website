---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Callout from '../../../components/docs/Callout.astro';
import Code from '../../../components/docs/Code.astro';
import Table from '../../../components/docs/Table.astro';
import DeviceConstraints from '../../../components/docs/DeviceConstraints.astro';
import { page } from '../../../data/docs-nav';

const entry = page('/docs/destinations/influxdb/');

const lines = `health,type=heart_rate,source=Apple\\ Watch,device=Apple\\ Watch,unit=count/min value=62.5 1787433046500000000
health,type=sleep_analysis,source=Apple\\ Watch value=3.0,duration=1800.0 1787436000000000000
health_workouts,type=workout,activity=Running,source=Apple\\ Watch duration=1800.0,id="7b21c0de-0000-4000-8000-000000000001" 1787382000000000000
health_deletions,type=step_count,id=9c40c0de-0000-4000-8000-000000000002 deleted=true`;

const v2 = `POST http://influxdb.local:8086/api/v2/write?org=YOURORG&bucket=health&precision=ns
Authorization: Token YOUR_API_TOKEN
Content-Type: text/plain; charset=utf-8`;

const v1 = `POST http://influxdb.local:8086/write?db=health&precision=ns`;

const tags = [
  ['type', 'The metric name, e.g. heart_rate. workout for a workout.'],
  ['source', 'The app or device that recorded it. Omitted when unknown.'],
  ['device', 'The hardware name. Omitted when unknown.'],
  ['unit', 'HealthKit’s unit string. Omitted for types without one.'],
  ['activity', 'Workouts only — Running, Cycling, and so on.'],
];

const fields = [
  ['value', 'Float', 'Samples.'],
  ['duration', 'Float', 'Seconds. Present when the record covers an interval.'],
  ['id', 'String', 'Workouts and events, for tracing a point back to a record.'],
  ['deleted', 'Boolean', 'Tombstones.'],
];
---

<DocsLayout page={entry} section="Destinations">
  <div class="fact-strip">
    <div>
      <dt>Format</dt>
      <dd>InfluxDB line protocol</dd>
    </div>
    <div>
      <dt>Versions</dt>
      <dd>1.8, 2.x and 3.x</dd>
    </div>
    <div>
      <dt>Default measurement</dt>
      <dd><code>health</code></dd>
    </div>
  </div>

  <p>
    Hozz writes line protocol directly to InfluxDB's write endpoint.
  </p>

  <h2>Setting it up</h2>

  <ol class="steps">
    <li>
      <h3>Put the whole write URL in the address field</h3>
      <p>
        Include the query string: <code>/api/v2/write</code> with <code>org</code>,{' '}
        <code>bucket</code> and <code>precision</code>, or <code>/write?db=…</code> for 1.8.
      </p>
    </li>
    <li>
      <h3>Put the authorization value in the secret field</h3>
      <p>
        For 2.x and 3.x, enter <code>Token YOUR_API_TOKEN</code>.
      </p>
    </li>
    <li>
      <h3>Set the measurement and precision under Details</h3>
      <p>
        The measurement defaults to <code>health</code>. Match the URL's precision.
      </p>
    </li>
    <li>
      <h3>Send a test</h3>
      <p>
        The probe writes one <code>hozz_connection_test</code> point without Health data.
      </p>
    </li>
  </ol>

  <h3>InfluxDB 2.x and 3.x</h3>
  <Code caption="Address and secret" code={v2} />

  <h3>InfluxDB 1.8</h3>
  <Code caption="Address" code={v1} />

  <Callout kind="warn" title="Precision has to match, and InfluxDB will not tell you">
    <p>
      A mismatch silently files points in 1970 or the far future. Use nanoseconds unless you need
      another precision; Hozz warns when the settings disagree.
    </p>
  </Callout>

  <h2>What gets written</h2>

  <Code caption="Line protocol" code={lines} />

  <h3>Measurements</h3>

  <Table caption="Measurements and what each holds" columns={['Measurement', 'Holds']} mono>
    <tr>
      <th scope="row">health</th>
      <td>Every sample with a numeric value.</td>
    </tr>
    <tr>
      <th scope="row">health_workouts</th>
      <td>Workouts.</td>
    </tr>
    <tr>
      <th scope="row">health_events</th>
      <td>Records with no numeric value at all, such as a correlation.</td>
    </tr>
    <tr>
      <th scope="row">health_deletions</th>
      <td>Tombstones.</td>
    </tr>
  </Table>

  <p>
    <code>health</code> is the configurable part; the four suffixes follow whatever you set it to.
  </p>

  <h3>Tags</h3>

  <Table caption="Tags written on each point" columns={['Tag', 'Value']} mono>
    {
      tags.map(([tag, value]) => (
        <tr>
          <th scope="row">{tag}</th>
          <td>{value}</td>
        </tr>
      ))
    }
  </Table>

  <p>
    Tags stay low-cardinality. <strong>Record identifiers are not tags</strong>, except on deletions.
  </p>

  <h3>Fields</h3>

  <Table caption="Fields written on each point" columns={['Field', 'Type', 'Where']} mono>
    {
      fields.map(([field, type, where]) => (
        <tr>
          <th scope="row">{field}</th>
          <td>{type}</td>
          <td>{where}</td>
        </tr>
      ))
    }
  </Table>

  <h2>Limits</h2>

  <Callout kind="lossy" title="InfluxDB deduplicates, and that loses samples">
    <p>
      Measurement, tag set and timestamp identify a point. Matching samples collapse into one. Send{' '}
      <a href="/docs/delivery-schema/#ndjson">NDJSON</a> elsewhere if every sample must stay separate.
    </p>
  </Callout>

  <p>
    <strong>Deletions are recorded, not applied.</strong> Reconcile tombstones from{' '}
    <code>&lt;measurement&gt;_deletions</code>. Their ids are tags because tombstones have no source
    timestamp and would otherwise overwrite one another.
  </p>

  <p>
    Non-finite values go to <code>&lt;measurement&gt;_events</code>.
  </p>

  <DeviceConstraints />
</DocsLayout>
