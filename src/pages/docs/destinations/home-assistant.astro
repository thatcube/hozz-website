---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Callout from '../../../components/docs/Callout.astro';
import Code from '../../../components/docs/Code.astro';
import DeviceConstraints from '../../../components/docs/DeviceConstraints.astro';
import { page } from '../../../data/docs-nav';
import { COUNTS, spell } from '../../../data/docs';

const entry = page('/docs/destinations/home-assistant/');

const webhookYaml = `# configuration.yaml — or an automation created in the UI
automation:
  - alias: Receive Hozz health data
    trigger:
      - platform: webhook
        webhook_id: hozz
        allowed_methods: [POST]
        local_only: true
    action:
      - variables:
          metrics: "{{ trigger.json.data.metrics }}"`;

const payload = `{
  "data": {
    "metrics": [
      {
        "name": "heart_rate",
        "units": "count/min",
        "data": [
          {
            "date": "2026-08-22T21:10:46.500Z",
            "qty": 62.5,
            "units": "count/min",
            "source": "Apple Watch"
          }
        ]
      }
    ],
    "deletions": []
  }
}`;
---

<DocsLayout page={entry} section="Destinations">
  <div class="fact-strip">
    <div>
      <dt>Format</dt>
      <dd>Metrics JSON</dd>
    </div>
    <div>
      <dt>Underneath</dt>
      <dd>An ordinary HTTPS POST</dd>
    </div>
    <div>
      <dt>Needs</dt>
      <dd>The phone to reach your HA</dd>
    </div>
  </div>

  <p>
    Hozz posts <a href="/docs/delivery-schema/#metrics-json">Metrics JSON</a> to a webhook or REST API.
  </p>

  <h2>Setting it up</h2>

  <ol class="steps">
    <li>
      <h3>Decide: webhook or REST API</h3>
      <p>
        Webhooks need no token. The REST API needs a long-lived access token.
      </p>
    </li>
    <li>
      <h3>For a webhook, add the trigger</h3>
      <p>
        Create a webhook automation and note its ID. The placeholder is{' '}
        <code>http://homeassistant.local:8123/api/webhook/hozz</code>.
      </p>
    </li>
    <li>
      <h3>For the REST API, create a token</h3>
      <p>
        Create a long-lived token. Prefix it with <code>Bearer</code> and one space, then store the
        full value in the secret field.
      </p>
    </li>
    <li>
      <h3>Send a test</h3>
      <p>Home Assistant will show the request arriving. The probe contains no Health data.</p>
    </li>
  </ol>

  <Callout kind="warn" title="Your phone has to be able to reach the address">
    <p>
      A <code>.local</code> address works only on the same network. External addresses need TLS.
    </p>
  </Callout>

  <h2>The webhook trigger</h2>

  <Code caption="Home Assistant automation" code={webhookYaml} />

  <p>
    Keep <code>local_only: true</code> unless you intend to expose the webhook.
  </p>

  <h2>What arrives</h2>

  <Code caption="POST body — Metrics JSON" code={payload} />

  <p>
    Points use stable lowercase snake_case metric names.
  </p>

  <p>
    See <a href="/docs/delivery-schema/#metrics-json">the delivery schema</a> for the full payload shape, including the <code>deletions</code> array.
  </p>

  <h2>Coming from Health Auto Export</h2>

  <p>
    Existing automations can use an opt-in compatibility mode.{' '}
    <a href="/docs/switching-from-health-auto-export/">See its mappings and limits.</a>
  </p>

  <h2>Telling it is working</h2>

  <ul>
    <li>
      <strong>Send a test</strong> reports the response. Any <code>2xx</code> accepts.
    </li>
    <li>
      In Home Assistant, a webhook automation's trace shows the payload it received.
    </li>
    <li>
      On the phone, the destination shows <code>delivered</code> once everything staged has been
      accepted. <a href="/docs/background-sync/">The other {spell(COUNTS.deliveryStates - 1)} states</a> are all explained.
    </li>
  </ul>

  <DeviceConstraints />
</DocsLayout>
