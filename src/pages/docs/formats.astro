---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/docs/Callout.astro';
import Table from '../../components/docs/Table.astro';
import Code from '../../components/docs/Code.astro';
import { page } from '../../data/docs-nav';
import { COUNTS, DELIVERY_FORMATS, EXPORT_FORMATS, spell } from '../../data/docs';

const entry = page('/docs/formats/');

const picker = EXPORT_FORMATS.filter((format) => format.inPicker);
const engineOnly = EXPORT_FORMATS.filter((format) => !format.inPicker);

const sqliteQuery = `-- Everything that happened last Tuesday, across every type:
SELECT local_day, type, value, unit, source_name
FROM record
WHERE local_day = '2026-08-18'
ORDER BY start_date;

-- Anything the columns left out is still there:
SELECT json_extract(raw, '$.metadata.HKTimeZone.value') AS tz
FROM sample
WHERE type = 'HKQuantityTypeIdentifierStepCount'
LIMIT 5;`;

const frontMatter = `---
date: 2026-08-18
steps: 8241
sleep_hours: 7.2
workout_minutes: 42
resting_heart_rate: 54
---`;
---

<DocsLayout page={entry}>
  <p>
    <strong>Manual exports</strong> produce files. <strong>Automatic destinations</strong> receive
    batches. Their formats differ.
  </p>

  <h2>Manual export formats</h2>

  <Table
    caption="Manual export formats, what each is good for, and what each keeps"
    columns={['Format', 'File', 'Good for', 'Keeps']}
  >
    {
      picker.map((format) => (
        <tr>
          <th scope="row">
            {format.name}
            {format.lossy && <> — lossy</>}
          </th>
          <td>
            <code>.{format.fileExtension}</code>
          </td>
          <td>{format.good}</td>
          <td>{format.keeps}</td>
        </tr>
      ))
    }
  </Table>

  {
    engineOnly.map((format) => (
      <p>
        <strong>{format.name}</strong> ({format.keeps}) {format.good.toLowerCase()}
      </p>
    ))
  }

  <Callout kind="lossy" title="Three of these deliberately throw detail away">
    <p>
      <strong>CSV</strong> and <strong>Markdown</strong> flatten records. <strong>GPX</strong> keeps
      only routed workouts. The app marks all {spell(COUNTS.lossyExportFormats)} as lossy. For an
      archive, use NDJSON or SQLite.
    </p>
  </Callout>

  <h3>NDJSON — the default</h3>

  <p>
    One record per line, streamable and lossless for every encoded field.
  </p>

  <h3>SQLite — for asking questions</h3>

  <p>
    Query it in Datasette, DuckDB, pandas, Grafana or <code>sqlite3</code>. Time-shaped data uses one
    wide <code>sample</code> table for cross-type queries.
  </p>

  <p>
    Workouts, deletions and characteristics have separate tables. <code>record</code> and{' '}
    <code>daily</code> views provide common timelines and aggregates.
  </p>

  <Code caption="Querying an export" code={sqliteQuery} />

  <p>
    <strong>SQLite is lossless:</strong> every row keeps the original export line in <code>raw</code>.
    <code>meta</code> records scope, run time and the time zone used for <code>local_day</code>.
  </p>

  <h3>CSV — for spreadsheets</h3>

  <p>
    One CSV per Health type, plus deletion and export-log files when needed. Opens in Excel, Numbers
    or Sheets.
  </p>

  <p>
    <strong>Lossy.</strong> Metadata and nested workout details are omitted.
  </p>

  <h3>Markdown — for Obsidian and journals</h3>

  <p>
    One <code>YYYY-MM-DD.md</code> note per day, each carrying YAML front matter that Dataview can
    query, then the day in prose and small tables.
  </p>

  <Code caption="Front matter on a daily note" code={frontMatter} />

  <p>
    <strong>Lossy.</strong> Notes keep daily counts, totals and extremes, not records, metadata,
    sources, devices or sample identifiers.
  </p>

  <p>
    Days are local days, and sleep is filed under the day it <em>ended</em>, because last night's
    sleep belongs to the morning you woke up.
  </p>

  <h3>GPX — for maps</h3>

  <p>
    One GPX 1.1 track per routed workout. <strong>GPX excludes all other Health data.</strong> A
    workout without GPS produces no file.
  </p>

  <Callout kind="note" title="Gaps in a route are shown as gaps">
    <p>
      Missing route pages split <code>&lt;trkseg&gt;</code>. The track description and archive
      README record each gap.
    </p>
    <p>
      Speed, course and accuracy use Hozz <code>&lt;extensions&gt;</code>.
    </p>
  </Callout>

  <h2>Delivery formats</h2>

  <p>
    Automatic destinations use five formats. See the <a href="/docs/delivery-schema/"
      >delivery schema</a
    > for fields and examples.
  </p>

  <Table
    caption="Delivery formats and what each keeps"
    columns={['Format', 'Media type', 'Notes']}
  >
    {
      DELIVERY_FORMATS.map((format) => (
        <tr>
          <th scope="row">
            {format.name}
            {!format.lossless && <> — lossy</>}
          </th>
          <td>
            <code>{format.contentType}</code>
          </td>
          <td>{format.note}</td>
        </tr>
      ))
    }
  </Table>

  <h3>No SQLite or Markdown delivery</h3>

  <p>
    SQLite files cannot append over HTTP. Batch-sized Markdown rewrites would replace complete days.
  </p>

  <h3>No line protocol for folders</h3>

  <p>
    The Mac app ingests <code>ndjson</code>, <code>json</code>, Metrics JSON and{' '}
    <code>csv</code> from folders.
  </p>
</DocsLayout>
