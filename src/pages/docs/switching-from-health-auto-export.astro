---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Callout from '../../components/docs/Callout.astro';
import Code from '../../components/docs/Code.astro';
import Table from '../../components/docs/Table.astro';
import { page } from '../../data/docs-nav';

const entry = page('/docs/switching-from-health-auto-export/');

const compat = `{
  "data": {
    "metrics": [
      {
        "name": "heart_rate",
        "units": "bpm",
        "data": [
          {
            "date": "2026-02-06 14:30:00 -0800",
            "Min": 62,
            "Avg": 62,
            "Max": 62,
            "source": "Apple Watch"
          }
        ]
      },
      {
        "name": "sleep_analysis",
        "units": "hr",
        "data": [
          {
            "startDate": "2026-02-05 23:00:00 -0800",
            "endDate": "2026-02-06 00:30:00 -0800",
            "qty": 1.5,
            "value": "Core",
            "source": "Apple Watch"
          }
        ]
      }
    ],
    "workouts": [
      {
        "id": "7b21…",
        "name": "Running",
        "start": "2026-02-06 07:00:00 -0800",
        "end": "2026-02-06 07:30:00 -0800",
        "duration": 1800
      }
    ]
  }
}`;

const differences = [
  [
    'Date format',
    '2026-02-06T22:30:00.000Z',
    '2026-02-06 14:30:00 -0800 — local time, space separated, numeric offset, not ISO 8601',
  ],
  ['Heart rate points', 'qty', 'Min, Avg, Max — capitalised, with no qty'],
  ['Heart rate units', 'count/min', 'bpm'],
  [
    'Sleep points',
    'date, qty as a raw stage number',
    'startDate, endDate, qty in hours, value as a stage name',
  ],
  ['Sleep units', 'count', 'hr'],
  ['Sleep stage', '0–5', 'In Bed, Asleep, Awake, Core, Deep, REM'],
  ['Workout name', 'Workout', 'The activity, e.g. Running'],
  ['Workout duration', 'absent', 'Seconds'],
  ['Per-point units', 'present', 'absent'],
];
---

<DocsLayout page={entry}>
  <p>
    <strong>Compatibility mode</strong> keeps existing field names for{' '}
    <a href="/docs/destinations/home-assistant/">Home Assistant</a>,{' '}
    <a href="/docs/destinations/mqtt/">MQTT</a> and{' '}
    <a href="/docs/destinations/web/">web address</a> destinations using Metrics JSON.
  </p>

  <Callout kind="note" title="Hozz’s own schema stays the default">
    <p>
      Use it for existing automations. New receivers should use{' '}
      <a href="/docs/delivery-schema/#metrics-json">Hozz's own Metrics JSON</a>, which is more
      precise about intervals and carries deletions.
    </p>
  </Callout>

  <h2>What maps to what</h2>

  <Table
    caption="Field differences between Hozz’s schema and compatibility mode"
    columns={['', 'Hozz', 'Compatibility mode']}
  >
    {
      differences.map(([label, hozz, compatible]) => (
        <tr>
          <th scope="row">{label}</th>
          <td>
            <code>{hozz}</code>
          </td>
          <td>
            <code>{compatible}</code>
          </td>
        </tr>
      ))
    }
  </Table>

  <Code caption="A compatibility-mode payload" code={compat} />

  <h2>What this mode does not claim</h2>

  <p>
    Field renaming cannot remove these differences.
  </p>

  <h3>A heart rate point carries the same number three times</h3>

  <p>
    Hozz sends <strong>individual samples, not rollups</strong>. Each heart-rate point repeats its
    value in <code>Min</code>, <code>Avg</code> and <code>Max</code>. Aggregated sleep is absent.
  </p>

  <p>
    Automations that require differing <code>Min</code> and <code>Max</code> will not work.
  </p>

  <h3>Blood pressure stays split</h3>

  <p>
    Hozz sends systolic and diastolic as separate metrics. It does not guess pairings.
  </p>

  <h3>Metadata-derived point fields are not emitted</h3>

  <p>
    Metadata-derived fields such as <code>mealTime</code> and <code>reason</code> are absent.
  </p>

  <h3>Deletions are still included</h3>

  <p>
    Hozz adds a <code>deletions</code> key. Existing consumers may ignore it.
  </p>

  <h2>Compatibility boundary</h2>

  <p>
    Hozz matches the published{' '}
    <code>data.metrics[].{'{'}name, units, data{'}'}</code> envelope, the{' '}
    <code>yyyy-MM-dd HH:mm:ss Z</code> timestamp, <code>qty</code>, the capitalised{' '}
    <code>Min</code>/<code>Avg</code>/<code>Max</code>, and the sleep point's{' '}
    <code>startDate</code>/<code>endDate</code>/<code>value</code>.
  </p>

  <p>
    <strong>Undocumented behaviour is not covered.</strong> Test any dependency on it.
  </p>

  <h2>Running both at once</h2>

  <p>
    Run Hozz beside the existing exporter and compare separate destinations before switching.
  </p>
</DocsLayout>
