---
/**
 * Sketch C — "Quiet"
 *
 * Thesis: an app that handles your health records should look like it has
 * nothing to sell, so the page is almost entirely type. No cards, no tiles, no
 * panels — statements set large enough to be read as claims you could hold
 * someone to.
 *
 * The spectrum appears exactly once, as a hairline the width of the page, and it
 * is the only colour in the design. Everything the Health app does with fourteen
 * gradients, this does with one rule and a lot of restraint.
 */
import SketchLayout from '../../layouts/SketchLayout.astro';
import { HEALTH_CATEGORIES } from '../../data/health';
import { GITHUB_URL } from '../../data/site';

const CLAIMS = [
  {
    lead: 'There is no server of mine',
    rest: 'in the middle of this. No relay, no database, nothing to breach and nothing to subpoena.',
    cat: 'heart',
  },
  {
    lead: 'There is no account',
    rest: 'to make, because there is nothing to make one on. The app never asks who you are.',
    cat: 'activity',
  },
  {
    lead: 'There is no paid tier',
    rest: 'coming later. Hozz has nothing to upsell, so it has no reason to hold anything back.',
    cat: 'nutrition',
  },
  {
    lead: 'And it will never claim',
    rest: 'it got everything, because Apple will not let it know whether it did.',
    cat: 'other',
  },
];

const stops = HEALTH_CATEGORIES.map(
  (c, i) => `${c.to} ${(i / HEALTH_CATEGORIES.length) * 100}% ${((i + 1) / HEALTH_CATEGORIES.length) * 100}%`,
).join(', ');
---

<SketchLayout title="Sketch C — Quiet · Hozz" letter="C" name="Quiet">
  <main>
    <header>
      <p class="mark">Hozz</p>
      <h1>
        Your health data is the most detailed record anyone holds about you.
        <span>You should have a copy.</span>
      </h1>
      <p class="stand">
        A free, open-source app for iPhone and iPad that copies what Apple Health
        knows about you into a file you keep, or onto a server you run.
      </p>
    </header>

    <!-- The only colour on the page, and it is the fourteen Health categories in
         the order Apple lists them. -->
    <div class="spectrum" style={`--stops: ${stops}`} aria-hidden="true"></div>
    <p class="legend">
      Fourteen categories. Every one of them in scope, not a curated handful.
    </p>

    <section class="claims">
      {
        CLAIMS.map((c) => (
          <p class="claim" style={`--hue: var(--h-${c.cat})`}>
            <b>{c.lead}</b> {c.rest}
          </p>
        ))
      }
    </section>

    <footer>
      <p>Pre-alpha. Nothing to install yet.</p>
      <a href={GITHUB_URL} rel="noopener">github.com/thatcube/hozz</a>
    </footer>
  </main>
</SketchLayout>

<style>
  body {
    background: #f2f2f7;
    color: #0b0b0d;
  }

  main {
    width: min(100% - 2.5rem, 940px);
    margin-inline: auto;
    padding-block: clamp(3.5rem, 9vw, 8rem) 6rem;
  }

  .mark {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: clamp(3rem, 8vw, 6rem);
  }

  h1 {
    font-size: clamp(1.9rem, 1rem + 3.6vw, 3.5rem);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.038em;
    text-wrap: pretty;
    max-width: 22ch;
  }

  /* The second sentence is the one that asks something of you, so it is the one
     set apart. */
  h1 span {
    display: block;
    margin-top: 0.5em;
    font-weight: 800;
  }

  .stand {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    max-width: 52ch;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    letter-spacing: -0.012em;
    color: #46454c;
  }

  .spectrum {
    margin-top: clamp(4rem, 10vw, 8rem);
    block-size: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--stops));
  }

  .legend {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    color: #55545c;
  }

  /* ── Claims ───────────────────────────────────────────────────────────── */
  .claims {
    margin-top: clamp(4rem, 10vw, 8rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3.25rem);
  }

  .claim {
    font-size: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.03em;
    text-wrap: pretty;
    max-width: 30ch;
    color: #46454c;
  }

  /* One phrase per claim carries the hue, and it is always the phrase you would
     hold me to. Category hues are built for a screen rather than for body copy,
     so each is taken down until it reads cleanly on the grey. */
  .claim b {
    font-weight: 800;
    color: color-mix(in oklab, var(--hue) 62%, #05050a);
  }

  footer {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-top: 1.25rem;
    border-top: 1px solid #d7d7de;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    font-size: 0.9375rem;
    color: #55545c;
  }

  footer a {
    font-weight: 600;
    color: #0b0b0d;
    text-decoration: none;
    border-bottom: 1px solid #b9b8c2;
  }

  footer a:hover {
    border-bottom-color: #0b0b0d;
  }
</style>
