---
import SketchLayout from '../../layouts/SketchLayout.astro';
import '../../styles/sketch-y.css';

const destinations = [
  {
    name: 'Your Mac',
    detail: 'The companion Mac app catches batches over your local network and files them away.',
    mono: 'NDJSON · token auth · Bonjour _hozz._tcp · port 54330',
  },
  {
    name: 'Folder',
    detail: 'Any folder in Files — iCloud Drive, Dropbox, OneDrive, Google Drive, an SMB share, or on-device.',
    mono: 'Files picker',
  },
  {
    name: 'Home Assistant',
    detail: 'Your readings become entities in the dashboard you already run.',
    mono: 'Metrics JSON · webhook or REST',
  },
  {
    name: 'Web address',
    detail: 'POST straight to an endpoint you control. Retries are safe.',
    mono: 'NDJSON / JSON / CSV / Metrics JSON · Idempotency-Key',
  },
  {
    name: 'MQTT',
    detail: 'Publish to your own broker. Anything already listening on a topic gets it.',
    mono: 'MQTT 3.1.1 · mqtt:// or mqtts:// · retained, QoS 0',
  },
];

const faq = [
  {
    q: 'How do I export my Apple Health data?',
    a: 'Install Hozz on your iPhone, add a destination you control — your Mac, a folder in Files, or a URL — choose which Health types to send, run a test export to confirm it arrived, then pick a schedule. Hozz sends new records from then on, automatically.',
  },
  {
    q: 'Does my Health data go through anyone else’s server?',
    a: 'No. Hozz has no account, no hosted relay and no default destination. Nothing leaves the phone until you add a destination and confirm it.',
  },
  {
    q: 'What format does Hozz export Apple Health data in?',
    a: 'NDJSON by default, plus JSON, CSV and Metrics JSON. CSV is lossy on purpose — metadata and nested workout detail do not fit a grid. Encoding is deterministic, so output is byte-identical regardless of locale or time zone.',
  },
  {
    q: 'Can an export miss records?',
    a: 'Hozz keeps an opaque per-type anchor using HKAnchoredObjectQuery and only advances it once records are durably staged, so there are no date-window watermarks. An interruption can repeat work, but it cannot skip records.',
  },
];

// machine names stay in mono, even inside prose
const IDENT = /(HKAnchoredObjectQuery|Idempotency-Key|NDJSON|Metrics JSON|MQTT|CSV|JSON)/g;
const parts = (t: string) => t.split(IDENT);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      description:
        'Free, open-source app that exports Apple Health data to destinations you own: a Mac on your local network, a folder, Home Assistant, your own web endpoint, or an MQTT broker.',
      license: 'https://www.gnu.org/licenses/gpl-3.0.html',
      isAccessibleForFree: true,
      author: { '@type': 'Person', name: 'Brandon Moore' },
      codeRepository: 'https://github.com/thatcube/hozz',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'Automatic export of new Apple Health records on a schedule you choose',
        'NDJSON, JSON, CSV and Metrics JSON output',
        'Deletions carried as tombstones',
        'Resumable manual export with durable checkpoints',
        'Read-only MCP server for assistants',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<SketchLayout title="Sketch Y — Throughline · Hozz" letter="Y" name="Throughline">
  <main class="y">
    <div class="y-wrap">
      <div class="rail" aria-hidden="true"><span class="rail-ink"></span></div>

      <!-- ------------------------------------------------------------ hero -->
      <header class="hero">
        <span class="node" data-i="01" aria-hidden="true"></span>
        <div class="hero-grid">
          <div>
            <p class="eyebrow"><i></i> Hozz · iPhone &amp; Mac · GPL-3.0</p>
            <h1>Export Apple&nbsp;Health <br />to somewhere <span class="em">you own</span>.</h1>
            <p class="lede">
              Your Health data lives on exactly one device. Hozz makes a second copy — in a
              file, on a machine, in a format that is yours.
            </p>
            <div class="cta">
              <a class="btn btn-a" href="https://github.com/thatcube/hozz">
                Get Hozz on GitHub
                <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"
                  ><path d="M3 10L10 3M10 3H4.4M10 3v5.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg
                >
              </a>
              <a class="btn btn-b" href="https://github.com/sponsors/thatcube">Sponsor the work</a>
            </div>
            <p class="alpha"><b>Early alpha</b> <span>It works. Coverage is still partial.</span></p>
          </div>

          <figure class="fig reveal">
            <svg class="dia-wide" viewBox="0 0 560 336" role="img"
              aria-label="Diagram: Apple Health records on your iPhone fan out along five dotted routes to Your Mac, a Folder, Home Assistant, a Web address, and MQTT.">
