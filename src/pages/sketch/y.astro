              <path class="guide" style="animation-delay:-0.3s" d="M154 157 C 240 157, 252 97, 352 97" />
              <path class="guide" style="animation-delay:-0.6s" d="M154 168 C 240 168, 252 163, 352 163" />
              <path class="guide" style="animation-delay:-0.9s" d="M154 179 C 240 179, 252 229, 352 229" />
              <path class="guide" style="animation-delay:-1.2s" d="M154 190 C 240 190, 252 295, 352 295" />

              <g>
                <rect class="hair" x="352" y="10" width="206" height="42" rx="21" fill="#fff" />
                <text class="lbl" x="374" y="36">Your Mac</text>
                <text class="lbl-r" x="536" y="36">local network</text>
                <rect class="hair" x="352" y="76" width="206" height="42" rx="21" fill="#fff" />
                <text class="lbl" x="374" y="102">Folder</text>
                <text class="lbl-r" x="536" y="102">Files</text>
                <rect class="hair" x="352" y="142" width="206" height="42" rx="21" fill="#fff" />
                <text class="lbl" x="374" y="168">Home Assistant</text>
                <text class="lbl-r" x="536" y="168">webhook / REST</text>
                <rect class="hair" x="352" y="208" width="206" height="42" rx="21" fill="#fff" />
                <text class="lbl" x="374" y="234">Web address</text>
                <text class="lbl-r" x="536" y="234">POST</text>
