---
/**
 * Sketch K — "Cut sheet".
 *
 * Subject: what you actually get out, and the honest admission that CSV loses
 * information. The idea is that the comparison is not illustrated, it is built:
 * the CSV card is genuinely shorter than the NDJSON and JSON cards because it
 * carries fewer field groups. Height is the chart.
 */
import SketchLayout from '../../layouts/SketchLayout.astro';
import '../../styles/sketch-k.css';
import { GITHUB_URL, LICENSE_URL } from '../../data/site';

type Field = { name: string; note: string };

const fields: Field[] = [
  { name: 'type', note: 'identifier' },
  { name: 'value · unit', note: 'quantity' },
  { name: 'startDate · endDate', note: 'interval' },
  { name: 'sourceName', note: 'provenance' },
  { name: 'uuid', note: 'identity' },
  { name: 'metadata', note: 'dictionary' },
  { name: 'workout · activities', note: 'nested' },
  { name: 'workout · events', note: 'nested' },
  { name: 'deleted', note: 'tombstone' },
];

const cutInCsv = new Set(['metadata', 'workout · activities', 'workout · events']);
---

<SketchLayout title="Sketch K — Cut sheet · Hozz" letter="K" name="Cut sheet">
  <main class="k">
    <div class="k-inner">
      <header class="k-strip">
        <b>hozz</b>
        <span>what comes out · export formats</span>
        <span class="k-alpha"><i aria-hidden="true"></i> early alpha · partial coverage</span>
      </header>

      <section class="k-hero" aria-labelledby="k-title">
        <p class="k-eyebrow">The artefact, not the promise</p>
        <h1 class="k-h1" id="k-title">
          one record.<br />
          three containers.<br />
          one of them <em>forgets.</em>
        </h1>

        <div class="k-hero-row">
          <p class="k-lede">
            Hozz writes Apple Health data to files you own — nothing leaves the iPhone until you add
            a destination and confirm it. So the only question left is what actually lands on disk.{' '}
            <strong>Including the format that throws part of it away.</strong>
          </p>

          <figure class="k-artefact">
          <div class="k-artefact-head">
            <span>export.ndjson · line 1 of many</span>
            <span>example</span>
          </div>
          <pre><code>&#123;<span class="k-key">"type"</span>: <span class="k-type">"heartRate"</span>, <span class="k-key">"value"</span>: <span class="k-num">58</span>, <span class="k-key">"unit"</span>: <span class="k-str">"count/min"</span>, <span class="k-key">"startDate"</span>: <span class="k-str">"2026-03-11T07:02:14Z"</span>, <span class="k-key">"endDate"</span>: <span class="k-str">"2026-03-11T07:02:14Z"</span>, <span class="k-key">"sourceName"</span>: <span class="k-str">"Apple Watch"</span>, <span class="k-key">"metadata"</span>: &#123;<span class="k-key">"HKMetadataKeyHeartRateMotionContext"</span>: <span class="k-num">1</span>&#125;&#125;</code></pre>
          <figcaption>
            One line, one record, newline-delimited. The values are an illustration; the field and
            type names are HealthKit's own. Read it with <code>jq</code>, a spreadsheet, or your own
            twenty-line script — that is the whole point of the format.
          </figcaption>
          </figure>
        </div>
      </section>

      <section aria-labelledby="k-sheet">
        <div class="k-sheet-head">
          <h2 class="k-h2" id="k-sheet">a grid has <em>columns.</em><br />three of these are not columns.</h2>
          <p class="k-sheet-note">
            The field groups below are named the way HealthKit names them. NDJSON and JSON hold all
            nine. CSV is a spreadsheet, and a spreadsheet has no cell shaped like a nested
            dictionary.
          </p>
        </div>

        <div class="k-cols">
          <div class="k-col-wrap"><article class="k-col k-col--default">
            <div class="k-col-head">
              <h3>ndjson</h3>
              <span class="k-ext">.zip → .ndjson</span>
            </div>
            <p class="k-col-sub">
              One record per line. Streamable, resumable, and lossless for the fields Hozz currently
              encodes.
            </p>
            <span class="k-badge">Default</span>
            <ul class="k-fields">
              {fields.map((f) => (
                <li><b>{f.name}</b><i>{f.note}</i></li>
              ))}
            </ul>
            <p class="k-col-foot">
              Also available raw and un-zipped, as a plain <code>.ndjson</code> you can pipe straight
              into something else.
            </p>
          </article></div>

          <div class="k-col-wrap"><article class="k-col">
            <div class="k-col-head">
              <h3>json</h3>
              <span class="k-ext">.zip → .json</span>
            </div>
            <p class="k-col-sub">
              A single JSON array. Convenient for smaller exports and for tools that expect one JSON
              value rather than a stream.
            </p>
            <span class="k-badge k-badge--ghost">Same facts</span>
            <ul class="k-fields">
              {fields.map((f) => (
                <li><b>{f.name}</b><i>{f.note}</i></li>
              ))}
            </ul>
            <p class="k-col-foot">
              Identical content to NDJSON, wrapped in brackets instead of newlines.
            </p>
          </article></div>

          <div class="k-col-wrap"><article class="k-col k-col--cut">
            <div class="k-col-head">
              <h3>csv</h3>
              <span class="k-ext">.zip → many .csv</span>
            </div>
            <p class="k-col-sub">
              One file per Health type, plus deletions and an export log. Opens in a spreadsheet
              without you writing anything.
            </p>
            <span class="k-badge k-badge--ghost">Lossy — on purpose</span>
            <ul class="k-fields">
              {fields.map((f) =>
                cutInCsv.has(f.name) ? (
                  <li class="k-gone"><b>{f.name}</b><i>no column</i></li>
                ) : (
                  <li>
                    <b>{f.name}</b>
                    <i>{f.name === 'deleted' ? 'own file' : f.note}</i>
                  </li>
                ),
              )}
            </ul>
          </article></div>
        </div>

        <div class="k-measure">
          <b>Read the height ↑</b>
          <p>
            <span class="k-strong">This card is cut off, not finished, and it ends before the other
            two.</span>{' '}<code>metadata</code>, <code>workout.activities</code> and{' '}
            <code>workout.events</code> are drawn at the size of the hole they leave — six of nine
            groups carried. Most products let you find that out months later, in a file you had
            already trusted. Pick CSV knowing the price, or pick NDJSON and lose nothing.
          </p>
        </div>
      </section>

      <section class="k-notes" aria-label="Three things the format does on your behalf">
        <article class="k-note">
          <h3>deletions <em>arrive too</em></h3>
          <p>
            If you removed a record in Health, the export says so — a tombstone travels alongside the
            data instead of the record silently not being there.
          </p>
          <div class="k-tomb">
            &#123;<span class="k-key">"uuid"</span>: "…", <span class="k-key">"deleted"</span>:
            <span class="k-true"> true</span>&#125;
          </div>
        </article>

        <article class="k-note">
          <h3>the spool is the <em>real</em> format</h3>
          <p>
            Every manual export is assembled from one canonical NDJSON spool, because a spool streams,
            survives interruption, and can be packaged without recompressing. The format you picked is
            produced from it at the end.
          </p>
          <div class="k-spool" aria-hidden="true">
            <span>&#123;"type":"stepCount","value":812,"startDate":"2026-03-11T06:00:00Z"&#125;</span>
            <span>&#123;"type":"sleepAnalysis","value":"asleepCore","startDate":"2026-03-1</span>
            <span>&#123;"type":"restingHeartRate","value":52,"unit":"count/min","startDat</span>
            <span>&#123;"type":"dietaryProtein","value":18.4,"unit":"g","startDate":"2026</span>
            <span>&#123;"type":"walkingSpeed","value":1.31,"unit":"m/s",</span>
          </div>
        </article>

        <article class="k-note">
          <h3>the same bytes, <em>twice</em></h3>
          <p>
            Encoding is deterministic. The same records produce byte-identical output regardless of
            your locale or time zone, so two exports can be diffed against each other and the
            difference means something.
          </p>
          <div class="k-spool k-spool--diff" aria-hidden="true">
            <span>$ diff monday.ndjson monday-again.ndjson</span>
            <span>$ </span>
          </div>
        </article>
      </section>

      <footer class="k-foot">
        <div>
          <p class="k-foot-lead">
            Automatic destinations choose a delivery format — NDJSON, JSON, CSV, or <em>Metrics
            JSON</em>, which groups points by metric name for Home Assistant, MQTT and dashboards.
          </p>
          <p style="margin-top: 0.9rem">
            Exported today: quantity samples, category samples, workout records, historical
            deletions. Catalogued but <strong>not</strong> claimed as coverage: correlations, routes,
            ECG, audiograms, series, characteristics, documents, scored assessments, clinical
            records. It works; it is not finished.
          </p>
        </div>
        <p class="k-meta">
          Free · open source ·{' '}
          <a class="k-link" href={LICENSE_URL} rel="noopener">GPL-3.0 + App Store exception</a><br />
          No account · no analytics · no hosted relay<br />
          iPhone app with a companion Mac app<br />
          By Brandon Moore<br />
          <a class="k-link" href={GITHUB_URL} rel="noopener">Read the exporter yourself ↗</a>
        </p>
      </footer>
    </div>
  </main>
</SketchLayout>
