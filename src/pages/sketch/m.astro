---
/**
 * Sketch M — "Received"
 *
 * Thesis: the Mac app is not a dashboard and not a cloud. It is a local
 * receiver that ends as a plain SQLite file on a machine you own. The page
 * leads with that file, then shows how the phone finds the desk without typing
 * an address — Bonjour, iCloud Keychain, private /24 sweep — and what the
 * receiver will admit in its activity log (events, never sample values).
 *
 * No mocked Mac UI. Real artefacts only: service type, port, path, schema.
 */
import SketchLayout from '../../layouts/SketchLayout.astro';
import '../../styles/sketch-m.css';

const GITHUB = 'https://github.com/thatcube/hozz';

const FIND = [
  {
    n: '01',
    title: 'Bonjour first',
    body: 'Hozz looks for _hozz._tcp on your local network. No hostname to type.',
    code: 'service: _hozz._tcp\nport:   54330',
  },
  {
    n: '02',
    title: 'Your Keychain',
    body: 'Your iCloud Keychain shares receiver details between devices on the same Apple ID.',
    code: 'token via Keychain\naccess group · same Apple ID',
  },
  {
    n: '03',
    title: 'Local fallback',
    body: 'If Bonjour misses, Hozz checks the local /24 on port 54330. Dead addresses stay offline.',
    code: 'probe before reuse\noffline ≠ remembered',
  },
];

const LISTENER = [
  { k: 'Transport', v: 'NWListener · HTTP' },
  { k: 'Advertise', v: '_hozz._tcp' },
  { k: 'Default port', v: '54330' },
  { k: 'Pair', v: '/pair · no token required' },
  { k: 'Deliver', v: 'token required' },
  { k: 'Store', v: 'hozz-received.sqlite' },
  { k: 'Folder watch', v: 'NDJSON · JSON · CSV · Metrics JSON' },
  { k: 'Cloud path', v: 'none · local network only' },
];

const DESTINATIONS = [
  { name: 'Your Mac', detail: 'SQLite over your LAN' },
  { name: 'Files', detail: 'Any folder in the Files picker' },
  { name: 'Your server', detail: 'HTTPS endpoint you run' },
  { name: 'MQTT', detail: 'A broker you choose' },
  { name: 'Home Assistant', detail: 'Metrics to your home' },
];

const FORMATS = ['NDJSON', 'JSON', 'CSV', 'Metrics JSON'];

const LOG = [
  { t: '14:02:11', tag: 'accepted', kind: 'ok', msg: 'batch received · types listed, values not logged' },
  { t: '14:02:11', tag: 'duplicate', kind: 'dup', msg: 'identical batch hash · skipped' },
  { t: '13:58:44', tag: 'paired', kind: 'pair', msg: 'new device · token issued on Mac' },
  { t: '13:41:02', tag: 'test', kind: 'test', msg: 'connectivity probe · no samples written' },
  { t: '13:40:55', tag: 'rejected', kind: 'rej', msg: 'missing or stale token' },
];

const FAQ_ANSWER =
  'Install Hozz on your iPhone, choose the Apple Health types to export, then add a destination you control: the companion Mac app, a folder in Files, your HTTPS endpoint, MQTT, or Home Assistant. Send a test batch, then choose manual, on-arrival, hourly, or daily delivery. New records continue from the last durable checkpoint. Nothing leaves your phone until you confirm a destination.';

const STRUCTURED_DATA = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Hozz',
      applicationCategory: 'HealthApplication',
      operatingSystem: 'iOS, macOS',
      description:
        'Open-source Apple Health export software that sends data from your iPhone to destinations you control.',
      url: GITHUB,
      codeRepository: GITHUB,
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I export my Apple Health data?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: FAQ_ANSWER,
          },
        },
      ],
    },
  ],
};
---

<SketchLayout title="Sketch M — Received · Hozz" letter="M" name="Received">
  <script type="application/ld+json" set:html={JSON.stringify(STRUCTURED_DATA)} />
  <main class="m">
    <header class="m-bar">
      <a class="m-word" href="#top" id="top">Hozz</a>
      <nav class="m-bar-meta" aria-label="Page">
        <a href="#export">Export</a>
        <a href="#find">Discovery</a>
        <a href="#start">Start</a>
        <span>Mac receiver · early alpha</span>
      </nav>
    </header>

    <section class="m-hero" aria-labelledby="m-title">
      <div class="m-hero-copy m-reveal">
        <p class="m-kicker"><i aria-hidden="true"></i> Listening on your desk</p>
        <h1 class="m-title" id="m-title">Your history,<br /><em>received</em> —<br />not uploaded.</h1>
        <p class="m-lede">
          Hozz copies Apple Health data from your iPhone to a Mac you own.
          It arrives as SQLite. <strong>No relay. No Hozz account.</strong>
        </p>
        <div class="m-actions">
          <a class="m-button is-primary" href="#start">How to start</a>
          <a class="m-button" href={GITHUB}>See the source</a>
        </div>
      </div>

      <aside class="m-file m-reveal" aria-label="The file the Mac app writes">
        <div class="m-file-top">
          <span class="m-file-kind">Local database</span>
          <span class="m-file-state">on this Mac only</span>
        </div>
        <p class="m-file-name">hozz-received.sqlite</p>
        <dl class="m-file-grid">
          <div>
            <dt>Engine</dt>
            <dd>SQLite</dd>
          </div>
          <div>
            <dt>Owner</dt>
            <dd>your user account</dd>
          </div>
          <div>
            <dt>Network default</dt>
            <dd>none</dd>
          </div>
          <div>
            <dt>Hosted copy</dt>
            <dd>does not exist</dd>
          </div>
        </dl>
        <p class="m-file-note">
          Open it with SQLite tools. Browse it on the Mac, or export a type as CSV.
        </p>
      </aside>
    </section>

    <section class="m-export m-reveal" id="export" aria-labelledby="export-title">
      <div class="m-export-copy">
        <p class="m-kicker">On the phone</p>
        <h2 id="export-title">Export Health. Keep the route yours.</h2>
        <p>
          Choose Health types once. Hozz sends new records on your schedule and resumes
          from its last checkpoint.
        </p>
        <ul class="m-formats" aria-label="Export formats">
          {FORMATS.map((format) => <li>{format}</li>)}
        </ul>
        <p class="m-format-note">NDJSON is the faithful default. CSV is intentionally flat.</p>
      </div>

      <figure class="m-route" aria-labelledby="route-caption">
        <svg viewBox="0 0 320 160" role="img" aria-label="Apple Health travels directly from your iPhone to destinations you control">
          <path class="m-route-line" pathLength="1" d="M30 80 C62 80 64 30 130 30 H290 M130 30 C110 30 110 80 90 80 M90 80 C110 80 110 130 130 130 H290" />
          <circle class="m-route-dot" r="4" />
          <circle class="m-route-node" cx="30" cy="80" r="18" />
          <circle class="m-route-node" cx="90" cy="80" r="18" />
          <circle class="m-route-node" cx="290" cy="30" r="18" />
          <circle class="m-route-node" cx="290" cy="130" r="18" />
          <text x="30" y="84" text-anchor="middle">Health</text>
          <text x="90" y="84" text-anchor="middle">Hozz</text>
          <text x="290" y="34" text-anchor="middle">Mac</text>
          <text x="290" y="134" text-anchor="middle">Yours</text>
        </svg>
        <figcaption id="route-caption">Direct routes. Hozz hosts no middle.</figcaption>
        <ul class="m-destinations">
          {DESTINATIONS.map((destination) => (
            <li>
              <strong>{destination.name}</strong>
              <span>{destination.detail}</span>
            </li>
          ))}
        </ul>
      </figure>
    </section>

    <section class="m-section m-reveal" id="find" aria-labelledby="find-title">
      <div class="m-section-head">
        <h2 id="find-title">How the phone finds the desk</h2>
        <p>No IP address to type. Three local paths, in order.</p>
      </div>
      <div class="m-find-grid">
      <ol class="m-spine">
        {
          FIND.map((s) => (
            <li class="m-step">
              <span class="m-step-num">Step {s.n}</span>
              <h3>{s.title}</h3>
              <div class="m-step-body">
                <p>{s.body}</p>
                <pre class="m-code">{s.code}</pre>
              </div>
            </li>
          ))
        }
      </ol>
      <aside class="m-beacon" aria-label="Local service advertisement">
        <p class="m-beacon-label">Advertised service</p>
        <p class="m-beacon-svc">_hozz._tcp</p>
        <p class="m-beacon-port"><span>port</span> 54330</p>
        <p class="m-beacon-note">The Mac advertises. Your phone listens.</p>
      </aside>
      </div>
    </section>

    <section class="m-rails m-reveal" aria-label="Receiver contract and activity log">
      <div class="m-rail">
        <h2>Receiver contract</h2>
        <p>
          The real transport. Folder watch also accepts batches from a synced folder.
        </p>
        <dl class="m-props">
          {
            LISTENER.map((row) => (
              <div class="m-prop">
                <dt>{row.k}</dt>
                <dd>{row.v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="m-rail">
        <h2>Activity, without samples</h2>
        <p>
          Delivery status only. Sample values never enter the log.
        </p>
        <div class="m-log" role="list">
          {
            LOG.map((row) => (
              <div class="m-log-row" role="listitem">
                <span class="m-log-time">{row.t}</span>
                <span class={`m-log-tag is-${row.kind}`}>{row.tag}</span>
                <span class="m-log-msg">{row.msg}</span>
              </div>
            ))
          }
        </div>
        <p class="m-log-foot">
          Illustrative lines. Device status comes from the last real delivery.
        </p>
      </div>
    </section>

    <figure class="m-schema m-reveal" aria-labelledby="schema-title">
      <div class="m-schema-top">
        <h2 id="schema-title">What “stored on your Mac” means</h2>
        <span>illustrative shape · not a live dump</span>
      </div>
      <pre><code><span class="cm">-- accepted batches become rows you can open with any SQLite tool</span>
<span class="kw">CREATE TABLE</span> received_batches (
  id           <span class="ty">INTEGER PRIMARY KEY</span>,
  received_at  <span class="ty">TEXT NOT NULL</span>,       <span class="cm">-- local timestamp</span>
  device_label <span class="ty">TEXT</span>,
  content_hash <span class="ty">TEXT NOT NULL</span>,       <span class="cm">-- duplicate detection</span>
  payload      <span class="ty">BLOB NOT NULL</span>        <span class="cm">-- the batch, on disk you own</span>
);</code></pre>
    </figure>

    <section class="m-answer m-reveal" id="start" aria-labelledby="answer-title">
<p class="m-kicker">A useful answer</p>
<h2 id="answer-title">How do I export my Apple Health data?</h2>
<p>
  Pick the Health types you want. Add your Mac, a Files folder, your server, MQTT, or
  Home Assistant. Send a test. Then choose manual, on-arrival, hourly, or daily delivery.
</p>
<p>Nothing leaves your phone until you confirm a destination.</p>
    </section>

    <footer class="m-close m-reveal">
<div>
  <p class="m-close-title">Start with one destination.</p>
  <p class="m-sub">Open source. No account. Early alpha.</p>
</div>
<div class="m-actions">
  <a class="m-button is-primary" href={GITHUB}>Follow the build</a>
  <a class="m-button" href="#top">Back to top</a>
</div>
    </footer>
  </main>
  <script is:inline>
    const root = document.querySelector('.m');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (root && !reducedMotion && 'IntersectionObserver' in window) {
root.classList.add('m-ready');
const observer = new IntersectionObserver(
  (entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    }
  },
  { threshold: 0.12 }
);
root.querySelectorAll('.m-reveal').forEach((element) => observer.observe(element));
    }
  </script>
</SketchLayout>
