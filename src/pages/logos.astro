---
/**
 * The logo gallery.
 *
 * Auto-discovers everything in `src/components/mark/logos/`, so concepts can be
 * built in parallel without a shared import list to collide on, and a missing
 * one cannot break the build.
 *
 * Every concept renders at four sizes against both a light and a dark ground,
 * because a mark that only works at 128px on white is not a mark yet. The 16px
 * column is the favicon test and it is where most of these will fail.
 */
import '../styles/sketch-base.css';
import { SITE } from '../data/site';
import { facePathsAt } from '../data/mark';

const mods = import.meta.glob('../components/mark/logos/*.astro', { eager: true }) as Record<
  string,
  { default: any }
>;
const metas = import.meta.glob('../components/mark/logos/*.meta.ts', { eager: true }) as Record<
  string,
  { default?: { n?: string; name?: string; idea?: string; ground?: string; palette?: string[] } }
>;

const all = Object.entries(mods)
  .map(([path, mod]) => {
    const slug = path.split('/').pop()!.replace('.astro', '');
    const meta = metas[path.replace('.astro', '.meta.ts')]?.default ?? {};
    return { slug, Comp: mod.default, meta };
  })
  .sort((a, b) => a.slug.localeCompare(b.slug));

/* Hozz marks are cNN; only the complete p31+/t31+ restart belongs in this review. */
const items = all.filter((i) => i.slug.startsWith('c'));
const plozz = all.filter((i) => /^p(?:3[1-9]|[4-9]\d)$/.test(i.slug));
const twozz = all.filter((i) => /^t(?:3[1-9]|[4-9]\d)$/.test(i.slug));

const SIZES = [96, 48, 28, 16];

/**
 * The current pick. Nothing is deleted when a mark is chosen — the whole set
 * stays on this page as a record of what was tried and rejected, which is worth
 * more than a tidy page. This just floats the selection to the top.
 */
const SELECTED = 'c45';
const chosen = all.find((i) => i.slug === SELECTED);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Logo concepts · Hozz</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="canonical" href={`${SITE}/logos/`} />
  </head>
  <body>
    <header class="top">
      <p class="eyebrow">Hozz · working file</p>
      <h1>{items.length} marks for the fourth sibling.</h1>
      <p class="lede">
        Plozz is a TV, Mozz is a disc, Twozz is a speech bubble. Hozz has to
        belong to that family without shouting like it — quieter, more
        translucent, more atmospheric. Every concept below competes on
        silhouette, palette, depth and light.
      </p>
      <p class="lede lede--fine">
        The face never competes. Every new carrier uses the same supplied 8×8
        face—two 3-wide <code>ZZ</code> eyes and the compact two-row smile—without
        redrawing or rescaling it.
      </p>
      <nav class="jump" aria-label="Jump to the new logo explorations">
        <a href="#plozz">Review {plozz.length} Plozz marks</a>
        <a href="#twozz">Review {twozz.length} Twozz / Strozz marks</a>
      </nav>

      <figure class="proof">
        <svg viewBox="0 0 32 32" width="120" height="120" shape-rendering="crispEdges" aria-hidden="true">
          {
            Array.from({ length: 32 }, (_, i) => (
              <>
                <line x1="0" y1={i} x2="32" y2={i} stroke="#e6e6ea" stroke-width="0.06" />
                <line x1={i} y1="0" x2={i} y2="32" stroke="#e6e6ea" stroke-width="0.06" />
              </>
            ))
          }
          <g fill="#14161a">
            {facePathsAt({ cx: 16, cy: 16, size: 'md', smile: 'compact', gap: 2 }).map((d) => <path d={d} />)}
          </g>
        </svg>
        <figcaption>
          The supplied face is the fixed part: exactly 8×8 pixels, centred on
          each carrier's body rather than on any tail or stand.
        </figcaption>
      </figure>
    </header>

    {
      chosen && (
        <section class="chosen">
          <div class="chosen-art">
            <div class="chosen-ground chosen-ground--light">
              <chosen.Comp size={128} />
            </div>
            <div class="chosen-ground chosen-ground--dark">
              <chosen.Comp size={128} />
            </div>
          </div>
          <div class="chosen-note">
            <p class="eyebrow">Selected</p>
            <h2>
              {chosen.meta.n} · {chosen.meta.name}
            </h2>
            <p>{chosen.meta.idea}</p>
            <p class="chosen-file">
              <a href="/marks/hozz-lens.svg" download>
                Download the SVG
              </a>{' '}
              — 32×32 grid, 4px padding, nine tones.
            </p>
            <p class="chosen-keep">
              Everything else stays below. A rejected mark is a record of what
              was tried, and that is worth keeping.
            </p>
          </div>
        </section>
      )
    }

    <main>
      {
        items.map((it) => {
          const C = it.Comp;
          const m = it.meta;
          return (
            <section class="card" id={it.slug}>
              <div class="meta">
                <p class="tag">
                  <b>{m.n ?? it.slug}</b>
                  <span>{m.name ?? 'Untitled'}</span>
                </p>
                {m.idea && <p class="idea">{m.idea}</p>}
                {m.palette && (
                  <ul class="pal">
                    {m.palette.map((c) => (
                      <li><i style={`background:${c}`} />{c}</li>
                    ))}
                  </ul>
                )}
              </div>

              <div class="grounds">
                <div class="ground ground--light">
                  {SIZES.map((s) => (
                    <span class="slot"><C size={s} /><em>{s}</em></span>
                  ))}
                </div>
                <div class="ground ground--dark">
                  {SIZES.map((s) => (
                    <span class="slot"><C size={s} /><em>{s}</em></span>
                  ))}
                </div>
              </div>
            </section>
          );
        })
      }
      {items.length === 0 && <p class="empty">No concepts yet.</p>}
      {
        plozz.length > 0 && (
          <>
            <header class="band" id="plozz">
              <h2>Plozz — {plozz.length} new directions</h2>
              <p>
                Ten distinct carrier ideas, each explored through four controlled
                variations. Every mark uses a dimensional 8–11-tone construction
                and the exact supplied face.
              </p>
            </header>
            {plozz.map((it) => {
              const C = it.Comp;
              const m = it.meta;
              return (
                <section class="card" id={it.slug}>
                  <div class="meta">
                    <p class="tag"><b>{m.n ?? it.slug}</b><span>{m.name ?? 'Untitled'}</span></p>
                    {m.idea && <p class="idea">{m.idea}</p>}
                    {m.palette && (
                      <ul class="pal">{m.palette.map((c) => (<li><i style={`background:${c}`} />{c}</li>))}</ul>
                    )}
                  </div>
                  <div class="grounds">
                    <div class="ground ground--light">
                      {SIZES.map((s) => (<span class="slot"><C size={s} /><em>{s}</em></span>))}
                    </div>
                    <div class="ground ground--dark">
                      {SIZES.map((s) => (<span class="slot"><C size={s} /><em>{s}</em></span>))}
                    </div>
                  </div>
                </section>
              );
            })}
          </>
        )
      }

      {
        twozz.length > 0 && (
          <>
            <header class="band" id="twozz">
              <h2>Twozz / Strozz — {twozz.length} new directions</h2>
              <p>
                Ten carrier families, each explored through four variations:
                conventional speech silhouettes, broader streaming forms and
                dimensional light treatments that still survive at icon size.
              </p>
            </header>
            {twozz.map((it) => {
              const C = it.Comp;
              const m = it.meta;
              return (
                <section class="card" id={it.slug}>
                  <div class="meta">
                    <p class="tag"><b>{m.n ?? it.slug}</b><span>{m.name ?? 'Untitled'}</span></p>
                    {m.idea && <p class="idea">{m.idea}</p>}
                    {m.palette && (
                      <ul class="pal">{m.palette.map((c) => (<li><i style={`background:${c}`} />{c}</li>))}</ul>
                    )}
                  </div>
                  <div class="grounds">
                    <div class="ground ground--light">
                      {SIZES.map((s) => (<span class="slot"><C size={s} /><em>{s}</em></span>))}
                    </div>
                    <div class="ground ground--dark">
                      {SIZES.map((s) => (<span class="slot"><C size={s} /><em>{s}</em></span>))}
                    </div>
                  </div>
                </section>
              );
            })}
          </>
        )
      }
    </main>

    <footer class="end">
      <a href="/directions/">Directions board</a>
      <a href="/lab/">Visualisation lab</a>
    </footer>
  </body>
</html>

<style>
  body {
    background: #f4f5f7;
    color: #14161a;
    font-family: var(--sans);
  }

  .top {
    width: min(100% - 2.5rem, 1180px);
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 4vw, 2.5rem);
  }

  .eyebrow {
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6a6f77;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2rem, 1.2rem + 3.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.042em;
    line-height: 1.02;
  }

  .lede {
    margin-top: 1.1rem;
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: #4d525a;
  }

  .lede--fine {
    font-size: 0.9375rem;
  }

  .lede code {
    font-family: var(--mono);
    font-size: 0.875em;
    color: #23262b;
  }

  .proof {
    margin: 2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    padding: 1.15rem;
    background: #fff;
    border: 1px solid #e4e6ea;
    border-radius: 16px;
    max-width: 44rem;
  }

  .proof svg {
    background: #fff;
    border-radius: 8px;
    flex: none;
  }

  .proof figcaption {
    font-size: 0.875rem;
    line-height: 1.5;
    color: #5c6169;
    max-width: 34ch;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.25rem;
  }

  .jump a {
    padding: 0.65rem 0.85rem;
    color: #132638;
    background: #fff;
    border: 1px solid #d8dbe0;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  main {
    width: min(100% - 2.5rem, 1180px);
    margin-inline: auto;
    display: grid;
    gap: 1.25rem;
    padding-bottom: 4rem;
  }

  .band {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 0;
  }

  .band h2 {
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .band p {
    margin-top: 0.7rem;
    max-width: 58ch;
    line-height: 1.55;
    color: #4d525a;
  }

  /**
   * The Selected block. It gets the same pair of grounds as every card below,
   * because the decision it records was made by looking at both — promoting a
   * mark that had only ever been checked on white is precisely the mistake
   * this page exists to catch.
   */
  .chosen {
    display: grid;
    gap: 1.5rem;
    margin-block: clamp(1.25rem, 3vw, 2rem);
    padding: clamp(1.35rem, 3vw, 2rem);
    background: #fff;
    border: 1px solid #d8dbe0;
    border-radius: 18px;
  }

  @media (min-width: 940px) {
    .chosen {
      grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
      gap: 2.25rem;
      align-items: center;
    }
  }

  .chosen-art {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .chosen-ground {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    border-radius: 14px;
  }

  /* The marks come in at a fixed 128px, so let them shrink with the column
     instead of pushing it wider than the grid track. */
  .chosen-ground :global(svg) {
    width: 100%;
    height: auto;
    max-width: 128px;
  }

  .chosen-ground--light {
    background: #fbfbfc;
    border: 1px solid #eceef1;
  }

  .chosen-ground--dark {
    background: #17181c;
    border: 1px solid #17181c;
  }

  .chosen-note h2 {
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .chosen-note p {
    margin-top: 0.7rem;
    max-width: 58ch;
    line-height: 1.55;
    color: #4d525a;
  }

  .chosen-file,
  .chosen-keep {
    font-size: 0.875rem;
    color: #6a6f77;
  }

  .card {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.85rem);
    background: #fff;
    border: 1px solid #e4e6ea;
    border-radius: 18px;
  }

  .card > * {
    min-inline-size: 0;
  }

  @media (min-width: 940px) {
    .band {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 0;
  }

  .band h2 {
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .band p {
    margin-top: 0.7rem;
    max-width: 58ch;
    line-height: 1.55;
    color: #4d525a;
  }

  .card {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      gap: 2.25rem;
      align-items: center;
    }
  }

  .tag {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .tag b {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: #6b7079;
  }

  .tag span {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.032em;
  }

  .idea {
    margin-top: 0.55rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #5c6169;
  }

  .pal {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }

  .pal li {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    font-family: var(--mono);
    font-size: 0.625rem;
    color: #5d626a;
    border: 1px solid #e8eaee;
    border-radius: 999px;
    padding: 0.14rem 0.42rem 0.14rem 0.2rem;
  }

  .pal i {
    inline-size: 11px;
    block-size: 11px;
    border-radius: 3px;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }

  .grounds {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 620px) {
    .grounds {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ground {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    padding: 1.15rem 0.85rem 0.85rem;
    border-radius: 14px;
  }

  .ground--light {
    background: #fbfbfc;
    border: 1px solid #eceef1;
  }

  .ground--dark {
    background: #17181c;
    border: 1px solid #17181c;
  }

  .slot {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
  }

  .slot em {
    font-style: normal;
    font-family: var(--mono);
    font-size: 0.5625rem;
    color: #6b7079;
  }

  .ground--dark .slot em {
    color: #9298a1;
  }

  .empty {
    padding: 4rem 0;
    text-align: center;
    color: #6a6f77;
  }

  .end {
    width: min(100% - 2.5rem, 1180px);
    margin: 0 auto 5rem;
    display: flex;
    gap: 1.5rem;
  }

  .end a {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #14161a;
    text-decoration: none;
    border-bottom: 2px solid #c6cad1;
    padding-bottom: 2px;
  }

  .end a:hover {
    border-bottom-color: #14161a;
  }

  :focus-visible {
    outline: 3px solid #0070e0;
    outline-offset: 3px;
  }
</style>
