/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # SAMEORIGIN rather than DENY: the clickjacking this defends against is a
  # third-party site framing ours, which this still blocks outright. Allowing
  # our own origin is what lets /directions/ show the variations side by side.
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
